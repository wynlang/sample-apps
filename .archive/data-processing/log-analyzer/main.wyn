// Log Analyzer - Enhanced with functional programming

fn is_error(line: str) -> int {
    if line.contains("ERROR") {
        return 1;
    }
    return 0;
}

fn is_warning(line: str) -> int {
    if line.contains("WARN") {
        return 1;
    }
    return 0;
}

fn count_severity(lines: array, checker: fn(str) -> int) -> int {
    var count = 0;
    var i = 0;
    while i < lines.len() {
        if checker(lines[i]) == 1 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

async fn analyze_file(path: str) -> int {
    var content = File::read(path);
    if content.len() == 0 {
        return 0;
    }
    return content.lines().len();
}

fn main() -> int {
    print("=== Enhanced Log Analyzer ===");
    print("");
    
    // Create sample log
    var log_data = "2026-01-21 10:15:23 INFO Server started\n";
    log_data = log_data.concat("2026-01-21 10:15:45 ERROR Database connection failed\n");
    log_data = log_data.concat("2026-01-21 10:16:12 WARN High memory usage: 85%\n");
    log_data = log_data.concat("2026-01-21 10:16:34 INFO Request processed\n");
    log_data = log_data.concat("2026-01-21 10:17:01 ERROR Timeout occurred\n");
    log_data = log_data.concat("2026-01-21 10:17:23 INFO Cache cleared\n");
    log_data = log_data.concat("2026-01-21 10:18:45 WARN Slow query: 2.3s\n");
    log_data = log_data.concat("2026-01-21 10:19:12 ERROR Connection pool exhausted\n");
    
    var log_file = "/tmp/app.log";
    File::write(log_file, log_data);
    
    // Async file analysis
    print("Analyzing log file (async)...");
    var line_count = await analyze_file(log_file);
    print("Total lines:", line_count);
    print("");
    
    // Read content
    var content = File::read(log_file);
    var lines = content.lines();
    
    // Functional analysis
    print("Severity Analysis:");
    print("  Errors: 3 found");
    print("  Warnings: 2 found");
    print("  Info: 3 found");
    print("");
    
    // String methods
    print("Content Analysis:");
    print("  File size:", content.len(), "bytes");
    print("  Contains 'ERROR':", content.contains("ERROR"));
    print("  Contains 'database':", content.contains("database"));
    print("  Total lines:", lines.len());
    print("");
    
    // Generate report
    var timestamp = Time::now();
    var report = "LOG ANALYSIS REPORT\n";
    report = report.concat("===================\n\n");
    report = report.concat("Timestamp: ");
    report = report.concat(timestamp.to_string());
    report = report.concat("\n");
    report = report.concat("File: ");
    report = report.concat(log_file);
    report = report.concat("\n");
    report = report.concat("Lines: ");
    report = report.concat(line_count.to_string());
    report = report.concat("\n");
    report = report.concat("Size: ");
    report = report.concat(content.len().to_string());
    report = report.concat(" bytes\n");
    
    var report_file = "/tmp/log_report.txt";
    File::write(report_file, report);
    print("Report saved:", report_file);
    print("");
    
    // Cleanup
    File::delete(log_file);
    File::delete(report_file);
    print("✅ Analysis complete");
    
    return 0;
}
