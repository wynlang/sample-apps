// Process Monitor - Real system process monitoring
fn main() -> int {
    print("=== PROCESS MONITOR ===");
    print("");
    
    // Get real process list
    var ps_output = System::exec("ps aux | head -10");
    print("Top Processes:");
    print(ps_output);
    print("");
    
    // Get memory info
    var mem_output = System::exec("free -h 2>/dev/null || vm_stat 2>/dev/null | head -5");
    print("Memory Status:");
    print(mem_output);
    print("");
    
    // Get uptime
    var uptime_cmd = System::exec("uptime");
    var uptime = uptime_cmd.trim();
    print("System Uptime:");
    print(uptime);
    print("");
    
    // Check if specific process is running
    var nginx_check = System::exec("ps aux | grep nginx | grep -v grep | wc -l");
    var nginx_count = nginx_check.trim();
    print("Nginx processes: ${nginx_count}");
    
    // Save report
    var report = "SYSTEM MONITOR REPORT\n=====================\n\n";
    report = report.concat("Uptime: ").concat(uptime).concat("\n");
    File::write("/tmp/system_report.txt", report);
    print("");
    print("Report saved to /tmp/system_report.txt");
    
    return 0;
}
