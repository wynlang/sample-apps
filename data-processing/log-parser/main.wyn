// Log Parser — Parse structured logs, extract errors, generate report
// Demonstrates: File.read, string methods, structs, enums, Result type

struct LogEntry { timestamp: string, level: string, message: string }

fn parse_log_line(line: string) -> ResultInt {
    if line.len() < 25 {
        return Err("Line too short")
    }
    // Format: "2026-02-11 08:00:01 LEVEL Message..."
    // Timestamp is first 19 chars, level starts at 20
    return Ok(1)
}

fn main() {
    println("=== Log Parser ===")
    println("")

    var content = File.read("../sample-apps/data-processing/log-parser/sample.log")
    var line_start = 0
    var total_len = content.len()

    var info_count = 0
    var warn_count = 0
    var error_count = 0
    var total_lines = 0

    println("Errors found:")

    for idx in 0..total_len {
        if content[idx] == "\n" {
            var line = content.substring(line_start, idx)
            var trimmed = line.trim()
            line_start = idx + 1

            if trimmed.len() < 20 { continue }
            total_lines = total_lines + 1

            if trimmed.contains("ERROR") {
                error_count = error_count + 1
                // Extract timestamp (first 19 chars)
                var ts = trimmed.substring(0, 19)
                // Extract message (after level)
                var msg_start = trimmed.index_of("ERROR") + 6
                var msg = trimmed.substring(msg_start, trimmed.len())
                println("  [" + ts + "] " + msg)
            }
            if trimmed.contains("WARN") {
                warn_count = warn_count + 1
            }
            if trimmed.contains("INFO") {
                info_count = info_count + 1
            }
        }
    }

    println("")
    println("=== Summary ===")
    println("  Total lines: " + total_lines.to_string())
    println("  INFO:        " + info_count.to_string())
    println("  WARN:        " + warn_count.to_string())
    println("  ERROR:       " + error_count.to_string())

    if error_count > 0 {
        println("")
        println("  ⚠ " + error_count.to_string() + " errors require attention!")
    }

}
