// Log Parser -- Parse structured logs, extract errors, generate report
// Demonstrates: File.read, string interpolation, structs, pattern matching

fn main() -> int {
    println("=== Log Parser ===")
    println("")

    var content = File.read("../sample-apps/data-processing/log-parser/sample.log")
    var line_start = 0
    var total_len = content.len()

    var info_count = 0
    var warn_count = 0
    var error_count = 0
    var total_lines = 0

    var errors = ["", "", "", "", "", "", "", "", "", ""]
    var error_idx = 0

    println("Errors found:")

    for idx in 0..total_len {
        if content[idx] == "\n" {
            var line = content.substring(line_start, idx)
            var trimmed = line.trim()
            line_start = idx + 1

            if trimmed.len() < 20 { continue }
            total_lines += 1

            if trimmed.contains("ERROR") {
                error_count += 1
                var ts = trimmed.substring(0, 19)
                var msg_start = trimmed.index_of("ERROR") + 6
                var msg = trimmed.substring(msg_start, trimmed.len())
                println("  [${ts}] ${msg}")
                if error_idx < 10 {
                    errors[error_idx] = msg
                    error_idx += 1
                }
            } else if trimmed.contains("WARN") {
                warn_count += 1
            } else if trimmed.contains("INFO") {
                info_count += 1
            }
        }
    }

    println("")
    println("=== Summary ===")
    println("  Total lines: ${total_lines}")
    println("  INFO:        ${info_count}")
    println("  WARN:        ${warn_count}")
    println("  ERROR:       ${error_count}")

    if error_count > 0 {
        println("")
        println("  ⚠ ${error_count} errors require attention!")
    }
    return 0
}
