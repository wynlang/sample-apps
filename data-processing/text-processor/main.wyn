// Text Processor - Simplified without complex modules

fn count_lines(text: string) -> int {
    return text.lines().len();
}

fn main() -> int {
    print("=== TEXT PROCESSOR ===");
    print("");
    
    // Create test file
    var test_content = "Hello World\nThis is a test\nWyn is great";
    var test_file = "/tmp/test.txt";
    File::write(test_file, test_content);
    
    // Read and analyze
    print("Reading file...");
    var content = File::read(test_file);
    
    if content.len() == 0 {
        print("Error: Empty file");
        return 1;
    }
    
    print("");
    print("=== FILE ANALYSIS ===");
    
    // Count lines
    var line_count = count_lines(content);
    var char_count = content.len();
    
    print("Characters:", char_count);
    print("Lines:", line_count);
    
    print("");
    print("✅ Text processing working!");
    
    return 0;
}
