// CSV Analyzer -- Read student grades, compute statistics
// Demonstrates: File.read, string interpolation, structs, computed grades

fn main() {
    print("=== Student Grade Analyzer ===")
    print("")

    // Data file lives next to this source; also try cwd for `wyn run` from src/.
    var path = "src/data.csv"
    if File.exists(path) == 0 { path = "data.csv" }
    if File.exists(path) == 0 {
        print("data.csv not found - run from the app root (src/data.csv)")
        return
    }
    var content = File.read(path)
    var line_start = 0
    var total_len = content.len()
    var count = 0
    var sum_math = 0
    var sum_sci = 0
    var sum_eng = 0
    var best_avg = 0
    var best_name = ""

    print("Name       Math  Sci   Eng   Avg  Grade")
    print("─────────────────────────────────────────")

    for idx in 0..total_len {
        if content[idx] == "\n" {
            var line = content.substring(line_start, idx).trim()
            line_start = idx + 1

            if line.len() == 0 { continue }
            if line.contains(",") == 0 { continue }

            var name = line.split_at(",", 0)
            var math_score = line.split_at(",", 1).to_int()
            var sci_score = line.split_at(",", 2).to_int()
            var eng_score = line.split_at(",", 3).to_int()
            var avg = (math_score + sci_score + eng_score) / 3

            var grade = "F"
            if avg >= 90 { grade = "A" }
            else if avg >= 80 { grade = "B" }
            else if avg >= 70 { grade = "C" }
            else if avg >= 60 { grade = "D" }

            print("${name}     ${math_score}    ${sci_score}    ${eng_score}    ${avg}   ${grade}")

            sum_math += math_score
            sum_sci += sci_score
            sum_eng += eng_score
            count += 1

            if avg > best_avg {
                best_avg = avg
                best_name = name
            }
        }
    }

    print("─────────────────────────────────────────")
    print("")
    print("Students:     ${count}")
    print("Avg Math:     ${sum_math / count}")
    print("Avg Science:  ${sum_sci / count}")
    print("Avg English:  ${sum_eng / count}")
    print("Top Student:  ${best_name} (avg: ${best_avg})")
}
