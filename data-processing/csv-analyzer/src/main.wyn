// csv-analyzer -- read a real CSV, infer each column's type, profile it, print it aligned.
//
// The previous version was a "Student Grade Analyzer" with five students HARDCODED in the
// source, and its table was ragged because the name column was never padded -- real output:
//     Alice     85    92    78    85   B
//     Bob     90    88    95    91   A
//     Charlie     72    68    80    73   C
// It also walked `content[idx]` one character at a time hunting for "\n", and it knew the
// schema (name, math, sci, eng) at compile time -- so it could analyze exactly one CSV:
// the one already inside it.
//
// Rewritten as an actual CSV analyzer:
//   * `.lines()` / `.split(",")` replace the hand-rolled character scan.
//   * NO schema knowledge. `infer()` reads the values and returns `Kind { Int, Float, Text }`;
//     `match` then picks statistics that make sense -- min/max/mean/median for numbers,
//     cardinality and top values for text -- into one `struct Column`.
//   * every column is profiled CONCURRENTLY: one `spawn` each, joined by `await_all`.
//   * every width is the widest cell, applied with `pad_right`/`pad_left` (both UTF-8 aware,
//     so the rule and non-ASCII names line up); numeric columns align right and get an
//     8-bucket histogram.
//
//   wyn run src/main.wyn [file.csv]

enum Kind { Int, Float, Text }

struct Column {
    name: string, kind: Kind, facts: string,
    min: float, max: float, mean: float, median: float, hist: [int]
}

fn kname(k: Kind) -> string => match k { Kind.Int => "int", Kind.Float => "float", Kind.Text => "text" }
fn numeric(k: Kind) -> bool => match k { Kind.Text => false, _ => true }

// A raw float prints as 14.285714285714286; round to 2 decimals. Int columns stay ints.
fn f2(x: float) -> string {
    var sign = ""
    var v = x
    if v < 0.0 { sign = "-"  v = 0.0 - v }
    var n = (v * 100.0 + 0.5).to_int()
    var frac = "${n % 100}"
    return "${sign}${n / 100}.${frac.pad_left(2, "0")}"
}
fn num(k: Kind, x: float) -> string => match k { Kind.Int => "${x.to_int()}", _ => f2(x) }

// 2 = looks like a float, 1 = looks like an int, 0 = anything else.
fn shape(v: string) -> int {
    var digits = 0
    var dots = 0
    for i in 0..v.len() {
        var c = v[i]
        if "0123456789".contains(c) { digits += 1 }
        else if c == "." { dots += 1 }
        else if not (c == "-" and i == 0) { return 0 }
    }
    if digits == 0 or dots > 1 { return 0 }
    return dots + 1
}

// A column's type is whatever EVERY value in it agrees to be. No schema, no configuration.
// (Written as a loop, not `vals.map((v) => shape(v))`: a lambda that calls a USER-DEFINED
// function is emitted above that function's forward declaration in the generated C ->
// "call to undeclared function". Lambdas over builtin methods, as below, are fine.)
fn infer(vals: [string]) -> Kind {
    var shapes = []
    for v in vals { shapes.push(shape(v)) }
    if shapes.min() == 0 { return Kind.Text }
    if shapes.max() == 1 { return Kind.Int }
    return Kind.Float
}

// What there is to say about a text column: how many distinct values, and the top two.
fn text_facts(vals: [string]) -> string {
    var counts = HashMap.new()
    for v in vals { counts.insert_int(v, counts.get_int(v) + 1) }
    var distinct = counts.keys().len()
    if distinct == vals.len() { return "distinct ${distinct} -- every value unique" }
    var out = []
    for round in 0..2 {
        var best = ""
        var n = 0
        for k in counts.keys() { if counts.get_int(k) > n { n = counts.get_int(k)  best = "" + k } }
        if n == 0 { break }
        out.push("${best} ${n}x")
        counts.insert_int(best, 0)
    }
    return "distinct ${distinct}, top: ${out.join(", ")}"
}

// One column's values: a stride through the flat cell array.
fn values_of(cells: [string], ncol: int, j: int) -> [string] {
    var out = []
    var i = j
    while i < cells.len() { out.push("" + cells[i])  i = i + ncol }
    return out
}

// One aligned row: pad_left for the numeric columns, pad_right for the rest (and never the
// last one, so no line carries trailing space).
fn row(vals: [string], widths: [int], right: [int]) -> string {
    var out = []
    for j in 0..vals.len() {
        var v = "" + vals[j]
        if right[j] == 1 { v = v.pad_left(widths[j], " ") }
        else if j < vals.len() - 1 { v = v.pad_right(widths[j], " ") }
        out.push(v)
    }
    return out.join("  ")
}

// The statistics. `facts` arrives pre-computed for text columns (HashMap is not
// concurrency-safe in the current runtime) so the spawned half stays purely numeric.
fn profile(name: string, facts: string, vals: [string]) -> Column {
    var c = Column { name: name, kind: infer(vals), facts: facts,
        min: 0.0, max: 0.0, mean: 0.0, median: 0.0, hist: [0, 0, 0, 0, 0, 0, 0, 0] }
    if not numeric(c.kind) { return c }
    // A loop, not `vals.map((v) => v.to_float())`: a float-returning lambda in `.map()`
    // yields [1, 1, 1] on this compiler -- silently wrong rather than a compile error.
    var nums = []
    for v in vals { nums.push(v.to_float()) }
    var s = nums.sorted()
    var mid = s.len() / 2
    c.min = s.first()
    c.max = s.last()
    c.mean = nums.sum() / nums.len().to_float()
    c.median = s[mid]
    if s.len() % 2 == 0 { c.median = (s[mid - 1] + s[mid]) / 2.0 }
    var span = c.max - c.min
    if span == 0.0 { span = 1.0 }
    for x in nums { c.hist[((x - c.min) / span * 7.99).to_int()] += 1 }
    c.facts = "min ${num(c.kind, c.min)}  max ${num(c.kind, c.max)}  mean ${f2(c.mean)}  median ${f2(c.median)}"
    return c
}

fn main() {
    print("\x1b[1;36m═══ csv analyzer ═══\x1b[0m")

    // The argument, or the bundled data.csv, found from the app dir, src/, or the repo root.
    var path = ""
    var args = System.args()
    if args.len() > 1 { path = "" + args[1] }
    else {
        for cand in ["data.csv", "../data.csv", "data-processing/csv-analyzer/data.csv"] {
            if File.exists(cand) == 1 { path = "" + cand  break }
        }
    }
    if path == "" or File.exists(path) == 0 {
        print("  \x1b[31mno such file:\x1b[0m ${path}  (usage: wyn run src/main.wyn [file.csv])")
        return
    }

    // The header names the columns; every later row appends its cells to one flat array.
    var header = []
    var cells = []
    var rows = 0
    for line in File.read(path).lines() {
        if line.trim().len() == 0 { continue }
        var fields = line.trim().split(",")
        if header.len() == 0 { for f in fields { header.push(("" + f).trim()) }  continue }
        if fields.len() != header.len() { continue }
        for f in fields { cells.push(("" + f).trim()) }
        rows += 1
    }
    var ncol = header.len()
    if rows == 0 { print("  \x1b[31mno data rows in\x1b[0m ${path}")  return }
    print("  \x1b[90m${path}\x1b[0m  ${rows} rows x ${ncol} columns")

    // Width = widest cell in the column. Profiling = one spawn each, joined by await_all.
    var futs = []
    var widths = []
    for j in 0..ncol {
        var vals = values_of(cells, ncol, j)
        var name = "" + header[j]
        var lens = vals.map((v) => v.len())
        lens.push(name.len())
        widths.push(lens.max())
        futs.push(spawn profile(name, text_facts(vals), vals))
    }
    var cols = await_all(futs)

    // The inferred type also decides the alignment: numbers right, text left.
    var right = []
    var head = []
    var rule = []
    for j in 0..ncol {
        var r = 0
        if numeric(cols[j].kind) { r = 1 }
        right.push(r)
        head.push(("" + cols[j].name).upper())
        rule.push("─".repeat(widths[j]))
    }

    print("")
    print("  \x1b[1m${row(head, widths, right)}\x1b[0m")
    print("  \x1b[90m${rule.join("  ")}\x1b[0m")
    for i in 0..rows {
        var cs = []
        for j in 0..ncol { cs.push("" + cells[i * ncol + j]) }
        print("  ${row(cs, widths, right)}")
    }

    // Numeric columns also get their distribution: 8 equal buckets from min to max.
    print("")
    print("  \x1b[1mcolumn profile\x1b[0m")
    for c in cols {
        print("")
        print("  \x1b[1m${("" + c.name).pad_right(14, " ")}\x1b[0m \x1b[36m${kname(c.kind).pad_right(6, " ")}\x1b[0m ${"" + c.facts}")
        if not numeric(c.kind) or c.min == c.max { continue }
        var peak = c.hist.max()
        for b in 0..8 {
            var lo = num(c.kind, c.min + (c.max - c.min) * b.to_float() / 8.0)
            var bar = "█".repeat(c.hist[b] * 20 / peak)
            print("    ${lo.pad_left(11, " ")} \x1b[36m${bar}\x1b[0m ${c.hist[b]}")
        }
    }
    print("")
}
