// CSV Analyzer — Read student grades, compute statistics

fn main() {
    println("=== Student Grade Analyzer ===")
    println("")

    var content = File.read("../sample-apps/data-processing/csv-analyzer/data.csv")
    var line_start = 0
    var total_len = content.len()
    var count = 0
    var sum_math = 0
    var sum_sci = 0
    var sum_eng = 0
    var best_avg = 0
    var best_name = ""

    println("Name       Math  Sci   Eng   Avg  Grade")
    println("─────────────────────────────────────────")

    for idx in 0..total_len {
        if content[idx] == "\n" {
            var line = content.substring(line_start, idx)
            var trimmed = line.trim()
            line_start = idx + 1

            if trimmed.len() == 0 { continue }
            if trimmed.contains(",") == 0 { continue }

            var name = trimmed.split_at(",", 0)
            var ms = trimmed.split_at(",", 1)
            var ss = trimmed.split_at(",", 2)
            var es = trimmed.split_at(",", 3)
            var math_score = ms.to_int()
            var sci_score = ss.to_int()
            var eng_score = es.to_int()
            var avg = (math_score + sci_score + eng_score) / 3

            var grade = "F"
            if avg >= 60 { grade = "D" }
            if avg >= 70 { grade = "C" }
            if avg >= 80 { grade = "B" }
            if avg >= 90 { grade = "A" }

            println(name + "     " + math_score.to_string() + "    " + sci_score.to_string() + "    " + eng_score.to_string() + "    " + avg.to_string() + "   " + grade)

            sum_math = sum_math + math_score
            sum_sci = sum_sci + sci_score
            sum_eng = sum_eng + eng_score
            count = count + 1

            if avg > best_avg {
                best_avg = avg
                best_name = name
            }
        }
    }

    println("─────────────────────────────────────────")
    println("")
    println("Students:     " + count.to_string())
    var avg_m = sum_math / count
    var avg_s = sum_sci / count
    var avg_e = sum_eng / count
    println("Avg Math:     " + avg_m.to_string())
    println("Avg Science:  " + avg_s.to_string())
    println("Avg English:  " + avg_e.to_string())
    println("Top Student:  " + best_name + " (avg: " + best_avg.to_string() + ")")

}
