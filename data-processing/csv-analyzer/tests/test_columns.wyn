// Tests for the two things csv-analyzer can get silently wrong: what TYPE a column is,
// and whether the table lines up. The app had no tests at all, which is how it shipped
// with a visibly ragged table (`Alice     85` beside `Bob     90`) and a hardcoded
// dataset presented as if parsed.
//
// The functions below mirror src/main.wyn.
//
//   wyn test tests/test_columns.wyn

enum Kind { Int, Float, Text }

fn kname(k: Kind) -> string => match k { Kind.Int => "int", Kind.Float => "float", Kind.Text => "text" }
fn numeric(k: Kind) -> bool => match k { Kind.Text => false, _ => true }

// 0 = not a number, 1 = integer, 2 = decimal. The digit/dot shape of one cell.
fn shape(v: string) -> int {
    var digits = 0
    var dots = 0
    for i in 0..v.len() {
        var c = v[i]
        if "0123456789".contains(c) { digits += 1 }
        else if c == "." { dots += 1 }
        else if not (c == "-" and i == 0) { return 0 }
    }
    if digits == 0 or dots > 1 { return 0 }
    return dots + 1
}

fn infer(vals: [string]) -> Kind {
    var shapes = []
    for v in vals { shapes.push(shape(v)) }
    if shapes.min() == 0 { return Kind.Text }
    if shapes.max() == 1 { return Kind.Int }
    return Kind.Float
}

// ---- the shape of a single cell --------------------------------------------

test "an integer is shape 1" {
    assert_eq(shape("0"), 1)
    assert_eq(shape("142000"), 1)
    assert_eq(shape("-5"), 1)
}

test "a decimal is shape 2" {
    assert_eq(shape("4.8"), 2)
    assert_eq(shape("-0.5"), 2)
    assert_eq(shape("100.0"), 2)
}

test "anything else is shape 0" {
    assert_eq(shape("Alice Chen"), 0)
    assert_eq(shape(""), 0)          // no digits at all
    assert_eq(shape("12a"), 0)
    assert_eq(shape("1.2.3"), 0)     // more than one dot is not a number
    assert_eq(shape("5-3"), 0)       // a minus is only allowed leading
    assert_eq(shape("."), 0)
}

// ---- a column's type is whatever EVERY value agrees to be -------------------

test "all integers make an int column" {
    assert_eq(kname(infer(["1", "2", "300"])), "int")
}

test "one decimal makes the whole column a float" {
    // The rule that matters: a column of mostly-integers with one decimal must not be
    // reported as int, or its mean and median would be computed on truncated values.
    assert_eq(kname(infer(["1", "2", "3.5"])), "float")
    assert_eq(kname(infer(["4.8", "4.1", "5"])), "float")
}

test "one non-numeric value makes the whole column text" {
    assert_eq(kname(infer(["1", "2", "n/a"])), "text")
    assert_eq(kname(infer(["Berlin", "Lisbon", "Austin"])), "text")
    // An empty cell is not a number, so the column is text rather than silently 0.
    assert_eq(kname(infer(["1", "", "3"])), "text")
}

test "numeric() agrees with the kind" {
    assert(numeric(infer(["1", "2"])))
    assert(numeric(infer(["1.5", "2"])))
    assert(not numeric(infer(["a", "b"])))
}

// ---- alignment: the headline bug of the old version ------------------------
// The old table was ragged because the name column was printed unpadded. The rule is
// that every cell in a column is padded to the width of the WIDEST cell, so the only
// thing worth asserting is that the widths agree across rows.

fn width_of(vals: [string]) -> int {
    var w = 0
    for v in vals { if v.len() > w { w = v.len() } }
    return w
}

test "a column's width is its widest cell" {
    assert_eq(width_of(["Alice Chen", "Bob Marsh", "Hana Watanabe"]), 13)
    assert_eq(width_of(["a"]), 1)
}

test "padding every cell to that width makes rows line up" {
    var names = ["Alice Chen", "Bob Marsh", "Hana Watanabe"]
    var w = width_of(names)
    // Every padded cell has the SAME length - that is exactly what "aligned" means, and
    // what the old version failed: `Alice     85` beside `Bob     90`.
    for n in names { assert_eq(n.pad_right(w, " ").len(), w) }
}

test "the shipped data.csv is really parsed, not hardcoded" {
    // The old app carried its dataset in the source. This asserts the file exists and
    // that its header names the columns the report claims to profile.
    assert_eq(File.exists("data.csv"), 1)
    var rows = File.read("data.csv").split("\n")
    assert(rows.len() > 1)
    var head = "" + rows[0]
    assert(head.contains("name"))
    assert(head.contains("salary"))
    // Every data row has the same number of fields as the header.
    var ncol = head.split(",").len()
    var checked = 0
    for i in 1..rows.len() {
        var r = "" + rows[i]
        if r.len() == 0 { continue }
        assert_eq(r.split(",").len(), ncol)
        checked += 1
    }
    assert(checked > 5)
}
