// Data Pipeline - Showcases all Wyn v1.4.0 features
// Demonstrates: functional programming, async/await, networking, file I/O

// === Functional transformations ===
fn parse_number(line: str) -> int {
    return line.trim().parse_int();
}

fn is_valid(n: int) -> int {
    return n > 0;
}

fn square(n: int) -> int {
    return n * n;
}

fn sum(acc: int, n: int) -> int {
    return acc + n;
}

// === Async data fetching ===
async fn fetch_from_file(path: str) -> int {
    var content = File::read(path);
    if content.len() == 0 {
        return 0;
    }
    return content.lines().len();
}

async fn process_async(data: int) -> int {
    Time::sleep(1);
    return data * 2;
}

// === Higher-order function ===
fn apply_pipeline(arr: array, transform: fn(int) -> int) -> array {
    return arr.map(transform);
}

fn main() -> int {
    print("=== Wyn v1.4.0 Data Pipeline ===");
    print("");
    
    // === String methods ===
    var text = "  Hello, Wyn!  ";
    print("String processing:");
    print("  Original:", text);
    print("  Trimmed:", text.trim());
    print("  Upper:", text.upper());
    print("  Contains 'Wyn':", text.contains("Wyn"));
    print("");
    
    // === Array functional methods ===
    var numbers = [1, 2, 3, 4, 5, -1, -2];
    print("Functional array operations:");
    print("  Original:", numbers.len(), "elements");
    
    var positive = numbers.filter(is_valid);
    print("  Filtered (positive):", positive.len(), "elements");
    
    var squared = positive.map(square);
    print("  Mapped (squared):", squared.len(), "elements");
    
    var total = squared.reduce(sum, 0);
    print("  Reduced (sum):", total);
    print("");
    
    // === Higher-order functions ===
    print("Higher-order functions:");
    var transformed = apply_pipeline([10, 20, 30], square);
    print("  Pipeline result:", transformed[0], transformed[1], transformed[2]);
    print("");
    
    // === File I/O ===
    print("File operations:");
    var test_file = "/tmp/wyn_test.txt";
    File::write(test_file, "Line 1\nLine 2\nLine 3");
    
    if File::exists(test_file) {
        var content = File::read(test_file);
        var line_count = content.lines().len();
        print("  Lines in file:", line_count);
        File::delete(test_file);
        print("  File cleaned up");
    }
    print("");
    
    // === Async/await ===
    print("Async operations:");
    var async_result = await process_async(50);
    print("  Async result:", async_result);
    print("");
    
    // === Integer methods ===
    var num = 42;
    print("Integer operations:");
    print("  Binary:", num.to_binary());
    print("  Hex:", num.to_hex());
    print("  Is even:", num.is_even());
    print("");
    
    // === Float methods ===
    var pi = 3.14159;
    print("Float operations:");
    print("  Rounded:", pi.round());
    print("  Floor:", pi.floor());
    print("");
    
    // === System operations ===
    print("System info:");
    var args = System::args();
    print("  Args count:", args.len());
    print("  Current dir:", File::get_cwd());
    print("");
    
    // === Time operations ===
    var timestamp = Time::now();
    print("Time:", timestamp);
    print("");
    
    print("✅ All features demonstrated successfully!");
    return 0;
}
