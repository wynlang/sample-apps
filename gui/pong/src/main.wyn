// Pong -- Classic arcade game in Wyn
// Demonstrates: Gui, game loop, AI opponent, collision, scoring
// Controls: Up/Down arrows or W/S, Esc to quit, Space to pause

var sep = "|"
var py = 250       // player paddle Y
var bx = 400       // ball X
var by = 300       // ball Y
var bdx = 5        // ball velocity X
var bdy = 3        // ball velocity Y
var ay = 250       // AI paddle Y
var sl = 0         // score left (player)
var sr = 0         // score right (AI)
var paused = 0
var paddle_h = 80
var paddle_w = 12
var ball_sz = 10
var speed = 5

fn reset_ball() {
    bx = 400
    by = 300
    bdx = speed
    if sl > sr { bdx = 0 - speed }
    bdy = 3
}

fn main() {
    var ok = Gui.create("Wyn Pong", 800, 600)
    if ok < 0 {
        print("Install SDL2: brew install sdl2")
        return 1
    }

    while Gui.running() > 0 {
        var ev = Gui.poll()
        var t = ev.split_at(sep, 0)
        if t == "quit" { break }
        if t == "key" {
            var k = ev.split_at(sep, 1).to_int()
            if k == 27 { break }
            if k == 32 { paused = 1 - paused }
        }

        // Input -- arrows and WASD
        if Gui.key_pressed(1073741906) > 0 or Gui.key_pressed(119) > 0 { py = py - 7 }
        if Gui.key_pressed(1073741905) > 0 or Gui.key_pressed(115) > 0 { py = py + 7 }
        if py < 10 { py = 10 }
        if py > 510 { py = 510 }

        if paused == 0 {
            // Ball physics
            bx += bdx
            by += bdy

            // Top/bottom bounce
            if by < ball_sz { by = ball_sz  bdy = 0 - bdy }
            if by > 590 - ball_sz { by = 590 - ball_sz  bdy = 0 - bdy }

            // Player paddle collision (left)
            if bx < 35 + paddle_w and bx > 25 and by > py - 5 and by < py + paddle_h + 5 {
                bdx = 0 - bdx
                // Add spin based on where ball hits paddle
                var hit_pos = by - py - paddle_h / 2
                bdy += hit_pos / 15
                bx = 35 + paddle_w + 1
            }

            // AI paddle collision (right)
            if bx > 765 - paddle_w and bx < 775 and by > ay - 5 and by < ay + paddle_h + 5 {
                bdx = 0 - bdx
                var hit_pos = by - ay - paddle_h / 2
                bdy += hit_pos / 15
                bx = 765 - paddle_w - 1
            }

            // AI movement -- tracks ball with slight delay
            var ai_target = by - paddle_h / 2
            if ay < ai_target - 3 { ay = ay + 4 }
            if ay > ai_target + 3 { ay = ay - 4 }
            if ay < 10 { ay = 10 }
            if ay > 510 { ay = 510 }

            // Scoring
            if bx < 0 { sr = sr + 1  reset_ball() }
            if bx > 800 { sl = sl + 1  reset_ball() }

            // Speed up slightly over time
            if bdx > 0 and bdx < 10 { bdx = bdx }
            if bdx < 0 and bdx > -10 { bdx = bdx }
        }

        // === Drawing ===
        Gui.clear(15, 16, 22)

        // Center line
        Gui.color(40, 42, 55)
        for i in 0..30 {
            Gui.rect(397, i * 20 + 5, 6, 12)
        }

        // Player paddle (blue)
        Gui.color(80, 160, 255)
        Gui.rect(25, py, paddle_w, paddle_h)
        // Paddle glow
        Gui.color(40, 80, 130)
        Gui.rect(22, py + 2, 3, paddle_h - 4)

        // AI paddle (red)
        Gui.color(255, 80, 100)
        Gui.rect(765, ay, paddle_w, paddle_h)
        Gui.color(130, 40, 50)
        Gui.rect(777, ay + 2, 3, paddle_h - 4)

        // Ball with glow
        Gui.color(80, 80, 60)
        Gui.rect(bx - ball_sz - 2, by - ball_sz - 2, ball_sz * 2 + 4, ball_sz * 2 + 4)
        Gui.color(255, 255, 220)
        Gui.rect(bx - ball_sz, by - ball_sz, ball_sz * 2, ball_sz * 2)

        // Scores
        Gui.color(80, 160, 255)
        Gui.text(320, 30, sl.to_string(), 3)
        Gui.color(100, 100, 120)
        Gui.text(393, 35, "-", 2)
        Gui.color(255, 80, 100)
        Gui.text(440, 30, sr.to_string(), 3)

        // Pause overlay
        if paused == 1 {
            Gui.color(0, 0, 0)
            Gui.rect(250, 250, 300, 80)
            Gui.color(255, 255, 255)
            Gui.text(330, 275, "PAUSED", 3)
            Gui.color(150, 150, 160)
            Gui.text(310, 305, "Press SPACE to resume", 1)
        }

        // Controls hint
        Gui.color(50, 50, 60)
        Gui.text(10, 580, "W/S or Arrows | Space: Pause | Esc: Quit", 1)

        Gui.present()
        Gui.delay(16)
    }

    Gui.destroy()
    print("Final Score: ${sl} - ${sr}")
}
