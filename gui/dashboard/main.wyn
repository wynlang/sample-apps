// GUI Dashboard — System monitor with widgets

var cpu_pct = 0
var mem_pct = 65
var disk_pct = 0
var frame = 0
var sep = "|"

fn update_stats() {
    var cpu_raw = System.exec("ps -A -o %cpu | awk '{s+=$1} END {printf \"%.0f\", s}'").trim()
    var ncpu = System.exec("sysctl -n hw.ncpu 2>/dev/null || echo 4").trim().to_int()
    if ncpu < 1 { ncpu = 1 }
    cpu_pct = cpu_raw.to_int() / ncpu
    if cpu_pct > 100 { cpu_pct = 100 }
    var disk_raw = System.exec("df -Ph / | tail -1 | awk '{print $5}' | tr -d '%'").trim()
    disk_pct = disk_raw.to_int()
}

fn main() {
    var ok = Gui.create("Wyn Dashboard", 800, 500)
    if ok < 0 {
        println("Install SDL2: brew install sdl2")
        return 1
    }
    update_stats()
    
    while Gui.running() > 0 {
        var event = Gui.poll()
        var etype = event.split_at(sep, 0)
        if etype == "key" {
            var key = event.split_at(sep, 1).to_int()
            if key == 27 { break }
            if key == 114 { update_stats() }
        }
        
        Gui.clear(25, 25, 35)
        Gui.color(100, 200, 255)
        Gui.text(20, 15, "WYN SYSTEM DASHBOARD", 3)
        Gui.color(150, 150, 170)
        Gui.text(600, 25, "ESC:QUIT R:REFRESH", 1)
        
        Gui.panel(20, 60, 240, 120)
        Gui.label(35, 70, "CPU", 2)
        Gui.progress(35, 100, 210, 25, cpu_pct)
        
        Gui.panel(280, 60, 240, 120)
        Gui.label(295, 70, "MEMORY", 2)
        Gui.progress(295, 100, 210, 25, mem_pct)
        
        Gui.panel(540, 60, 240, 120)
        Gui.label(555, 70, "DISK", 2)
        Gui.progress(555, 100, 210, 25, disk_pct)
        
        Gui.panel(20, 200, 760, 280)
        Gui.label(35, 210, "STATUS", 2)
        Gui.color(80, 200, 80)
        Gui.circle(55, 260, 8)
        Gui.label(75, 253, "SYSTEM OK", 1)
        Gui.color(80, 200, 80)
        Gui.circle(55, 290, 8)
        Gui.label(75, 283, "NETWORK OK", 1)
        
        Gui.present()
        Gui.delay(33)
        frame = frame + 1
        if frame % 90 == 0 { update_stats() }
    }
    
    Gui.destroy()
}
