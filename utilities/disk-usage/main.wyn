// Disk Usage Analyzer (ncdu clone)
// Analyzes directory sizes recursively

fn analyze_dir(path: string) -> int {
    var total_size = 0;
    var entries = File::list_dir(path);
    
    if (entries.len() == 0) {
        return 0;
    }
    
    var i = 0;
    while (i < entries.len()) {
        var entry = entries.get(i);
        var full_path = File::path_join(path, entry);
        
        if (File::is_dir(full_path)) {
            var dir_size = analyze_dir(full_path);
            total_size = total_size + dir_size;
            print(entry);
            print(" (dir): ");
            print(dir_size);
            print(" bytes");
        } else {
            var file_size = File::file_size(full_path);
            total_size = total_size + file_size;
        }
        
        i = i + 1;
    }
    
    return total_size;
}

fn main() {
    var args = System::args();
    var path = ".";
    
    if (args.len() > 1) {
        path = args.get(1);
    }
    
    print("Analyzing disk usage for: ");
    print(path);
    print("");
    
    var total = analyze_dir(path);
    
    print("");
    print("Total size: ");
    print(total);
    print(" bytes");
}
