// Fibonacci -- Recursive, iterative, and concurrent computation
// Demonstrates: recursion, spawn, await_all, string interpolation

fn fib_recursive(n: int) -> int {
    if n <= 1 { return n }
    return fib_recursive(n - 1) + fib_recursive(n - 2)
}

fn fib_iterative(n: int) -> int {
    if n <= 1 { return n }
    var a = 0
    var b = 1
    for i in 2..(n + 1) {
        var temp = a + b
        a = b
        b = temp
    }
    return b
}

fn main() {
    print("=== Fibonacci Comparison ===")
    print("")

    var test_values = [0, 1, 5, 10, 15, 20]
    var count = test_values.len()

    // Compute all fibonacci values concurrently using await_all
    var futures = []
    for i in 0..count {
        futures.push(spawn fib_recursive(test_values[i]))
    }
    var results = await_all(futures)

    var all_match = true
    for i in 0..count {
        var n = test_values[i]
        var recursive = results[i]
        var iterative = fib_iterative(n)
        print("  fib(${n}) = ${recursive} [recursive] / ${iterative} [iterative]")
        if recursive != iterative {
            print("  ✗ MISMATCH!")
            all_match = false
        }
    }

    print("")
    if all_match {
        print("  ✓ All results match!")
    }
}
