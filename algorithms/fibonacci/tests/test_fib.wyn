fn fib_recursive(n: int) -> int {
    if n <= 1 { return n }
    return fib_recursive(n - 1) + fib_recursive(n - 2)
}

fn fib_iterative(n: int) -> int {
    if n <= 1 { return n }
    var a = 0
    var b = 1
    for i in 2..n + 1 {
        var tmp = a + b
        a = b
        b = tmp
    }
    return b
}

test "fib base cases" {
    assert_eq(fib_recursive(0), 0)
    assert_eq(fib_recursive(1), 1)
    assert_eq(fib_iterative(0), 0)
    assert_eq(fib_iterative(1), 1)
}

test "fib sequence" {
    assert_eq(fib_recursive(10), 55)
    assert_eq(fib_iterative(10), 55)
    assert_eq(fib_recursive(20), 6765)
    assert_eq(fib_iterative(20), 6765)
}

test "recursive matches iterative" {
    for i in 0..15 {
        assert_eq(fib_recursive(i), fib_iterative(i))
    }
}
