// Sorting Algorithms in Wyn
// Demonstrates: arrays, for..in, string interpolation

fn main() -> int {
    println("=== Sorting Algorithms ===")

    var data = [64, 34, 25, 12, 22, 11, 90, 1, 45, 78]
    var n = data.len()

    println("")
    var s = "["
    for i in 0..n {
        if i > 0 { s = s + ", " }
        s += data[i].to_string()
    }
    println("Input: ${s}]")

    // Bubble sort
    for i in 0..n {
        for j in 0..(n - 1) {
            if data[j] > data[j + 1] {
                var temp = data[j]
                data[j] = data[j + 1]
                data[j + 1] = temp
            }
        }
    }

    var s2 = "["
    for i in 0..n {
        if i > 0 { s2 = s2 + ", " }
        s2 += data[i].to_string()
    }
    println("Sorted: ${s2}]")

    var sorted = true
    for i in 0..(n - 1) {
        if data[i] > data[i + 1] { sorted = false }
    }

    if sorted {
        println("  ✓ Correctly sorted!")
    } else {
        println("  ✗ Sort failed!")
    }
    return 0
}
