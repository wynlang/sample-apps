// Counter App - Wyn Mobile UI Demo
// A simple counter with increment/decrement buttons

// Mobile SDK stubs
fn wyn_ui_text(ctx: int, text: string, size: int) {}
fn wyn_ui_spacer(ctx: int, size: int) {}
fn wyn_ui_button(ctx: int, label: string, id: int) {}
fn wyn_ios_main(a: int, b: int) {}

var count = 0

fn wyn_app_title() -> string {
    return "Wyn Counter"
}

fn wyn_app_build(ctx: int) {
    wyn_ui_text(ctx, "Counter App", 32)
    wyn_ui_spacer(ctx, 24)
    wyn_ui_text(ctx, "Count: ${count}", 48)
    wyn_ui_spacer(ctx, 24)
    wyn_ui_button(ctx, "  +  ", 1)
    wyn_ui_button(ctx, "  -  ", 2)
    wyn_ui_button(ctx, "Reset", 3)
}

fn wyn_on_button(id: int) {
    if id == 1 {
        count = count + 1
    } else if id == 2 {
        count = count - 1
    } else if id == 3 {
        count = 0
    }
    println("count=${count}")
}

fn main() {
    return wyn_ios_main(0, 0)
}
