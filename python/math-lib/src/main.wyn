// Math library for Python -- built with Wyn
// Build: wyn build --python        (writes libmath_lib.dylib + math_lib.py)
// Use:   python3 test.py

fn add(a: int, b: int) -> int {
    return a + b
}

fn subtract(a: int, b: int) -> int {
    return a - b
}

fn multiply(a: int, b: int) -> int {
    return a * b
}

fn divide(a: int, b: int) -> int {
    if b == 0 { return 0 }
    return a / b
}

fn modulo(a: int, b: int) -> int {
    if b == 0 { return 0 }
    return a % b
}

fn power(base: int, exponent: int) -> int {
    var result = 1
    for i in 0..exponent {
        result *= base
    }
    return result
}

fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn fibonacci(n: int) -> int {
    if n <= 1 { return n }
    var a = 0
    var b = 1
    for i in 2..n + 1 {
        var tmp = a + b
        a = b
        b = tmp
    }
    return b
}

fn calc_gcd(a: int, b: int) -> int {
    var x = a
    var y = b
    if x < 0 { x = 0 - x }
    if y < 0 { y = 0 - y }
    while y != 0 {
        var t = y
        y = x % y
        x = t
    }
    return x
}

fn is_prime(n: int) -> bool {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 { return false }
    var i = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i += 2
    }
    return true
}

fn calc_clamp(val: int, lo: int, hi: int) -> int {
    if val < lo { return lo }
    if val > hi { return hi }
    return val
}

fn calc_abs(n: int) -> int {
    if n < 0 { return 0 - n }
    return n
}

fn greet(name: string) -> string {
    return "Hello from Wyn, ${name}!"
}

fn repeat_str(s: string, n: int) -> string {
    var result = ""
    for i in 0..n {
        result = result + s
    }
    return result
}

// A function worth crossing the FFI boundary for. Everything above is a one-liner whose
// ctypes call overhead dwarfs its work; this one does real iteration, so it shows the
// actual reason to write a hot function in Wyn and call it from Python. See bench.py.
//
// Collatz: repeatedly halve an even number or 3n+1 an odd one, counting steps to reach 1.
// Not reducible to a closed form (an earlier benchmark attempt was constant-folded by the
// C compiler and reported an absurd speedup), and it stays in int64 for the ranges here,
// so the comparison against Python's bignums is honest.
fn collatz_steps(n: int) -> int {
    var count = 0
    var x = n
    while x != 1 {
        if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
        count = count + 1
    }
    return count
}

// The longest Collatz chain for any start below `limit`. One call, a lot of work - the
// shape where native code pays for itself.
fn max_collatz_below(limit: int) -> int {
    var best = 0
    var i = 1
    while i < limit {
        var s = collatz_steps(i)
        if s > best { best = s }
        i = i + 1
    }
    return best
}

fn main() {
    print("=== Python-style Math Library ===")
    print("")
    print("  abs(-5) = ${calc_abs(-5)}")
    print("  clamp(15, 0, 10) = ${calc_clamp(15, 0, 10)}")
    print("  factorial(6) = ${factorial(6)}")
    print("  gcd(48, 18) = ${calc_gcd(48, 18)}")
    print("  fibonacci(10) = ${fibonacci(10)}")
    print("  power(2, 10) = ${power(2, 10)}")
    print("  repeat_str(ab, 3) = ${repeat_str("ab", 3)}")
    print("  greet(Wyn) = ${greet("Wyn")}")
    print("  max_collatz_below(10000) = ${max_collatz_below(10000)}")
    print("")
    print("All functions working -- run `python3 bench.py` for the reason to use them.")
}
