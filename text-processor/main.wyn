// Text Processor - Demonstrates Wyn's Module System
// Shows how to import and use custom modules

import string_utils
import file_utils

fn main() -> int {
    print("=== TEXT PROCESSOR ===");
    print("Demonstrates: Module System");
    print("");
    
    // Get command line arguments
    var args = System::args();
    
    if args.len() < 2 {
        print("Usage: text-processor <file>");
        print("Example: text-processor sample.txt");
        return 1;
    }
    
    var filename = args[1];
    
    // Use file_utils module
    print("Reading file: ${filename}");
    var content = file_utils::read_file_safe(filename);
    
    if content.is_empty() {
        return 1;
    }
    
    print("");
    print("=== FILE ANALYSIS ===");
    
    // Use string_utils module
    var word_count = string_utils::count_words(content);
    var line_count = string_utils::count_lines(content);
    var char_count = content.len();
    
    print("Characters: ${char_count}");
    print("Words: ${word_count}");
    print("Lines: ${line_count}");
    
    // More string_utils functions
    print("");
    print("=== TEXT TRANSFORMATIONS ===");
    
    var first_line = content.split("\n")[0];
    print("First line: ${first_line}");
    
    var title_case = string_utils::to_title_case(first_line);
    print("Title case: ${title_case}");
    
    var reversed = string_utils::reverse_text(first_line);
    print("Reversed: ${reversed}");
    
    // Generate report using both modules
    print("");
    print("=== GENERATING REPORT ===");
    
    var report = "TEXT ANALYSIS REPORT\n";
    report = report.concat("====================\n\n");
    report = report.concat("File: ").concat(filename).concat("\n");
    report = report.concat("Characters: ").concat(char_count.to_string()).concat("\n");
    report = report.concat("Words: ").concat(word_count.to_string()).concat("\n");
    report = report.concat("Lines: ").concat(line_count.to_string()).concat("\n");
    report = report.concat("\nFirst line: ").concat(first_line).concat("\n");
    report = report.concat("Title case: ").concat(title_case).concat("\n");
    
    var report_file = "/tmp/text_analysis.txt";
    file_utils::write_file_safe(report_file, report);
    
    print("");
    print("=== COMPLETE ===");
    print("Report saved to: ${report_file}");
    
    return 0;
}
