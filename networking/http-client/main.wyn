// HTTP Client - Demonstrates networking and string processing

fn count_lines(text: str) -> int {
    return text.lines().len();
}

fn check_success(text: str) -> int {
    if text.contains("200") {
        return 1;
    }
    return 0;
}

async fn fetch_url(host: str, port: int) -> int {
    print("Connecting to", host);
    
    var socket = Net::connect(host, port);
    if socket < 0 {
        return -1;
    }
    
    var request = "GET / HTTP/1.1\r\nHost: ";
    request = request.concat(host);
    request = request.concat("\r\n\r\n");
    
    var sent = Net::send(socket, request);
    if sent < 0 {
        Net::close(socket);
        return -2;
    }
    
    var response = Net::recv(socket);
    Net::close(socket);
    
    return response.len();
}

fn main() -> int {
    print("=== HTTP Client Demo ===");
    print("");
    
    // String processing
    var sample = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html></html>";
    print("Sample response:");
    print("  Length:", sample.len());
    print("  Lines:", count_lines(sample));
    print("  Has 200:", check_success(sample));
    print("");
    
    // Async networking
    print("Attempting connection...");
    var bytes = await fetch_url("example.com", 80);
    
    if bytes > 0 {
        print("Response:", bytes, "bytes");
    } else {
        print("Connection failed (code:", bytes, ")");
    }
    print("");
    
    print("✅ HTTP client demo complete");
    return 0;
}
