// Tests for web/server. A server that compiles proves nothing, so these do a real HTTP
// round trip over loopback and assert on the bytes that come back.
//
// web/ had NO tests at all - four apps, all of which returned byte-identical HTML from
// `/`, and nothing checked any of it. The one that had nothing of its own (web/website,
// whose only unique call was Json.stringify) was folded into this app as /api/info.min.
//
// SINGLE-THREADED BY CONSTRUCTION, the same shape the compiler's own
// tests/stdlib/test_web_e2e.wyn uses: the client write buffers in the socket until the
// server accepts, so no spawn or scheduler participates and there is nothing to race.
// The server side is closed explicitly before draining - Http.respond deliberately does
// not close the connection (a handler loop owns the fd), and there is no handler loop
// here, so without that close the drain blocks forever waiting for a peer that will
// never hang up. That is a guaranteed hang, not a flake.
//
// Ports are in the 189xx range and distinct per test so a re-run cannot collide with a
// socket still in TIME_WAIT.
//
//   wyn test tests/test_server.wyn

// One request in, one response out. Returns the raw response text ("" on failure).
fn round_trip(port: int, method: string, path: string, ctype: string, resp_body: string) -> string {
    var srv = Http.serve(port)
    if srv <= 0 { return "" }

    var client = Net.connect("127.0.0.1", port)
    if client <= 0 {
        Http.close_server(srv)
        return ""
    }
    Net.send(client, method + " " + path + " HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n")

    var accepted = Http.accept(srv)
    var client_fd = Http.fd(accepted)
    Http.respond(client_fd, 200, ctype, resp_body)
    Net.close(client_fd)

    // Net.recv is a single read(); the head and body need not arrive together.
    var got = ""
    var i = 0
    while i < 16 {
        var chunk = Net.recv(client)
        if chunk.len() == 0 { break }
        got = got + chunk
        i = i + 1
    }
    Net.close(client)
    Http.close_server(srv)
    return got
}

// ---- the transport actually works ------------------------------------------

test "a GET round trip returns a 200 with the body" {
    var r = round_trip(18901, "GET", "/", "text/html", "<h1>hello</h1>")
    assert(r.len() > 0)
    assert(r.contains("200"))
    assert(r.contains("<h1>hello</h1>"))
}

test "the content type the handler chose is the one sent" {
    var r = round_trip(18902, "GET", "/api/info", "application/json", "{\"ok\":true}")
    assert(r.contains("application/json"))
    assert(r.contains("{\"ok\":true}"))
}

test "a POST round trip works too" {
    var r = round_trip(18903, "POST", "/api/users", "application/json", "{\"id\":4}")
    assert(r.contains("200"))
    assert(r.contains("{\"id\":4}"))
}

// ---- both JSON serializers, which is why website was folded in here --------

test "Json.stringify is compact and Json.to_pretty_string is not" {
    var j = Json.new()
    Json.set(j, "server", "wyn")
    Json.set_int(j, "users", 3)

    var compact = Json.stringify(j)
    var pretty = Json.to_pretty_string(j)

    // Both carry the same data...
    assert(compact.contains("wyn"))
    assert(pretty.contains("wyn"))
    assert(compact.contains("3"))
    assert(pretty.contains("3"))

    // ...and the compact form is the one you put on the wire: no newlines, and
    // strictly shorter. This is the whole distinction web/website existed to show.
    assert(not compact.contains("\n"))
    assert(pretty.contains("\n"))
    assert(compact.len() < pretty.len())
}

test "a JSON document survives a round trip through the socket" {
    var j = Json.new()
    Json.set(j, "platform", "test")
    Json.set_int(j, "uptime", 42)
    var r = round_trip(18904, "GET", "/api/info.min", "application/json", Json.stringify(j))
    assert(r.contains("platform"))
    assert(r.contains("42"))
}

// ---- the version string that went stale for thirteen releases --------------

test "the advertised version matches the compiler's VERSION file" {
    // The footer and /api/info both said 1.8.0 while the compiler was at 1.20.0. There is
    // no runtime accessor for the compiler version, so the app hardcodes it - which means
    // the only thing that can keep it honest is a test that reads VERSION.
    assert_eq(File.exists("../../../wyn/VERSION"), 1)
    var want = File.read("../../../wyn/VERSION").trim()
    var src = File.read("src/main.wyn")
    assert(src.contains("Powered by Wyn v" + want))
    assert(src.contains("\"version\", \"" + want + "\""))
    // And the stale value is gone from the two places that SERVE it. Checked as the
    // exact served strings rather than a bare `contains("1.8.0")`: the source comment
    // explaining this bug mentions the old version, and a test that cannot survive its
    // own explanation is a test that will be deleted rather than fixed.
    assert(not src.contains("Powered by Wyn v1.8.0"))
    assert(not src.contains("\"version\", \"1.8.0\""))
}

// ---- the response builders, which used to be hand-built strings -------------
//
// api_add_user assembled its response by interpolation:
//
//     return "{\"id\":${id},\"name\":\"${name}\",\"email\":\"${email}\"}"
//
// The SQL side was escaped (Db.escape), but the JSON side was not -- and Db.escape does
// not help, because this is JSON quoting, not SQL quoting. A client posting the name
//   Eve","role":"admin
// closed the string early and injected a field: verified before the fix, the forged
// "role" read back as "admin" from the parsed response. Both builders use Json.set now.
//
// Duplicated from src/main.wyn rather than imported: `import` from a sibling directory
// needs the module on the search path, and a sample app should not need a package layout
// to be testable. Must stay in step with src.

fn t_json_error(msg: string) -> string {
    var e = Json.new()
    Json.set(e, "error", msg)
    return Json.stringify(e)
}

fn t_add_user_response(id: int, name: string, email: string) -> string {
    var out = Json.new()
    Json.set_int(out, "id", id)
    Json.set(out, "name", name)
    Json.set(out, "email", email)
    return Json.stringify(out)
}

test "the add-user response is valid JSON with every field" {
    var doc = Json.parse(t_add_user_response(4, "Dana", "dana@example.com"))
    assert_eq(Json.get_int(doc, "id"), 4)
    assert_eq(Json.get(doc, "name"), "Dana")
    assert_eq(Json.get(doc, "email"), "dana@example.com")
}

test "a name containing a quote cannot inject a field" {
    // The exact attack. The forged key must be absent AND the real name must survive whole
    // -- dropping the value would also pass an absence check, and that is not a fix.
    var doc = Json.parse(t_add_user_response(7, "Eve\",\"role\":\"admin", "e@f.g"))
    assert_eq(Json.has(doc, "role"), 0)
    assert_eq(Json.get(doc, "name"), "Eve\",\"role\":\"admin")
    assert_eq(Json.get_int(doc, "id"), 7)
    assert_eq(Json.get(doc, "email"), "e@f.g")
}

test "a name containing a backslash or newline survives" {
    // Both used to produce a response the app's own parser could not read back.
    var doc = Json.parse(t_add_user_response(8, "A\\B", "x\ny"))
    assert_eq(Json.get(doc, "name"), "A\\B")
    assert_eq(Json.get(doc, "email"), "x\ny")
}

test "the error response is valid JSON" {
    var doc = Json.parse(t_json_error("name required"))
    assert_eq(Json.get(doc, "error"), "name required")
    assert_eq(Json.has(doc, "error"), 1)
}

test "src no longer hand-builds a JSON response by interpolation" {
    // The units above are COPIES of src, so they cannot catch src drifting back to hand-built
    // strings. This reads src itself.
    //
    // The removed line cannot be spelled literally here: a ${...} inside a Wyn string
    // interpolates even with the braces backslash-escaped, so writing it out would try to
    // resolve a variable named `id` at compile time (it fails with "Undefined variable 'id'").
    // The dollar sign is therefore built from its code point.
    var src = File.read("src/main.wyn")
    var dollar = String.from_chars([36])

    // The response must be built with Json.set*, not interpolated.
    assert(src.contains("Json.set_int(out, \"id\", id)"))
    assert(src.contains("Json.set(out, \"name\", name)"))
    assert(src.contains("json_error("))

    // And no JSON-looking string in src may interpolate a value into it. Any line that both
    // opens a JSON object in a literal and contains a ${ is the bug coming back.
    var lines = src.split("\n")
    var bad = 0
    for line in lines {
        // Skip the comment that explains the bug -- a test that cannot survive its own
        // explanation is a test that gets deleted rather than fixed.
        if not line.trim().starts_with("//") {
            if line.contains("{\\\"") and line.contains(dollar + "{") {
                bad = bad + 1
            }
        }
    }
    assert_eq(bad, 0)
}

test "a builder response survives a real round trip" {
    // End to end: the bytes a client actually receives parse back to the same values.
    var body = t_add_user_response(9, "Quote\"Name", "q@e.com")
    var r = round_trip(18905, "POST", "/api/users", "application/json", body)
    assert(r.contains("application/json"))
    // The response body is at the end, after the headers.
    var doc = Json.parse(r.substring(r.index_of("{"), r.len()))
    assert_eq(Json.get(doc, "name"), "Quote\"Name")
    assert_eq(Json.get_int(doc, "id"), 9)
}
