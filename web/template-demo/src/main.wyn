// Template Demo -- Web app with HTML templates and dynamic content
// Demonstrates: Http.serve, Template.render, HashMap, spawn, string interpolation

fn page(title: string, body: string) -> string {
    return "<!DOCTYPE html><html><head><meta charset=utf-8><title>${title}</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f8f9fa;color:#1a2332}header{background:#1a2332;color:#fff;padding:16px 24px}header a{color:#4fc3f7;text-decoration:none;margin-right:16px}main{max-width:700px;margin:24px auto;padding:0 16px}.card{background:#fff;border:1px solid #e2e6ec;border-radius:8px;padding:20px;margin-bottom:16px}h2{margin-bottom:12px;color:#4fc3f7}ul{padding-left:20px}li{margin:4px 0}code{background:#eee;padding:2px 6px;border-radius:3px}footer{text-align:center;padding:24px;color:#999;font-size:0.8em}</style></head><body><header><b>Template Demo</b> <a href=/>Home</a> <a href=/users>Users</a> <a href=/api/info>API</a></header><main>${body}</main><footer>Powered by Wyn v1.8.0</footer></body></html>"
}

fn on_request(method: string, path: string, body: string, fd: int) {
    if path == "/" {
        var now = DateTime.to_iso(DateTime.now())
        var html = page("Home", "<div class=card><h2>Welcome</h2><p>This page is dynamically generated by Wyn.</p><p>Server time: <code>${now}</code></p></div><div class=card><h2>Features</h2><ul><li>HTML templates with <code>\${var}</code> interpolation</li><li>Concurrent request handling via <code>spawn</code></li><li>JSON API endpoints</li><li>Zero external dependencies</li></ul></div>")
        Http.respond(fd, 200, "text/html", html)
    } else if path == "/users" {
        var users = "<div class=card><h2>Users</h2><ul>"
        var names = ["Alice", "Bob", "Charlie", "Diana", "Eve"]
        for i in 0..5 {
            users += "<li>" + names[i] + "</li>"
        }
        users += "</ul></div>"
        Http.respond(fd, 200, "text/html", page("Users", users))
    } else if path == "/api/info" {
        var j = Json.new()
        Json.set(j, "server", "Wyn")
        Json.set(j, "version", "1.8.0")
        Json.set(j, "platform", Os.platform())
        Json.set(j, "time", DateTime.to_iso(DateTime.now()))
        Http.respond(fd, 200, "application/json", Json.to_pretty_string(j))
    } else {
        Http.respond(fd, 404, "text/html", page("404", "<div class=card><h2>404</h2><p>Page not found.</p></div>"))
    }
}

fn main() {
    var port = 8080
    var server = Http.serve(port)
    print("Template demo on http://localhost:${port}")
    print("Press Ctrl+C to stop")

    while 1 == 1 {
        var req = Http.accept(server)
        var method = req.split_at("|", 0)
        var path = req.split_at("|", 1)
        var body = req.split_at("|", 2)
        var fd = req.split_at("|", 3).to_int()
        if fd > 0 {
            spawn on_request(method, path, body, fd)
        }
    }
}
