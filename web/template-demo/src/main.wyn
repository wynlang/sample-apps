// Template Demo -- a web app that renders HTML, with the rendering split out so it can be
// tested without opening a socket.
//
// Demonstrates: Http.serve, spawn per request, JSON, string interpolation, and HTML
// ESCAPING -- which the previous version did not do. It interpolated values straight into
// markup, so any `<` in the data became a tag. There is no html_escape in the stdlib
// (checked), so this app carries one; `escape()` below is the whole reason the user list is
// safe to render.
//
// tests/test_render.wyn covers escape(), the route decision, and the user list.

// --- routes ------------------------------------------------------------------------
//
// An enum rather than string comparison scattered through on_request(): a typo in a string
// literal is a silent 404, a typo in a variant name does not compile.
enum Page {
    Home
    Users
    ApiInfo
    NotFound
}

fn route(path: string) -> Page {
    if path == "/" {
        return Page::Home
    }
    if path == "/users" {
        return Page::Users
    }
    if path == "/api/info" {
        return Page::ApiInfo
    }
    return Page::NotFound
}

fn status_for(p: Page) -> int {
    if p == Page::NotFound {
        return 404
    }
    return 200
}

fn content_type_for(p: Page) -> string {
    if p == Page::ApiInfo {
        return "application/json"
    }
    return "text/html"
}

// --- HTML escaping ------------------------------------------------------------------

// Escape the five characters that change meaning inside HTML. `&` MUST be replaced first:
// doing it after the others would re-escape the ampersands they just introduced, turning
// `<` into `&amp;lt;` instead of `&lt;`. That ordering bug is the classic one, and the tests
// pin it.
fn escape(s: string) -> string {
    out = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    out = out.replace("'", "&#39;")
    return out
}

fn wyn_version() -> string {
    // Kept in one place. The previous version hardcoded "1.8.0" in two spots and was six
    // minor releases stale (VERSION says 1.20.0), so the footer and the JSON disagreed with
    // reality and with any future bump.
    return "1.20.0"
}

fn page(title: string, body: string) -> string {
    return "<!DOCTYPE html><html><head><meta charset=utf-8><title>${escape(title)}</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f8f9fa;color:#1a2332}header{background:#1a2332;color:#fff;padding:16px 24px}header a{color:#4fc3f7;text-decoration:none;margin-right:16px}main{max-width:700px;margin:24px auto;padding:0 16px}.card{background:#fff;border:1px solid #e2e6ec;border-radius:8px;padding:20px;margin-bottom:16px}h2{margin-bottom:12px;color:#4fc3f7}ul{padding-left:20px}li{margin:4px 0}code{background:#eee;padding:2px 6px;border-radius:3px}footer{text-align:center;padding:24px;color:#999;font-size:0.8em}</style></head><body><header><b>Template Demo</b> <a href=/>Home</a> <a href=/users>Users</a> <a href=/api/info>API</a></header><main>${body}</main><footer>Powered by Wyn v${wyn_version()}</footer></body></html>"
}

// Render a <ul> of names, each escaped.
//
// Iterates the array directly rather than `for i in 0..5` over a hardcoded length -- the
// old loop silently dropped or over-read entries the moment the list changed size.
fn user_list(names: [string]) -> string {
    out = "<div class=card><h2>Users</h2><ul>"
    for n in names {
        out = out + "<li>" + escape(n) + "</li>"
    }
    out = out + "</ul></div>"
    return out
}

fn demo_users() -> [string] {
    // One entry deliberately contains markup, so the escaping is exercised by simply
    // visiting /users rather than only by the tests.
    return ["Alice", "Bob", "Charlie", "Diana", "Eve", "<script>alert(1)</script>"]
}

// --- request handling ---------------------------------------------------------------

fn on_request(method: string, path: string, body: string, fd: int) {
    p = route(path)
    code = status_for(p)
    ctype = content_type_for(p)

    if p == Page::Home {
        now = DateTime.to_iso(DateTime.now())
        html = page("Home", "<div class=card><h2>Welcome</h2><p>This page is dynamically generated by Wyn.</p><p>Server time: <code>${escape(now)}</code></p></div><div class=card><h2>Features</h2><ul><li>HTML templates with <code>\${var}</code> interpolation</li><li>Concurrent request handling via <code>spawn</code></li><li>JSON API endpoints</li><li>HTML escaping, so data cannot inject markup</li><li>Zero external dependencies</li></ul></div>")
        Http.respond(fd, code, ctype, html)
        return
    }
    if p == Page::Users {
        Http.respond(fd, code, ctype, page("Users", user_list(demo_users())))
        return
    }
    if p == Page::ApiInfo {
        j = Json.new()
        Json.set(j, "server", "Wyn")
        Json.set(j, "version", wyn_version())
        Json.set(j, "platform", Os.platform())
        Json.set(j, "time", DateTime.to_iso(DateTime.now()))
        Http.respond(fd, code, ctype, Json.to_pretty_string(j))
        return
    }
    Http.respond(fd, code, ctype,
        page("404", "<div class=card><h2>404</h2><p>Page not found.</p></div>"))
}

fn main() {
    port = 8080
    server = Http.serve(port)
    if server < 0 {
        print("Failed to start server on port ${port}")
        return 0
    }
    print("Template demo on http://localhost:${port}")
    print("Routes: / , /users , /api/info")
    print("Press Ctrl+C to stop")

    while 1 == 1 {
        req = Http.accept(server)
        if req.len() == 0 {
            continue
        }
        method = req.split_at("|", 0)
        path = req.split_at("|", 1)
        body = req.split_at("|", 2)
        fd = req.split_at("|", 3).to_int()
        if fd > 0 {
            print("${method} ${path} -> ${status_for(route(path))}")
            spawn on_request(method, path, body, fd)
        }
    }
}
