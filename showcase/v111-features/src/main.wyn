// v1.11 Feature Showcase - "The Developer Experience Release"

enum Status { Active, Inactive, Pending }

struct Task {
    name: string,
    status: Status
}

impl Task {
    fn new(name: string, status: Status) -> Task {
        return Task { name: name, status: status }
    }
    fn to_string(self) -> string {
        return self.name
    }
}

fn main() -> int {
    print("=" * 40)
    print("  Wyn v1.11 Feature Showcase")
    print("=" * 40)

    // 1. enum.to_string() returns variant name
    print("\n--- enum.to_string() ---")
    print("Status.Active = " + Status.Active.to_string())
    print("Status.Pending = " + Status.Pending.to_string())

    // 2. for i, v in arr - indexed iteration
    print("\n--- Indexed Iteration ---")
    var langs = ["Wyn", "Go", "Rust", "Python"]
    for i, lang in langs {
        print(i.to_string() + ". " + lang)
    }

    // 3. "str" * n - string repeat
    print("\n--- String Repeat ---")
    print("ha" * 5)
    print("-" * 30)

    // 4. int? optional syntax
    print("\n--- Optional Types ---")
    var found: int? = OptionInt_Some(42)
    var missing: int? = OptionInt_None()
    print("found: " + OptionInt_unwrap(found).to_string())
    print("missing has value: " + OptionInt_is_some(missing).to_string())
    print("missing or default: " + OptionInt_unwrap_or(missing, -1).to_string())

    // 5. Static constructors work
    print("\n--- Static Constructors ---")
    var t = Task.new("Ship v1.11", Status.Active)
    print(t.to_string())

    print("\n" + "=" * 40)
    print("  All features working!")
    print("=" * 40)
    return 0
}
