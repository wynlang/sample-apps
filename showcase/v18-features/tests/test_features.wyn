fn double(n: int) -> int { return n * 2 }
fn add10(n: int) -> int { return n + 10 }

fn apply_twice(x: int, f: fn(int) -> int) -> int {
    return f(f(x))
}

fn fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

test "function composition" {
    var result = add10(double(5))
    assert_eq(result, 20)
}

test "higher-order functions" {
    assert_eq(apply_twice(5, double), 20)
    assert_eq(apply_twice(3, add10), 23)
}

test "fibonacci" {
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
    assert_eq(fib(10), 55)
}

test "string interpolation" {
    var name = "Wyn"
    assert_eq("${name}", "Wyn")
    assert_eq("${name.upper()}", "WYN")
    assert_eq("${name.len()}", "3")
}

fn greet_default(name: string = "World") -> string {
    return "Hello, ${name}!"
}

test "default parameters" {
    assert_eq(greet_default(), "Hello, World!")
    assert_eq(greet_default("Wyn"), "Hello, Wyn!")
}
