// Wyn Feature Showcase - every major language feature in one file
// Updated: demonstrates await_all, await_any, Shared atomics

// --- Structs ---
struct Vec2 { x: float, y: float }

fn vec2_add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
}

fn vec2_mag(v: Vec2) -> float {
    return Math.sqrt(v.x * v.x + v.y * v.y)
}

// --- Enums ---
enum Color { Red, Green, Blue }

fn color_name(c: Color) -> string {
    match c {
        Red => return "red"
        Green => return "green"
        Blue => return "blue"
    }
    return "unknown"
}

// --- Default params + Result + ? operator ---
fn safe_divide(a: int, b: int = 1) -> ResultInt {
    if b == 0 { return ResultInt_Err("division by zero") }
    return ResultInt_Ok(a / b)
}

fn compute_ratio(x: int, y: int) -> ResultInt {
    var result = safe_divide(x, y)?
    return ResultInt_Ok(result * 100)
}

// --- Pipe operator ---
fn dbl(n: int) -> int { return n * 2 }
fn add10(n: int) -> int { return n + 10 }

// --- Higher-order functions ---
fn apply_twice(x: int, f: fn(int) -> int) -> int {
    return f(f(x))
}

// --- Spawn ---
fn fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn increment(handle: int) -> int {
    Shared.add(handle, 1)
}

fn main() {
    println("=== Wyn Feature Showcase ===")
    println("")

    // Higher-order functions + closures
    var offset = 100
    println("Closures:  apply_twice(5, dbl) = ${apply_twice(5, dbl)}")
    println("           offset capture = ${offset + 42}")

    // Structs
    var a = Vec2 { x: 3.0, y: 4.0 }
    var b = Vec2 { x: 1.0, y: 2.0 }
    var c = vec2_add(a, b)
    println("Structs:   (${a.x}, ${a.y}) + (${b.x}, ${b.y}) = (${c.x}, ${c.y})")
    println("           magnitude = ${vec2_mag(a)}")
    println("Enums:     ${color_name(Color.Red)}, ${color_name(Color.Green)}, ${color_name(Color.Blue)}")

    // Default params + Result + ?
    var r1 = compute_ratio(100, 3)
    var r2 = compute_ratio(100, 0)
    println("Result:    100/3 ok=${ResultInt_is_ok(r1)}, 100/0 err=${ResultInt_is_err(r2)}")

    // Function composition (nested calls)
    var piped = add10(dbl(5))
    println("Compose:   add10(dbl(5)) = ${piped}")

    // HashMap
    var scores = HashMap.new()
    scores.set("alice", "95")
    scores.set("bob", "87")
    println("HashMap:   alice=${scores.get("alice")}, bob=${scores.get("bob")}")

    // String interpolation
    var name = "Wyn"
    println("Interp:    ${name} -- ${name.len()} chars, upper=${name.upper()}")

    // Spawn + await_all (parallel fibonacci)
    var fib_futures = []
    for i in 0..5 {
        fib_futures.push(spawn fib(25 + i))
    }
    var fib_results = await_all(fib_futures)
    println("await_all: fib(25..29) = [${fib_results[0]}, ${fib_results[1]}, ${fib_results[2]}, ${fib_results[3]}, ${fib_results[4]}]")

    // await_any (first to complete)
    var race_f1 = spawn fib(20)
    var race_f2 = spawn fib(21)
    var race_f3 = spawn fib(22)
    var first = await_any([race_f1, race_f2, race_f3])
    println("await_any: first result = ${first}")

    // Shared atomic values (concurrent counter)
    var counter = Shared.new(0)
    var inc_futures = []
    for i in 0..100 {
        inc_futures.push(spawn increment(counter))
    }
    await_all(inc_futures)
    println("Shared:    100 concurrent increments = ${Shared.get(counter)}")

    println("")
    println("All features working! ")
}
