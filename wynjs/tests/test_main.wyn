// WynJS Test Runner
fn main() {
    print("=== WynJS Test Suite ===")

    // Copy test file for wynjs to read
    System_exec("cp tests/test.js /tmp/_wynjs_input.js")

    // Run wynjs
    var output = System_exec("perl -e \"alarm 30; exec @ARGV\" ../../wyn/wyn run src/main.wyn 2>/dev/null")

    if output.contains("0 fail") {
        print("✓ " + output.trim())
        return 0
    }
    print("✗ Test failed:")
    print(output)
    return 1
}
