export enum JsVal {
    Num(float)
    Str(string)
    Bool(int)
    Null
    Undef
    Fn(int)
    Arr(int)
    Obj(int)
}

export fn js_truthy(v: JsVal) -> int {
    return match v {
        JsVal.Num(n) => { if n == 0.0 { 0 } else { 1 } }
        JsVal.Str(s) => { if s.len() > 0 { 1 } else { 0 } }
        JsVal.Bool(b) => b
        JsVal.Null => 0
        JsVal.Undef => 0
        _ => 1
    }
}

export fn js_to_str(v: JsVal) -> string {
    return match v {
        JsVal.Num(n) => {
            var s = n.to_string()
            if s.ends_with(".0") { s.substring(0, s.len() - 2) } else { s }
        }
        JsVal.Str(s) => s
        JsVal.Bool(b) => { if b == 1 { "true" } else { "false" } }
        JsVal.Null => "null"
        JsVal.Undef => "undefined"
        _ => ""
    }
}

export fn js_typeof(v: JsVal) -> string {
    return match v {
        JsVal.Num(n) => "number"
        JsVal.Str(s) => "string"
        JsVal.Bool(b) => "boolean"
        JsVal.Null => "object"
        JsVal.Undef => "undefined"
        JsVal.Fn(id) => "function"
        _ => "object"
    }
}
