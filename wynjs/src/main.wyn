// WynJS - A JavaScript runtime written in Wyn
// Lexer + recursive descent parser + tree-walk interpreter
// Supports: ES6 classes, arrow functions, closures, destructuring,
// async/await, promises, modules, Map/Set, RegExp, and more.

// === Token type constants ===
const T_NUM = 1
const T_STR = 2
const T_ID = 3
const T_KW = 4
const T_PLUS = 10
const T_MINUS = 11
const T_STAR = 12
const T_SLASH = 13
const T_PCT = 14
const T_EQ = 15
const T_BANG = 16
const T_LT = 17
const T_GT = 18
const T_AMP = 19
const T_OR = 20
const T_EQEQ = 21
const T_NEQ = 22
const T_LTE = 23
const T_GTE = 24
const T_AND = 25
const T_OROR = 26
const T_AMPAMP = 27
const T_PIPE = 28
const T_QQ = 29
const T_LPAREN = 30
const T_RPAREN = 31
const T_LBRACE = 32
const T_RBRACE = 33
const T_LBRACK = 34
const T_RBRACK = 35
const T_COMMA = 36
const T_SEMI = 37
const T_DOT = 38
const T_COLON = 39
const T_ARROW = 40
const T_INC = 41
const T_PLUSEQ = 42
const T_DEC = 43
const T_MINUSEQ = 44
const T_POW = 45
const T_MULEQ = 46
const T_DIVEQ = 47
const T_MODEQ = 48
const T_EQEQEQ = 49
const T_NEQEQ = 50
const T_FUNCTION = 53
const T_TYPEOF = 90
const T_QDOT = 96
const T_TERNARY = 97
const T_SPREAD = 98
const T_IN = 93
const T_OF = 94
const T_QQEQ = 100
const T_OREQ = 101
const T_ANDEQ = 102

// === Globals ===
src = ""
pos = 0
tt = 0
tv = ""
tstart = 0
// === Lazy-evaluation depth ===
// JS `? :`, `&&`, `||`, `??` must NOT evaluate the untaken branch. This is a
// single-pass parse-and-evaluate interpreter, so the untaken branch still has to
// be PARSED (to advance `pos`) - it just must not take effect. While noeval > 0
// the parse runs but every state mutation and every output is suppressed.
noeval = 0

// Fixed-capacity pools. Overflowing one used to raise a raw Wyn
// "array index out of bounds" panic; now it sets overflow and reports a
// JS-style RangeError, so a runaway script fails legibly.
MAX_ENV = 65536
MAX_DEPTH = 4096
MAX_ASTORE = 65536
MAX_ARRAYS = 8192
overflow = 0
// Measured: the host C stack (callfn -> p_block_body -> p_expr -> callfn) dies
// somewhere around 1350-1400 JS frames on macOS-arm64, and the exact point moves
// with per-frame expression nesting. Cap well below that so deep recursion always
// yields a clean RangeError instead of a segfault.
MAX_CALL_DEPTH = 900
call_depth = 0

DIGITS = "0123456789"
ALPHA = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$"

// === Value encoding: "TAG:data" ===
// n=number s=string b=bool N=null u=undefined f=func a=array o=object
// COMPILER WORKAROUND (see README "Compiler bug"): storing a `string`
// PARAMETER straight into a global array element or global scalar stores a
// pointer the caller then releases, so the slot reads back empty. Forcing a
// fresh allocation via `v + ""` sidesteps it. Every store of a parameter goes
// through sdup().
fn sdup(v: string) -> string { return v + "" }

fn vtag(v: string) -> string { return v.substring(0, 1) }
fn vdata(v: string) -> string { if v.len() < 3 { return "" } return v.substring(2, v.len()) }
fn vnum(n: int) -> string { return "n:" + n.to_string() }
fn vfloat(f: float) -> string { return "n:" + f.to_string() }
fn vstr(s: string) -> string { return "s:" + s }
fn vbool(b: int) -> string { if b == 1 { return "b:true" } return "b:false" }
fn vnull() -> string { return "N:" }
fn vundef() -> string { return "u:" }
fn vfn(id: int) -> string { return "f:" + id.to_string() }
fn varr(id: int) -> string { return "a:" + id.to_string() }
fn vobj(id: int) -> string { return "o:" + id.to_string() }

fn vtostr(v: string) -> string {
    var t = vtag(v)
    if t == "s" { return vdata(v) }
    if t == "n" {
        var d = vdata(v)
        // Strip trailing .0 for display
        if d.ends_with(".0") { return d.substring(0, d.len() - 2) }
        return d
    }
    if t == "b" { return vdata(v) }
    if t == "N" { return "null" }
    if t == "u" { return "undefined" }
    if t == "a" { return vtostr_full(v) }
    if t == "o" { return "[object Object]" }
    return v
}

// NOTE: named js_str_to_int, not str_to_int - the latter collides with a
// wyn_runtime.h symbol and fails the C compile with "redefinition".
// `to_int()` PANICS on "-1.0" / "3.5", so anything with a "." must round-trip
// through to_float(). Non-numeric text yields 0 (JS NaN -> 0 here).
fn js_str_to_int(d: string) -> int {
    if d.len() == 0 { return 0 }
    if d.contains(".") or d.contains("e") or d.contains("E") { return d.to_float().to_int() }
    var i = 0
    if d.starts_with("-") or d.starts_with("+") { i = 1 }
    if i >= d.len() { return 0 }
    while i < d.len() {
        if not DIGITS.contains(d.substring(i, i + 1)) { return 0 }
        i = i + 1
    }
    return d.to_int()
}

fn vtonum(v: string) -> int {
    var t = vtag(v)
    if t == "n" { return js_str_to_int(vdata(v)) }
    if t == "b" { if vdata(v) == "true" { return 1 } return 0 }
    if t == "s" { return js_str_to_int(vdata(v).trim()) }
    return 0
}

fn vtofloat(v: string) -> float {
    var t = vtag(v)
    if t == "n" { return vdata(v).to_float() }
    if t == "b" { if vdata(v) == "true" { return 1.0 } return 0.0 }
    if t == "s" { var d = vdata(v).trim(); if vis_num_str("s:" + d) == 1 { return d.to_float() }; return 0.0 }
    return 0.0
}

fn vtruthy(v: string) -> int {
    var t = vtag(v)
    if t == "b" { if vdata(v) == "true" { return 1 } return 0 }
    if t == "n" { var d = vdata(v); if d == "0" or d == "0.0" or d == "NaN" { return 0 } return 1 }
    if t == "s" { if vdata(v).len() > 0 { return 1 } return 0 }
    if t == "N" { return 0 }
    if t == "u" { return 0 }
    return 1
}

// JS parseInt/parseFloat take the longest numeric PREFIX ("42px" -> 42) and give
// NaN when there is none. Wyn's to_int()/to_float() PANIC on trailing junk, so the
// prefix has to be extracted first.
//
// Returns "" when there were NO digits, which the callers turn into NaN. It used
// to return "0" for that case, making parseInt("abc") === 0 - wrong, and wrong in
// the dangerous direction, because 0 is falsy and a real value while NaN is
// neither. Cross-checked against node: `parseInt("abc")` is NaN.
fn num_prefix(sv: string) -> string {
    var d = sv.trim()
    var i = 0
    var out = ""
    if d.starts_with("-") or d.starts_with("+") { out = d.substring(0, 1); i = 1 }
    var seen_dot = 0
    var seen_digit = 0
    while i < d.len() {
        var c = d.substring(i, i + 1)
        if DIGITS.contains(c) { out = out + c; seen_digit = 1 }
        else if c == "." and seen_dot == 0 { out = out + c; seen_dot = 1 }
        else { break }
        i = i + 1
    }
    if seen_digit == 0 { return "" }
    return out
}

fn vis_num_str(v: string) -> int {
    var d = vdata(v)
    if d.len() == 0 { return 0 }
    var i = 0
    if d.substring(0, 1) == "-" { i = 1 }
    var has_dot = 0
    while i < d.len() {
        var c = d.substring(i, i + 1)
        if c == "." { if has_dot == 1 { return 0 } has_dot = 1 }
        else if not DIGITS.contains(c) { return 0 }
        i = i + 1
    }
    return 1
}

// === Environment ===
ekeys = [""]
evals = [""]
ecnt: int = 0
smarks = [0]
sdepth: int = 0

fn epush() {
    if sdepth >= MAX_DEPTH - 1 { overflow = 1; return }
    smarks[sdepth] = ecnt
    sdepth = sdepth + 1
}
fn epop() { if sdepth > 0 { sdepth = sdepth - 1; ecnt = smarks[sdepth] } }

fn edef(name: string, val: string) {
    if ecnt >= MAX_ENV - 1 { overflow = 1; return }
    ekeys[ecnt] = sdup(name)
    evals[ecnt] = sdup(val)
    ecnt = ecnt + 1
}

fn eset(name: string, val: string) {
    if noeval > 0 { return }
    for j in 0..ecnt {
        var i = ecnt - 1 - j
        if ekeys[i] == name { evals[i] = sdup(val); return }
    }
    edef(name, val)
}

fn eget(name: string) -> string {
    for j in 0..ecnt {
        var i = ecnt - 1 - j
        if ekeys[i] == name { return evals[i] }
    }
    return vundef()
}

// === Function storage ===
fbodies = [""]
fparams = [""]
fthis = [""]
fcap_keys = [""]
fcap_vals = [""]
fcnt = 0

fn capture_env() -> string {
    var result = ""
    var i = 0
    while i < ecnt {
        if ekeys[i].len() > 0 and ekeys[i] != "this" and ekeys[i] != "arguments" {
            if result.len() > 0 { result = result + "\x02" }
            result = result + ekeys[i] + "\x01" + evals[i]
        }
        i = i + 1
    }
    return result
}

fn restore_captures(fid: int) {
    var cap_k = sdup(fcap_keys[fid])
    var cap_v = sdup(fcap_vals[fid])
    if cap_k.len() == 0 { return }
    var keys = cap_k.split("\x02")
    var vals = cap_v.split("\x02")
    var i = 0
    while i < keys.len() {
        if i < vals.len() { edef(keys[i], vals[i]) }
        i = i + 1
    }
}

fn save_captures(fid: int) {
    var cap_k = sdup(fcap_keys[fid])
    if cap_k.len() == 0 { return }
    var keys = cap_k.split("\x02")
    var new_vals = ""
    var i = 0
    while i < keys.len() {
        if i > 0 { new_vals = new_vals + "\x02" }
        new_vals = new_vals + eget(keys[i])
        i = i + 1
    }
    fcap_vals[fid] = sdup(new_vals)
}

// Write a closure's captured values back into the ENCLOSING scope.
//
// A capture here is a SNAPSHOT: restore_captures re-defines each captured name in
// the callee's fresh scope, and save_captures copies the modified values back into
// the function's own slot so the NEXT call sees them. That makes a counter work
// from inside the closure and leaves the outer variable untouched, so
//
//     let c = 0
//     const bump = () => { c = c + 1; return c }
//     bump(); bump(); c        // returned 1 then 2, and c was still 0
//
// which is wrong for arrows AND for function expressions - a closure that cannot
// mutate what it closes over is not a closure. Node says 2.
//
// So this runs AFTER epop, once the callee's scope is gone and the enclosing
// binding is the one `eset` will find. Split from save_captures rather than folded
// into it because the two must happen on OPPOSITE sides of the pop, and calling
// one function twice around a pop would have been the same bug with more steps.
//
// `eset` and not `edef`: eset walks back to the existing binding and assigns it,
// which is what "the outer variable changed" means. edef would push a NEW entry
// that the next epop discards - the original bug, one layer out.
//
// A name that no longer exists in any live scope is simply not found by eset,
// which then defines it at the current level; harmless, because the only way to
// reach that is a closure outliving its scope, where there is nothing to update.
// Reduce a stored params string to a comma-joined list of bare NAMES: drop any
// "=default" suffix and the "..." rest marker. Same spelling callfn splits on.
fn strip_param_meta(psrc: string) -> string {
    var out = ""
    var parts = psrc.split(",")
    var i = 0
    while i < parts.len() {
        var nm = parts[i]
        var eq = nm.index_of("=")
        if eq > 0 { nm = nm.substring(0, eq) }
        if nm.starts_with("...") { nm = nm.substring(3, nm.len()) }
        nm = nm.trim()
        if nm.len() > 0 {
            if out.len() > 0 { out = out + "," }
            out = out + nm
        }
        i = i + 1
    }
    return out
}

fn writeback_captures(fid: int, before: string) {
    var cap_k = sdup(fcap_keys[fid])
    var cap_v = sdup(fcap_vals[fid])
    if cap_k.len() == 0 { return }
    var keys = cap_k.split("\x02")
    var vals = cap_v.split("\x02")
    var olds = before.split("\x02")
    // A PARAMETER SHADOWS a captured name of the same spelling, and its value must
    // NOT escape:
    //
    //     let n = 100
    //     const f = (n) => { n = n + 1; return n }
    //     f(1)          // 2, and the outer n must still be 100
    //
    // The parameter is bound in the callee's scope over the captured entry, so
    // save_captures reads the PARAMETER's value under the captured name. Writing
    // that back sets the outer variable to the argument - measured: this regressed
    // `2 100` to `2 2` before the guard. Comma-joined with the "..." rest marker
    // and any `=default` suffix stripped, matching how callfn splits it.
    var pnames = "," + strip_param_meta(sdup(fparams[fid])) + ","
    var i = 0
    while i < keys.len() {
        if i < vals.len() {
            // ONLY WRITE BACK WHAT THE CALLEE ACTUALLY CHANGED.
            //
            // capture_env captures EVERY binding in scope, not just the ones a
            // closure mentions - so writing all of them back restores a stale
            // snapshot of variables the callee never touched. That is not a
            // theoretical risk; it broke the test suite's own counter:
            //
            //     let pass = 0
            //     function expect(...) { ... pass++ ... }
            //     expect(c1); expect(c2)      // pass came back 1, not 2
            //
            // because a DIFFERENT closure had captured `pass` while it was 0 and
            // put that 0 back on return. Comparing against the value captured at
            // entry makes the write-back precise: an untouched name is skipped, so
            // it cannot clobber a change made by anyone else.
            var unchanged = 0
            if i < olds.len() { if olds[i] == vals[i] { unchanged = 1 } }
            if pnames.contains("," + keys[i] + ",") { unchanged = 1 }
            if unchanged == 0 { eset(keys[i], vals[i]) }
        }
        i = i + 1
    }
}

// === Array storage ===
astore = [""]
alens = [0]
abases = [0]
acnt = 0
anext = 0

fn anew() -> int {
    if acnt >= MAX_ARRAYS - 1 { overflow = 1; return 0 }
    var id = acnt; abases[id] = anext; alens[id] = 0; acnt = acnt + 1; return id
}
fn apush(id: int, v: string) {
    var s = abases[id] + alens[id]
    if s >= MAX_ASTORE - 1 { overflow = 1; return }
    astore[s] = sdup(v); alens[id] = alens[id] + 1; anext = s + 1
}
fn aget(id: int, i: int) -> string { if i < 0 { return vundef() } if i >= alens[id] { return vundef() } return astore[abases[id] + i] }
fn aset(id: int, i: int, v: string) { if noeval > 0 { return } if i >= 0 and i < alens[id] { astore[abases[id] + i] = sdup(v) } }

fn acopy(id: int) -> int {
    var nid = anew()
    var i = 0
    while i < alens[id] { apush(nid, aget(id, i)); i = i + 1 }
    return nid
}

fn vtostr_full(v: string) -> string {
    var t = vtag(v)
    if t == "a" {
        var id = vdata(v).to_int()
        var r = ""
        var i = 0
        while i < alens[id] {
            if i > 0 { r = r + "," }
            r = r + vtostr_full(aget(id, i))
            i = i + 1
        }
        return r
    }
    if t == "o" { return "[object Object]" }
    return vtostr(v)
}

// === Object storage (HashMap-based) ===
omaps = [HashMap.new()]
oprotos = [-1]
ocnt = 0
// Insertion order of each object's keys, "\n"-joined. A HashMap iterates in BUCKET
// order, but JS *guarantees* string keys enumerate in insertion order - so
// Object.keys / for-in / JSON.stringify cannot read the map's order. This is the
// order; the map stays the value store. "\n" is safe as a separator because it
// cannot appear in an identifier, and a computed key containing one would only
// mis-order, never corrupt, the value.
okeyorder = [""]

fn onew() -> int {
    var id = ocnt
    var m = HashMap.new()
    omaps.push(m)
    oprotos.push(-1)
    okeyorder.push("")
    ocnt = ocnt + 1
    return id
}

fn oset(id: int, k: string, v: string) {
    if noeval > 0 { return }
    var m = omaps[id]
    // First write of a key appends it to the order; a REwrite must not move it, as
    // JS keeps a key at its original position when its value is replaced.
    if not m.has(k) {
        if okeyorder[id].len() > 0 { okeyorder[id] = okeyorder[id] + "\n" + k } else { okeyorder[id] = sdup(k) }
    }
    m.set(sdup(k), sdup(v))
}

// COMPILER WORKAROUND: a `var m = omaps[i]` binding declared INSIDE a loop body
// gets a `hashmap_free(m)` emitted at the end of that body, freeing the map the
// global array still owns -> use-after-free on the next lookup. Indexing inline
// (no loop-local binding) does not emit the free. Same for ohas below.
fn oget(id: int, k: string) -> string {
    var cur = id
    while cur >= 0 {
        if omaps[cur].has(k) { return omaps[cur].get(k) }
        cur = oprotos[cur]
    }
    return vundef()
}

fn odel(id: int, k: string) {
    if noeval > 0 { return }
    var m = omaps[id]
    m.remove(k)
    // Drop it from the order too, or a delete-then-re-add would reuse the ORIGINAL
    // position; JS puts a re-added key at the end.
    if okeyorder[id].len() > 0 {
        var kept = ""
        var parts = okeyorder[id].split("\n")
        for ok in parts {
            if ok != k and ok.len() > 0 {
                if kept.len() > 0 { kept = kept + "\n" + ok } else { kept = sdup(ok) }
            }
        }
        okeyorder[id] = sdup(kept)
    }
}

fn ohas(id: int, k: string) -> int {
    var m = omaps[id]
    if m.has(k) { return 1 }
    return 0
}

// Safe accessors: a `var m = omaps[i]` binding inside a NESTED block (if/loop
// body) gets a spurious hashmap_free at block end. Binding at function-top
// scope, as these do, does not. Every nested-block map use calls these instead.
//
// okeys returns keys in INSERTION order (see okeyorder). Everything user-visible -
// Object.keys, for-in, JSON.stringify - goes through here, so the map's bucket order
// never leaks. A key that okeyorder lists but the map no longer has was deleted, so
// the `has` filter also keeps delete/re-add correct: it re-appends at the end.
fn okeys(id: int) -> [string] {
    if okeyorder[id].len() == 0 { return [] }
    var ordered: [string] = []
    var parts = okeyorder[id].split("\n")
    for k in parts { if omaps[id].has(k) { ordered.push(sdup(k)) } }
    return ordered
}

fn oget_own(id: int, k: string) -> string {
    var m = omaps[id]
    if m.has(k) { return m.get(k) }
    return vundef()
}

fn olen(id: int) -> int {
    var m = omaps[id]
    return m.len()
}

fn okeys_arr(id: int) -> int {
    // okeys() (insertion order), NOT m.keys() (bucket order) - Object.keys is
    // user-visible and JS guarantees insertion order for string keys.
    // It is called BEFORE anew() on purpose: astore is a bump allocator, so
    // allocating the result array first and then building a second collection would
    // interleave the two regions. That is OPEN-A exactly.
    var ks = okeys(id)
    var aid = anew()
    for k in ks {
        // A getter/setter IS an enumerable own property in JS, so it must appear in
        // Object.keys - under its real name, not the mangled storage key.
        if k.starts_with("__get_") { apush(aid, vstr(k.substring(6, k.len()))) }
        else if k.starts_with("__set_") {
            // A get/set PAIR is one property: only the getter emits it, or the name
            // would appear twice.
            var sname = k.substring(6, k.len())
            if ohas(id, "__get_" + sname) == 0 { apush(aid, vstr(sname)) }
        }
        // A "#name" key is a PRIVATE field: not an own enumerable property in JS,
        // so it must not appear here (nor in JSON.stringify).
        else if not k.starts_with("__") and not k.starts_with("#") { apush(aid, vstr(k)) }
    }
    return aid
}

// === Class storage ===
cnames = [""]
cprotos = [0]
cconstructors = [-1]
cparents = [-1]
ccnt = 0
// Instance field declarations (`class A { n = 0 }`), stored as SOURCE per class
// and re-evaluated on every `new`. They cannot live on the prototype: each
// instance needs its own copy, and an initializer may read `this`.
cfields = [""]

// === this stack ===
this_stack = [""]
this_depth = 0
fn this_push(v: string) { this_stack[this_depth] = sdup(v); this_depth = this_depth + 1 }
fn this_pop() { this_depth = this_depth - 1 }
fn this_cur() -> string { if this_depth > 0 { return this_stack[this_depth - 1] } return vundef() }

// === Return/break/continue/throw flags ===
retval = ""
retflag = 0
brkflag = 0
contflag = 0
throwval = ""
throwflag = 0

// === Module cache ===
mod_paths = [""]
mod_exports = [""]
mod_cnt = 0

// === Builtin registry ===
bnames = [""]
bcnt = 0

fn init_env() {
    ekeys = []; evals = []
    for i in 0..(MAX_ENV) { ekeys.push(""); evals.push("") }
    smarks = []
    for i in 0..(MAX_DEPTH) { smarks.push(0) }
    fbodies = []; fparams = []; fthis = []; fcap_keys = []; fcap_vals = []
    for i in 0..1024 { fbodies.push(""); fparams.push(""); fthis.push(""); fcap_keys.push(""); fcap_vals.push("") }
    astore = []
    for i in 0..(MAX_ASTORE) { astore.push("") }
    alens = []; abases = []
    for i in 0..(MAX_ARRAYS) { alens.push(0); abases.push(0) }
    omaps = [HashMap.new()]; oprotos = []; okeyorder = []
    for i in 0..1024 { oprotos.push(-1); okeyorder.push("") }
    cnames = []; cprotos = []; cconstructors = []; cparents = []; cfields = []
    for i in 0..128 { cnames.push(""); cprotos.push(0); cconstructors.push(-1); cparents.push(-1); cfields.push("") }
    this_stack = []
    for i in 0..128 { this_stack.push("") }
    mod_paths = []; mod_exports = []
    for i in 0..64 { mod_paths.push(""); mod_exports.push("") }
    bnames = []
    for i in 0..256 { bnames.push("") }
}

// === Lexer ===
fn ch() -> string { if pos >= src.len() { return "" } return src.substring(pos, pos + 1) }
fn adv() -> string { var c = ch(); pos = pos + 1; return c }
fn peek2() -> string { if pos + 1 >= src.len() { return "" } return src.substring(pos + 1, pos + 2) }

fn skipws() {
    while pos < src.len() {
        var c = ch()
        if c == " " or c == "\t" or c == "\r" or c == "\n" { pos = pos + 1 }
        else if c == "/" {
            var n = peek2()
            if n == "/" { pos = pos + 2; while pos < src.len() { if ch() == "\n" { pos = pos + 1; break } pos = pos + 1 } }
            else if n == "*" { pos = pos + 2; while pos < src.len() { if ch() == "*" and peek2() == "/" { pos = pos + 2; break } pos = pos + 1 } }
            else { return }
        } else { return }
    }
}

// Read digits of the given radix at the current position and return the value.
fn lex_radix(radix: int) -> int {
    var digits = "0123456789abcdef"
    var val = 0
    var any = 0
    while pos < src.len() {
        var c = ch().lower()
        if c == "_" { pos = pos + 1; continue }
        var d = digits.index_of(c)
        if d < 0 or d >= radix { break }
        val = val * radix + d
        any = 1
        pos = pos + 1
    }
    if any == 0 { return 0 }
    return val
}

// Turn a mantissa plus decimal exponent into plain decimal text, so "1e3"
// becomes "1000" and "1.5e-2" becomes "0.015".
fn expand_exp(mant: string, sign: string, digits: string) -> string {
    var e = digits.to_int()
    var f = mant.to_float()
    var i = 0
    if sign == "-" {
        while i < e { f = f / 10.0; i = i + 1 }
    } else {
        while i < e { f = f * 10.0; i = i + 1 }
    }
    var out = f.to_string()
    if out.ends_with(".0") { return out.substring(0, out.len() - 2) }
    return out
}

fn next() {
    skipws()
    // Where the token about to be lexed BEGINS. After next() returns, `pos` sits
    // past the token, so `pos` cannot delimit a source slice; tstart can. It is how
    // a class field initializer's source is cut out exactly (see the class parser).
    tstart = pos
    if pos >= src.len() { tt = 0; tv = ""; return }
    var c = ch()
    // Numbers
    if DIGITS.contains(c) {
        // 0x.. / 0b.. / 0o.. radix literals, plus 1_000 digit separators and
        // 1e3 exponents. All are normalised to a plain decimal token here so the
        // rest of the interpreter only ever sees base-10 text.
        if c == "0" and pos + 1 < src.len() {
            var c2 = peek2()
            if c2 == "x" or c2 == "X" { pos = pos + 2; tt = 1; tv = lex_radix(16).to_string(); return }
            if c2 == "b" or c2 == "B" { pos = pos + 2; tt = 1; tv = lex_radix(2).to_string(); return }
            if c2 == "o" or c2 == "O" { pos = pos + 2; tt = 1; tv = lex_radix(8).to_string(); return }
        }
        var n = ""
        while pos < src.len() {
            c = ch()
            if DIGITS.contains(c) or c == "." { n = n + c; pos = pos + 1 }
            else if c == "_" { pos = pos + 1 }
            else if c == "e" or c == "E" {
                // exponent: consume e/E, an optional sign, then digits
                var save = pos
                pos = pos + 1
                var sign = ""
                if ch() == "+" or ch() == "-" { sign = ch(); pos = pos + 1 }
                var digits = ""
                while pos < src.len() and DIGITS.contains(ch()) { digits = digits + ch(); pos = pos + 1 }
                if digits.len() == 0 { pos = save; break }
                n = expand_exp(n, sign, digits)
                break
            }
            else { break }
        }
        tt = 1; tv = n; return
    }
    // Strings
    if c == "\"" { pos = pos + 1; var s = ""; while pos < src.len() { c = ch(); if c == "\"" { pos = pos + 1; break } else if c == "\\" { pos = pos + 1; var e = adv(); if e == "n" { s = s + "\n" } else if e == "t" { s = s + "\t" } else if e == "r" { s = s + "\r" } else if e == "\\" { s = s + "\\" } else if e == "\"" { s = s + "\"" } else if e == "'" { s = s + "'" } else { s = s + e } } else { s = s + c; pos = pos + 1 } } tt = 2; tv = s; return }
    if c == "'" { pos = pos + 1; var s = ""; while pos < src.len() { c = ch(); if c == "'" { pos = pos + 1; break } else if c == "\\" { pos = pos + 1; var e = adv(); if e == "n" { s = s + "\n" } else if e == "t" { s = s + "\t" } else if e == "'" { s = s + "'" } else if e == "\\" { s = s + "\\" } else { s = s + e } } else { s = s + c; pos = pos + 1 } } tt = 2; tv = s; return }
    // Template literal
    if c == "`" { pos = pos + 1; var s = ""; while pos < src.len() { c = ch(); if c == "`" { pos = pos + 1; break } else if c == "\\" { pos = pos + 1; var e = adv(); if e == "n" { s = s + "\n" } else { s = s + e } } else if c == "$" { if peek2() == "{" { pos = pos + 2; tt = 61; tv = s; return } s = s + c; pos = pos + 1 } else { s = s + c; pos = pos + 1 } } tt = 2; tv = s; return }
    // Identifiers / keywords
    if ALPHA.contains(c) {
        var id = ""
        while pos < src.len() { c = ch(); if ALPHA.contains(c) or DIGITS.contains(c) { id = id + c; pos = pos + 1 } else { break } }
        if id == "let" { tt = 50 } else if id == "const" { tt = 51 } else if id == "var" { tt = 52 }
        else if id == "function" { tt = 53 } else if id == "return" { tt = 54 }
        else if id == "if" { tt = 55 } else if id == "else" { tt = 56 }
        else if id == "while" { tt = 57 } else if id == "for" { tt = 58 }
        else if id == "break" { tt = 59 } else if id == "continue" { tt = 60 }
        else if id == "class" { tt = 70 } else if id == "new" { tt = 71 }
        else if id == "this" { tt = 72 } else if id == "extends" { tt = 73 }
        else if id == "super" { tt = 74 } else if id == "static" { tt = 75 }
        else if id == "typeof" { tt = 76 } else if id == "instanceof" { tt = 77 }
        else if id == "switch" { tt = 78 } else if id == "case" { tt = 79 }
        else if id == "default" { tt = 80 } else if id == "do" { tt = 81 }
        else if id == "throw" { tt = 82 } else if id == "try" { tt = 83 }
        else if id == "catch" { tt = 84 } else if id == "finally" { tt = 85 }
        else if id == "import" { tt = 86 } else if id == "export" { tt = 87 }
        else if id == "from" { tt = 88 } else if id == "async" { tt = 89 }
        else if id == "await" { tt = 90 } else if id == "yield" { tt = 91 }
        else if id == "delete" { tt = 92 } else if id == "in" { tt = 93 }
        else if id == "of" { tt = 94 } else if id == "void" { tt = 95 }
        else if id == "true" { tt = 4; tv = "true"; return }
        else if id == "false" { tt = 4; tv = "false"; return }
        else if id == "null" { tt = 5; tv = "null"; return }
        else if id == "undefined" { tt = 6; tv = "undefined"; return }
        else { tt = 3 }
        tv = id; return
    }
    // Operators
    pos = pos + 1
    if c == "+" { if ch() == "+" { pos = pos + 1; tt = 41; tv = "++"; return } if ch() == "=" { pos = pos + 1; tt = 42; tv = "+="; return } tt = 10; tv = "+"; return }
    if c == "-" { if ch() == "-" { pos = pos + 1; tt = 43; tv = "--"; return } if ch() == "=" { pos = pos + 1; tt = 44; tv = "-="; return } if ch() == ">" { pos = pos + 1; tt = 40; tv = "=>"; return } tt = 11; tv = "-"; return }
    if c == "*" { if ch() == "*" { pos = pos + 1; tt = 45; tv = "**"; return } if ch() == "=" { pos = pos + 1; tt = 46; tv = "*="; return } tt = 12; tv = "*"; return }
    if c == "/" { if ch() == "=" { pos = pos + 1; tt = 47; tv = "/="; return } tt = 13; tv = "/"; return }
    if c == "%" { if ch() == "=" { pos = pos + 1; tt = 48; tv = "%="; return } tt = 14; tv = "%"; return }
    if c == "=" { if ch() == "=" { pos = pos + 1; if ch() == "=" { pos = pos + 1; tt = 17; tv = "==="; return } tt = 16; tv = "=="; return } if ch() == ">" { pos = pos + 1; tt = 40; tv = "=>"; return } tt = 15; tv = "="; return }
    if c == "!" { if ch() == "=" { pos = pos + 1; if ch() == "=" { pos = pos + 1; tt = 19; tv = "!=="; return } tt = 18; tv = "!="; return } tt = 24; tv = "!"; return }
    // `<<` and `>>` are checked BEFORE `<=` / `>=`, and `>>>` before `>>`: the
    // longest match must win or `1 << 4` lexes as `<` then `<`, and `a >>> b`
    // lexes as `>>` then `>`.
    if c == "<" { if ch() == "<" { pos = pos + 1; tt = 103; tv = "<<"; return } if ch() == "=" { pos = pos + 1; tt = 22; tv = "<="; return } tt = 20; tv = "<"; return }
    if c == ">" { if ch() == ">" { pos = pos + 1; if ch() == ">" { pos = pos + 1; tt = 105; tv = ">>>"; return } tt = 104; tv = ">>"; return } if ch() == "=" { pos = pos + 1; tt = 23; tv = ">="; return } tt = 21; tv = ">"; return }
    if c == "^" { tt = 106; tv = "^"; return }
    if c == "&" { if ch() == "&" { pos = pos + 1; if ch() == "=" { pos = pos + 1; tt = 102; tv = "&&="; return }; tt = 25; tv = "&&"; return } tt = 27; tv = "&"; return }
    if c == "|" { if ch() == "|" { pos = pos + 1; if ch() == "=" { pos = pos + 1; tt = 101; tv = "||="; return }; tt = 26; tv = "||"; return } tt = 28; tv = "|"; return }
    if c == "?" { if ch() == "?" { pos = pos + 1; if ch() == "=" { pos = pos + 1; tt = 100; tv = "??="; return }; tt = 29; tv = "??"; return } if ch() == "." { pos = pos + 1; tt = 96; tv = "?."; return } tt = 97; tv = "?"; return }
    if c == "(" { tt = 30; tv = "("; return }
    if c == ")" { tt = 31; tv = ")"; return }
    if c == "{" { tt = 32; tv = "{"; return }
    if c == "}" { tt = 33; tv = "}"; return }
    if c == "[" { tt = 34; tv = "["; return }
    if c == "]" { tt = 35; tv = "]"; return }
    if c == "," { tt = 36; tv = ","; return }
    if c == ";" { tt = 37; tv = ";"; return }
    if c == "." { if ch() == "." { pos = pos + 1; if ch() == "." { pos = pos + 1; tt = 98; tv = "..."; return } } tt = 38; tv = "."; return }
    // `#name` - a private class member. It lexes as one identifier token whose
    // text KEEPS the "#", so `this.#p` reaches the ordinary property path and the
    // name can never collide with a public property called "p". Privacy is then
    // just the "#" prefix being hidden from Object.keys/JSON, like "__" keys.
    if c == "#" {
        var pid = "#"
        while pos < src.len() { c = ch(); if ALPHA.contains(c) or DIGITS.contains(c) { pid = pid + c; pos = pos + 1 } else { break } }
        tt = 3; tv = pid; return
    }
    if c == ":" { tt = 39; tv = ":"; return }
    if c == "~" { tt = 99; tv = "~"; return }
    tt = 0; tv = ""
}

fn eat(t: int) { next() }

// === Parser/Interpreter - expressions ===
fn p_expr() -> string { return p_ternary() }

fn p_ternary() -> string {
    var left = p_nullish()
    if tt == 97 {
        next()
        var take_then = vtruthy(left)
        // Parse both arms (to advance past them) but only EVALUATE the taken one.
        if take_then == 0 { noeval = noeval + 1 }
        var then_val = p_ternary()
        if take_then == 0 { noeval = noeval - 1 }
        if tt == 39 { next() }
        if take_then == 1 { noeval = noeval + 1 }
        var else_val = p_ternary()
        if take_then == 1 { noeval = noeval - 1 }
        if take_then == 1 { return then_val }
        return else_val
    }
    return left
}

fn p_nullish() -> string {
    var left = p_or()
    while tt == 29 {
        next()
        var t = vtag(left)
        var want = 0
        if t == "N" or t == "u" { want = 1 }
        if want == 0 { noeval = noeval + 1 }
        var right = p_or()
        if want == 0 { noeval = noeval - 1 }
        if want == 1 { left = right }
    }
    return left
}

fn p_or() -> string {
    var left = p_and()
    while tt == 26 {
        next()
        // `a || b`: b is only evaluated when a is falsy.
        var skip = vtruthy(left)
        if skip == 1 { noeval = noeval + 1 }
        var right = p_and()
        if skip == 1 { noeval = noeval - 1 }
        if skip == 0 { left = right }
    }
    return left
}

fn p_and() -> string {
    var left = p_bitor()
    while tt == 25 {
        next()
        // `a && b`: b is only evaluated when a is truthy.
        var skip = 0
        if vtruthy(left) == 0 { skip = 1 }
        if skip == 1 { noeval = noeval + 1 }
        var right = p_bitor()
        if skip == 1 { noeval = noeval - 1 }
        if skip == 0 { left = right }
    }
    return left
}

// ---- bitwise: | then ^ then & then equality ------------------------------
//
// THE ORDER IS JAVASCRIPT'S, and it is the whole reason these are three separate
// functions rather than one: `a & b | c` must mean `(a & b) | c`, and
// `1 | 2 ^ 3 & 4` must be `1 | (2 ^ (3 & 4))`. A single level would make them all
// left-associative peers and quietly give 3 for the second.
//
// These sit between `&&` and `==`, so `a & 1 == 1` parses as `a & (1 == 1)` -
// which is JavaScript's own famous wart, faithfully reproduced rather than
// silently fixed, because a language implementation that is "better" than the
// language is the harder thing to debug.
//
// Operands go through vtoint, so a float truncates and a numeric string converts,
// matching JS's ToInt32 closely enough for a teaching interpreter. Wyn's ints are
// 64-bit where JS coerces to 32, which is visible only past 2^31 - noted here
// rather than papered over, and it is why `~5` is -6 in both.
fn p_bitor() -> string {
    var left = p_bitxor()
    while tt == 28 {
        next()
        var right = p_bitxor()
        if noeval == 0 { left = vnum(vtonum(left) | vtonum(right)) }
    }
    return left
}

fn p_bitxor() -> string {
    var left = p_bitand()
    while tt == 106 {
        next()
        var right = p_bitand()
        if noeval == 0 { left = vnum(vtonum(left) ^ vtonum(right)) }
    }
    return left
}

fn p_bitand() -> string {
    var left = p_eq()
    while tt == 27 {
        next()
        var right = p_eq()
        if noeval == 0 { left = vnum(vtonum(left) & vtonum(right)) }
    }
    return left
}

// Strict equality: same tag AND same value. No coercion whatsoever.
//
// AN OBJECT COMPARES BY IDENTITY, NOT BY CONTENT, and that needs its own branch
// because `vtostr` renders every object as the string "[object Object]" - so
// comparing rendered text made any two objects equal, and `{x:1} === {x:2}` was
// true. Arrays and functions have the same problem for the same reason.
//
// The identity is the value's own payload: `vdata` of an "o"/"a"/"f" tagged value
// is its store index, which is exactly what a reference IS in this interpreter. So
// comparing payloads gives reference equality for these tags and value equality
// for the primitives, which is the rule JavaScript actually has.
fn strict_eq(a: string, b: string) -> int {
    var ta = vtag(a)
    if ta != vtag(b) { return 0 }
    if ta == "o" or ta == "a" or ta == "f" {
        if vdata(a) == vdata(b) { return 1 }
        return 0
    }
    if vtostr(a) != vtostr(b) { return 0 }
    return 1
}

// LOOSE equality, `==`, which is NOT strict equality with a different spelling.
//
// It was implemented as strict for both operators, so `1 == "1"` was false and
// `null == undefined` was false - two of the handful of facts every JavaScript
// programmer knows. This is the abstract-equality algorithm, in the order the spec
// applies it:
//
//   1. null and undefined are loosely equal to each other AND TO NOTHING ELSE.
//      That exception first, because it is the one rule people rely on
//      (`x == null` as "absent") and the one a numeric coercion would get wrong,
//      since Number(null) is 0 and `0 == null` must still be false.
//   2. Same tag -> strict comparison. Two strings, two numbers, two booleans
//      compare directly; there is nothing to coerce.
//   3. Otherwise compare NUMERICALLY, which is what covers number/string,
//      boolean/number and boolean/string in one line - a boolean is 1 or 0 and a
//      numeric string is its value.
//   4. An object against a primitive is false here. The spec calls ToPrimitive on
//      the object; this interpreter has no valueOf/toString dispatch to call, and
//      guessing would be worse than being predictable. Two objects compare by
//      identity through step 2, which is correct.
fn loose_eq(a: string, b: string) -> int {
    var ta = vtag(a)
    var tb = vtag(b)

    // 1. null/undefined
    if ta == "N" or ta == "u" {
        if tb == "N" or tb == "u" { return 1 }
        return 0
    }
    if tb == "N" or tb == "u" { return 0 }

    // 2. same type
    if ta == tb { return strict_eq(a, b) }

    // 4. object vs primitive - no ToPrimitive available.
    if ta == "o" or ta == "a" or ta == "f" { return 0 }
    if tb == "o" or tb == "a" or tb == "f" { return 0 }

    // 3. numeric comparison.
    //
    // A STRING THAT IS NOT A NUMBER IS NaN, AND NaN EQUALS NOTHING. vtofloat
    // returns 0.0 for such a string, so comparing through it made `"abc" == 0`
    // true - which is the one thing loose equality is famous for NOT doing.
    // Empty and whitespace-only strings are the exception: Number("") is 0, so
    // `"" == 0` and `"  " == false` really are true.
    if ta == "s" { if numeric_or_empty(a) == 0 { return 0 } }
    if tb == "s" { if numeric_or_empty(b) == 0 { return 0 } }
    if vtofloat(a) == vtofloat(b) { return 1 }
    return 0
}

// Would Number(s) be a number rather than NaN? Empty/whitespace counts, since
// Number("") is 0.
fn numeric_or_empty(v: string) -> int {
    var d = vdata(v).trim()
    if d.len() == 0 { return 1 }
    return vis_num_str("s:" + d)
}

fn p_eq() -> string {
    var left = p_cmp()
    while tt == 16 or tt == 17 or tt == 18 or tt == 19 {
        var op = tt; next(); var right = p_cmp()
        // 16 == | 17 === | 18 != | 19 !==
        if op == 17 { left = vbool(strict_eq(left, right)) }
        if op == 19 { left = vbool(1 - strict_eq(left, right)) }
        if op == 16 { left = vbool(loose_eq(left, right)) }
        if op == 18 { left = vbool(1 - loose_eq(left, right)) }
    }
    return left
}

// ---- shifts: tighter than a comparison, looser than + ---------------------
//
// `1 << 2 + 3` is `1 << 5` in JavaScript, not `(1 << 2) + 3`, and `a << b < c` is
// `(a << b) < c`. That is what placing this level between p_cmp and p_add buys.
//
// `>>` is arithmetic (sign-preserving) and `>>>` is logical. Wyn's `>>` on a
// signed int is already arithmetic, so `>>` is direct; `>>>` masks to 32 bits
// FIRST, because a logical shift of a negative number is only meaningful on a
// fixed width and JS defines it on 32.
fn p_shift() -> string {
    var left = p_add()
    while tt == 103 or tt == 104 or tt == 105 {
        var op = tt
        next()
        var right = p_add()
        if noeval == 0 {
            var a = vtonum(left)
            // Only the low 5 bits of the count are used, as JS does: `1 << 32`
            // is 1, not 0. Without this a large count is undefined behaviour in
            // C and the answer becomes whatever the hardware happens to do.
            var n = vtonum(right) % 32
            if n < 0 { n = n + 32 }
            if op == 103 { left = vnum(a << n) }
            if op == 104 { left = vnum(a >> n) }
            if op == 105 {
                // Logical: reinterpret as unsigned 32-bit, then shift in zeros.
                var u = a % 4294967296
                if u < 0 { u = u + 4294967296 }
                left = vnum(u >> n)
            }
        }
    }
    return left
}

fn p_cmp() -> string {
    var left = p_shift()
    if tt == 77 {
        next(); var right = p_shift()
        if vtag(left) == "o" and vtag(right) == "o" {
            var cls_name = vtostr(right)
            var oid = vdata(left).to_int()
            var proto_tag = oget(oid, "__class__")
            if vtostr(proto_tag) == cls_name { return vbool(1) }
        }
        return vbool(0)
    }
    while tt == 20 or tt == 21 or tt == 22 or tt == 23 or tt == 93 {
        var op = tt; next(); var right = p_shift()
        if op == 93 {
            if vtag(right) == "o" { left = vbool(ohas(vdata(right).to_int(), vtostr(left))); continue }
            left = vbool(0); continue
        }
        // String comparison
        if vtag(left) == "s" and vtag(right) == "s" {
            var ls = vdata(left); var rs = vdata(right)
            if op == 20 { left = vbool(if ls < rs { 1 } else { 0 }) }
            else if op == 21 { left = vbool(if ls > rs { 1 } else { 0 }) }
            else if op == 22 { left = vbool(if ls <= rs { 1 } else { 0 }) }
            else { left = vbool(if ls >= rs { 1 } else { 0 }) }
            continue
        }
        var ln = vtofloat(left); var rn = vtofloat(right)
        if op == 20 { if ln < rn { left = vbool(1) } else { left = vbool(0) } }
        else if op == 21 { if ln > rn { left = vbool(1) } else { left = vbool(0) } }
        else if op == 22 { if ln <= rn { left = vbool(1) } else { left = vbool(0) } }
        else { if ln >= rn { left = vbool(1) } else { left = vbool(0) } }
    }
    return left
}

fn p_add() -> string {
    var left = p_mul()
    while tt == 10 or tt == 11 {
        var op = tt; next(); var right = p_mul()
        if op == 10 {
            if vtag(left) == "s" or vtag(right) == "s" { left = vstr(vtostr(left) + vtostr(right)) }
            else { left = vfloat(vtofloat(left) + vtofloat(right)) }
        } else { left = vfloat(vtofloat(left) - vtofloat(right)) }
    }
    return left
}

fn p_mul() -> string {
    var left = p_power()
    while tt == 12 or tt == 13 or tt == 14 {
        var op = tt; next(); var right = p_power()
        if op == 12 { left = vfloat(vtofloat(left) * vtofloat(right)) }
        else if op == 13 { var d = vtofloat(right); if d != 0.0 { left = vfloat(vtofloat(left) / d) } else { left = vstr("Infinity") } }
        else { left = vnum(vtonum(left) % vtonum(right)) }
    }
    return left
}

fn p_power() -> string {
    var left = p_unary()
    if tt == 45 { next(); var right = p_power(); left = vfloat(Math.pow(vtofloat(left), vtofloat(right))) }
    return left
}

fn p_unary() -> string {
    if tt == 11 { next(); return vfloat(0.0 - vtofloat(p_unary())) }
    // Bitwise NOT. `~5` is -6 because ~x == -(x+1) on two's complement, which
    // holds at any width - so this is one of the few bitwise results that is
    // identical whether the operand is treated as 32-bit (JS) or 64-bit (Wyn).
    if tt == 99 { next(); return vnum(0 - vtonum(p_unary()) - 1) }
    if tt == 24 { next(); if vtruthy(p_unary()) == 1 { return vbool(0) } return vbool(1) }
    if tt == 76 {
        next(); var val = p_unary()
        var t = vtag(val)
        if t == "n" { return vstr("number") }
        if t == "s" { return vstr("string") }
        if t == "b" { return vstr("boolean") }
        if t == "f" { return vstr("function") }
        if t == "u" { return vstr("undefined") }
        if t == "N" { return vstr("object") }
        if t == "a" { return vstr("object") }
        if t == "y" { return vstr("symbol") }
        if t == "o" { return vstr("object") }
        return vstr("undefined")
    }
    if tt == 95 { next(); p_unary(); return vundef() }
    if tt == 92 {
        next()
        if tt == 3 {
            var name = tv; next()
            // `delete o.a` must remove the KEY from o, leaving o itself intact. It
            // used to run eset(name, undefined), which erased the whole object -
            // masked until property-access-on-undefined started throwing.
            if tt == 38 or tt == 34 {
                var base = eget(name)
                var pend = ""
                while tt == 38 or tt == 34 {
                    if pend.len() > 0 {
                        // resolve the previously-seen segment before descending
                        if vtag(base) == "o" { base = oget(vdata(base).to_int(), pend) }
                        else if vtag(base) == "a" { base = aget(vdata(base).to_int(), pend.to_int()) }
                        else { base = vundef() }
                    }
                    if tt == 38 { next(); pend = tv; next() }
                    else { next(); pend = vtostr(p_expr()); if tt == 35 { next() } }
                }
                if pend.len() > 0 and vtag(base) == "o" { odel(vdata(base).to_int(), pend) }
                return vbool(1)
            }
            // `delete someVar` on a plain binding is a no-op in sloppy mode and
            // evaluates to false; it does NOT unset the variable.
            return vbool(0)
        }
        return vbool(1)
    }
    if tt == 90 { next(); return p_unary() }
    if tt == 98 {
        next(); var val = p_unary()
        if vtag(val) == "a" { return val }
        return val
    }
    return p_post()
}

// === Postfix: member access, calls, indexing ===
fn p_post() -> string {
    var left = p_primary()
    while tt == 38 or tt == 96 or tt == 34 or tt == 30 or tt == 41 or tt == 43 {
        // ++ / --
        if tt == 41 { next(); if vtag(left) == "n" { return left } return left }
        if tt == 43 { next(); return left }
        // optional chaining ?.
        if tt == 96 {
            next()
            // `a?.b` on null/undefined yields undefined and must SKIP the rest of
            // the chain. next() has already consumed "?.", so the property name is
            // the current token: consume it here, then drop any call/index that
            // follows. (skip_chain expects to start ON the "." / "(" / "[".)
            if vtag(left) == "N" or vtag(left) == "u" {
                next()
                if tt == 30 or tt == 34 or tt == 38 { skip_chain() }
                left = vundef()
                continue
            }
            var prop = tv; next()
            left = do_member(left, prop)
            continue
        }
        // dot access
        if tt == 38 {
            next(); var prop = tv; next()
            // Reading/writing a property of null or undefined is a TypeError in JS,
            // not undefined. Raise it and stop walking the chain.
            if vtag(left) == "N" or vtag(left) == "u" {
                throw_null_prop(left, prop)
                if tt == 30 or tt == 34 or tt == 38 { skip_chain() }
                return vundef()
            }
            // Property assignment: obj.prop = expr
            if tt == 15 {
                next(); var val = p_expr()
                if vtag(left) == "o" {
                    var soid = vdata(left).to_int()
                    var setter = oget(soid, "__set_" + prop)
                    if vtag(setter) == "f" {
                        this_push(left)
                        var sargs = [""]
                        sargs = []
                        sargs.push(val)
                        callfn(setter, sargs)
                    } else { oset(soid, prop, val) }
                }
                else if vtag(left) == "s" { static_set(vdata(left), prop, val) }
                left = val; continue
            }
            // Compound property assignment: obj.prop += expr
            if tt == 42 or tt == 44 or tt == 46 {
                var aop = tt; next(); var rhs = p_expr()
                if vtag(left) == "o" {
                    var oid = vdata(left).to_int()
                    var cur = oget(oid, prop)
                    var val = vundef()
                    if aop == 42 { val = vfloat(vtofloat(cur) + vtofloat(rhs)) }
                    else if aop == 44 { val = vfloat(vtofloat(cur) - vtofloat(rhs)) }
                    else { val = vfloat(vtofloat(cur) * vtofloat(rhs)) }
                    oset(oid, prop, val)
                    left = val
                }
                continue
            }
            // ++ on property
            if tt == 41 { next(); left = do_prop_inc(left, prop); continue }
            left = do_member(left, prop)
            continue
        }
        // bracket access
        if tt == 34 {
            next(); var idx = p_expr(); if tt == 35 { next() }
            if vtag(left) == "N" or vtag(left) == "u" {
                throw_null_prop(left, vtostr(idx))
                if tt == 30 or tt == 34 or tt == 38 { skip_chain() }
                return vundef()
            }
            // Bracket assignment: obj[key] = expr
            if tt == 15 {
                next(); var val = p_expr()
                if vtag(left) == "o" { oset(vdata(left).to_int(), vtostr(idx), val) }
                else if vtag(left) == "a" { aset(vdata(left).to_int(), vtonum(idx), val) }
                left = val; continue
            }
            if vtag(left) == "a" { left = aget(vdata(left).to_int(), vtonum(idx)) }
            else if vtag(left) == "s" {
                var si = vtonum(idx)
                var sd = vdata(left)
                if si >= 0 and si < sd.len() { left = vstr(sd.substring(si, si + 1)) } else { left = vundef() }
            }
            else if vtag(left) == "o" { left = oget(vdata(left).to_int(), vtostr(idx)) }
            else { left = vundef() }
            continue
        }
        // function call
        if tt == 30 {
            next()
            var args = [""]
            args = []
            while tt != 31 and tt != 0 {
                if tt == 98 { next(); var sp = p_expr(); if vtag(sp) == "a" { var si = 0; while si < alens[vdata(sp).to_int()] { args.push(aget(vdata(sp).to_int(), si)); si = si + 1 } } else if vtag(sp) == "s" { var ss2 = vdata(sp); var ci2 = 0; while ci2 < ss2.len() { args.push(vstr(ss2.substring(ci2, ci2 + 1))); ci2 = ci2 + 1 } } else { args.push(sp) } }
                else { args.push(p_expr()) }
                if tt == 36 { next() }
            }
            if tt == 31 { next() }
            left = callfn(left, args)
            continue
        }
        break
    }
    return left
}

fn skip_chain() {
    if tt == 38 { next(); next() }
    else if tt == 30 { next(); var d = 1; while d > 0 and tt != 0 { if tt == 30 { d = d + 1 } if tt == 31 { d = d - 1 } if d > 0 { next() } } if tt == 31 { next() } }
    else if tt == 34 { next(); p_expr(); if tt == 35 { next() } }
}

fn do_prop_inc(obj: string, prop: string) -> string {
    if vtag(obj) == "o" {
        var oold = oget(vdata(obj).to_int(), prop)
        var num = vtofloat(oold) + 1.0
        oset(vdata(obj).to_int(), prop, vfloat(num))
        return oold
    }
    var sold = static_get(vdata(obj), prop)
    if vtag(sold) != "u" {
        var snum = vtofloat(sold) + 1.0
        static_set(vdata(obj), prop, vfloat(snum))
        return sold
    }
    return vundef()
}

fn static_get(cn: string, prop: string) -> string {
    var si = 0
    while si < ccnt { if cnames[si] == cn { return oget(cprotos[si], "__static_" + prop) }; si = si + 1 }
    return vundef()
}

fn static_set(cn: string, prop: string, val: string) -> int {
    var si = 0
    while si < ccnt { if cnames[si] == cn { oset(cprotos[si], "__static_" + prop, val); return 0 }; si = si + 1 }
    return 0
}

fn static_access(cn: string, prop: string) -> string {
    var si = 0
    while si < ccnt {
        if cnames[si] == cn {
            var result = oget(cprotos[si], "__static_" + prop)
            if vtag(result) == "u" { break }
            return result
        }
        si = si + 1
    }
    return "NOSTATIC"
}

fn do_member(left: string, prop: string) -> string {
    // console.log / console.error / console.warn
    if vtag(left) == "s" and vdata(left) == "_console" {
        if prop == "log" or prop == "warn" or prop == "error" { return do_console_log() }
        return vundef()
    }
    // Math builtins
    if vtag(left) == "s" and vdata(left) == "_Math" {
        if prop == "PI" { return vfloat(3.141592653589793) }
        if prop == "E" { return vfloat(2.718281828459045) }
        if prop == "SQRT2" { return vfloat(1.4142135623730951) }
        if prop == "LN2" { return vfloat(0.6931471805599453) }
        return register_builtin("_Math_" + prop)
    }
    // JSON builtins
    if vtag(left) == "s" and vdata(left) == "_JSON" {
        return register_builtin("_JSON_" + prop)
    }
    // Object builtins
    if vtag(left) == "s" and vdata(left) == "_Object" {
        return register_builtin("_Object_" + prop)
    }
    // Array builtins
    if vtag(left) == "s" and vdata(left) == "_Array" {
        return register_builtin("_Array_" + prop)
    }
    // Promise.resolve / Promise.reject / Promise.all
    if vtag(left) == "s" and vdata(left) == "_Promise" {
        if prop == "resolve" {
            if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() }
                var oid = onew()
                oset(oid, "__type__", vstr("Promise"))
                oset(oid, "__state__", vstr("fulfilled"))
                oset(oid, "__value__", v)
                return vobj(oid)
            }
            return vundef()
        }
        if prop == "reject" {
            if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() }
                var oid = onew()
                oset(oid, "__type__", vstr("Promise"))
                oset(oid, "__state__", vstr("rejected"))
                oset(oid, "__value__", v)
                return vobj(oid)
            }
            return vundef()
        }
        return vundef()
    }
    // Number methods
    if vtag(left) == "n" {
        if prop == "toString" { if tt == 30 { next(); if tt == 31 { next() } } return vstr(vdata(left)) }
        if prop == "toFixed" {
            if tt == 30 { next()
                var digits = vtonum(p_expr())
                if tt == 31 { next() }
                // toFixed ROUNDS (123.456.toFixed(2) === "123.46"); truncating
                // the decimal text gave "123.45".
                var n = vtofloat(left)
                var neg = 0
                if n < 0.0 { neg = 1; n = 0.0 - n }
                var scale = 1.0
                var si = 0
                while si < digits { scale = scale * 10.0; si = si + 1 }
                var scaled = n * scale + 0.5
                var whole = scaled.to_int()
                var ws = whole.to_string()
                var s = ""
                if digits == 0 {
                    s = ws
                } else {
                    while ws.len() <= digits { ws = "0" + ws }
                    s = ws.substring(0, ws.len() - digits) + "." + ws.substring(ws.len() - digits, ws.len())
                }
                if neg == 1 { s = "-" + s }
                return vstr(s)
            }
            return vstr(vdata(left))
        }
        return vundef()
    }
    // Static class member access
    if vtag(left) == "s" {
        var scr = static_access(vdata(left), prop)
        if scr != "NOSTATIC" { return scr }
    }
    // String methods
    if vtag(left) == "s" { return str_method(left, prop) }
    // Array methods
    if vtag(left) == "a" { return arr_method(left, prop) }
    // Object property or method
    if vtag(left) == "o" {
        var oid = vdata(left).to_int()
        // Check for Map/Set/Promise methods
        var type_val = oget(oid, "__type__")
        if vtag(type_val) == "s" {
            var ts = vdata(type_val)
            if ts == "Map" or ts == "Set" or ts == "Promise" { return map_set_method(oid, prop) }
            if ts == "Generator" {
                if prop == "next" {
                    eat_parens()
                    var ya = oget(oid, "__yields__")
                    var yi = vtonum(oget(oid, "__yidx__"))
                    var rid = onew()
                    if vtag(ya) == "a" {
                        var yaid = vdata(ya).to_int()
                        if yi < alens[yaid] {
                            oset(rid, "value", aget(yaid, yi))
                            oset(rid, "done", vbool(0))
                            oset(oid, "__yidx__", vnum(yi + 1))
                        } else {
                            oset(rid, "value", vundef())
                            oset(rid, "done", vbool(1))
                        }
                    }
                    return vobj(rid)
                }
                if prop == "return" { eat_parens(); var rid = onew(); oset(rid, "value", vundef()); oset(rid, "done", vbool(1)); return vobj(rid) }
                return vundef()
            }
            if ts == "Error" {
                if prop == "message" { return oget(oid, "message") }
                if prop == "name" { return oget(oid, "name") }
                if prop == "stack" { return vstr("") }
            }
        }
        // A getter is stored under a mangled key by p_object_literal; reading the
        // plain name must CALL it and yield the result, with `this` bound to the
        // object. Checked before the ordinary lookup so a getter always wins.
        var getter = oget(oid, "__get_" + prop)
        if vtag(getter) == "f" {
            this_push(left)
            var noargs = [""]
            noargs = []
            return callfn(getter, noargs)
        }
        var val = oget(oid, prop)
        // Object prototype methods
        if vtag(val) == "u" {
            if prop == "hasOwnProperty" { var key = vtostr(eat_args1()); if ohas(oid, key) { return vbool(1) }; return vbool(0) }
            if prop == "toString" { eat_parens(); return vstr("[object Object]") }
            if prop == "valueOf" { eat_parens(); return left }
        }
        if vtag(val) == "f" { this_push(left) }
        return val
    }
    return vundef()
}

fn do_console_log() -> string {
    if tt != 30 { return vundef() }
    next()
    var line = ""
    var first = 1
    while tt != 31 and tt != 0 {
        if first == 0 { line = line + " " }
        var v = p_expr()
        line = line + vtostr_full(v)
        first = 0
        if tt == 36 { next() }
    }
    if tt == 31 { next() }
    if noeval == 0 and overflow == 0 { print(line) }
    return vundef()
}

// === Helpers for method dispatch ===
fn eat_parens() -> int { if tt == 30 { next(); if tt == 31 { next() } }; return 0 }
fn eat_args1() -> string { if tt == 30 { next() }; var v = p_expr(); if tt == 31 { next() }; return v }
fn eat_args2() -> [string] {
    if tt == 30 { next() }
    var a = p_expr()
    if tt == 36 { next() }
    var b = p_expr()
    if tt == 31 { next() }
    // COMPILER WORKAROUND: `return [a, b]` of two local strings yields two empty
    // elements. Building the array with push() keeps the values.
    var out = [""]
    out = []
    out.push(sdup(a))
    out.push(sdup(b))
    return out
}

// === String prototype methods ===
fn str_method(left: string, prop: string) -> string {
    var s = vdata(left)
    if prop == "length" { return vnum(s.len()) }
    // Zero-arg methods
    if prop == "toUpperCase" { eat_parens(); return vstr(s.upper()) }
    if prop == "toLowerCase" { eat_parens(); return vstr(s.lower()) }
    if prop == "trim" { eat_parens(); return vstr(s.trim()) }
    if prop == "trimStart" or prop == "trimLeft" { eat_parens(); return vstr(s.trim_left()) }
    if prop == "trimEnd" or prop == "trimRight" { eat_parens(); return vstr(s.trim_right()) }
    if prop == "toString" or prop == "valueOf" { eat_parens(); return left }
    // One-arg methods
    if prop == "charAt" { var i = vtonum(eat_args1()); if i >= 0 and i < s.len() { return vstr(s.substring(i, i + 1)) }; return vstr("") }
    if prop == "at" { var i = vtonum(eat_args1()); if i < 0 { i = s.len() + i }; if i >= 0 and i < s.len() { return vstr(s.substring(i, i + 1)) }; return vundef() }
    if prop == "indexOf" { return vnum(s.index_of(vtostr(eat_args1()))) }
    if prop == "lastIndexOf" { return vnum(s.last_index_of(vtostr(eat_args1()))) }
    if prop == "search" { return vnum(s.index_of(vtostr(eat_args1()))) }
    if prop == "includes" { if s.contains(vtostr(eat_args1())) { return vbool(1) }; return vbool(0) }
    if prop == "startsWith" { if s.starts_with(vtostr(eat_args1())) { return vbool(1) }; return vbool(0) }
    if prop == "endsWith" { if s.ends_with(vtostr(eat_args1())) { return vbool(1) }; return vbool(0) }
    if prop == "repeat" { return vstr(s.repeat(vtonum(eat_args1()))) }
    if prop == "concat" { return vstr(s + vtostr(eat_args1())) }
    if prop == "match" { eat_args1(); return vnull() }
    if prop == "charCodeAt" { var i = vtonum(eat_args1()); if i >= 0 and i < s.len() { return vnum(s.substring(i, i+1).ascii()) }; return vstr("NaN") }
    if prop == "slice" or prop == "substring" {
        if tt == 30 { next()
            var start = vtonum(p_expr())
            var end_val = s.len()
            if tt == 36 { next(); end_val = vtonum(p_expr()) }
            if tt == 31 { next() }
            if start < 0 { start = s.len() + start; if start < 0 { start = 0 } }
            if end_val < 0 { end_val = s.len() + end_val }
            if start > s.len() { start = s.len() }
            if end_val > s.len() { end_val = s.len() }
            if start > end_val { return vstr("") }
            return vstr(s.substring(start, end_val))
        }
        return vundef()
    }
    if prop == "split" { var delim = vtostr(eat_args1()); var parts = s.split(delim); var aid = anew(); for p in parts { apush(aid, vstr(p)) }; return varr(aid) }
    if prop == "replace" { var args = eat_args2(); var old_s = vtostr(args[0]); var new_s = vtostr(args[1]); var idx = s.index_of(old_s); if idx >= 0 { return vstr(s.substring(0, idx) + new_s + s.substring(idx + old_s.len(), s.len())) }; return left }
    if prop == "replaceAll" { var args = eat_args2(); return vstr(s.replace(vtostr(args[0]), vtostr(args[1]))) }
    if prop == "padStart" { if tt == 30 { next(); var w = vtonum(p_expr()); var pad = " "; if tt == 36 { next(); pad = vtostr(p_expr()) }; if tt == 31 { next() }; while s.len() < w { s = pad + s }; return vstr(s) }; return vundef() }
    if prop == "padEnd" { if tt == 30 { next(); var w = vtonum(p_expr()); var pad = " "; if tt == 36 { next(); pad = vtostr(p_expr()) }; if tt == 31 { next() }; while s.len() < w { s = s + pad }; return vstr(s) }; return vundef() }
    if prop == "toFixed" {
        if tt == 30 { next()
            var digits = vtonum(p_expr())
            if tt == 31 { next() }
            var ns = vtofloat(left).to_string()
            var dot = ns.index_of(".")
            if dot < 0 { ns = ns + "."; dot = ns.len() - 1 }
            var dec_len = ns.len() - dot - 1
            while dec_len < digits { ns = ns + "0"; dec_len = dec_len + 1 }
            if dec_len > digits { ns = ns.substring(0, dot + 1 + digits) }
            return vstr(ns)
        }
        return vstr(vdata(left))
    }
    return vundef()
}

// === Array prototype methods ===
fn arr_method(left: string, prop: string) -> string {
    var id = vdata(left).to_int()
    if prop == "length" { return vnum(alens[id]) }
    if prop == "push" { if tt == 30 { next(); while tt != 31 and tt != 0 { apush(id, p_expr()); if tt == 36 { next() } } if tt == 31 { next() } return vnum(alens[id]) } return vundef() }
    if prop == "pop" { if tt == 30 { next(); if tt == 31 { next() } } if alens[id] > 0 { var v = aget(id, alens[id] - 1); alens[id] = alens[id] - 1; return v } return vundef() }
    if prop == "at" { if tt == 30 { next(); var ai = vtonum(p_expr()); if tt == 31 { next() } if ai < 0 { ai = alens[id] + ai }; return aget(id, ai) } return vundef() }
    if prop == "shift" { if tt == 30 { next(); if tt == 31 { next() } } if alens[id] > 0 { var v = aget(id, 0); var i = 0; while i < alens[id] - 1 { aset(id, i, aget(id, i + 1)); i = i + 1 } alens[id] = alens[id] - 1; return v } return vundef() }
    if prop == "unshift" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } apush(id, vundef()); var i = alens[id] - 1; while i > 0 { aset(id, i, aget(id, i - 1)); i = i - 1 } aset(id, 0, v); return vnum(alens[id]) } return vundef() }
    if prop == "indexOf" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } var i = 0; while i < alens[id] { if vtostr(aget(id, i)) == vtostr(v) { return vnum(i) } i = i + 1 } return vnum(-1) } return vundef() }
    if prop == "includes" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } var i = 0; while i < alens[id] { if vtostr(aget(id, i)) == vtostr(v) { return vbool(1) } i = i + 1 } return vbool(0) } return vundef() }
    if prop == "join" { if tt == 30 { next(); var sep = vtostr(p_expr()); if tt == 31 { next() } var r = ""; var i = 0; while i < alens[id] { if i > 0 { r = r + sep } r = r + vtostr(aget(id, i)); i = i + 1 } return vstr(r) } return vundef() }
    if prop == "reverse" { if tt == 30 { next(); if tt == 31 { next() } } var i = 0; var j = alens[id] - 1; while i < j { var tmp = aget(id, i); aset(id, i, aget(id, j)); aset(id, j, tmp); i = i + 1; j = j - 1 } return left }
    if prop == "concat" {
        if tt == 30 { next()
            var nid = acopy(id)
            while tt != 31 and tt != 0 {
                var arg = p_expr()
                if vtag(arg) == "a" { var ai = 0; var aid2 = vdata(arg).to_int(); while ai < alens[aid2] { apush(nid, aget(aid2, ai)); ai = ai + 1 } }
                else { apush(nid, arg) }
                if tt == 36 { next() }
            }
            if tt == 31 { next() }
            return varr(nid)
        }
        return vundef()
    }
    if prop == "slice" {
        if tt == 30 { next()
            var start = 0
            var end = alens[id]
            if tt != 31 { start = vtonum(p_expr()); if tt == 36 { next(); end = vtonum(p_expr()) } }
            if tt == 31 { next() }
            if start < 0 { start = alens[id] + start; if start < 0 { start = 0 } }
            if end < 0 { end = alens[id] + end }
            var nid = anew()
            var i = start
            while i < end and i < alens[id] { apush(nid, aget(id, i)); i = i + 1 }
            return varr(nid)
        }
        return vundef()
    }
    if prop == "splice" {
        if tt == 30 { next()
            var start = vtonum(p_expr()); var del = alens[id] - start
            if tt == 36 { next(); del = vtonum(p_expr()) }
            var inserts = [""]
            inserts = []
            while tt == 36 { next(); inserts.push(p_expr()) }
            if tt == 31 { next() }
            var removed = anew()
            var i = 0; while i < del and start + i < alens[id] { apush(removed, aget(id, start + i)); i = i + 1 }
            // Rebuild: keep [0..start], add inserts, add [start+del..]
            var nid = anew()
            i = 0; while i < start { apush(nid, aget(id, i)); i = i + 1 }
            for ins in inserts { apush(nid, ins) }
            i = start + del; while i < alens[id] { apush(nid, aget(id, i)); i = i + 1 }
            // Copy back
            alens[id] = alens[nid]; abases[id] = abases[nid]
            return varr(removed)
        }
        return vundef()
    }
    if prop == "map" { return arr_hof(id, "map") }
    if prop == "filter" { return arr_hof(id, "filter") }
    if prop == "reduce" { return arr_hof(id, "reduce") }
    if prop == "forEach" { return arr_hof(id, "forEach") }
    if prop == "flatMap" { return arr_hof(id, "flatMap") }
    if prop == "find" { return arr_hof(id, "find") }
    if prop == "findIndex" { return arr_hof(id, "findIndex") }
    if prop == "findLast" { return arr_hof(id, "findLast") }
    if prop == "findLastIndex" { return arr_hof(id, "findLastIndex") }
    if prop == "some" { return arr_hof(id, "some") }
    if prop == "every" { return arr_hof(id, "every") }
    if prop == "flat" {
        if tt == 30 { next(); if tt != 31 { p_expr() }; if tt == 31 { next() } }
        var felems: [string] = []
        var i = 0
        while i < alens[id] {
            var elem = aget(id, i)
            if vtag(elem) == "a" {
                var sid = vdata(elem).to_int()
                var j = 0
                while j < alens[sid] { felems.push(aget(sid, j)); j = j + 1 }
            } else { felems.push(elem) }
            i = i + 1
        }
        var nid = anew()
        for fe in felems { apush(nid, fe) }
        return varr(nid)
    }
    if prop == "fill" {
        if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } var i = 0; while i < alens[id] { aset(id, i, v); i = i + 1 } return left }
        return vundef()
    }
    if prop == "sort" {
        if tt == 30 { next()
            var has_fn = 0
            var cmp_fn = vundef()
            if tt != 31 { cmp_fn = p_expr(); has_fn = 1 }
            if tt == 31 { next() }
            // Simple bubble sort
            var n = alens[id]
            var i = 0
            while i < n {
                var j = 0
                while j < n - 1 - i {
                    var a = aget(id, j)
                    var b = aget(id, j + 1)
                    var swap = 0
                    if has_fn == 1 {
                        var r = callfn(cmp_fn, [a, b])
                        if vtonum(r) > 0 { swap = 1 }
                    } else {
                        if vtostr(a) > vtostr(b) { swap = 1 }
                    }
                    if swap == 1 { aset(id, j, b); aset(id, j + 1, a) }
                    j = j + 1
                }
                i = i + 1
            }
            return left
        }
        return vundef()
    }
    if prop == "isArray" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } if vtag(v) == "a" { return vbool(1) } return vbool(0) } return vundef() }
    return vundef()
}

fn arr_hof(id: int, method: string) -> string {
    if tt != 30 { return vundef() }
    next()
    var callback = p_expr()
    var init_val = vundef()
    if method == "reduce" and tt == 36 { next(); init_val = p_expr() }
    if tt == 31 { next() }
    if method == "map" {
        var results: [string] = []
        var i = 0
        while i < alens[id] { results.push(callfn2(callback, aget(id, i), vnum(i))); i = i + 1 }
        var nid = anew()
        for r in results { apush(nid, r) }
        return varr(nid)
    }
    if method == "filter" {
        var results: [string] = []
        var i = 0
        while i < alens[id] { var v = aget(id, i); if vtruthy(callfn2(callback, v, vnum(i))) == 1 { results.push(v) }; i = i + 1 }
        var nid = anew()
        for r in results { apush(nid, r) }
        return varr(nid)
    }
    if method == "reduce" {
        var acc = init_val
        var start = 0
        if vtag(acc) == "u" { acc = aget(id, 0); start = 1 }
        var i = start
        while i < alens[id] { acc = callfn2(callback, acc, aget(id, i)); i = i + 1 }
        return acc
    }
    if method == "forEach" { var i = 0; while i < alens[id] { callfn2(callback, aget(id, i), vnum(i)); i = i + 1 } return vundef() }
    if method == "flatMap" {
        var fmelems: [string] = []
        var i = 0
        while i < alens[id] {
            var result = callfn2(callback, aget(id, i), vnum(i))
            if vtag(result) == "a" {
                var sid = vdata(result).to_int()
                var j = 0
                while j < alens[sid] { fmelems.push(aget(sid, j)); j = j + 1 }
            } else { fmelems.push(result) }
            i = i + 1
        }
        var nid = anew()
        for fme in fmelems { apush(nid, fme) }
        return varr(nid)
    }
    if method == "find" { var i = 0; while i < alens[id] { var v = aget(id, i); if vtruthy(callfn2(callback, v, vnum(i))) == 1 { return v } i = i + 1 } return vundef() }
    if method == "findIndex" { var i = 0; while i < alens[id] { if vtruthy(callfn2(callback, aget(id, i), vnum(i))) == 1 { return vnum(i) } i = i + 1 } return vnum(-1) }
    if method == "findLast" { var i = alens[id] - 1; while i >= 0 { var v = aget(id, i); if vtruthy(callfn2(callback, v, vnum(i))) == 1 { return v } i = i - 1 } return vundef() }
    if method == "findLastIndex" { var i = alens[id] - 1; while i >= 0 { if vtruthy(callfn2(callback, aget(id, i), vnum(i))) == 1 { return vnum(i) } i = i - 1 } return vnum(-1) }
    if method == "some" { var i = 0; while i < alens[id] { if vtruthy(callfn2(callback, aget(id, i), vnum(i))) == 1 { return vbool(1) } i = i + 1 } return vbool(0) }
    if method == "every" { var i = 0; while i < alens[id] { if vtruthy(callfn2(callback, aget(id, i), vnum(i))) == 0 { return vbool(0) } i = i + 1 } return vbool(1) }
    return vundef()
}

// === Simple JSON serializer/deserializer ===
fn json_ser(v: string) -> string {
    var t = vtag(v)
    // vtostr, not vdata: a whole number produced by ARITHMETIC carries a ".0"
    // (`[1,2].map(x => x*2)` -> "2.0"), and JS has one number type, so
    // JSON.stringify must print 2, not 2.0. A literal 2 was already fine, which is
    // why this only showed up on computed values.
    if t == "n" { return vtostr(v) }
    if t == "s" { return "\"" + vdata(v).replace("\"", "\\\"") + "\"" }
    if t == "b" { return vdata(v) }
    if t == "N" { return "null" }
    if t == "u" { return "undefined" }
    if t == "a" {
        var id = vdata(v).to_int()
        var r = "["
        var i = 0
        while i < alens[id] { if i > 0 { r = r + "," } r = r + json_ser(aget(id, i)); i = i + 1 }
        return r + "]"
    }
    if t == "o" {
        var id = vdata(v).to_int()
        var r = "{"
        var ks = okeys(id)
        var first = 1
        for k in ks {
            // Getters are stored mangled ("__get_b"). Serialize them under their real
            // name with the COMPUTED value, as node does; setters have no readable
            // value and are omitted.
            if k.starts_with("__set_") { continue }
            // Private fields are not serialized, and neither is the interpreter's own
            // "__class__" bookkeeping - node prints {"p":1}, not {"p":1,"__class__":"A"}.
            if k.starts_with("#") { continue }
            if k.starts_with("__") and not k.starts_with("__get_") { continue }
            var kname = sdup(k)
            var kval = oget_own(id, k)
            if k.starts_with("__get_") {
                kname = k.substring(6, k.len())
                if vtag(kval) == "f" {
                    var gargs: [string] = []
                    // `this` must be the object being serialized, or a getter reading
                    // this._n faults.
                    this_push(v)
                    kval = callfn(kval, gargs)
                }
            }
            if first == 0 { r = r + "," }
            r = r + "\"" + kname + "\":" + json_ser(kval)
            first = 0
        }
        return r + "}"
    }
    return "null"
}

jstr = ""
jpos = 0

fn json_deser(s: string) -> string {
    jstr = sdup(s); jpos = 0
    return jparse()
}

fn jskip() { while jpos < jstr.len() { var c = jstr.substring(jpos, jpos + 1); if c == " " or c == "\n" or c == "\r" or c == "\t" { jpos = jpos + 1 } else { return } } }
fn jch() -> string { if jpos >= jstr.len() { return "" } return jstr.substring(jpos, jpos + 1) }

fn jparse() -> string {
    jskip()
    var c = jch()
    if c == "\"" { return jparse_str() }
    if c == "{" { return jparse_obj() }
    if c == "[" { return jparse_arr() }
    if c == "t" { jpos = jpos + 4; return vbool(1) }
    if c == "f" { jpos = jpos + 5; return vbool(0) }
    if c == "n" { jpos = jpos + 4; return vnull() }
    var n = ""
    while jpos < jstr.len() { c = jch(); if DIGITS.contains(c) or c == "." or c == "-" or c == "e" or c == "E" or c == "+" { n = n + c; jpos = jpos + 1 } else { break } }
    if n.contains(".") { return vfloat(n.to_float()) }
    return vnum(n.to_int())
}

fn jparse_str() -> string {
    jpos = jpos + 1
    var s = ""
    while jpos < jstr.len() {
        var c = jch()
        if c == "\"" { jpos = jpos + 1; return vstr(s) }
        if c == "\\" { jpos = jpos + 1; var e = jch(); jpos = jpos + 1; if e == "n" { s = s + "\n" } else if e == "\"" { s = s + "\"" } else { s = s + e } }
        else { s = s + c; jpos = jpos + 1 }
    }
    return vstr(s)
}

fn jparse_obj() -> string {
    jpos = jpos + 1; jskip()
    var oid = onew()
    if jch() == "}" { jpos = jpos + 1; return vobj(oid) }
    while jpos < jstr.len() {
        jskip()
        var key = vdata(jparse_str())
        jskip(); jpos = jpos + 1; jskip()
        oset(oid, key, jparse())
        jskip()
        if jch() == "," { jpos = jpos + 1 } else { break }
    }
    jskip(); if jch() == "}" { jpos = jpos + 1 }
    return vobj(oid)
}

fn jparse_arr() -> string {
    jpos = jpos + 1; jskip()
    var aid = anew()
    if jch() == "]" { jpos = jpos + 1; return varr(aid) }
    while jpos < jstr.len() {
        jskip()
        apush(aid, jparse())
        jskip()
        if jch() == "," { jpos = jpos + 1 } else { break }
    }
    jskip(); if jch() == "]" { jpos = jpos + 1 }
    return varr(aid)
}

// === Built-in objects: Math, JSON, Object, Number, parseInt, etc. ===
fn call_builtin(name: string, args: [string]) -> string {
    // Math
    if name == "_Math_floor" { return vnum(Math.floor(vtofloat(args[0])).to_int()) }
    if name == "_Math_ceil" { return vnum(Math.ceil(vtofloat(args[0])).to_int()) }
    // JS Math.round is "round half UP toward +Infinity": round(2.5)==3,
    // round(-2.5)==-2. floor(x + 0.5) gives exactly that.
    if name == "_Math_round" { return vnum(Math.floor(vtofloat(args[0]) + 0.5).to_int()) }
    if name == "_Math_abs" { var v = vtofloat(args[0]); if v < 0.0 { return vfloat(0.0 - v) } return vfloat(v) }
    if name == "_Math_sqrt" { return vfloat(Math.sqrt(vtofloat(args[0]))) }
    if name == "_Math_pow" { return vfloat(Math.pow(vtofloat(args[0]), vtofloat(args[1]))) }
    if name == "_Math_min" {
        if args.len() == 0 { return vstr("Infinity") }
        var r = vtofloat(args[0])
        var i = 1
        while i < args.len() { var v = vtofloat(args[i]); if v < r { r = v } i = i + 1 }
        return vfloat(r)
    }
    if name == "_Math_max" {
        if args.len() == 0 { return vstr("-Infinity") }
        var r = vtofloat(args[0])
        var i = 1
        while i < args.len() { var v = vtofloat(args[i]); if v > r { r = v } i = i + 1 }
        return vfloat(r)
    }
    if name == "_Math_random" { return vfloat(Math.random()) }
    if name == "_Math_log" { return vfloat(Math.log(vtofloat(args[0]))) }
    if name == "_Math_sin" { return vfloat(Math.sin(vtofloat(args[0]))) }
    if name == "_Math_cos" { return vfloat(Math.cos(vtofloat(args[0]))) }
    if name == "_Math_tan" { return vfloat(Math.tan(vtofloat(args[0]))) }
    if name == "_Math_trunc" { return vnum(Math.floor(vtofloat(args[0])).to_int()) }
    // JSON
    if name == "_JSON_stringify" {
        return vstr(json_ser(args[0]))
    }
    if name == "_JSON_parse" {
        return json_deser(vtostr(args[0]))
    }
    // parseInt / parseFloat / Number / String / Boolean / isNaN / isFinite
    if name == "_parseInt" {
        var pi = num_prefix(vtostr(args[0]))
        if pi == "" { return vstr("NaN") }
        return vnum(pi.to_float().to_int())
    }
    if name == "_parseFloat" {
        var pf = num_prefix(vtostr(args[0]))
        if pf == "" { return vstr("NaN") }
        return vfloat(pf.to_float())
    }
    if name == "_Number" {
        // Number("") is 0 in JS, but Number("abc") is NaN - so an empty STRING is
        // not the same as no digits.
        var ns = vtostr(args[0])
        if vtag(args[0]) == "s" and ns.trim() != "" and num_prefix(ns) == "" { return vstr("NaN") }
        return vfloat(vtofloat(args[0]))
    }
    if name == "_String" { return vstr(vtostr(args[0])) }
    if name == "_Boolean" { return vbool(vtruthy(args[0])) }
    if name == "_isNaN" { var s = vtostr(args[0]); if s == "NaN" or s == "undefined" { return vbool(1) } return vbool(0) }
    if name == "_isFinite" { return vbool(1) }
    // Array.isArray
    if name == "_Array_isArray" { if vtag(args[0]) == "a" { return vbool(1) } return vbool(0) }
    if name == "_Array_of" {
        var aid = anew()
        for a in args { apush(aid, a) }
        return varr(aid)
    }
    // Array.from
    if name == "_Array_from" {
        var elems: [string] = []
        if vtag(args[0]) == "s" {
            var s = vdata(args[0])
            var i = 0
            while i < s.len() { elems.push(vstr(s.substring(i, i + 1))); i = i + 1 }
        } else if vtag(args[0]) == "a" {
            var sid = vdata(args[0]).to_int()
            var i = 0
            while i < alens[sid] { elems.push(aget(sid, i)); i = i + 1 }
        }
        var aid = anew()
        for e in elems { apush(aid, e) }
        return varr(aid)
    }
    // Object.keys / values / entries / assign / freeze
    if name == "_Object_keys" { if vtag(args[0]) == "o" { return varr(okeys_arr(vdata(args[0]).to_int())) } return varr(anew()) }
    if name == "_Object_values" {
        if vtag(args[0]) == "o" {
            var oid: int = vdata(args[0]).to_int()
            var aid = anew()
            var ks = okeys(oid)
            for k in ks { apush(aid, oget_own(oid, k)) }
            return varr(aid)
        }
        return varr(anew())
    }
    if name == "_Object_entries" {
        if vtag(args[0]) == "o" {
            var oid: int = vdata(args[0]).to_int()
            var ks = okeys(oid)
            // BUILD EVERY PAIR FIRST, THEN THE OUTER ARRAY.
            //
            // astore is a BUMP allocator: anew() pins abases[id] = anext and apush
            // advances the shared anext. So two arrays being filled at the same time
            // INTERLEAVE in one region: allocating the outer array up front and then
            // pushing to a pair, then to the outer, then to the next pair, made the
            // outer array's slots overlap the pairs. e[0][0] came back as the PAIR
            // ITSELF (typeof "object", length 2) instead of the key, and any string
            // USE of it - console.log, concatenation - then recursed until the stack
            // overflowed. Reading it was fine, which is why this looked like a printing
            // bug; `k.length` returning 2 for the key "a" is what gave it away.
            //
            // Each pair is therefore completed before the next allocation happens, and
            // the outer array is allocated only once every pair is closed.
            var pairs: [string] = []
            for k in ks {
                var pair = anew()
                apush(pair, vstr(k))
                apush(pair, oget_own(oid, k))
                pairs.push(varr(pair))
            }
            var aid = anew()
            for pv in pairs { apush(aid, pv) }
            return varr(aid)
        }
        return varr(anew())
    }
    if name == "_Object_assign" {
        if args.len() >= 2 and vtag(args[0]) == "o" {
            var tid: int = vdata(args[0]).to_int()
            var i: int = 1
            while i < args.len() {
                if vtag(args[i]) == "o" {
                    var sid: int = vdata(args[i]).to_int()
                    var sks = okeys(sid)
                    for sk in sks { oset(tid, sk, oget_own(sid, sk)) }
                }
                i = i + 1
            }
            return args[0]
        }
        return args[0]
    }
    if name == "_Object_freeze" { return args[0] }
    if name == "_Object_fromEntries" {
        var oid = onew()
        if vtag(args[0]) == "a" {
            var aid = vdata(args[0]).to_int()
            var i = 0
            while i < alens[aid] {
                var entry = aget(aid, i)
                if vtag(entry) == "a" {
                    var eid = vdata(entry).to_int()
                    if alens[eid] >= 2 { oset(oid, vtostr(aget(eid, 0)), aget(eid, 1)) }
                }
                i = i + 1
            }
        }
        return vobj(oid)
    }
    if name == "_Object_create" {
        var oid = onew()
        if vtag(args[0]) == "o" { oprotos[oid] = vdata(args[0]).to_int() }
        return vobj(oid)
    }
    if name == "_Object_getPrototypeOf" {
        if vtag(args[0]) == "o" {
            var oid = vdata(args[0]).to_int()
            if oprotos[oid] >= 0 { return vobj(oprotos[oid]) }
        }
        return vnull()
    }
    if name == "_noop" { return vundef() }
    return vundef()
}

// === Function calling with this binding ===
fn callfn(callee: string, args: [string]) -> string {
    if noeval > 0 or overflow == 1 { return vundef() }
    if vtag(callee) != "f" { return vundef() }
    var fid = vdata(callee).to_int()
    // Builtin dispatch (no depth accounting - builtins do not recurse into
    // p_block_body, and they return early, which would leak the counter).
    if fid >= 9000 {
        var bidx = fid - 9000
        if bidx >= 0 and bidx < bcnt { return call_builtin(bnames[bidx], args) }
        return vundef()
    }
    if call_depth >= MAX_CALL_DEPTH { overflow = 1; return vundef() }
    call_depth = call_depth + 1
    // A local that merely ALIASES a global array element is released at
    // function exit, freeing the element -> the 2nd call to the same JS function
    // read a dangling body. sdup() forces a private copy.
    var psrc = sdup(fparams[fid])
    var bsrc = sdup(fbodies[fid])
    var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
    epush()
    // Bind this
    if this_depth > 0 {
        var t = this_stack[this_depth - 1]
        if vtag(t) != "u" { edef("this", t) }
        this_pop()
    }
    // Bind params
    if psrc.len() > 0 {
        var ps = psrc.split(",")
        for i in 0..ps.len() {
            var pname = ps[i].trim()
            if pname.len() > 0 {
                // Check for default value: "param=defaultSrc"
                var eq_pos = pname.index_of("=")
                if eq_pos > 0 {
                    var real_name = pname.substring(0, eq_pos)
                    if i < args.len() and vtag(args[i]) != "u" { edef(real_name, args[i]) }
                    else {
                        // Evaluate default
                        var dsrc = pname.substring(eq_pos + 1, pname.len())
                        var ds = sdup(src); var dp = pos; var dt = tt; var dv = sdup(tv)
                        src = sdup(dsrc); pos = 0; next()
                        var dval = p_expr()
                        src = sdup(ds); pos = dp; tt = dt; tv = sdup(dv)
                        edef(real_name, dval)
                    }
                } else if pname.starts_with("...") {
                    // Rest parameter: collect remaining args into array
                    var rest_name = pname.substring(3, pname.len())
                    var rest_id = anew()
                    var ri = i
                    while ri < args.len() { apush(rest_id, args[ri]); ri = ri + 1 }
                    edef(rest_name, varr(rest_id))
                } else if pname.starts_with("[") or pname.starts_with("{") {
                    // A DESTRUCTURING parameter - `function f([a,b])`, `({x}) => x`.
                    // The params string is split on ",", so the pattern's own commas
                    // are stored as "|" and restored here; a "|" cannot appear in a
                    // pattern of identifiers, and the encoding is confined to the
                    // params string.
                    var pat_src = pname.replace("|", ",")
                    var argv = vundef()
                    if i < args.len() { argv = args[i] }
                    if pat_src.starts_with("[") {
                        bind_arr_pattern(pat_src.substring(1, pat_src.len() - 1), argv)
                    } else {
                        bind_obj_pattern(obj_pattern_names(pat_src.substring(1, pat_src.len() - 1)), argv)
                    }
                } else {
                    if i < args.len() { edef(pname, args[i]) }
                    else { edef(pname, vundef()) }
                }
            }
        }
    }
    // Bind `arguments` to the actual argument list. It used to be bound to
    // undefined, so `arguments.length` read as undefined; once property access on
    // undefined started throwing, that silent wrong answer became a loud TypeError,
    // so bind the real thing.
    // Only materialise it when the body actually mentions `arguments`: allocating an
    // array on EVERY call exhausts the fixed array pool under deep recursion (fib(20)
    // turned into a spurious RangeError).
    if bsrc.contains("arguments") {
        var argid = anew()
        var ai = 0
        while ai < args.len() { apush(argid, args[ai]); ai = ai + 1 }
        edef("arguments", varr(argid))
    } else { edef("arguments", vundef()) }
    // Restore closure captures BEFORE param binding so params take precedence
    restore_captures(fid)
    // Re-bind params to override any captured values with same name
    if psrc.len() > 0 {
        var ps2 = psrc.split(",")
        for i in 0..ps2.len() {
            var pname2 = ps2[i].trim()
            // Strip default value
            var eq2 = pname2.index_of("=")
            if eq2 > 0 { pname2 = pname2.substring(0, eq2) }
            if pname2.len() > 0 {
                if i < args.len() { edef(pname2, args[i]) }
            }
        }
    }
    src = sdup(bsrc); pos = 0; retflag = 0; next()
    p_block_body()
    var result = sdup(retval)
    if retflag == 0 { result = vundef() }
    retflag = 0
    // Save modified captures back
    // The values as they were at ENTRY, so the write-back can tell a real change
    // from an untouched capture.
    var cap_before = sdup(fcap_vals[fid])
    save_captures(fid)
    epop()
    writeback_captures(fid, cap_before)
    src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
    call_depth = call_depth - 1
    return result
}

// === Builtin registry ===
fn register_builtin(name: string) -> string {
    // Check if already registered
    var i = 0
    while i < bcnt { if bnames[i] == name { return "f:" + (9000 + i).to_string() } i = i + 1 }
    bnames[bcnt] = sdup(name)
    var fid = 9000 + bcnt
    bcnt = bcnt + 1
    return "f:" + fid.to_string()
}

// Bind the first two parameters of a params string to two values. Used by callfn2,
// the fast path for the array HOFs (map/filter/reduce/...), which is why it exists
// separately from callfn's general loop. It must understand a DESTRUCTURING parameter
// or `.map(([k,v]) => ...)` binds nothing - the shape Object.entries() feeds.
fn bind_two_params(psrc: string, a0: string, a1: string) {
    if psrc.len() == 0 { return }
    var ps = psrc.split(",")
    if ps.len() > 0 { var pn = ps[0].trim(); if pn.len() > 0 { bind_one_param(pn, a0) } }
    if ps.len() > 1 { var pn = ps[1].trim(); if pn.len() > 0 { bind_one_param(pn, a1) } }
}

// Bind ONE parameter spelling to one value: a destructuring pattern, or a plain name
// (with any `=default` suffix stripped, since the value is supplied here).
fn bind_one_param(pn: string, av: string) {
    if pn.starts_with("[") or pn.starts_with("{") {
        var pat = pn.replace("|", ",")
        if pat.starts_with("[") { bind_arr_pattern(pat.substring(1, pat.len() - 1), av) }
        else { bind_obj_pattern(obj_pattern_names(pat.substring(1, pat.len() - 1)), av) }
        return
    }
    var nm = sdup(pn)
    var eqp = nm.index_of("=")
    if eqp > 0 { nm = nm.substring(0, eqp) }
    edef(nm, av)
}

fn callfn2(callee: string, a0: string, a1: string) -> string {
    if noeval > 0 or overflow == 1 { return vundef() }
    if vtag(callee) != "f" { return vundef() }
    var fid = vdata(callee).to_int()
    if fid >= 9000 { var bidx = fid - 9000; if bidx >= 0 and bidx < bcnt { return call_builtin(bnames[bidx], [a0, a1]) } return vundef() }
    if call_depth >= MAX_CALL_DEPTH { overflow = 1; return vundef() }
    call_depth = call_depth + 1
    // A local that merely ALIASES a global array element is released at
    // function exit, freeing the element -> the 2nd call to the same JS function
    // read a dangling body. sdup() forces a private copy.
    var psrc = sdup(fparams[fid])
    var bsrc = sdup(fbodies[fid])
    var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
    epush()
    if this_depth > 0 { var t = this_stack[this_depth - 1]; if vtag(t) != "u" { edef("this", t) } this_pop() }
    bind_two_params(psrc, a0, a1)
    edef("arguments", vundef())
    restore_captures(fid)
    // Re-bind params to override captured values
    bind_two_params(psrc, a0, a1)
    src = sdup(bsrc); pos = 0; retflag = 0; next()
    p_block_body()
    var result = sdup(retval)
    if retflag == 0 { result = vundef() }
    retflag = 0
    // The values as they were at ENTRY, so the write-back can tell a real change
    // from an untouched capture.
    var cap_before = sdup(fcap_vals[fid])
    save_captures(fid)
    epop()
    writeback_captures(fid, cap_before)
    src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
    call_depth = call_depth - 1
    return result
}

// === Primary expressions ===
fn p_primary() -> string {
    // Number
    if tt == 1 {
        var v = tv; next()
        if v.contains(".") { return vfloat(v.to_float()) }
        return vnum(v.to_int())
    }
    // String
    if tt == 2 { var v = tv; next(); return vstr(v) }
    // Boolean
    if tt == 4 { var v = tv; next(); if v == "true" { return vbool(1) } return vbool(0) }
    // null
    if tt == 5 { next(); return vnull() }
    // undefined
    if tt == 6 { next(); return vundef() }
    // this
    if tt == 72 { next(); return eget("this") }
    // super
    if tt == 74 {
        next()
        // super(...) = call parent constructor
        if tt == 30 {
            next()
            var args = [""]
            args = []
            while tt != 31 and tt != 0 { args.push(p_expr()); if tt == 36 { next() } }
            if tt == 31 { next() }
            // Find parent class constructor and call it with current this
            var cur_this = eget("this")
            if vtag(cur_this) == "o" {
                var oid = vdata(cur_this).to_int()
                var cls = vtostr(oget(oid, "__class__"))
                // Find class id
                var ci = 0
                while ci < ccnt { if cnames[ci] == cls { break } ci = ci + 1 }
                if ci < ccnt and cparents[ci] >= 0 {
                    var pid = cparents[ci]
                    if cconstructors[pid] >= 0 {
                        this_push(cur_this)
                        callfn(vfn(cconstructors[pid]), args)
                    }
                }
            }
            return vundef()
        }
        // super.method()
        if tt == 38 { next(); var prop = tv; next(); return eget("this") }
        return vundef()
    }
    // new
    if tt == 71 {
        next()
        var cls_name = tv; next()
        // new Map(), new Set(), new Error(), new RegExp()
        if cls_name == "Map" { return new_map() }
        if cls_name == "Set" { return new_set() }
        if cls_name == "WeakMap" or cls_name == "WeakSet" or cls_name == "WeakRef" {
            if tt == 30 { next(); if tt != 31 { p_expr() }; if tt == 31 { next() } }
            var oid = onew()
            oset(oid, "__type__", vstr(cls_name))
            return vobj(oid)
        }
        if cls_name == "Proxy" {
            if tt == 30 { next()
                var target = p_expr()
                if tt == 36 { next() }
                var handler = p_expr()
                if tt == 31 { next() }
                // Create proxy: store target and handler
                var oid = onew()
                oset(oid, "__type__", vstr("Proxy"))
                oset(oid, "__target__", target)
                oset(oid, "__handler__", handler)
                return vobj(oid)
            }
            return vundef()
        }
        if cls_name == "Error" or cls_name == "TypeError" or cls_name == "RangeError" or cls_name == "SyntaxError" or cls_name == "ReferenceError" or cls_name == "URIError" or cls_name == "EvalError" {
            var oid = onew()
            oset(oid, "__type__", vstr("Error"))
            oset(oid, "name", vstr(cls_name))
            if tt == 30 { next(); if tt != 31 { oset(oid, "message", p_expr()) }; if tt == 31 { next() } }
            oset(oid, "stack", vstr(""))
            return vobj(oid)
        }
        if cls_name == "RegExp" { return new_regexp() }
        if cls_name == "Promise" { return new_promise() }
        // User-defined class
        return new_class(cls_name)
    }
    // Template literal
    if tt == 61 {
        var result = tv
        // pos is right after ${ - we need to parse the expression
        next()
        while true {
            var inner = p_expr()
            result = result + vtostr(inner)
            // tt should be 33 (}) - don't call next(), just advance pos manually
            if tt == 33 {
                // Read raw text after } until ` or ${
                var more = ""
                while pos < src.len() {
                    var c = ch()
                    if c == "`" { pos = pos + 1; next(); return vstr(result + more) }
                    if c == "$" {
                        if pos + 1 < src.len() and src.substring(pos + 1, pos + 2) == "{" {
                            pos = pos + 2; next()
                            result = result + more
                            more = ""
                            // Parse next expression
                            inner = p_expr()
                            result = result + vtostr(inner)
                            continue
                        }
                    }
                    more = more + c; pos = pos + 1
                }
                result = result + more
                next()
                return vstr(result)
            }
            break
        }
        return vstr(result)
    }
    // Parens or arrow
    if tt == 30 {
        next()
        if tt == 31 { next(); if tt == 40 { next(); return p_arrow("") } return vundef() }
        // `([a,b]) => ...` / `({x}) => ...`. A pattern parameter must be recognised
        // BEFORE the identifier path below, which only handles plain names; without
        // this the arrow was re-parsed as a parenthesised expression and the pattern
        // names all bound to undefined.
        if tt == 34 or tt == 32 {
            var psp = pos
            var ptt = tt
            var ptv = sdup(tv)
            var pparams = ""
            var pok = 1
            while pok == 1 {
                if tt == 34 or tt == 32 {
                    if pparams.len() > 0 { pparams = pparams + "," }
                    pparams = pparams + capture_param_pattern()
                } else if tt == 3 or tt == 98 {
                    if pparams.len() > 0 { pparams = pparams + "," }
                    if tt == 98 { next(); pparams = pparams + "..." + tv } else { pparams = pparams + tv }
                    next()
                    // A plain parameter AFTER a leading pattern may carry a default -
                    // `([a], y = 5) => ...`. Same `name=default` encoding the other
                    // two param paths use, so callfn needs no special case.
                    if tt == 15 {
                        next()
                        if tt == 2 { pparams = pparams + "=\"" + tv + "\""; next() }
                        else if tt == 1 or tt == 4 { pparams = pparams + "=" + tv; next() }
                        else { var dstart = tstart; p_expr(); pparams = pparams + "=" + src.substring(dstart, pos).trim() }
                    }
                } else { pok = 0; break }
                if tt == 36 { next() } else { pok = 0 }
            }
            if tt == 31 {
                next()
                if tt == 40 { next(); return p_arrow(pparams) }
            }
            // Not an arrow after all (an array/object LITERAL in parens) - rewind.
            pos = psp; tt = ptt; tv = sdup(ptv)
        }
        if tt == 3 {
            var id1 = tv; var sp = pos
            next()
            // A parameter may be followed by `)`, `,` or `=` (a default). The `=`
            // case was missing, so `(a, b = 1) => ...` never matched here: it fell
            // through to the backtrack below, was re-parsed as a parenthesised
            // EXPRESSION, and the whole arrow silently vanished - taking the rest
            // of the program with it, because the `=>` that followed was then
            // unexpected. `wynjs` printed NOTHING for such a file and exited 0.
            //
            // Defaults are encoded into the params string as `name=default`,
            // exactly as p_func_expr does it, because callfn splits fparams on ","
            // and already understands that spelling - a plain `function` with
            // default parameters has always worked, and this makes the arrow use
            // the same machinery rather than a second one.
            if tt == 31 or tt == 36 or tt == 15 {
                var params = id1
                var pdone = 0
                while pdone == 0 {
                    if tt == 15 {
                        next()
                        if tt == 2 {
                            params = params + "=\"" + tv + "\""
                            next()
                        } else if tt == 1 or tt == 4 {
                            params = params + "=" + tv
                            next()
                        } else {
                            // Complex default: capture its source text.
                            var ds = pos - tv.len()
                            p_expr()
                            params = params + "=" + src.substring(ds, pos).trim()
                        }
                    }
                    if tt == 36 {
                        next()
                        // A LATER parameter may itself be a destructuring pattern -
                        // `(x, [a,b], {c}) => ...`. Only a leading pattern is caught
                        // by the branch above this one, so without this a pattern in
                        // any non-first position bound nothing.
                        // No `continue` here: control must reach the top of the loop
                        // again so a following `= default` and the next `,` are still
                        // handled - `([a], y = 5) => ...` needs both.
                        if tt == 34 or tt == 32 {
                            params = params + "," + capture_param_pattern()
                        } else {
                            // A rest parameter may only be last; the encoding is the
                            // same `...name` p_func_expr uses.
                            if tt == 98 { next(); params = params + ",..." + tv } else { params = params + "," + tv }
                            next()
                        }
                    } else {
                        pdone = 1
                    }
                }
                if tt == 31 { next() }
                if tt == 40 { next(); return p_arrow(params) }
            }
            pos = sp - id1.len(); next()
        }
        var v = p_expr()
        while tt == 36 { next(); v = p_expr() }
        if tt == 31 { next() }
        return v
    }
    // Array literal
    if tt == 34 { return p_array_literal() }
    // Object literal
    if tt == 32 { return p_object_literal() }
    // async function
    if tt == 89 {
        next()
        if tt == 53 { return p_func_expr() }
        // async arrow: async (params) => body
        if tt == 30 or tt == 3 { return p_primary() }
        return vundef()
    }
    // function expression
    if tt == 53 { return p_func_expr() }
    // Identifier
    if tt == 3 {
        var name = tv; next()
        if name == "console" { return vstr("_console") }
        if name == "Math" { return vstr("_Math") }
        if name == "JSON" { return vstr("_JSON") }
        if name == "Object" { return vstr("_Object") }
        if name == "Array" { return vstr("_Array") }
        if name == "Date" { if tt == 38 { next(); var dp = tv; next(); if dp == "now" { if tt == 30 { next(); if tt == 31 { next() } }; return vnum(1000000) }; return vundef() }; return vundef() }
        if name == "Number" { if tt == 38 { next(); var np = tv; next(); if np == "isInteger" { if tt == 30 { next(); var nv = p_expr(); if tt == 31 { next() }; return vbool(if not vtostr(nv).contains(".") and vtag(nv) == "n" { 1 } else { 0 }) }; return vundef() }; if np == "MAX_SAFE_INTEGER" { return vnum(9007199254740991) }; return vundef() }; return register_builtin("_Number") }
        if name == "parseInt" { return register_builtin("_parseInt") }
        if name == "parseFloat" { return register_builtin("_parseFloat") }
        if name == "String" {
            if tt == 38 { next()
                var prop = tv; next()
                if prop == "fromCharCode" {
                    if tt == 30 { next(); var code = vtonum(p_expr()); if tt == 31 { next() }
                        return vstr(String.char(code))
                    }
                }
                return vundef()
            }
            return register_builtin("_String")
        }
        if name == "Boolean" { return register_builtin("_Boolean") }
        if name == "Symbol" {
            if tt == 30 { next(); var desc = ""; if tt != 31 { desc = vtostr(p_expr()) }; if tt == 31 { next() }
                return "y:" + desc
            }
            if tt == 38 { next(); var sym_prop = tv; next()
                if sym_prop == "iterator" { return "y:Symbol.iterator" }
                if sym_prop == "toPrimitive" { return "y:Symbol.toPrimitive" }
                return "y:Symbol." + sym_prop
            }
            return "y:"
        }
        if name == "isNaN" { return register_builtin("_isNaN") }
        if name == "isFinite" { return register_builtin("_isFinite") }
        // Compound assignment
        if tt == 42 { next(); var right = p_expr(); var cur = eget(name); var v = vundef(); if vtag(cur) == "s" or vtag(right) == "s" { v = vstr(vtostr(cur) + vtostr(right)) } else { v = vfloat(vtofloat(cur) + vtofloat(right)) } eset(name, v); return v }
        if tt == 44 { next(); var right = p_expr(); var v = vfloat(vtofloat(eget(name)) - vtofloat(right)); eset(name, v); return v }
        if tt == 46 { next(); var right = p_expr(); var v = vfloat(vtofloat(eget(name)) * vtofloat(right)); eset(name, v); return v }
        if tt == 47 { next(); var right = p_expr(); var v = vfloat(vtofloat(eget(name)) / vtofloat(right)); eset(name, v); return v }
        if tt == 48 { next(); var right = p_expr(); var v = vnum(vtonum(eget(name)) % vtonum(right)); eset(name, v); return v }
        // Logical/nullish assignment
        if tt == 100 { next(); var right = p_expr(); var cur = eget(name); if vtag(cur) == "N" or vtag(cur) == "u" { eset(name, right); return right }; return cur }
        if tt == 101 { next(); var right = p_expr(); var cur = eget(name); if vtruthy(cur) == 0 { eset(name, right); return right }; return cur }
        if tt == 102 { next(); var right = p_expr(); var cur = eget(name); if vtruthy(cur) != 0 { eset(name, right); return right }; return cur }
        // Single-identifier arrow: x => expr
        if tt == 40 { next(); return p_arrow(name) }
        // Assignment
        if tt == 15 { next(); var right = p_expr(); eset(name, right); return right }
        // Postfix ++/--
        if tt == 41 { next(); var n = vtonum(eget(name)); eset(name, vnum(n + 1)); return vnum(n) }
        if tt == 43 { next(); var n = vtonum(eget(name)); eset(name, vnum(n - 1)); return vnum(n) }
        return eget(name)
    }
    next(); return vundef()
}

fn p_array_literal() -> string {
    next()
    var elems: [string] = []
    while tt != 35 and tt != 0 {
        if tt == 98 {
            next()
            var sp = p_expr()
            if vtag(sp) == "a" {
                var spid: int = vdata(sp).to_int()
                var si: int = 0
                while si < alens[spid] { elems.push(aget(spid, si)); si = si + 1 }
            } else if vtag(sp) == "s" {
                var ss = vdata(sp)
                var ci: int = 0
                while ci < ss.len() { elems.push(vstr(ss.substring(ci, ci + 1))); ci = ci + 1 }
            } else { elems.push(sp) }
        } else { elems.push(p_expr()) }
        if tt == 36 { next() }
    }
    if tt == 35 { next() }
    var aid = anew()
    for e in elems { apush(aid, e) }
    return varr(aid)
}

fn p_object_literal() -> string {
    next()
    var oid = onew()
    while tt != 33 and tt != 0 {
        if tt == 98 {
            next()
            var sp2 = p_expr()
            if vtag(sp2) == "o" {
                var sid: int = vdata(sp2).to_int()
                var sks = okeys(sid)
                for sk in sks { oset(oid, sk, oget_own(sid, sk)) }
            }
            if tt == 36 { next() }
            continue
        }
        if tt == 34 { next(); var key = vtostr(p_expr()); if tt == 35 { next() } if tt == 39 { next() } oset(oid, key, p_expr()); if tt == 36 { next() } continue }
        // Accessor: `get x() {...}` / `set x(v) {...}`. A property may itself be
        // NAMED get/set (`{ get() {} }`, `{ get: 1 }`), so only treat the word as an
        // accessor keyword when an identifier follows it. Without this, `get` was
        // stored as an ordinary key and `x()` was then parsed as a method, so
        // `{ get x(){return 7} }.x` read back as the function, not 7.
        var acc = ""
        if tv == "get" or tv == "set" {
            var sv_pos = pos
            var sv_tt = tt
            var sv_tv = sdup(tv)
            var kw = sdup(tv)
            next()
            if tt == 3 { acc = kw }
            else { pos = sv_pos; tt = sv_tt; tv = sdup(sv_tv) }
        }
        var key = tv; next()
        if acc.len() > 0 { key = "__" + acc + "_" + key }
        if tt == 30 {
            var fid = fcnt; next()
            var params = ""
            while tt != 31 and tt != 0 { if params.len() > 0 { params = params + "," } params = params + tv; next(); if tt == 36 { next() } }
            if tt == 31 { next() }
            var bstart = pos; if tt == 32 { next() }
            var depth = 1
            while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
            var bend = pos - 1; if bend < bstart { bend = bstart }
            fparams[fid] = sdup(params); fbodies[fid] = sdup(src.substring(bstart, bend)); fcnt = fcnt + 1
            next()
            oset(oid, key, vfn(fid))
            if tt == 36 { next() }
            continue
        }
        if tt == 39 { next(); oset(oid, key, p_expr()) }
        else { oset(oid, key, eget(key)) }
        if tt == 36 { next() }
    }
    if tt == 33 { next() }
    return vobj(oid)
}

fn p_func_expr() -> string {
    next()
    var name = ""
    if tt == 3 { name = tv; next() }
    if tt == 30 { next() }
    var params = ""
    while tt != 31 and tt != 0 {
        if params.len() > 0 { params = params + "," }
        // A destructuring parameter - `function f([a,b])` / `function g({x})`.
        if tt == 34 or tt == 32 { params = params + capture_param_pattern(); if tt == 36 { next() }; continue }
        // Rest parameter: ...name
        if tt == 98 { next(); params = params + "..." }
        params = params + tv; next()
        if tt == 15 {
            // Default param: store default value directly
            next()
            // For string defaults, store with quotes for re-parsing
            if tt == 2 {
                params = params + "=\"" + tv + "\""
                next()
            } else if tt == 1 {
                params = params + "=" + tv
                next()
            } else if tt == 4 {
                params = params + "=" + tv
                next()
            } else {
                // Complex default - capture source
                var ds = pos - tv.len()
                p_expr()
                params = params + "=" + src.substring(ds, pos).trim()
            }
        }
        if tt == 36 { next() }
    }
    if tt == 31 { next() }
    var bstart = pos; if tt == 32 { next() }
    var depth = 1
    while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
    var bend = pos - 1; if bend < bstart { bend = bstart }
    var fid = fcnt; fparams[fid] = sdup(params); fbodies[fid] = sdup(src.substring(bstart, bend)); fcnt = fcnt + 1
    // Capture closure environment
    var cap = capture_env()
    if cap.len() > 0 {
        var parts = cap.split("\x02")
        var ck = ""
        var cv = ""
        for p in parts {
            var sep = p.index_of("\x01")
            if sep > 0 {
                if ck.len() > 0 { ck = ck + "\x02"; cv = cv + "\x02" }
                ck = ck + p.substring(0, sep)
                cv = cv + p.substring(sep + 1, p.len())
            }
        }
        fcap_keys[fid] = sdup(ck)
        fcap_vals[fid] = sdup(cv)
    }
    next()
    if name.len() > 0 { edef(name, vfn(fid)) }
    return vfn(fid)
}

fn p_arrow(params: string) -> string {
    var fid = fcnt
    fparams[fid] = sdup(params)
    if tt == 32 {
        // bstart BEFORE the next() that eats `{`, which is the whole fix here.
        // Taking it after leaves bstart pointing past the body's first token, so
        // `() => { return 1 }` captured "1 }" minus its `return` and every
        // block-bodied arrow silently evaluated to undefined - including the
        // `.map(x => { return x*2 })` shape that is most of real JS. The two
        // other body-capture sites (p_func_expr, class methods) already spell it
        // this way; this one had drifted.
        var bstart = pos; if tt == 32 { next() }
        var depth = 1
        while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
        var bend = pos - 1; if bend < bstart { bend = bstart }
        fbodies[fid] = sdup(src.substring(bstart, bend))
        next()
    } else {
        // Expression body: capture raw source text
        // pos is currently at the start of the first token of the body
        // We need to capture everything until ), ;, ,, or }
        var estart = pos - tv.len()
        // For string/template tokens, pos includes quotes but tv doesn't
        if tt == 2 { estart = pos - tv.len() - 2 }
        if tt == 61 { estart = pos - tv.len() - 2 }
        var eend = pos
        var edepth = 0
        while tt != 0 {
            if tt == 34 or tt == 30 { edepth = edepth + 1 }
            if tt == 35 or tt == 31 { if edepth > 0 { edepth = edepth - 1 } else { break } }
            if edepth == 0 and (tt == 37 or tt == 36 or tt == 33) { break }
            eend = pos; next()
        }
        fbodies[fid] = sdup("return " + src.substring(estart, eend) + ";")
    }
    fcnt = fcnt + 1
    // Capture closure environment for arrow functions
    var cap = capture_env()
    if cap.len() > 0 {
        var parts = cap.split("\x02")
        var ck = ""
        var cv = ""
        for p in parts {
            var sep = p.index_of("\x01")
            if sep > 0 {
                if ck.len() > 0 { ck = ck + "\x02"; cv = cv + "\x02" }
                ck = ck + p.substring(0, sep)
                cv = cv + p.substring(sep + 1, p.len())
            }
        }
        fcap_keys[fid] = sdup(ck)
        fcap_vals[fid] = sdup(cv)
    }
    return vfn(fid)
}

// === new Map/Set/Error/RegExp/Promise ===
fn new_map() -> string {
    if tt == 30 { next(); if tt == 31 { next() } }
    var oid = onew()
    oset(oid, "__type__", vstr("Map"))
    oset(oid, "__data__", vobj(onew()))
    return vobj(oid)
}

fn new_set() -> string {
    if tt == 30 { next()
        var items = [""]
        items = []
        if tt != 31 { var arg = p_expr(); if vtag(arg) == "a" { var i = 0; while i < alens[vdata(arg).to_int()] { items.push(aget(vdata(arg).to_int(), i)); i = i + 1 } } }
        if tt == 31 { next() }
        var oid = onew()
        oset(oid, "__type__", vstr("Set"))
        var did = onew()
        for item in items { oset(did, vtostr(item), item) }
        oset(oid, "__data__", vobj(did))
        return vobj(oid)
    }
    var oid = onew()
    oset(oid, "__type__", vstr("Set"))
    oset(oid, "__data__", vobj(onew()))
    return vobj(oid)
}

fn new_error() -> string {
    var msg = ""
    if tt == 30 { next(); if tt != 31 { msg = vtostr(p_expr()) } if tt == 31 { next() } }
    var oid = onew()
    oset(oid, "__type__", vstr("Error"))
    oset(oid, "message", vstr(msg))
    oset(oid, "name", vstr("Error"))
    return vobj(oid)
}

// Raise a JS-visible error from the INTERPRETER (not from a `throw` statement),
// so a runtime fault like reading a property of null is an ordinary catchable
// TypeError rather than a silent undefined.
fn throw_error(ename: string, msg: string) -> string {
    if noeval > 0 or overflow == 1 { return vundef() }
    var oid = onew()
    oset(oid, "__type__", vstr("Error"))
    oset(oid, "name", vstr(ename))
    oset(oid, "message", vstr(msg))
    oset(oid, "stack", vstr(""))
    throwval = vobj(oid)
    throwflag = 1
    return vundef()
}

// node: "Cannot read properties of null (reading 'x')"
fn throw_null_prop(base: string, prop: string) -> string {
    var what = "null"
    if vtag(base) == "u" { what = "undefined" }
    return throw_error("TypeError", "Cannot read properties of " + what + " (reading '" + prop + "')")
}

fn new_regexp() -> string {
    var pattern = ""
    var flags = ""
    if tt == 30 { next(); if tt != 31 { pattern = vtostr(p_expr()); if tt == 36 { next(); flags = vtostr(p_expr()) } } if tt == 31 { next() } }
    var oid = onew()
    oset(oid, "__type__", vstr("RegExp"))
    oset(oid, "source", vstr(pattern))
    oset(oid, "flags", vstr(flags))
    return vobj(oid)
}

fn new_promise() -> string {
    if tt != 30 { return vundef() }
    next()
    var executor = p_expr()
    if tt == 31 { next() }
    var oid = onew()
    oset(oid, "__type__", vstr("Promise"))
    oset(oid, "__state__", vstr("pending"))
    oset(oid, "__value__", vundef())
    // Create resolve/reject functions
    var resolve_fid = fcnt
    fparams[resolve_fid] = "v"
    fbodies[resolve_fid] = ""
    fcnt = fcnt + 1
    // The executor runs synchronously; resolve/reject are tiny JS bodies that
    // write the promise's internal slots through `this`.
    edef("__promise_oid__", vnum(oid))
    var rfid = fcnt
    fparams[rfid] = "v"
    fbodies[rfid] = "this.__state__ = \"fulfilled\"; this.__value__ = v;"
    fcnt = fcnt + 1
    var rjfid = fcnt
    fparams[rjfid] = "v"
    fbodies[rjfid] = "this.__state__ = \"rejected\"; this.__value__ = v;"
    fcnt = fcnt + 1
    this_push(vobj(oid))
    callfn(executor, [vfn(rfid), vfn(rjfid)])
    return vobj(oid)
}

// Run a class's field initializers against a fresh instance. The statements are
// re-parsed in a scope where `this` is that instance; lexer state is saved and
// restored because the caller is mid-parse at the `new` expression.
fn run_field_inits(ci: int, inst: string) {
    if noeval > 0 or overflow == 1 { return }
    var fsrc = sdup(cfields[ci])
    if fsrc.len() == 0 { return }
    var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv); var ts1 = tstart
    epush()
    edef("this", inst)
    src = sdup(fsrc); pos = 0; next()
    while tt != 0 and overflow == 0 { p_stmt() }
    epop()
    src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1); tstart = ts1
}

fn new_class(cls_name: string) -> string {
    // Find class
    var ci = 0
    while ci < ccnt { if cnames[ci] == cls_name { break } ci = ci + 1 }
    if ci >= ccnt {
        // Not a class, try as function constructor
        var ctor = eget(cls_name)
        if vtag(ctor) == "f" {
            var oid = onew()
            if tt == 30 { next()
                var args = [""]
                args = []
                while tt != 31 and tt != 0 { args.push(p_expr()); if tt == 36 { next() } }
                if tt == 31 { next() }
                this_push(vobj(oid))
                callfn(ctor, args)
            }
            return vobj(oid)
        }
        if tt == 30 { next(); while tt != 31 and tt != 0 { p_expr(); if tt == 36 { next() } } if tt == 31 { next() } }
        return vobj(onew())
    }
    // Create instance
    var oid = onew()
    oprotos[oid] = cprotos[ci]
    oset(oid, "__class__", vstr(cls_name))
    // Field initializers run BEFORE the constructor body, as in JS, so a
    // constructor may read and overwrite a declared field.
    run_field_inits(ci, vobj(oid))
    // Call constructor
    if tt == 30 {
        next()
        var args = [""]
        args = []
        while tt != 31 and tt != 0 { args.push(p_expr()); if tt == 36 { next() } }
        if tt == 31 { next() }
        if cconstructors[ci] >= 0 {
            this_push(vobj(oid))
            callfn(vfn(cconstructors[ci]), args)
        }
    }
    return vobj(oid)
}

// === Destructuring patterns ===
// A pattern is parsed ONCE into a comma-joined name list, then bound per value.
// for-of needs exactly that split: the pattern text appears once in the source but
// binds on every iteration, so parsing it per iteration would mean re-lexing the
// header inside the loop.
//
// Array form: names in order; "" is a hole (`[, n]`); "...r" is a rest element.
// Object form: "key:local" when renamed, else just the name.

// Parse an array pattern, positioned ON the "[". Leaves the token after "]".
fn p_arr_pattern() -> string {
    var names = ""
    var first = 1
    next()
    while tt != 35 and tt != 0 {
        // One element per position. A bare "," means this position is a HOLE, which
        // still consumes an index - `[, n]` binds n to element 1, not element 0.
        if first == 0 { names = names + "," }
        first = 0
        if tt == 98 { next(); names = names + "..." + tv; next() }
        else if tt != 36 { names = names + tv; next() }
        if tt == 36 { next() }
    }
    if tt == 35 { next() }
    return names
}

// Parse an object pattern, positioned ON the "{". Leaves the token after "}".
fn p_obj_pattern() -> string {
    var names = ""
    next()
    while tt != 33 and tt != 0 {
        var key = tv; next()
        var local = sdup(key)
        if tt == 39 { next(); local = sdup(tv); next() }
        if names.len() > 0 { names = names + "," }
        names = names + key + ":" + local
        if tt == 36 { next() }
    }
    if tt == 33 { next() }
    return names
}

// Normalise an object pattern's inner text ("a, b: local") to the "key:local" list
// bind_obj_pattern expects. Used for a pattern that arrives as SOURCE rather than
// through p_obj_pattern - i.e. a destructuring function parameter.
fn obj_pattern_names(inner: string) -> string {
    var out = ""
    var parts = inner.split(",")
    for p in parts {
        var e = p.trim()
        if e.len() == 0 { continue }
        var ci3 = e.index_of(":")
        var key = sdup(e)
        var local = sdup(e)
        if ci3 > 0 { key = e.substring(0, ci3).trim(); local = e.substring(ci3 + 1, e.len()).trim() }
        if out.len() > 0 { out = out + "," }
        out = out + key + ":" + local
    }
    return out
}

// Bind an array pattern's names against one value.
fn bind_arr_pattern(names: string, val: string) {
    if names.len() == 0 { return }
    var ns = names.split(",")
    var aid = -1
    if vtag(val) == "a" { aid = vdata(val).to_int() }
    var i = 0
    for n in ns {
        var nm = n.trim()
        if nm.starts_with("...") {
            var rest_name = nm.substring(3, nm.len())
            var rid = anew()
            if aid >= 0 { while i < alens[aid] { apush(rid, aget(aid, i)); i = i + 1 } }
            edef(rest_name, varr(rid))
        } else if nm.len() > 0 {
            if aid >= 0 and i < alens[aid] { edef(nm, aget(aid, i)) } else { edef(nm, vundef()) }
        }
        i = i + 1
    }
}

// Bind an object pattern's "key:local" pairs against one value.
fn bind_obj_pattern(names: string, val: string) {
    if names.len() == 0 { return }
    var ns = names.split(",")
    var oid = -1
    if vtag(val) == "o" { oid = vdata(val).to_int() }
    for n in ns {
        var pair = n.trim()
        if pair.len() == 0 { continue }
        var ci2 = pair.index_of(":")
        var key = sdup(pair)
        var local = sdup(pair)
        if ci2 > 0 { key = pair.substring(0, ci2); local = pair.substring(ci2 + 1, pair.len()) }
        if oid >= 0 { edef(local, oget(oid, key)) } else { edef(local, vundef()) }
    }
}

// Capture a destructuring PARAMETER, positioned on its "[" or "{", and encode it for
// the params string: the pattern's own commas become "|" so that callfn's split(",")
// does not tear it apart. Leaves the token after the closing bracket.
fn capture_param_pattern() -> string {
    var open_tt = tt
    var close_tt = 35
    if open_tt == 32 { close_tt = 33 }
    var out = ""
    if open_tt == 34 { out = "[" } else { out = "{" }
    next()
    while tt != close_tt and tt != 0 {
        if tt == 36 { out = out + "|" } else if tt == 39 { out = out + ":" } else if tt == 98 { out = out + "..." } else { out = out + tv }
        next()
    }
    if tt == close_tt { next() }
    if open_tt == 34 { out = out + "]" } else { out = out + "}" }
    return out
}

// Capture a loop body as source, positioned on its first token. A braced block runs
// to its matching "}"; a braceless body (`for (v of a) s += v;`) is a single
// statement ending at ";". Leaves the token after the body.
fn capture_loop_body() -> string {
    if tt == 32 {
        var bstart = pos
        next()
        var depth = 1
        while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
        var b = sdup(src.substring(bstart, pos - 1))
        next()
        return b
    }
    var bstart2 = tstart
    while tt != 37 and tt != 0 and tt != 33 { next() }
    var b2 = sdup(src.substring(bstart2, pos - 1))
    if tt == 37 { next() }
    return b2
}

// === Statements ===
fn p_stmt() {
    if overflow == 1 { return }
    if retflag == 1 or throwflag == 1 { return }
    if brkflag == 1 or contflag == 1 { return }
    // Labeled statement: handled in expression fallthrough
    // (labels are identifier followed by colon, detected below)
    // let/const/var with destructuring
    if tt == 50 or tt == 51 or tt == 52 {
        next()
        // Array destructuring: let [a, b] = expr
        if tt == 34 {
            next()
            var names = [""]
            names = []
            while tt != 35 and tt != 0 {
                if tt == 36 { next(); names.push(""); continue }
                if tt == 98 { next(); names.push("..." + tv); next(); if tt == 36 { next() }; continue }
                names.push(tv); next(); if tt == 36 { next() }
            }
            if tt == 35 { next() }
            if tt == 15 { next() }
            var val = p_expr()
            if vtag(val) == "a" {
                var aid = vdata(val).to_int()
                var i = 0
                for n in names {
                    if n.starts_with("...") {
                        var rest_name = n.substring(3, n.len())
                        var rid = anew()
                        while i < alens[aid] { apush(rid, aget(aid, i)); i = i + 1 }
                        edef(rest_name, varr(rid))
                    } else if n.len() > 0 { edef(n, aget(aid, i)) }
                    i = i + 1
                }
            }
            if tt == 37 { next() }
            return
        }
        // Object destructuring: let {a, b} = expr
        if tt == 32 {
            next()
            var onames = [""]
            onames = []
            while tt != 33 and tt != 0 { onames.push(tv); next(); if tt == 39 { next(); onames[onames.len()-1] = tv; next() }; if tt == 36 { next() } }
            if tt == 33 { next() }
            if tt == 15 { next() }
            var val = p_expr()
            if vtag(val) == "o" {
                var oid = vdata(val).to_int()
                for n in onames { edef(n, oget(oid, n)) }
            }
            if tt == 37 { next() }
            return
        }
        var name = tv; next()
        var val = vundef()
        if tt == 15 { next(); val = p_expr() }
        edef(name, val)
        // Handle comma-separated declarations: let a = 1, b = 2
        while tt == 36 { next(); var n2 = tv; next(); var v2 = vundef(); if tt == 15 { next(); v2 = p_expr() }; edef(n2, v2) }
        if tt == 37 { next() }
        return
    }
    // function declaration
    if tt == 53 or (tt == 89 and peek_is_function()) {
        if tt == 89 { next() }
        next()
        var name = tv; next()
        if tt == 30 { next() }
        var params = ""
        while tt != 31 and tt != 0 {
            if params.len() > 0 { params = params + "," }
            // A destructuring parameter - `function f([a,b])` / `function g({x})`.
            if tt == 34 or tt == 32 { params = params + capture_param_pattern(); if tt == 36 { next() }; continue }
            if tt == 98 { next(); params = params + "..." }
            params = params + tv; next()
            if tt == 15 {
                next()
                if tt == 2 { params = params + "=\"" + tv + "\""; next() }
                else if tt == 1 { params = params + "=" + tv; next() }
                else if tt == 4 { params = params + "=" + tv; next() }
                else { var ds = pos - tv.len(); p_expr(); params = params + "=" + src.substring(ds, pos).trim() }
            }
            if tt == 36 { next() }
        }
        if tt == 31 { next() }
        var bstart = pos; if tt == 32 { next() }
        var depth = 1
        while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
        var bend = pos - 1; if bend < bstart { bend = bstart }
        var fid = fcnt; fparams[fid] = sdup(params); fbodies[fid] = sdup(src.substring(bstart, bend)); fcnt = fcnt + 1
        next()
        edef(name, vfn(fid))
        return
    }
    // class declaration
    if tt == 70 {
        next()
        var name = tv; next()
        var parent_id = -1
        if tt == 73 { next(); var pname = tv; next()
            var pi = 0; while pi < ccnt { if cnames[pi] == pname { parent_id = pi; break } pi = pi + 1 }
        }
        if tt == 32 { next() }
        var ci = ccnt
        cnames[ci] = sdup(name)
        var proto_oid = onew()
        if parent_id >= 0 { oprotos[proto_oid] = cprotos[parent_id] }
        cprotos[ci] = proto_oid
        cconstructors[ci] = -1
        cparents[ci] = parent_id
        // Inherit the parent's field initializers, so a subclass instance also gets
        // the fields declared on the base. Parent first: a subclass redeclaring a
        // name must win, and these are applied in order.
        if parent_id >= 0 { cfields[ci] = sdup(cfields[parent_id]) } else { cfields[ci] = "" }
        ccnt = ccnt + 1
        // Parse class body
        while tt != 33 and tt != 0 {
            var is_st = 0
            if tv == "static" { is_st = 1; next() }
            // `get x() {}` / `set x() {}` are accessors, but a METHOD may itself
            // be named get/set - e.g. `get() { return this.v; }`. Only treat the
            // word as an accessor keyword when another identifier follows it;
            // if the next token is "(" it is an ordinary method name.
            var cacc = ""
            if tv == "get" or tv == "set" {
                var save_pos = pos
                var save_tt = tt
                var save_tv = sdup(tv)
                var ckw = sdup(tv)
                next()
                if tt == 30 {
                    // it was a method called get/set - rewind
                    pos = save_pos; tt = save_tt; tv = sdup(save_tv)
                } else { cacc = ckw }
            }
            var mname = tv; next()
            // Store an accessor under the same mangled key an object literal uses, so
            // do_member invokes it on read instead of handing back the function.
            if cacc.len() > 0 { mname = "__" + cacc + "_" + mname }
            if is_st == 1 and tt == 15 { next(); oset(proto_oid, "__static_" + mname, p_expr()); if tt == 37 { next() }; continue }
            // An INSTANCE field declaration: `n = 0` or `n` (no initializer), and
            // not followed by "(". Its initializer is recorded as source and
            // re-evaluated per `new`, because every instance needs its own value and
            // the initializer may read `this`. Without this case the parser fell
            // straight into the parameter loop below, which scans for ")" - so a
            // field as the LAST class member consumed the rest of the program and
            // everything after the class silently vanished at exit 0.
            if tt != 30 {
                var init_src = "undefined"
                if tt == 15 {
                    next()
                    var istart = tstart
                    // Skip the initializer expression WITHOUT evaluating it here: it
                    // must run per-instantiation, not once at declaration time.
                    noeval = noeval + 1
                    p_expr()
                    noeval = noeval - 1
                    init_src = sdup(src.substring(istart, tstart).trim())
                    while init_src.ends_with(";") { init_src = sdup(init_src.substring(0, init_src.len() - 1).trim()) }
                    if init_src.len() == 0 { init_src = "undefined" }
                }
                // Stored as runnable JS - `this.n = 0;` - rather than a name/value
                // table. An initializer is arbitrary source that may itself contain
                // any separator character, so no delimiter is safe; re-running the
                // statements through the ordinary parser sidesteps the question and
                // gives `this` and field-reads-field semantics for free.
                cfields[ci] = cfields[ci] + "this." + mname + " = " + init_src + ";\n"
                if tt == 37 { next() }
                continue
            }
            if tt == 30 { next() }
            var params = ""
            while tt != 31 and tt != 0 { if params.len() > 0 { params = params + "," } params = params + tv; next(); if tt == 36 { next() } }
            if tt == 31 { next() }
            var bstart = pos; if tt == 32 { next() }
            var depth = 1
            while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
            var bend = pos - 1; if bend < bstart { bend = bstart }
            var fid = fcnt; fparams[fid] = sdup(params); fbodies[fid] = sdup(src.substring(bstart, bend)); fcnt = fcnt + 1
            next()
            if mname == "constructor" { cconstructors[ci] = fid }
            else { if is_st == 1 { oset(proto_oid, "__static_" + mname, vfn(fid)) } else { oset(proto_oid, mname, vfn(fid)) } }
            if tt == 37 { next() }
        }
        if tt == 33 { next() }
        edef(name, vstr(name))
        return
    }
    // return
    if tt == 54 {
        next()
        if tt == 37 or tt == 33 { retval = vundef() }
        else { retval = sdup(p_expr()) }
        retflag = 1
        if tt == 37 { next() }
        return
    }
    // yield (stub - skip expression)
    if tt == 91 { next(); if tt != 37 and tt != 33 { p_expr() }; if tt == 37 { next() }; return }
    // throw
    if tt == 82 {
        next()
        throwval = p_expr()
        throwflag = 1
        if tt == 37 { next() }
        return
    }
    // try/catch/finally
    if tt == 83 {
        next()
        if tt == 32 { next() }
        epush()
        throwflag = 0
        p_block_body()
        epop()
        var had_throw = throwflag
        var thrown = throwval
        throwflag = 0
        // catch
        if tt == 84 {
            next()
            var catch_var = ""
            if tt == 30 { next(); catch_var = tv; next(); if tt == 31 { next() } }
            if had_throw == 1 {
                if tt == 32 { next() }
                epush()
                if catch_var.len() > 0 { edef(catch_var, thrown) }
                p_block_body()
                epop()
            } else {
                skip_block_raw()
            }
        } else if had_throw == 1 {
            // `try { throw x } finally { ... }` with NO catch clause: there is nothing
            // to handle the throw here, so it must keep propagating. It used to be
            // cleared above and silently dropped.
            throwflag = 1
            throwval = sdup(thrown)
        }
        // finally
        if tt == 85 {
            next()
            if tt == 32 { next() }
            // `finally` must run even when the try/catch exited via return, break or
            // continue. Those flags are still set here, and p_block_body bails out
            // the moment it sees one - so the block would be skipped entirely. Park
            // the pending exit, run the block, then restore it. A return/throw raised
            // by `finally` itself wins, which is what JS does.
            var pend_ret = retflag
            var pend_retval = sdup(retval)
            var pend_brk = brkflag
            var pend_cont = contflag
            var pend_throw = throwflag
            var pend_thrown = sdup(throwval)
            retflag = 0; brkflag = 0; contflag = 0; throwflag = 0
            epush(); p_block_body(); epop()
            if retflag == 0 and throwflag == 0 {
                retflag = pend_ret
                retval = sdup(pend_retval)
                brkflag = pend_brk
                contflag = pend_cont
                throwflag = pend_throw
                throwval = sdup(pend_thrown)
            }
        }
        return
    }
    // if
    if tt == 55 {
        next(); if tt == 30 { next() }
        var cond = p_expr()
        if tt == 31 { next() }
        if vtruthy(cond) == 1 {
            p_block_or_stmt()
            while tt == 56 {
                next()
                if tt == 55 { next(); if tt == 30 { next() } p_expr(); if tt == 31 { next() } skip_block_or_stmt() }
                else { skip_block_or_stmt() }
            }
        } else {
            skip_block_or_stmt()
            if tt == 56 {
                next()
                if tt == 55 { p_stmt() }
                else { p_block_or_stmt() }
            }
        }
        return
    }
    // switch
    if tt == 78 {
        next(); if tt == 30 { next() }
        var val = p_expr()
        if tt == 31 { next() }
        if tt == 32 { next() }
        var matched = 0
        while tt != 33 and tt != 0 {
            if tt == 79 {
                next()
                var case_val = p_expr()
                if tt == 39 { next() }
                if matched == 1 or vtostr(val) == vtostr(case_val) {
                    matched = 1
                    while tt != 79 and tt != 80 and tt != 33 and tt != 0 {
                        if brkflag == 1 or retflag == 1 or throwflag == 1 { break }
                        p_stmt()
                    }
                    if retflag == 1 or throwflag == 1 { return }
                    if brkflag == 1 { brkflag = 0; break }
                } else {
                    while tt != 79 and tt != 80 and tt != 33 and tt != 0 { skip_stmt() }
                }
            } else if tt == 80 {
                next(); if tt == 39 { next() }
                if matched == 0 {
                    matched = 1
                    while tt != 79 and tt != 33 and tt != 0 {
                        if brkflag == 1 or retflag == 1 or throwflag == 1 { break }
                        p_stmt()
                    }
                    if retflag == 1 or throwflag == 1 { return }
                    if brkflag == 1 { brkflag = 0; break }
                } else {
                    while tt != 79 and tt != 33 and tt != 0 { skip_stmt() }
                }
            } else { next() }
        }
        if tt == 33 { next() }
        else {
            // Skip remaining switch body after break
            var depth = 1
            while depth > 0 and tt != 0 {
                if tt == 32 { depth = depth + 1 }
                if tt == 33 { depth = depth - 1; if depth == 0 { break } }
                next()
            }
            if tt == 33 { next() }
        }
        return
    }
    // while
    if tt == 57 {
        next(); if tt == 30 { next() }
        var cstart = pos - tv.len()
        var depth = 0
        while tt != 31 or depth > 0 { if tt == 30 { depth = depth + 1 } if tt == 31 { if depth > 0 { depth = depth - 1 } else { break } } next() }
        var csrc = src.substring(cstart, pos - 1)
        next()
        // Body: braced block, or ONE braceless statement ending at ";".
        // Only the braced form used to be captured, so `for (...) x += i;`
        // and `while (...) f();` silently never ran their body.
        var bsrc = ""
        if tt == 32 {
            var bstart = pos
            next()
            depth = 1
            while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
            bsrc = src.substring(bstart, pos - 1)
            next()
        } else {
            var bstart2 = pos - tv.len()
            while tt != 37 and tt != 0 and tt != 33 { next() }
            bsrc = src.substring(bstart2, pos - 1)
            if tt == 37 { next() }
        }
        var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
        var iter = 0
        while iter < 1000000 {
            src = sdup(csrc); pos = 0; next(); var cv = p_expr()
            if vtruthy(cv) == 0 { break }
            src = sdup(bsrc); pos = 0; next(); epush(); p_block_body(); epop()
            if retflag == 1 or throwflag == 1 { break }
            if brkflag == 1 { brkflag = 0; break }
            contflag = 0
            iter = iter + 1
        }
        src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
        return
    }
    // do...while
    if tt == 81 {
        next()
        // Body: braced block, or ONE braceless statement ending at ";".
        // Only the braced form used to be captured, so `for (...) x += i;`
        // and `while (...) f();` silently never ran their body.
        var depth = 1
        var bsrc = ""
        if tt == 32 {
            var bstart = pos
            next()
            depth = 1
            while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
            bsrc = src.substring(bstart, pos - 1)
            next()
        } else {
            var bstart2 = pos - tv.len()
            while tt != 37 and tt != 0 and tt != 33 { next() }
            bsrc = src.substring(bstart2, pos - 1)
            if tt == 37 { next() }
        }
        // expect 'while'
        if tt == 57 { next() }
        if tt == 30 { next() }
        var cstart = pos - tv.len()
        depth = 0
        while tt != 31 or depth > 0 { if tt == 30 { depth = depth + 1 } if tt == 31 { if depth > 0 { depth = depth - 1 } else { break } } next() }
        var csrc = src.substring(cstart, pos - 1)
        next()
        if tt == 37 { next() }
        var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
        var iter = 0
        while iter < 1000000 {
            src = sdup(bsrc); pos = 0; next(); epush(); p_block_body(); epop()
            if retflag == 1 or throwflag == 1 { break }
            if brkflag == 1 { brkflag = 0; break }
            contflag = 0
            src = sdup(csrc); pos = 0; next(); var cv = p_expr()
            if vtruthy(cv) == 0 { break }
            iter = iter + 1
        }
        src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
        return
    }
    // for...in / for...of / C-style for
    if tt == 58 {
        next(); if tt == 30 { next() }
        // Check for for...in / for...of
        var decl_type = 0
        if tt == 50 or tt == 51 or tt == 52 { decl_type = tt; next() }
        // `for (const [a,b] of pairs)` / `for (const {k} of objs)`. The two branches
        // below are gated on the loop variable being a plain identifier (tt == 3), so
        // a "[" or "{" PATTERN used to fall through to the C-style for(;;) path -
        // whose captured condition source is empty, reads as truthy, and spins to the
        // million-iteration cap. It presented as a hang.
        if tt == 34 or tt == 32 {
            var is_arr_pat = 0
            if tt == 34 { is_arr_pat = 1 }
            var pat = ""
            if is_arr_pat == 1 { pat = p_arr_pattern() } else { pat = p_obj_pattern() }
            // Only for-of destructures; `for (const [a] in o)` is not valid JS.
            if tt == 94 {
                next()
                var dobj = p_expr()
                if tt == 31 { next() }
                var dbsrc = capture_loop_body()
                var ds1 = sdup(src); var dp1 = pos; var dt1 = tt; var dv1 = sdup(tv)
                epush()
                if vtag(dobj) == "a" {
                    var daid = vdata(dobj).to_int()
                    var di = 0
                    while di < alens[daid] {
                        var elem = aget(daid, di)
                        if is_arr_pat == 1 { bind_arr_pattern(pat, elem) } else { bind_obj_pattern(pat, elem) }
                        src = sdup(dbsrc); pos = 0; next(); p_block_body()
                        if retflag == 1 or throwflag == 1 { break }
                        if brkflag == 1 { brkflag = 0; break }
                        contflag = 0
                        di = di + 1
                    }
                }
                epop()
                src = sdup(ds1); pos = dp1; tt = dt1; tv = sdup(dv1)
                return
            }
        }
        if tt == 3 {
            var vname = tv; var sp = pos; next()
            // for (x in obj)
            if tt == 93 {
                next()
                var obj = p_expr()
                if tt == 31 { next() }
                // Capture the body source. A braced block runs to its matching
                // "}"; a braceless body (`for (v of a) s += v;`) is a single
                // statement ending at ";". Only the braced form used to be
                // handled, so a braceless body silently never ran.
                var bsrc = ""
                if tt == 32 {
                    var bstart = pos
                    next()
                    var depth = 1
                    while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
                    bsrc = src.substring(bstart, pos - 1)
                    next()
                } else {
                    var bstart2 = pos - tv.len()
                    while tt != 37 and tt != 0 and tt != 33 { next() }
                    bsrc = src.substring(bstart2, pos - 1)
                    if tt == 37 { next() }
                }
                var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
                epush()
                if vtag(obj) == "o" {
                    var oid = vdata(obj).to_int()
                    var ks = okeys(oid)
                    for k in ks {
                        if not k.starts_with("__") {
                            edef(vname, vstr(k))
                            src = sdup(bsrc); pos = 0; next(); p_block_body()
                            if retflag == 1 or throwflag == 1 { break }
                            if brkflag == 1 { brkflag = 0; break }
                            contflag = 0
                        }
                    }
                } else if vtag(obj) == "a" {
                    var aid = vdata(obj).to_int()
                    var i = 0
                    while i < alens[aid] {
                        edef(vname, vstr(i.to_string()))
                        src = sdup(bsrc); pos = 0; next(); p_block_body()
                        if retflag == 1 or throwflag == 1 { break }
                        if brkflag == 1 { brkflag = 0; break }
                        contflag = 0
                        i = i + 1
                    }
                }
                epop()
                src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
                return
            }
            // for (x of arr)
            if tt == 94 {
                next()
                var obj = p_expr()
                if tt == 31 { next() }
                // Capture the body source. A braced block runs to its matching
                // "}"; a braceless body (`for (v of a) s += v;`) is a single
                // statement ending at ";". Only the braced form used to be
                // handled, so a braceless body silently never ran.
                var bsrc = ""
                if tt == 32 {
                    var bstart = pos
                    next()
                    var depth = 1
                    while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
                    bsrc = src.substring(bstart, pos - 1)
                    next()
                } else {
                    var bstart2 = pos - tv.len()
                    while tt != 37 and tt != 0 and tt != 33 { next() }
                    bsrc = src.substring(bstart2, pos - 1)
                    if tt == 37 { next() }
                }
                var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
                epush()
                if vtag(obj) == "a" {
                    var aid = vdata(obj).to_int()
                    var i = 0
                    while i < alens[aid] {
                        edef(vname, aget(aid, i))
                        src = sdup(bsrc); pos = 0; next(); p_block_body()
                        if retflag == 1 or throwflag == 1 { break }
                        if brkflag == 1 { brkflag = 0; break }
                        contflag = 0
                        i = i + 1
                    }
                }
                if vtag(obj) == "s" {
                    var str_val = vdata(obj)
                    var i = 0
                    while i < str_val.len() {
                        edef(vname, vstr(str_val.substring(i, i + 1)))
                        src = sdup(bsrc); pos = 0; next(); p_block_body()
                        if retflag == 1 or throwflag == 1 { break }
                        if brkflag == 1 { brkflag = 0; break }
                        contflag = 0
                        i = i + 1
                    }
                }
                epop()
                src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
                return
            }
            // C-style for - backtrack
            pos = sp - vname.len()
            if decl_type > 0 { pos = pos - 4 }
            next()
        }
        // C-style for
        epush()
        if tt != 37 { p_stmt() } else { next() }
        var cstart = pos - tv.len()
        while tt != 37 and tt != 0 { next() }
        var csrc = src.substring(cstart, pos - 1)
        next()
        var ustart = pos - tv.len()
        var depth = 0
        while tt != 31 or depth > 0 { if tt == 30 { depth = depth + 1 } if tt == 31 { if depth > 0 { depth = depth - 1 } else { break } } next() }
        var usrc = src.substring(ustart, pos - 1)
        next()
        // Body: braced block, or ONE braceless statement ending at ";".
        // Only the braced form used to be captured, so `for (...) x += i;`
        // and `while (...) f();` silently never ran their body.
        var bsrc = ""
        if tt == 32 {
            var bstart = pos
            next()
            depth = 1
            while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
            bsrc = src.substring(bstart, pos - 1)
            next()
        } else {
            var bstart2 = pos - tv.len()
            while tt != 37 and tt != 0 and tt != 33 { next() }
            bsrc = src.substring(bstart2, pos - 1)
            if tt == 37 { next() }
        }
        var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
        var iter = 0
        while iter < 1000000 {
            src = sdup(csrc); pos = 0; next(); var cv = p_expr()
            if vtruthy(cv) == 0 { break }
            src = sdup(bsrc); pos = 0; next(); p_block_body()
            if retflag == 1 or throwflag == 1 { break }
            if brkflag == 1 { brkflag = 0; break }
            contflag = 0
            src = sdup(usrc); pos = 0; next(); p_expr(); while tt == 36 { next(); p_expr() }
            iter = iter + 1
        }
        epop()
        src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
        return
    }
    // break
    if tt == 59 { next(); brkflag = 1; if tt == 37 { next() } return }
    // continue
    if tt == 60 { next(); contflag = 1; if tt == 37 { next() } return }
    // import
    if tt == 86 { p_import(); return }
    // export
    if tt == 87 { next(); p_stmt(); return }
    // block
    if tt == 32 { next(); epush(); p_block_body(); epop(); return }
    // empty statement
    if tt == 37 { next(); return }
    // expression statement
    p_expr()
    if tt == 37 { next() }
}

fn peek_is_function() -> int {
    var sp = pos
    skipws()
    if pos < src.len() {
        var c = ch()
        pos = sp
        if c == "f" { return 1 }
    }
    pos = sp
}

fn p_block_or_stmt() {
    if tt == 32 { next(); epush(); p_block_body(); epop() }
    else { p_stmt() }
}

fn p_block_or_stmt_rewind() {
    // Used by for-in: we need to re-execute the block each iteration
    // The caller handles the rewind
    p_block_or_stmt()
}

fn skip_block_raw() {
    if tt == 32 {
        next(); var depth = 1
        while depth > 0 and tt != 0 { if tt == 32 { depth = depth + 1 } if tt == 33 { depth = depth - 1; if depth == 0 { break } } next() }
        next()
    }
}

fn skip_block_or_stmt() {
    if tt == 32 { skip_block_raw() }
    else { while tt != 37 and tt != 0 and tt != 33 { next() } if tt == 37 { next() } }
}

fn skip_stmt() {
    if tt == 32 { skip_block_raw() }
    else { while tt != 37 and tt != 79 and tt != 80 and tt != 33 and tt != 0 { next() } if tt == 37 { next() } }
}

fn p_block_body() {
    while tt != 33 and tt != 0 {
        if overflow == 1 { break }
        if retflag == 1 or brkflag == 1 or contflag == 1 or throwflag == 1 { break }
        p_stmt()
    }
    // An early exit (throw/return/break/continue) leaves the REST of this block's
    // tokens unread. This is a single-pass parse-and-evaluate interpreter, so those
    // tokens do not just sit there - they become the next thing executed. That is
    // why `try { throw 1; console.log("x") } catch (e) {}` printed "x" and then
    // reached `catch` with the token stream one statement out of step, so the
    // handler saw no throw and bound `e` to undefined. Skip to this block's own
    // closing brace instead of leaving the stream mid-block.
    if tt != 33 and tt != 0 {
        var bdepth = 0
        while tt != 0 {
            if tt == 32 { bdepth = bdepth + 1 }
            else if tt == 33 {
                if bdepth == 0 { break }
                bdepth = bdepth - 1
            }
            next()
        }
    }
    if tt == 33 { next() }
}

fn p_import() {
    next()
    // import { a, b } from "file"
    if tt == 32 {
        next()
        var names = [""]
        names = []
        while tt != 33 and tt != 0 { names.push(tv); next(); if tt == 36 { next() } }
        if tt == 33 { next() }
        if tt == 88 { next() }
        var path = vtostr(p_expr())
        if tt == 37 { next() }
        var exports = load_module(path)
        if vtag(exports) == "o" {
            var oid = vdata(exports).to_int()
            for n in names { edef(n, oget(oid, n)) }
        }
        return
    }
    // import x from "file"
    if tt == 3 {
        var name = tv; next()
        if tt == 88 { next() }
        var path = vtostr(p_expr())
        if tt == 37 { next() }
        var exports = load_module(path)
        edef(name, exports)
        return
    }
    // import "file" (side effects only)
    var path = vtostr(p_expr())
    if tt == 37 { next() }
    load_module(path)
}

fn load_module(path: string) -> string {
    // Check cache
    var i = 0
    while i < mod_cnt { if mod_paths[i] == path { return mod_exports[i] } i = i + 1 }
    // Resolve path relative to current file
    var code = File.read(path)
    if code.len() == 0 { return vobj(onew()) }
    var s1 = sdup(src); var p1 = pos; var t1 = tt; var v1 = sdup(tv)
    var exports_oid = onew()
    epush()
    edef("module", vobj(exports_oid))
    src = sdup(code); pos = 0; next()
    while tt != 0 { p_stmt(); if retflag == 1 or overflow == 1 or throwflag == 1 { break } }
    retflag = 0
    epop()
    src = sdup(s1); pos = p1; tt = t1; tv = sdup(v1)
    mod_paths[mod_cnt] = sdup(path)
    mod_exports[mod_cnt] = sdup(vobj(exports_oid))
    mod_cnt = mod_cnt + 1
    return vobj(exports_oid)
}

// === Map/Set method dispatch (in do_member) ===
fn map_set_method(oid: int, prop: string) -> string {
    var type_val = oget(oid, "__type__")
    var type_s = vtostr(type_val)
    // Map/Set keep their entries in a second object (__data__); Promise does not,
    // and to_int("") panics, so this must be guarded rather than assumed.
    var did = 0
    var data_v = oget(oid, "__data__")
    if vtag(data_v) == "o" { did = vdata(data_v).to_int() }
    if type_s == "Map" {
        if prop == "set" { if tt == 30 { next(); var k = vtostr(p_expr()); if tt == 36 { next() } var v = p_expr(); if tt == 31 { next() } oset(did, k, v); return vobj(oid) } return vundef() }
        if prop == "get" { if tt == 30 { next(); var k = vtostr(p_expr()); if tt == 31 { next() } return oget(did, k) } return vundef() }
        if prop == "has" { if tt == 30 { next(); var k = vtostr(p_expr()); if tt == 31 { next() } return vbool(ohas(did, k)) } return vundef() }
        if prop == "delete" { if tt == 30 { next(); var k = vtostr(p_expr()); if tt == 31 { next() } oset(did, k, vundef()); return vbool(1) } return vundef() }
        if prop == "size" { return vnum(olen(did)) }
        if prop == "keys" { if tt == 30 { next(); if tt == 31 { next() } } return varr(okeys_arr(did)) }
        if prop == "values" {
            if tt == 30 { next(); if tt == 31 { next() } }
            var aid = anew()
            var ks = okeys(did)
            for k in ks { apush(aid, oget_own(did, k)) }
            return varr(aid)
        }
        if prop == "forEach" {
            if tt == 30 { next(); var cb = p_expr(); if tt == 31 { next() }
                var ks = okeys(did)
                for k in ks { callfn(cb, [oget_own(did, k), vstr(k)]) }
            }
            return vundef()
        }
    }
    if type_s == "Set" {
        if prop == "add" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } oset(did, vtostr(v), v); return vobj(oid) } return vundef() }
        if prop == "has" { if tt == 30 { next(); var v = p_expr(); if tt == 31 { next() } return vbool(ohas(did, vtostr(v))) } return vundef() }
        if prop == "delete" { if tt == 30 { next(); p_expr(); if tt == 31 { next() } return vbool(1) } return vundef() }
        if prop == "size" { return vnum(olen(did)) }
        if prop == "forEach" {
            if tt == 30 { next(); var cb = p_expr(); if tt == 31 { next() }
                var ks = okeys(did)
                for k in ks { callfn(cb, [oget_own(did, k)]) }
            }
            return vundef()
        }
    }
    if type_s == "Promise" {
        if prop == "then" { if tt == 30 { next(); var cb = p_expr(); if tt == 31 { next() }
            var state = vtostr(oget(oid, "__state__"))
            if state == "fulfilled" { callfn(cb, [oget(oid, "__value__")]) }
            return vobj(oid)
        } return vundef() }
        if prop == "catch" { if tt == 30 { next(); var cb = p_expr(); if tt == 31 { next() }
            var state = vtostr(oget(oid, "__state__"))
            if state == "rejected" { callfn(cb, [oget(oid, "__value__")]) }
            return vobj(oid)
        } return vundef() }
    }
    return vundef()
}

// === Main ===
fn setup_globals() {
    // Math constants
    edef("Infinity", vstr("Infinity"))
    edef("NaN", vstr("NaN"))
    // setTimeout/setInterval (synchronous approximation)
    var st_fid = fcnt
    fparams[st_fid] = "fn,ms"
    fbodies[st_fid] = "fn();"
    fcnt = fcnt + 1
    edef("setTimeout", vfn(st_fid))
    edef("setInterval", vfn(st_fid))
    edef("clearTimeout", register_builtin("_noop"))
    edef("clearInterval", register_builtin("_noop"))
    // Promise.resolve / Promise.reject
    edef("Promise", vstr("_Promise"))
}

fn main() {
    init_env()
    setup_globals()
    var args = System.args()
    var js_file = ""
    // Check args: look for -- separator or last .js arg
    var found = 0
    for arg in args {
        if found == 1 { js_file = arg; break }
        if arg == "--" { found = 1 }
    }
    if js_file == "" {
        if args.len() > 1 { js_file = args[args.len() - 1] }
    }
    // Fallback: read from env or /tmp/_wynjs_input.js
    if js_file == "" or not js_file.ends_with(".js") {
        var env_file = System.env("WYNJS_FILE")
        if env_file.len() > 0 { js_file = env_file }
    }
    if js_file == "" or not js_file.ends_with(".js") {
        var tmp = File.read("/tmp/_wynjs_input.js")
        if tmp.len() > 0 { js_file = "/tmp/_wynjs_input.js" }
    }
    if js_file == "" { print("Usage: wynjs <file.js>"); return 1 }

    var code = File.read(js_file)
    if code.len() == 0 { print("Error: cannot read ${js_file}"); return 1 }

    src = sdup(code); pos = 0; next()
    while tt != 0 {
        p_stmt()
        if retflag == 1 or overflow == 1 or throwflag == 1 { break }
    }
    if overflow == 1 {
        print("RangeError: Maximum call stack size exceeded")
        return 1
    }
    if throwflag == 1 {
        // An Error object carries its text in .message; anything else stringifies.
        desc = vtostr(throwval)
        if vtag(throwval) == "o" {
            oid = vdata(throwval).to_int()
            nm = oget(oid, "name")
            msg = oget(oid, "message")
            if vtag(msg) != "u" {
                label = "Error"
                if vtag(nm) != "u" { label = vtostr(nm) }
                desc = label + ": " + vtostr(msg)
            }
        }
        print("Uncaught ${desc}")
        return 1
    }
    return 0
}
