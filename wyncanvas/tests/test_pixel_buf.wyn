import pixel

// Call convention (v1.20.0 codegen constraint, see the wyn compiler's issue tracker):
//   extern fns   -> called BARE          (wynimg_new)
//   pub fn Wyn   -> called QUALIFIED     (pixel.approx)

test "buffer reports its dimensions" {
    var b = wynimg_new(64, 32)
    assert_eq(wynimg_width(b), 64)
    assert_eq(wynimg_height(b), 32)
    wynimg_free(b)
}

test "new buffer is fully transparent" {
    var b = wynimg_new(8, 8)
    assert_true(pixel.approx(wynimg_get(b, 0), 0.0, 0.00001))
    assert_true(pixel.approx(wynimg_get(b, 3), 0.0, 0.00001))
    wynimg_free(b)
}

test "float roundtrip survives the FFI boundary" {
    var b = wynimg_new(8, 8)
    wynimg_set(b, 5, 0.875)
    assert_true(pixel.approx(wynimg_get(b, 5), 0.875, 0.00001))
    wynimg_free(b)
}

test "fill writes all four channels" {
    var b = wynimg_new(4, 4)
    wynimg_fill(b, 0.9, 0.2, 0.35, 1.0)
    assert_true(pixel.approx(wynimg_get(b, 0), 0.9, 0.00001))
    assert_true(pixel.approx(wynimg_get(b, 1), 0.2, 0.00001))
    assert_true(pixel.approx(wynimg_get(b, 2), 0.35, 0.00001))
    assert_true(pixel.approx(wynimg_get(b, 3), 1.0, 0.00001))
    wynimg_free(b)
}

test "px_index computes interleaved RGBA offsets" {
    assert_eq(pixel.px_index(64, 0, 0, 0), 0)
    assert_eq(pixel.px_index(64, 1, 0, 0), 4)
    assert_eq(pixel.px_index(64, 0, 1, 0), 256)
    // (y*w + x)*4 + c = (3*64 + 2)*4 + 2 = 194*4 + 2 = 778.
    // The plan wrote 794, which is an arithmetic slip: 794 would require
    // y*w + x == 198, i.e. four pixels further along than (2,3). The formula
    // and the implementation agree on 778.
    assert_eq(pixel.px_index(64, 2, 3, 2), 778)
}

test "out-of-range access is safe" {
    var b = wynimg_new(4, 4)
    assert_true(pixel.approx(wynimg_get(b, 99999), 0.0, 0.00001))
    assert_true(pixel.approx(wynimg_get(b, 0 - 5), 0.0, 0.00001))
    wynimg_set(b, 99999, 1.0)
    wynimg_set(b, 0 - 5, 1.0)
    assert_true(pixel.approx(wynimg_get(b, 0), 0.0, 0.00001))
    wynimg_free(b)
}

test "zero-size allocation is rejected, not crashed" {
    var b = wynimg_new(0, 0)
    assert_eq(wynimg_width(b), 0)
}

test "repeated alloc/free does not leak or crash" {
    var i = 0
    while i < 200 {
        var b = wynimg_new(64, 64)
        wynimg_fill(b, 0.5, 0.5, 0.5, 1.0)
        wynimg_free(b)
        i = i + 1
    }
    assert_true(true)
}

// Absurd dimensions must be REFUSED. `(size_t)w * h * 4` used to wrap: with
// w = 2305843009213693960, h = 2 it wrapped to 64, so calloc returned 256
// bytes while the struct kept the huge w. wynimg_count() then overflowed too
// (signed UB), defeating the bounds checks in get/set, and wynimg_fill wrote
// far past the end of the buffer (ASan: heap-buffer-overflow WRITE; non-ASan:
// SIGBUS).
test "an overflowing allocation is refused" {
    var b = wynimg_new(2305843009213693960, 2)
    assert_eq(b, 0)
    assert_eq(wynimg_width(b), 0)
    assert_eq(wynimg_height(b), 0)
}

test "a refused allocation is inert, not corrupting" {
    var b = wynimg_new(4611686018427387904, 1)
    assert_eq(b, 0)
    // Every operation on the rejected handle must be a safe no-op.
    wynimg_fill(b, 1.0, 1.0, 1.0, 1.0)
    wynimg_set(b, 0, 1.0)
    assert_true(pixel.approx(wynimg_get(b, 0), 0.0, 0.00001))
    wynimg_free(b)
}

// 100000 x 100000 = 10^10 px = 160 GB. calloc succeeds lazily, then the first
// wynimg_fill spends ~16 s faulting pages in -- a DoS rather than a crash.
test "an implausibly large but non-overflowing size is refused too" {
    assert_eq(wynimg_new(100000, 100000), 0)
}

// The cap must not reject anything realistic.
test "a large but legitimate image still allocates" {
    var b = wynimg_new(4000, 3000)   // 12 MP
    assert_eq(wynimg_width(b), 4000)
    assert_eq(wynimg_height(b), 3000)
    wynimg_free(b)
}
