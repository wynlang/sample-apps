import pixel

// Reference values are the standard separable blend formulas
// (PDF 1.7 / W3C compositing spec), computed by hand.
//
// Call convention (v1.20.0 codegen constraint, see WYN_FINDINGS.md):
//   extern fns   -> called BARE          (wynimg_blend_px)
//   pub fn Wyn   -> called QUALIFIED     (pixel.approx, pixel.blend_name)

test "normal returns the source" {
    assert_true(pixel.approx(wynimg_blend_px(0, 0.3, 0.7), 0.7, 0.00001))
}

test "multiply darkens" {
    // 0.5 * 0.5 = 0.25
    assert_true(pixel.approx(wynimg_blend_px(1, 0.5, 0.5), 0.25, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(1, 1.0, 0.4), 0.4, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(1, 0.0, 0.9), 0.0, 0.00001))
}

test "screen lightens" {
    // 1 - (1-0.5)(1-0.5) = 0.75
    assert_true(pixel.approx(wynimg_blend_px(2, 0.5, 0.5), 0.75, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(2, 0.0, 0.4), 0.4, 0.00001))
}

test "overlay switches on the backdrop" {
    // backdrop 0.25 <= 0.5 -> multiply branch: 2 * 0.25 * 0.6 = 0.3
    assert_true(pixel.approx(wynimg_blend_px(3, 0.25, 0.6), 0.3, 0.00001))
    // backdrop 0.75 > 0.5 -> screen branch:
    // 1 - 2*(1-0.75)*(1-0.6) = 1 - 2*0.25*0.4 = 0.8
    assert_true(pixel.approx(wynimg_blend_px(3, 0.75, 0.6), 0.8, 0.00001))
}

test "darken and lighten pick a channel" {
    assert_true(pixel.approx(wynimg_blend_px(4, 0.3, 0.7), 0.3, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(5, 0.3, 0.7), 0.7, 0.00001))
}

test "difference and exclusion" {
    assert_true(pixel.approx(wynimg_blend_px(14, 0.8, 0.3), 0.5, 0.00001))
    // 0.5 + 0.5 - 2*0.5*0.5 = 0.5
    assert_true(pixel.approx(wynimg_blend_px(15, 0.5, 0.5), 0.5, 0.00001))
}

test "hard light switches on the source" {
    // source 0.25 <= 0.5 -> multiply branch: 2 * 0.6 * 0.25 = 0.3
    assert_true(pixel.approx(wynimg_blend_px(8, 0.6, 0.25), 0.3, 0.00001))
}

test "every mode is identity-safe on a normal-over-nothing case" {
    // Blending any mode with an all-white backdrop and white source must
    // stay in range - catches NaN and unclamped output.
    var m = 0
    while m < 27 {
        var r = wynimg_blend_px(m, 1.0, 1.0)
        assert_true(r >= 0.0 - 0.00001)
        assert_true(r <= 1.0 + 0.00001)
        m = m + 1
    }
}

test "no mode produces out-of-range output for mid values" {
    var m = 0
    while m < 27 {
        var r = wynimg_blend_px(m, 0.4, 0.6)
        assert_true(r >= 0.0 - 0.00001)
        assert_true(r <= 1.0 + 0.00001)
        m = m + 1
    }
}

test "blend_name maps modes to labels" {
    assert_eq(pixel.blend_name(0), "normal")
    assert_eq(pixel.blend_name(1), "multiply")
    assert_eq(pixel.blend_name(2), "screen")
}

// VividLight is DEFINED as ColorBurn(cb, 2cs) / ColorDodge(cb, 2cs-1), and
// those formulas guard on the BACKDROP first. Testing cs first inverted both
// corners: black backdrop -> white, white backdrop -> black, a full-scale
// error at exactly byte 0 and byte 255.
test "vivid_light guards on the backdrop, not the source" {
    // Black backdrop stays black however bright the source.
    assert_true(pixel.approx(wynimg_blend_px(13, 0.0, 0.999999), 0.0, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(13, 0.0, 1.0), 0.0, 0.00001))
    // White backdrop stays white however dark the source.
    assert_true(pixel.approx(wynimg_blend_px(13, 1.0, 0.000001), 1.0, 0.00001))
    assert_true(pixel.approx(wynimg_blend_px(13, 1.0, 0.0), 1.0, 0.00001))
}

// The old form jumped 0 -> 1 across a source step of 1e-6.
test "vivid_light is continuous at the source endpoints" {
    var lo = wynimg_blend_px(13, 0.0, 0.999999)
    var hi = wynimg_blend_px(13, 0.0, 1.0)
    var d = lo - hi
    if d < 0.0 { d = 0.0 - d }
    assert_true(d < 0.00001)
}

// VividLight must still agree with its definition away from the corners.
test "vivid_light matches ColorBurn and ColorDodge in the interior" {
    // cs = 0.25 -> ColorBurn(cb, 0.5)
    assert_true(pixel.approx(wynimg_blend_px(13, 0.6, 0.25),
                             wynimg_blend_px(7, 0.6, 0.5), 0.00001))
    // cs = 0.75 -> ColorDodge(cb, 0.5)
    assert_true(pixel.approx(wynimg_blend_px(13, 0.4, 0.75),
                             wynimg_blend_px(6, 0.4, 0.5), 0.00001))
}
