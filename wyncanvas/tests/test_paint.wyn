// test_paint - the brush, the eraser, the fill and the colour model, asserted on
// PIXELS.
//
// Every assertion here reads back an un-premultiplied channel with wynimg_pick
// and compares it to a value derived from first principles, not from a previous
// run. That matters for two of them in particular:
//
//   * "overlapping segments do not accumulate" is the bug a dab-based brush has
//     and this one must not: it paints the same place twice at alpha 0.5 and
//     asserts the result is still 0.5, not 0.75.
//   * "the brush composites in linear light" checks the actual stored float
//     against srgb_to_linear of the picked colour, so painting sRGB values
//     straight into the buffer would fail even though it would look plausible.

import pixel
import layer
import history
import select
import paint

// assert_eq COMPARES FLOATS, and this file's assertions depend on it.
//
// It used to route every numeric comparison through an INT compare, truncating
// both sides - so any two values inside one unit interval were equal and
// `assert_eq(coverage, 0.0)` passed for coverage 0.9999. Thirty-five of the
// assertions in this file and one in tests/test_history.wyn were vacuous in
// exactly that way: every `assert_eq(wynimg_pick(...), 0.0)`, every
// `assert_eq(wynimg_max_diff(a, b), 0.0)`, the three stroke-carry values, the
// frozen radius and the two wrapped angles. Each was re-checked against the
// compiler that compares floats and each is now genuinely asserted (verified by
// perturbing all 51 expectations by +0.4 and confirming every one goes red - none
// were hiding a defect, because the pixels had always been right).
//
// The ones that were ALREADY real are worth naming too, because it is not
// obvious: `assert_eq(wynimg_pick(...), 1.0)` on a channel clamped to [0,1] could
// only be satisfied by exactly 1.0 even under truncation, since the truncating
// compare accepted [1,2) and nothing in that range but 1.0 is reachable.
//
// This is the guard. If the float arm ever regresses, this test is the one that
// says so instead of the whole file silently going vacuous again.
test "assert_eq compares FLOATS, not their truncations" {
    // Two values in the same unit interval must NOT be equal. `approx` with a
    // tolerance smaller than the difference is the phrasing that cannot itself be
    // fooled - if assert_eq truncated, the line below would be the only thing left
    // asserting anything in half this file.
    assert_false(pixel.approx(0.0, 0.9999, 0.5))
    // ...and the compiler's own arm: a mismatch of 0.4 inside one interval must be
    // visible. Stated as an inequality on the SAME values assert_eq is handed
    // everywhere below.
    var a = pixel.srgb_to_linear(0.5)      // 0.2140, not 0
    assert_true(a > 0.2)
    assert_true(a < 0.22)
    assert_false(pixel.approx(a, 0.0, 0.2))
}

// A fresh single-layer document of transparent pixels, so each test starts from
// a known state (the layer and history stores are module-level and shared).
//
// The SELECTION is module-level state too, and it is released here rather than
// at the end of the tests that use one: a test that failed halfway would
// otherwise leave a selection behind and clip the next test's brush to it,
// turning one red assertion into a cascade of unrelated ones.
fn doc(w: int, h: int) -> int {
    layer.store_new()
    history.history_new()
    select.release()
    var b = wynimg_new(w, h)
    layer.add("paint", b, layer.KIND_RASTER())
    return b
}

test "a click paints a dab centred on the click" {
    var b = doc(64, 64)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 1.0, 1.0)          // pure red
    paint.set_radius(8.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 32.0, 32.0)
    paint.commit()

    // Centre is opaque red, EXACTLY. A hardness-1 core is coverage 1.0 and a pure
    // hue-0 red is (1,0,0) with no rounding anywhere on the path, so a tolerance
    // here would only be hiding a bug it was never going to catch. These read as
    // 0.01-tolerance approx() calls in most of this file's history because
    // assert_eq truncated floats and an exact float assertion was not expressible.
    assert_eq(wynimg_pick(b, 32, 32, 3), 1.0)
    assert_eq(wynimg_pick(b, 32, 32, 0), 1.0)
    assert_eq(wynimg_pick(b, 32, 32, 1), 0.0)
    // A pixel well outside the radius is untouched - and `falloff` returns exactly
    // 0.0 at and past the rim, so this is 0.0 and not "small".
    assert_eq(wynimg_pick(b, 32, 50, 3), 0.0)
    // A pixel just inside the radius is painted.
    assert_true(wynimg_pick(b, 37, 32, 3) > 0.9)
}

test "the brush stores LINEAR light, not the sRGB value" {
    var b = doc(32, 32)
    paint.set_tool(paint.TOOL_BRUSH())
    // 50% grey in sRGB: v=0.5, s=0 => srgb 0.5 => linear 0.2140
    paint.set_hsv(0.0, 0.0, 0.5)
    paint.set_radius(6.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    paint.commit()

    var want = pixel.srgb_to_linear(0.5)
    var got = wynimg_pick(b, 16, 16, 0)
    // Guard against the test passing for the wrong reason: linear and sRGB must
    // actually differ here, or this asserts nothing.
    assert_true(want < 0.4)
    assert_true(pixel.approx(got, want, 0.002))
}

test "overlapping segments saturate instead of accumulating" {
    var b = doc(32, 32)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)
    paint.set_radius(6.0)
    paint.set_hardness(1.0)
    paint.set_alpha(0.5)
    paint.begin(0, 16.0, 16.0)
    // Ten more segments over the identical spot. A dab-compositing brush would
    // drive alpha to 1 - 0.5^11 = 0.9995 here.
    var i = 0
    while i < 10 {
        paint.seg(16.0, 16.0)
        i = i + 1
    }
    paint.commit()

    var a = wynimg_pick(b, 16, 16, 3)
    assert_true(pixel.approx(a, 0.5, 0.01))
}

test "a drag paints a continuous capsule, not dots" {
    var b = doc(96, 32)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(120.0, 1.0, 1.0)
    paint.set_radius(4.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 10.0, 16.0)
    // ONE segment spanning 70 pixels. If the brush stamped only at endpoints the
    // middle would be empty.
    paint.seg(80.0, 16.0)
    paint.commit()

    var x = 10
    var gaps = 0
    while x <= 80 {
        if wynimg_pick(b, x, 16, 3) < 0.9 { gaps = gaps + 1 }
        x = x + 1
    }
    assert_eq(gaps, 0)
    // ...and it did not bleed far past the ends.
    assert_true(wynimg_pick(b, 2, 16, 3) < 0.01)
    assert_true(wynimg_pick(b, 90, 16, 3) < 0.01)
}

test "soft edges fall off monotonically" {
    var b = doc(64, 64)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)
    paint.set_radius(20.0)
    paint.set_hardness(0.0)               // fully soft
    paint.set_alpha(1.0)
    paint.begin(0, 32.0, 32.0)
    paint.commit()

    var prev = 2.0
    var d = 0
    var falls = 0
    while d < 20 {
        var a = wynimg_pick(b, 32 + d, 32, 3)
        if a <= prev { falls = falls + 1 }
        prev = a
        d = d + 1
    }
    assert_eq(falls, 20)
    // Genuinely soft: the halfway point is neither 0 nor 1.
    var mid = wynimg_pick(b, 42, 32, 3)
    assert_true(mid > 0.05)
    assert_true(mid < 0.95)
}

// ---------------------------------------------------------------------------
// THE DAB ENGINE: spacing, the arc-length carry, falloff endpoints, pressure,
// scatter determinism and the calligraphic nib.
//
// Every one of these was written to fail against the brush that came before it -
// one swept capsule per input sample, no dabs, no pressure, no seed. They are
// listed with the exact mutation each one catches, because a brush test that
// passes with the feature reverted is worse than no test.
// ---------------------------------------------------------------------------

// A fresh brush with every dab knob at a known value. Tests that care about one
// knob call this and then change that one, so a default drifting cannot silently
// rewrite what a test is measuring.
fn round_brush(rad: float, hard: float, space: float) {
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 1.0, 1.0)
    paint.set_radius(rad)
    paint.set_hardness(hard)
    paint.set_alpha(1.0)
    paint.set_spacing(space)
    paint.set_angle(0.0)
    paint.set_aspect(1.0)
    paint.set_scatter(0.0)
    paint.set_seed(1)
    paint.set_smoothing(false)
}

test "dab count depends on the PATH, not on the input sample rate" {
    // MUTATION GUARD: place one dab per input sample and the 181-sample count
    // becomes 181 while the 2-sample count becomes 2. This is the assertion that
    // decouples the stroke's look from the pointer's report rate.
    var b = doc(200, 32)
    round_brush(8.0, 1.0, 0.25)          // spacing = 2.0 px
    paint.begin(0, 10.0, 16.0)
    paint.seg(190.0, 16.0)               // ONE 180px sample
    var coarse = paint.stroke_dabs()
    paint.commit()
    assert_eq(paint.stroke_segments(), 2)

    var b2 = doc(200, 32)
    round_brush(8.0, 1.0, 0.25)
    paint.begin(0, 10.0, 16.0)
    var i = 1
    while i <= 180 {                     // the same path, 180 one-px samples
        paint.seg(10.0 + i.to_float(), 16.0)
        i = i + 1
    }
    var fine = paint.stroke_dabs()
    paint.commit()
    assert_eq(paint.stroke_segments(), 181)

    // Same geometry => same dabs, from 2 samples or from 181.
    assert_eq(coarse, fine)
    // And the count is the one spacing predicts: 1 at the start plus 180/2.
    assert_eq(coarse, 91)
    assert_true(wynimg_pick(b, 100, 16, 3) > 0.99)
    assert_true(wynimg_pick(b2, 100, 16, 3) > 0.99)
}

test "spacing gives CONTINUOUS coverage along a fast drag" {
    // A 180px drag reported as a single sample. If dabs were stamped per sample
    // this is two discs 180px apart with nothing between them.
    var b = doc(200, 40)
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 10.0, 20.0)
    paint.seg(190.0, 20.0)
    paint.commit()

    // Sample the whole spine: no gaps, and the value is FULL, not a dab rim.
    var x = 10
    var gaps = 0
    var lowest = 2.0
    while x <= 190 {
        var a = wynimg_pick(b, x, 20, 3)
        if a < 0.99 { gaps = gaps + 1 }
        if a < lowest { lowest = a }
        x = x + 1
    }
    assert_eq(gaps, 0)
    assert_eq(lowest, 1.0)               // exactly saturated, not merely close
    // Off both ends it stops. Coverage past the radius is EXACTLY zero.
    assert_eq(wynimg_pick(b, 2, 20, 3), 0.0)
    assert_eq(wynimg_pick(b, 198, 20, 3), 0.0)
}

test "the leftover distance carries ACROSS segment boundaries" {
    // Radius 8, spacing 0.25 => a dab every 2.0 px. Walk 3 px at a time:
    // the dab positions must be 0,2,4,6,8,... regardless of where the sample
    // boundaries (3,6,9,12) fall.
    var b = doc(64, 32)
    round_brush(8.0, 1.0, 0.25)
    paint.begin(0, 10.0, 16.0)
    assert_eq(paint.stroke_dabs(), 1)
    assert_eq(paint.stroke_carry(), 2.0)

    // 10 -> 13: one dab at 12, 1.0 px still owed.
    paint.seg(13.0, 16.0)
    assert_eq(paint.stroke_dabs(), 2)
    assert_eq(paint.stroke_carry(), 1.0)
    // 13 -> 16: dabs at 14 and 16, 2.0 px owed again.
    // MUTATION GUARD: reset the carry per segment and this reads 4 dabs with the
    // first at 13 - i.e. a dab on every input point, spacing defeated.
    paint.seg(16.0, 16.0)
    assert_eq(paint.stroke_dabs(), 4)
    assert_eq(paint.stroke_carry(), 2.0)
    paint.cancel()
}

test "no double-darkening at a segment boundary" {
    // THE BUG THIS CATCHES: stamping each segment's START point as well as
    // carrying the arc length stamps every interior input sample twice. With
    // max() coverage a duplicate round dab is invisible, so the probe uses a
    // SCATTERED brush, where a second dab at the same arc length lands at a
    // second random offset and widens the stroke.
    //
    // The measurement is the painted AREA off the spine. One path, split two
    // ways: the split must not change it.
    var b = doc(120, 60)
    round_brush(5.0, 1.0, 0.5)
    paint.set_scatter(1.5)
    paint.set_seed(7)
    paint.begin(0, 10.0, 30.0)
    paint.seg(100.0, 30.0)               // ONE segment
    paint.commit()
    var one = 0
    var yy = 0
    while yy < 60 {
        var xx = 0
        while xx < 120 {
            if wynimg_pick(b, xx, yy, 3) > 0.5 { one = one + 1 }
            xx = xx + 1
        }
        yy = yy + 1
    }

    var b2 = doc(120, 60)
    round_brush(5.0, 1.0, 0.5)
    paint.set_scatter(1.5)
    paint.set_seed(7)
    paint.begin(0, 10.0, 30.0)
    paint.seg(55.0, 30.0)                // the SAME path, split in two
    paint.seg(100.0, 30.0)
    paint.commit()
    var two = 0
    var y2 = 0
    while y2 < 60 {
        var x2 = 0
        while x2 < 120 {
            if wynimg_pick(b2, x2, y2, 3) > 0.5 { two = two + 1 }
            x2 = x2 + 1
        }
        y2 = y2 + 1
    }

    // Identical, not merely similar: the split falls at 45px = an exact multiple
    // of the 2.5px spacing, so the carry is 0 there and every dab must land on
    // the same arc length in both runs.
    assert_eq(one, two)
    assert_true(one > 0)
    // ...and the dab COUNT is identical too, which is the direct statement that
    // the boundary neither dropped nor duplicated a dab.
    assert_eq(paint.stroke_dabs(), 37)
}

test "falloff is monotonic, exactly 1.0 at a hard centre and exactly 0.0 past the rim" {
    var b = doc(80, 80)
    round_brush(20.0, 1.0, 0.25)
    paint.begin(0, 40.0, 40.0)
    paint.commit()
    // A hardness-1 dab centre is EXACTLY saturated. assert_eq compares floats
    // now, so 0.9999 fails here - which is the point: coverage 1.0 is a contract
    // the eraser and the fill both rely on.
    assert_eq(wynimg_pick(b, 40, 40, 3), 1.0)
    // At and past the radius, EXACTLY nothing. A brush that tints pixels outside
    // its own footprint has no usable footprint.
    assert_eq(wynimg_pick(b, 40 + 20, 40, 3), 0.0)
    assert_eq(wynimg_pick(b, 40 + 25, 40, 3), 0.0)

    // Soft: strictly falling from centre to rim, with no plateau in the ramp.
    //
    // NB the dab is placed at 40.5, i.e. ON a pixel centre. A hardness-0 brush
    // has a solid core of exactly zero width, so coverage is 1.0 only where the
    // distance is 0 - and pixel (40,40) is sampled at (40.5,40.5), 0.707 px from
    // a dab at (40,40), which measures 0.99958. That is correct geometry, not a
    // rounding failure, and stating it this way keeps the exact-1.0 contract
    // asserted rather than loosened to a tolerance.
    var b2 = doc(80, 80)
    round_brush(20.0, 0.0, 0.25)
    paint.begin(0, 40.5, 40.5)
    paint.commit()
    assert_eq(wynimg_pick(b2, 40, 40, 3), 1.0)   // 1.0 exactly AT the centre
    assert_eq(wynimg_pick(b2, 61, 40, 3), 0.0)   // 0.0 exactly past the rim
    var prev = 1.01
    var d = 0
    var strictly_down = 0
    while d < 20 {
        var a = wynimg_pick(b2, 40 + d, 40, 3)
        if a < prev { strictly_down = strictly_down + 1 }
        prev = a
        d = d + 1
    }
    assert_eq(strictly_down, 20)          // every step down, none flat
}

test "a soft brush does not band: the falloff has no flat shelf" {
    // A cubic smoothstep has a discontinuous SECOND derivative at the ends,
    // which reads as a ring - Mach banding - at the inner edge. The quintic does
    // not. Measured as: consecutive first differences change smoothly, so no
    // single step is more than 3x its neighbour anywhere in the ramp.
    var b = doc(160, 160)
    round_brush(60.0, 0.0, 0.25)
    paint.begin(0, 80.0, 80.0)
    paint.commit()

    var d = 1
    var prev_step = 0.0
    var jumps = 0
    var last = wynimg_pick(b, 80, 80, 3)
    while d < 59 {
        var a = wynimg_pick(b, 80 + d, 80, 3)
        var step = last - a
        // Skip the first few, where the step is legitimately near zero (the
        // curve is flat by construction at the top) and a ratio is meaningless.
        if d > 6 {
            if step > prev_step * 3.0 + 0.001 { jumps = jumps + 1 }
        }
        prev_step = step
        last = a
        d = d + 1
    }
    assert_eq(jumps, 0)
    // And it is a real soft edge, not a hard one: the half-radius point sits
    // well inside (0,1).
    var mid = wynimg_pick(b, 110, 80, 3)
    assert_true(mid > 0.1)
    assert_true(mid < 0.9)
}

test "coverage combines with max(), so a SOFT stroke keeps its soft edge" {
    // THE MUTATION THIS EXISTS FOR: switch the dab stamp's max() to += and this
    // goes red. It is the assertion that survives where the alpha test below
    // cannot, and the difference is worth stating, because the += bug was
    // committed here once and reverted:
    //
    //   * At 25% spacing, a pixel one radius off the spine is inside ~8 dabs. Any
    //     one of them covers it at ~0.13; SUMMED that is >1, so += clamps it to
    //     1.0 and the soft rim becomes a hard one.
    //   * The 30%-alpha assertion below cannot catch that, because stroke_apply
    //     clamps coverage to 1 before compositing - alpha still reads 0.3. So a
    //     suite that tests only stroke alpha lets += back in.
    //
    // Measured on a hardness-0 brush: with max() the cross-section is a genuine
    // gradient and the half-radius point sits near 0.45; with += it is a flat
    // plateau of exactly 1.0 all the way out to ~0.6 of the radius.
    var b = doc(140, 90)
    round_brush(20.0, 0.0, 0.25)
    paint.begin(0, 40.0, 45.0)
    paint.seg(100.0, 45.0)
    paint.commit()

    // Half a radius off the spine: partly covered, and nowhere near saturated.
    var half = wynimg_pick(b, 70, 55, 3)
    assert_true(half > 0.2)
    assert_true(half < 0.75)
    // And the profile is still strictly falling out to the rim - a summed
    // coverage is flat at 1.0 for the first 12 of these 20 steps.
    var prev = 1.01
    var d = 0
    var down = 0
    while d < 20 {
        var a = wynimg_pick(b, 70, 45 + d, 3)
        if a < prev { down = down + 1 }
        prev = a
        d = d + 1
    }
    assert_eq(down, 20)
}

test "a 30%-alpha stroke over itself does NOT reach opacity" {
    // THE BUG THIS CATCHES, and it was committed here once and reverted:
    // accumulate coverage with += instead of max() and a stroke that overlaps
    // itself goes opaque. At 25% spacing every pixel on the spine is inside four
    // or more dabs, so += reaches 1.0 after a single straight drag - no dawdling
    // required. Then the doubling-back below buries it further.
    var b = doc(80, 80)
    round_brush(10.0, 1.0, 0.25)
    paint.set_alpha(0.3)
    paint.begin(0, 20.0, 40.0)
    paint.seg(60.0, 40.0)
    paint.seg(20.0, 40.0)                 // straight back over the same pixels
    paint.seg(60.0, 40.0)                 // and again
    paint.commit()

    // Still 30%, to within float rounding. With += this is 1.0.
    assert_true(pixel.approx(wynimg_pick(b, 40, 40, 3), 0.3, 0.005))
    assert_true(pixel.approx(wynimg_pick(b, 25, 40, 3), 0.3, 0.005))
    assert_true(pixel.approx(wynimg_pick(b, 55, 40, 3), 0.3, 0.005))
    // The colour is unmuddied too: red at 30% over transparent.
    assert_true(pixel.approx(wynimg_pick(b, 40, 40, 0), 1.0, 0.01))
}

// The painted width of the stroke at column x, in pixels with coverage above
// half. Width is the measurable a taper, a nib and a scatter all move, and
// counting it is more honest than reading one pixel: a single sample cannot tell
// "thinner" from "shifted".
fn width_at(b: int, x: int, h: int) -> int {
    var y = 0
    var n = 0
    while y < h {
        if wynimg_pick(b, x, y, 3) > 0.5 { n = n + 1 }
        y = y + 1
    }
    return n
}

test "pressure tapers the stroke: the end is measurably thinner than the start" {
    // A synthetic taper - pressure 1 down to 0.2 across the drag - is exactly
    // what a stylus reports, and driving it from the test is what makes the
    // stylus path verifiable without a stylus.
    var b = doc(140, 60)
    round_brush(12.0, 1.0, 0.2)
    paint.begin_p(0, 20.0, 30.0, 1.0)
    var i = 1
    while i <= 10 {
        var f = i.to_float() / 10.0
        paint.seg_p(20.0 + f * 100.0, 30.0, 1.0 - f * 0.8)
        i = i + 1
    }
    paint.commit()

    var w_start = width_at(b, 22, 60)
    var w_mid = width_at(b, 70, 60)
    var w_end = width_at(b, 118, 60)

    // Full radius at the start: 12 px radius => ~24 px of covered height.
    assert_eq(w_start, 24)
    // Pressure 0.2 at the end => radius 2.4, and the half-coverage contour of a
    // 2.4 px dab sampled on pixel centres spans 4 rows. Measured exactly, not
    // asserted loosely: a taper that scaled only ALPHA and not the radius would
    // leave this at 24 and still pass a "the end is lighter" test.
    assert_eq(w_end, 4)
    assert_true(w_mid < w_start)
    assert_true(w_end < w_mid)
}

test "a tapering tail stays CONTINUOUS: spacing follows the shrinking radius" {
    // MUTATION GUARD: step by the base radius instead of the current dab's
    // radius and the thin tail breaks into beads, because the dabs stay 20% of
    // the FULL radius apart while each one is a fifth of the size.
    var b = doc(140, 60)
    round_brush(12.0, 1.0, 0.25)
    paint.begin_p(0, 20.0, 30.0, 1.0)
    var i = 1
    while i <= 20 {
        var f = i.to_float() / 20.0
        paint.seg_p(20.0 + f * 100.0, 30.0, 1.0 - f * 0.85)
        i = i + 1
    }
    paint.commit()

    // Walk the spine right to the tail: no gap anywhere.
    var x = 21
    var gaps = 0
    while x <= 118 {
        if wynimg_pick(b, x, 30, 3) < 0.5 { gaps = gaps + 1 }
        x = x + 1
    }
    assert_eq(gaps, 0)
}

test "zero pressure paints nothing but does not hang or crash" {
    // A stylus that reports 0 on lift-off, and the degenerate case of the
    // pressure-scaled spacing step: radius 0 with a 0-length step would spin the
    // placement loop forever if the step were not floored.
    var b = doc(60, 60)
    round_brush(10.0, 1.0, 0.25)
    paint.begin_p(0, 30.0, 30.0, 0.0)
    paint.seg_p(50.0, 30.0, 0.0)
    paint.commit()
    assert_eq(wynimg_pick(b, 30, 30, 3), 0.0)
    assert_eq(wynimg_pick(b, 40, 30, 3), 0.0)
    // The run still advanced, so the stroke was processed rather than refused.
    assert_true(paint.stroke_dabs() > 1)
}

test "the same scatter seed paints identical pixels twice; a different seed differs" {
    // A randomised brush that cannot be reproduced cannot be tested - and worse,
    // cannot be undone and redone into the same image. So scatter is a hash of
    // (seed, dab index), never rand(): there is no hidden state, and replaying a
    // stroke replays the pixels.
    var b1 = doc(120, 60)
    round_brush(6.0, 1.0, 0.4)
    paint.set_scatter(1.5)
    paint.set_seed(12345)
    paint.begin(0, 15.0, 30.0)
    paint.seg(105.0, 30.0)
    paint.commit()

    var b2 = doc(120, 60)
    round_brush(6.0, 1.0, 0.4)
    paint.set_scatter(1.5)
    paint.set_seed(12345)                 // THE SAME SEED
    paint.begin(0, 15.0, 30.0)
    paint.seg(105.0, 30.0)
    paint.commit()

    // Byte-exact across the whole buffer, not "close": max_diff returns 2.0 on a
    // mismatch of dimensions, so a shape error cannot masquerade as a pass.
    assert_eq(wynimg_max_diff(b1, b2), 0.0)

    var b3 = doc(120, 60)
    round_brush(6.0, 1.0, 0.4)
    paint.set_scatter(1.5)
    paint.set_seed(999)                   // A DIFFERENT SEED
    paint.begin(0, 15.0, 30.0)
    paint.seg(105.0, 30.0)
    paint.commit()
    // Different pixels - otherwise the seed is being ignored and every "random"
    // brush is the same brush.
    assert_true(wynimg_max_diff(b1, b3) > 0.5)
}

test "scatter widens the stroke and leaves the spine no darker" {
    // Scatter must MOVE dabs off the path, not merely dither their coverage. The
    // measurable is width; and because coverage combines with max(), scattering
    // cannot make the spine darker than the unscattered stroke already is.
    var b = doc(120, 80)
    round_brush(5.0, 1.0, 0.4)
    paint.set_scatter(0.0)
    paint.begin(0, 15.0, 40.0)
    paint.seg(105.0, 40.0)
    paint.commit()
    var tight = width_at(b, 60, 80)

    var b2 = doc(120, 80)
    round_brush(5.0, 1.0, 0.4)
    paint.set_scatter(2.0)                // dabs up to 10 px off the path
    paint.set_seed(4)
    paint.begin(0, 15.0, 40.0)
    paint.seg(105.0, 40.0)
    paint.commit()

    // Widest column of the scattered stroke, so one lucky gap cannot fail it.
    var widest = 0
    var x = 30
    while x < 90 {
        var w = width_at(b2, x, 80)
        if w > widest { widest = w }
        x = x + 1
    }
    assert_true(widest > tight)
    assert_true(widest > 20)              // ~10 px radius of jitter, both sides
    assert_true(wynimg_pick(b2, 60, 40, 3) <= 1.0)
}

test "a calligraphic nib is directional: angle and aspect change the footprint" {
    // aspect 0.25 at angle 0 is a nib four times wider than it is tall. A round
    // brush would give the same number either way, which is why the assertion is
    // the RATIO of the two extents and not either one alone.
    var b = doc(80, 80)
    round_brush(16.0, 1.0, 0.25)
    paint.set_aspect(0.25)
    paint.set_angle(0.0)                  // major axis along x
    paint.begin(0, 40.0, 40.0)
    paint.commit()

    var tall = width_at(b, 40, 80)        // extent across the nib
    var wide = 0
    var x = 0
    while x < 80 {
        if wynimg_pick(b, x, 40, 3) > 0.5 { wide = wide + 1 }
        x = x + 1
    }
    // 16 px radius along x, 4 px across: ~32 wide, ~8 tall.
    assert_eq(wide, 32)
    assert_eq(tall, 8)

    // Rotate the same nib 90 degrees and the two swap. If angle were ignored
    // these would still read 32 and 8.
    var b2 = doc(80, 80)
    round_brush(16.0, 1.0, 0.25)
    paint.set_aspect(0.25)
    paint.set_angle(90.0)
    paint.begin(0, 40.0, 40.0)
    paint.commit()
    var tall2 = width_at(b2, 40, 80)
    var wide2 = 0
    var x2 = 0
    while x2 < 80 {
        if wynimg_pick(b2, x2, 40, 3) > 0.5 { wide2 = wide2 + 1 }
        x2 = x2 + 1
    }
    assert_eq(wide2, 8)
    assert_eq(tall2, 32)
}

test "a nib stroke is thin across its travel and thick across the other axis" {
    // The reason a calligraphic brush exists: dragging a wide-flat nib
    // horizontally paints a thin line, and dragging it vertically a thick one.
    var b = doc(100, 100)
    round_brush(14.0, 1.0, 0.2)
    paint.set_aspect(0.2)
    paint.set_angle(0.0)                  // nib long in x, thin in y
    paint.begin(0, 20.0, 50.0)
    paint.seg(80.0, 50.0)                 // dragged ALONG its long axis
    paint.commit()
    var along = width_at(b, 50, 100)

    var b2 = doc(100, 100)
    round_brush(14.0, 1.0, 0.2)
    paint.set_aspect(0.2)
    paint.set_angle(0.0)
    paint.begin(0, 50.0, 20.0)
    paint.seg(50.0, 80.0)                 // dragged ACROSS it
    paint.commit()
    var across = width_at(b2, 50, 100)

    // Along its long axis the nib sweeps its own thin height; across, it sweeps
    // the whole drag plus its thin height.
    assert_true(along < 8)
    assert_true(across > 60)
}

test "brush geometry is frozen at begin(), not sampled per segment" {
    // A slider dragged mid-stroke must not make the second half of one line a
    // different brush from the first: half a stroke at one radius is a bug that
    // only ever appears in the field, because a test that never moves a slider
    // mid-stroke cannot see it.
    var b = doc(140, 60)
    round_brush(4.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)
    paint.seg(70.0, 30.0)
    paint.set_radius(20.0)                // yanked mid-stroke
    paint.set_aspect(0.2)
    paint.seg(120.0, 30.0)
    paint.commit()

    // Both halves are still the radius-4 brush.
    assert_eq(width_at(b, 40, 60), 8)
    assert_eq(width_at(b, 100, 60), 8)
    // ...and the parameter really did change, so this is not passing vacuously.
    assert_eq(paint.radius(), 20.0)
}

test "input smoothing is OFF by default, so a corner stays a corner" {
    // The default MUST be off: the spline moves where dabs land, so switching it
    // on globally would change the geometry every other test in this file
    // describes. This is that guarantee, asserted rather than assumed.
    assert_false(paint.smoothing())

    // An L: right along y=20, then down at x=60. Unsmoothed, the inside of the
    // corner is square - the pixel diagonally outside the elbow is empty.
    var b = doc(100, 100)
    round_brush(3.0, 1.0, 0.25)
    paint.begin(0, 20.0, 20.0)
    paint.seg(60.0, 20.0)
    paint.seg(60.0, 60.0)
    paint.commit()
    // The corner is reached and the two arms are painted.
    assert_true(wynimg_pick(b, 60, 20, 3) > 0.9)
    assert_true(wynimg_pick(b, 40, 20, 3) > 0.9)
    assert_true(wynimg_pick(b, 60, 40, 3) > 0.9)
    // Nothing past the corner along the first arm: a straight chord stops at 60.
    assert_eq(wynimg_pick(b, 70, 20, 3), 0.0)
}

test "smoothing on rounds the corner and stays on the sampled points" {
    var b = doc(100, 100)
    round_brush(3.0, 1.0, 0.25)
    paint.set_smoothing(true)
    assert_true(paint.smoothing())
    paint.begin(0, 20.0, 20.0)
    paint.seg(60.0, 20.0)
    paint.seg(60.0, 60.0)
    paint.commit()

    // Catmull-Rom INTERPOLATES: the curve still passes through every reported
    // sample, so the stroke goes where the user pointed. That is the property
    // that makes smoothing acceptable at all - an approximating spline (a
    // B-spline) would cut the corner off entirely and paint somewhere the user
    // never was.
    assert_true(wynimg_pick(b, 20, 20, 3) > 0.9)
    assert_true(wynimg_pick(b, 60, 20, 3) > 0.9)
    assert_true(wynimg_pick(b, 60, 60, 3) > 0.9)

    // And the tangent is now continuous through the elbow: the curve leaves
    // (60,20) heading along (p2-p0)/2 = right AND down, so the second arm bows
    // OUTSIDE the corner before settling onto x=60. Measured as: the arm at y=30
    // reaches past x=60, which the unsmoothed stroke never does.
    //
    // This outward bulge is Catmull-Rom's OVERSHOOT, and it is the honest reason
    // smoothing is opt-in rather than free: a fast right-angle gains a small
    // flick past the corner. It is bounded (a few px at these radii) and it is
    // the price of a continuous tangent from an interpolating spline.
    var x = 0
    var rightmost = 0
    while x < 100 {
        if wynimg_pick(b, x, 30, 3) > 0.5 {
            if x > rightmost { rightmost = x }
        }
        x = x + 1
    }
    assert_true(rightmost > 63)

    paint.set_smoothing(false)            // module state is shared across tests
}

test "smoothing leaves a straight line straight" {
    // Catmull-Rom is linear on collinear input, so smoothing must not bow a
    // straight drag. If it did, every ruled line in the editor would sag.
    var b = doc(120, 40)
    round_brush(3.0, 1.0, 0.25)
    paint.set_smoothing(true)
    paint.begin(0, 10.0, 20.0)
    paint.seg(50.0, 20.0)
    paint.seg(90.0, 20.0)
    paint.seg(110.0, 20.0)
    paint.commit()
    paint.set_smoothing(false)

    // The whole spine is painted and nothing strays a full radius off it.
    var x = 11
    var gaps = 0
    while x <= 109 {
        if wynimg_pick(b, x, 20, 3) < 0.5 { gaps = gaps + 1 }
        x = x + 1
    }
    assert_eq(gaps, 0)
    assert_eq(wynimg_pick(b, 60, 25, 3), 0.0)
    assert_eq(wynimg_pick(b, 60, 15, 3), 0.0)
}

// ---------------------------------------------------------------------------
// SMOOTHING AT A STROKE'S TWO ENDS - the samples with no neighbour to fit
// through. Smoothing is off by default and that stays right; these are the
// assertions that the ON path is correct where it has least information.
//
// A REAL DEFECT LIVED HERE and these were written against it: the missing
// neighbour was collapsed onto the endpoint (p3 = p2), which HALVES the spline's
// speed at the end of every segment. Dabs are placed by arc length along the
// chord but drawn at the spline's parameter, so a half-speed end bunched them up.
// Measured on three collinear samples 60 px apart at 8 px spacing, dab centres
// came out 19 27 35 43 51 59 67 75 83 92 102 111 120 128 134 139 - the last six
// gaps 10, 9, 9, 8, 6, 5 instead of 8. On a straight line, which the spline is
// not even supposed to bend. Reflecting the missing neighbour
// (p3 = 2*p2 - p1, and p0 = 2*p1 - p2 at the start) makes the end tangent the
// chord and fixes it.
// ---------------------------------------------------------------------------

// The number of separate covered runs along row `y`, and the widest gap between
// them. Together these describe a dotted line exactly: the run count says how
// many dabs are resolvable and the gap says how evenly they are spread. A
// coverage sum could not - bunching dabs conserves it.
fn runs_on_row(b: int, y: int, w: int) -> int {
    var x = 0
    var inrun = 0
    var n = 0
    while x < w {
        var on = 0
        if wynimg_pick(b, x, y, 3) > 0.5 { on = 1 }
        if on == 1 and inrun == 0 {
            n = n + 1
            inrun = 1
        }
        if on == 0 { inrun = 0 }
        x = x + 1
    }
    return n
}

fn widest_gap_on_row(b: int, y: int, w: int) -> int {
    var x = 0
    var last = 0 - 1
    var worst = 0
    while x < w {
        if wynimg_pick(b, x, y, 3) > 0.5 {
            if last >= 0 {
                if x - last - 1 > worst { worst = x - last - 1 }
            }
            last = x
        }
        x = x + 1
    }
    return worst
}

test "smoothing does not bunch the dabs at a segment's END" {
    // THE REGRESSION. A widely-spaced brush makes each dab a separate dot, so the
    // spacing is directly measurable. Three collinear samples 60 px apart, dabs
    // 8 px apart: every gap must be the same, smoothed or not.
    //
    // MUTATION GUARD: put back p3 = p2 (pass x1/y1 as the fourth catmull argument
    // instead of the reflected point) and the smoothed run count drops while the
    // widest gap grows - the second half of the line goes denser than the first.
    var b = doc(200, 40)
    round_brush(2.0, 1.0, 4.0)            // dabs 8 px apart: separate dots
    paint.set_smoothing(true)
    paint.begin(0, 20.0, 20.0)
    paint.seg(80.0, 20.0)
    paint.seg(140.0, 20.0)
    paint.commit()
    paint.set_smoothing(false)
    var s_runs = runs_on_row(b, 20, 200)
    var s_gap = widest_gap_on_row(b, 20, 200)

    var b2 = doc(200, 40)
    round_brush(2.0, 1.0, 4.0)
    paint.begin(0, 20.0, 20.0)
    paint.seg(80.0, 20.0)
    paint.seg(140.0, 20.0)
    paint.commit()

    // Collinear input: Catmull-Rom is linear on it, so smoothing must be the
    // IDENTITY here - not merely similar. Asserted as byte-exact over the whole
    // buffer, because "16 dots either way" would also hold if they were 16 dots in
    // different places.
    assert_eq(wynimg_max_diff(b, b2), 0.0)
    assert_eq(s_runs, runs_on_row(b2, 20, 200))
    assert_eq(s_gap, widest_gap_on_row(b2, 20, 200))
    // ...and the numbers are the ones spacing predicts, so this cannot pass by
    // both strokes being equally wrong: 121 px of path at 8 px = 16 dots, radius 2
    // dots leave a 4 px gap between them.
    assert_eq(s_runs, 16)
    assert_eq(s_gap, 4)
}

test "smoothing at the START: the first segment has no p0 and is the chord" {
    // The first segment of a stroke has no previous input point. Its only
    // defensible interpretation is the straight chord - there is no information
    // about the curve yet - and that is what reflecting p0 gives.
    //
    // A LONE segment is the sharpest form of the check: both neighbours are
    // missing, both are reflected, and the algebra makes the higher-order terms
    // cancel exactly. So it must be BIT-identical to the unsmoothed stroke, in a
    // direction that is not axis-aligned (an axis-aligned line would also pass
    // under a bug that only moved points along the other axis).
    var b = doc(160, 160)
    round_brush(3.0, 1.0, 0.3)
    paint.set_smoothing(true)
    paint.begin(0, 20.0, 20.0)
    paint.seg(140.0, 130.0)              // one diagonal segment
    paint.commit()
    paint.set_smoothing(false)

    var b2 = doc(160, 160)
    round_brush(3.0, 1.0, 0.3)
    paint.begin(0, 20.0, 20.0)
    paint.seg(140.0, 130.0)
    paint.commit()
    assert_eq(wynimg_max_diff(b, b2), 0.0)

    // And a CLICK - a stroke with no seg at all, i.e. the first dab and nothing
    // else. Smoothing must not move it: the dab is stamped by dab_begin, which
    // never consults the spline, and this is the assertion that it stays that way.
    var b3 = doc(80, 80)
    round_brush(6.0, 1.0, 0.25)
    paint.set_smoothing(true)
    paint.begin(0, 40.0, 40.0)
    paint.commit()
    paint.set_smoothing(false)
    assert_eq(wynimg_pick(b3, 40, 40, 3), 1.0)
    assert_eq(paint.stroke_dabs(), 1)
}

test "smoothing at the END: the last sample is reached and not overshot along the path" {
    // The final segment is drawn with p3 REFLECTED, which makes the curve leave p2
    // with the chord's tangent - so the stroke stops AT the last reported sample
    // rather than flicking past it. A curve, not a straight line, so the spline is
    // genuinely bending and the end condition is doing work.
    var b = doc(200, 140)
    round_brush(2.0, 1.0, 0.25)
    paint.set_smoothing(true)
    paint.begin(0, 20.0, 100.0)
    paint.seg(60.0, 70.0)
    paint.seg(110.0, 55.0)
    paint.seg(170.0, 50.0)                // the LAST sample
    paint.commit()
    paint.set_smoothing(false)

    // The last sample is painted...
    assert_true(wynimg_pick(b, 170, 50, 3) > 0.9)
    // ...and nothing is painted past it. Radius 2 plus the antialiased rim reaches
    // column 172; 175 onward must be empty in EVERY row, which is the statement
    // that the curve did not continue beyond the user's last point.
    var x = 175
    var beyond = 0
    while x < 200 {
        var y = 0
        while y < 140 {
            if wynimg_pick(b, x, y, 3) > 0.01 { beyond = beyond + 1 }
            y = y + 1
        }
        x = x + 1
    }
    assert_eq(beyond, 0)
}

test "smoothing END: a stroke that doubles back does not fling past its turn" {
    // The worst end case: the last segment reverses direction, so p1's tangent
    // points one way and p2 is behind it. With p3 reflected the reversal is
    // followed rather than extrapolated through, and the paint stops at the
    // furthest point the pointer actually reached.
    var b = doc(200, 80)
    round_brush(3.0, 1.0, 0.25)
    paint.set_smoothing(true)
    paint.begin(0, 20.0, 40.0)
    paint.seg(120.0, 40.0)
    paint.seg(60.0, 40.0)                 // straight back over itself
    paint.commit()
    paint.set_smoothing(false)

    // The turn is painted, and nothing is more than the brush's own reach past it.
    assert_true(wynimg_pick(b, 120, 40, 3) > 0.9)
    assert_eq(wynimg_pick(b, 130, 40, 3), 0.0)
    assert_eq(wynimg_pick(b, 150, 40, 3), 0.0)
    // The doubled-back half is still one solid line, not a row of gaps: coverage
    // combines with max(), so painting over itself changes nothing.
    var x = 62
    var gaps = 0
    while x <= 118 {
        if wynimg_pick(b, x, 40, 3) < 0.9 { gaps = gaps + 1 }
        x = x + 1
    }
    assert_eq(gaps, 0)
}

test "smoothing keeps the dab count per segment, so the carry still means what it says" {
    // Dabs are placed by arc length along the CHORD even when the spline bends, so
    // switching smoothing on must not change how many dabs a segment gets. If it
    // did, the arc-length carry would no longer be comparable between the two
    // modes and every spacing assertion in this file would mean something
    // different with the checkbox ticked.
    var b = doc(300, 40)
    round_brush(2.0, 1.0, 4.0)
    paint.set_smoothing(true)
    paint.begin(0, 20.0, 20.0)
    assert_eq(paint.stroke_dabs(), 1)
    paint.seg(80.0, 20.0)
    var s1 = paint.stroke_dabs()
    paint.seg(140.0, 20.0)
    var s2 = paint.stroke_dabs()
    paint.seg(200.0, 20.0)
    var s3 = paint.stroke_dabs()
    var s_carry = paint.stroke_carry()
    paint.commit()
    paint.set_smoothing(false)

    var b2 = doc(300, 40)
    round_brush(2.0, 1.0, 4.0)
    paint.begin(0, 20.0, 20.0)
    paint.seg(80.0, 20.0)
    var p1 = paint.stroke_dabs()
    paint.seg(140.0, 20.0)
    var p2 = paint.stroke_dabs()
    paint.seg(200.0, 20.0)
    var p3 = paint.stroke_dabs()
    var p_carry = paint.stroke_carry()
    paint.commit()

    assert_eq(s1, p1)
    assert_eq(s2, p2)
    assert_eq(s3, p3)
    assert_eq(s_carry, p_carry)
    // 60 px per segment at 8 px spacing: 7 dabs, 4 px owed into the next segment,
    // so the carry accumulates 4, 8 (which pays for one more dab, leaving 0)...
    // stated as numbers so "equal but both wrong" cannot pass.
    assert_eq(s1, 8)
    assert_eq(s3, 23)
}

test "the dab knobs clamp instead of accepting nonsense" {
    paint.set_spacing(0.0)                // would be infinitely many dabs
    assert_true(paint.spacing() >= 0.01)
    paint.set_spacing(1000.0)
    assert_true(paint.spacing() <= 4.0)
    paint.set_aspect(0.0)                 // a zero-width nib paints nothing
    assert_true(paint.aspect() >= 0.05)
    paint.set_aspect(9.0)                 // >1 is the same nib rotated
    assert_eq(paint.aspect(), 1.0)
    paint.set_scatter(0.0 - 3.0)
    assert_eq(paint.scatter(), 0.0)
    paint.set_angle(360.0 + 45.0)
    assert_eq(paint.angle(), 45.0)
    paint.set_angle(0.0 - 90.0)
    assert_eq(paint.angle(), 270.0)
}

test "the eraser removes colour AND alpha together" {
    var b = doc(32, 32)
    wynimg_fill(b, 0.8, 0.1, 0.1, 1.0)    // opaque red, premultiplied
    paint.set_tool(paint.TOOL_ERASER())
    paint.set_radius(6.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    paint.commit()

    // Fully erased: alpha EXACTLY zero. And the RAW stored channel is exactly zero
    // too - an eraser that zeroed only alpha would leave premultiplied colour
    // behind and show a red halo the moment anything composited over it.
    //
    // Exact, not within 0.001: destination-out at coverage 1 and alpha 1 scales
    // every channel by (1 - 1) = 0, so anything but 0.0 means the eraser is not
    // reaching full strength - which a 0.001 tolerance would let through at the
    // 99.9%-erased mark, i.e. with a visible halo still present in 8-bit output.
    assert_eq(wynimg_pick(b, 16, 16, 3), 0.0)
    assert_eq(wynimg_get(b, pixel.px_index(32, 16, 16, 0)), 0.0)
    // Outside the brush the red survives, at full opacity.
    assert_eq(wynimg_pick(b, 2, 2, 3), 1.0)
}

test "a stroke is ONE undo entry and undo restores the pixels" {
    var b = doc(32, 32)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)    // opaque black
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)          // white
    paint.set_radius(5.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)

    assert_eq(history.depth(), 0)
    paint.begin(0, 16.0, 16.0)
    var i = 0
    while i < 40 {
        paint.seg(16.0 + i.to_float() * 0.2, 16.0)
        i = i + 1
    }
    paint.commit()

    // 41 applications of the brush; exactly one history entry.
    assert_eq(history.depth(), 1)
    assert_eq(history.undo_label(), "paint")
    assert_true(wynimg_pick(b, 16, 16, 0) > 0.9)

    // Undo copies a SNAPSHOT back, so the restored pixel is bit-identical to the
    // black it started as - not approximately black. A tolerance here would accept
    // a restore that had been through a lossy path (a re-composite, a re-encode),
    // which is exactly the class of undo bug worth catching.
    history.undo_any()
    assert_eq(wynimg_pick(b, 16, 16, 0), 0.0)
    assert_eq(wynimg_pick(b, 16, 16, 3), 1.0)

    history.redo_any()
    assert_true(wynimg_pick(b, 16, 16, 0) > 0.9)
}

test "undo writes back into the SAME buffer handle" {
    // The layer's handle is also held by the texture-upload path, so undo must
    // move contents, not swap handles. If it swapped, the handle recorded here
    // would still show the painted pixels after an undo.
    var b = doc(32, 32)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)
    paint.set_radius(5.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    paint.commit()
    history.undo_any()

    assert_eq(layer.buffer(0), b)
    assert_eq(wynimg_pick(b, 16, 16, 0), 0.0)
}

test "cancel puts the layer back and records nothing" {
    var b = doc(32, 32)
    wynimg_fill(b, 0.2, 0.2, 0.2, 1.0)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)
    paint.set_radius(6.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    assert_true(wynimg_pick(b, 16, 16, 0) > 0.9)
    paint.cancel()
    assert_eq(history.depth(), 0)
    assert_true(pixel.approx(wynimg_pick(b, 16, 16, 0), 0.2, 0.01))
}

test "bucket fill floods a bounded region and stops at the border" {
    var b = doc(40, 40)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)                 // black field
    wynimg_rect(b, 10, 10, 20, 20, 1.0, 1.0, 1.0, 1.0) // white box, unpremul in
    paint.set_tool(paint.TOOL_FILL())
    paint.set_hsv(0.0, 1.0, 1.0)                       // fill with red
    paint.set_alpha(1.0)
    paint.set_tolerance(0.05)

    var n = paint.fill_at(0, 20, 20)
    assert_eq(n, 400)                                  // exactly the 20x20 box

    // Inside: red. Just outside: still black.
    assert_true(wynimg_pick(b, 20, 20, 0) > 0.9)
    assert_true(pixel.approx(wynimg_pick(b, 20, 20, 1), 0.0, 0.01))
    assert_true(pixel.approx(wynimg_pick(b, 5, 5, 0), 0.0, 0.01))
    // The border pixels of the box are filled, the ones outside are not.
    assert_true(wynimg_pick(b, 10, 10, 0) > 0.9)
    assert_true(pixel.approx(wynimg_pick(b, 9, 10, 0), 0.0, 0.01))
}

test "a fill is one undoable entry" {
    var b = doc(20, 20)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)
    paint.set_tool(paint.TOOL_FILL())
    paint.set_hsv(60.0, 1.0, 1.0)
    paint.set_alpha(1.0)
    paint.set_tolerance(0.05)
    paint.fill_at(0, 10, 10)
    assert_eq(history.depth(), 1)
    assert_true(wynimg_pick(b, 0, 0, 0) > 0.9)
    history.undo_any()
    assert_true(pixel.approx(wynimg_pick(b, 0, 0, 0), 0.0, 0.01))
}

test "HSV to RGB hits the primaries exactly" {
    // "Exactly" in the test's NAME, and now in its assertions. A primary at s=v=1
    // is (c, y, 0) with c = 1 and y = 0, so every value below is an exact float -
    // the multiplies are by 1.0 and 0.0. The tolerance these used to carry was a
    // workaround for assert_eq truncating floats, and it let a hue wheel that was
    // 0.1% off at the primaries pass a test called "exactly".
    assert_eq(pixel.hsv_channel(0.0, 1.0, 1.0, 0), 1.0)
    assert_eq(pixel.hsv_channel(0.0, 1.0, 1.0, 1), 0.0)
    assert_eq(pixel.hsv_channel(120.0, 1.0, 1.0, 1), 1.0)
    assert_eq(pixel.hsv_channel(120.0, 1.0, 1.0, 0), 0.0)
    assert_eq(pixel.hsv_channel(240.0, 1.0, 1.0, 2), 1.0)
    // Cyan: no red, full green and blue.
    assert_eq(pixel.hsv_channel(180.0, 1.0, 1.0, 0), 0.0)
    assert_eq(pixel.hsv_channel(180.0, 1.0, 1.0, 1), 1.0)
    assert_eq(pixel.hsv_channel(180.0, 1.0, 1.0, 2), 1.0)
    // Zero saturation is grey at every hue: c = 0, so all three channels are the
    // achromatic floor `v` itself, with no arithmetic to round.
    assert_eq(pixel.hsv_channel(37.0, 0.0, 0.6, 0), 0.6)
    assert_eq(pixel.hsv_channel(37.0, 0.0, 0.6, 1), 0.6)
    assert_eq(pixel.hsv_channel(37.0, 0.0, 0.6, 2), 0.6)
}

test "RGB to HSV round-trips through HSV to RGB" {
    var h = 0.0
    while h < 360.0 {
        var r = pixel.hsv_channel(h, 0.8, 0.7, 0)
        var g = pixel.hsv_channel(h, 0.8, 0.7, 1)
        var b = pixel.hsv_channel(h, 0.8, 0.7, 2)
        assert_true(pixel.approx(paint.rgb_hue(r, g, b), h, 0.5))
        assert_true(pixel.approx(paint.rgb_sat(r, g, b), 0.8, 0.005))
        assert_true(pixel.approx(paint.rgb_val(r, g, b), 0.7, 0.005))
        h = h + 15.0
    }
}

test "the eyedropper reads a painted pixel back as the same colour" {
    var b = doc(32, 32)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(280.0, 0.7, 0.9)
    paint.set_radius(8.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    paint.commit()

    // Move the picker somewhere else entirely, then pick the painted pixel.
    paint.set_hsv(0.0, 0.0, 0.0)
    paint.pick_from(b, 16, 16)
    assert_true(pixel.approx(paint.hue(), 280.0, 1.0))
    assert_true(pixel.approx(paint.sat(), 0.7, 0.01))
    assert_true(pixel.approx(paint.val(), 0.9, 0.01))
}

test "brush parameters clamp instead of accepting nonsense" {
    paint.set_radius(0.0 - 5.0)
    assert_true(paint.radius() >= 0.5)
    paint.set_radius(9999.0)
    assert_true(paint.radius() <= 200.0)
    paint.set_alpha(4.0)
    assert_true(pixel.approx(paint.alpha(), 1.0, 0.001))
    paint.set_hardness(0.0 - 1.0)
    assert_true(pixel.approx(paint.hardness(), 0.0, 0.001))
    paint.set_hsv(720.0 + 30.0, 2.0, 0.0 - 1.0)
    assert_true(pixel.approx(paint.hue(), 30.0, 0.001))
    assert_true(pixel.approx(paint.sat(), 1.0, 0.001))
    assert_true(pixel.approx(paint.val(), 0.0, 0.001))
    paint.set_tool(99)
    assert_true(paint.tool() <= 3)
}

test "painting an adjustment layer is refused, not crashed" {
    layer.store_new()
    history.history_new()
    layer.add("brighten", 0, layer.KIND_ADJUST_BRIGHTNESS())
    assert_eq(paint.begin(0, 1.0, 1.0), 0)
    assert_false(paint.stroke_active())
    assert_eq(paint.fill_at(0, 1, 1), 0 - 1)
    assert_eq(history.depth(), 0)
}

test "a stroke on a layer with a mask still lands in the layer's own pixels" {
    // Painting writes the layer buffer directly; the mask affects COMPOSITING,
    // not the brush. A brush that consulted the mask would make masks
    // destructive, which is the opposite of the point.
    var b = doc(32, 32)
    var m = wynimg_new(32, 32)
    wynimg_fill(m, 0.0, 0.0, 0.0, 1.0)     // mask fully hides the layer
    layer.set_mask(0, m)
    paint.set_tool(paint.TOOL_BRUSH())
    paint.set_hsv(0.0, 0.0, 1.0)
    paint.set_radius(5.0)
    paint.set_hardness(1.0)
    paint.set_alpha(1.0)
    paint.begin(0, 16.0, 16.0)
    paint.commit()
    assert_true(wynimg_pick(b, 16, 16, 3) > 0.9)
}

// ---------------------------------------------------------------------------
// THE SELECTION CLIPS THE STROKE, not merely gates it at the press.
//
// This was a stated limitation of the editor: pressing outside a selection did
// nothing, but a stroke that STARTED inside and was dragged out kept painting
// past the boundary. The fix is one multiply in src/paint.wyn's apply_cov, and
// these are the assertions that make it real. Each names the mutation it dies
// to, because the interesting failures here are all silent.
// ---------------------------------------------------------------------------

test "a stroke dragged OUT of a selection is CUT at the boundary" {
    // MUTATION GUARD: make clipped_cov return s_cov unconditionally (i.e. make
    // the clip a no-op) and the two "outside" assertions go red at 1.0.
    var b = doc(200, 60)
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())   // left half only
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)      // press INSIDE the selection
    paint.seg(180.0, 30.0)          // and drag right out of it
    paint.commit()

    // Inside: fully painted, exactly - the clip must not dim what it lets
    // through, and a hard selection edge multiplies by exactly 1.
    assert_eq(wynimg_pick(b, 20, 30, 3), 1.0)
    assert_eq(wynimg_pick(b, 50, 30, 3), 1.0)
    assert_eq(wynimg_pick(b, 99, 30, 3), 1.0)   // the last selected column
    // Outside: EXACTLY nothing, all the way to the far end of the drag. Not
    // "faint" - the coverage was multiplied by 0.
    assert_eq(wynimg_pick(b, 100, 30, 3), 0.0)  // the first unselected column
    assert_eq(wynimg_pick(b, 150, 30, 3), 0.0)
    assert_eq(wynimg_pick(b, 180, 30, 3), 0.0)
    select.release()
}

test "the clip does not corrupt the stroke's BASE outside the selection" {
    // The pre-stroke pixels are the `base` snapshot stroke_apply rebuilds from.
    // Clipping s_cov in place would be one bug; clipping the BASE would be a
    // worse one - the layer outside the selection would be rebuilt from a
    // multiplied snapshot and go transparent, i.e. a stroke inside a selection
    // would ERASE the rest of the layer. This is the assertion that it does not.
    var b = doc(120, 60)
    wynimg_fill(b, 0.0, 0.0, 0.4, 1.0)          // opaque blue everywhere
    select.init(120, 60)
    select.rect(0.0, 0.0, 60.0, 60.0, select.OP_REPLACE())
    round_brush(8.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)
    paint.seg(100.0, 30.0)
    paint.commit()

    // Inside the selection: red, painted over the blue.
    assert_true(wynimg_pick(b, 20, 30, 0) > 0.9)
    // Outside: the ORIGINAL blue, untouched in every channel, not a dimmed or
    // transparent version of it.
    assert_eq(wynimg_pick(b, 100, 30, 3), 1.0)
    assert_eq(wynimg_pick(b, 100, 30, 0), 0.0)
    assert_true(pixel.approx(wynimg_pick(b, 100, 30, 2), 0.4, 0.001))
    // ...including the row the stroke never went near.
    assert_eq(wynimg_pick(b, 100, 5, 3), 1.0)
    select.release()
}

test "a FEATHERED selection edge gives the stroke partial alpha" {
    // The clip is a multiply, so it is exact on fractional coverage - which is
    // the property that makes one clipping path enough for hard, antialiased and
    // feathered selections alike. A threshold-based clip would give 0 or 1 here.
    //
    // One box pass at radius 4 is a linear ramp, so the expected values are
    // countable by hand: 9 taps, coverage falling by 1/9 per column.
    var b = doc(200, 60)
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())
    select.feather_box(4.0, 1)
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)
    paint.seg(180.0, 30.0)
    paint.commit()

    // The painted alpha IS the selection coverage, column by column, because the
    // brush laid down coverage 1.0 along the whole spine.
    assert_eq(wynimg_pick(b, 96, 30, 3), select.cov_at(96, 30))
    assert_eq(wynimg_pick(b, 98, 30, 3), select.cov_at(98, 30))
    assert_eq(wynimg_pick(b, 100, 30, 3), select.cov_at(100, 30))
    assert_eq(wynimg_pick(b, 102, 30, 3), select.cov_at(102, 30))
    // And it is genuinely partial - stated as numbers so a clip that hardened
    // the edge could not pass by agreeing with a hardened cov_at.
    assert_true(pixel.approx(wynimg_pick(b, 98, 30, 3), 0.6667, 0.001))
    assert_true(pixel.approx(wynimg_pick(b, 100, 30, 3), 0.4444, 0.001))
    assert_true(pixel.approx(wynimg_pick(b, 102, 30, 3), 0.2222, 0.001))
    assert_eq(wynimg_pick(b, 104, 30, 3), 0.0)   // past the ramp: nothing
    select.release()
}

test "the clip is applied ONCE per apply, so a slow drag does not fade the edge" {
    // MUTATION GUARD: clip s_cov IN PLACE instead of on a copy and this goes
    // red. Every seg re-applies the whole coverage buffer, so an in-place
    // multiply compounds: a 0.44 feathered column would read 0.44^41 after 40
    // segments, i.e. the user's own dawdling would erase the selection's edge.
    // The 40-sample and 1-sample strokes must be pixel-identical.
    var few = doc(200, 60)
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())
    select.feather_box(4.0, 1)
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)
    paint.seg(180.0, 30.0)                   // ONE sample
    paint.commit()
    var one_edge = wynimg_pick(few, 100, 30, 3)

    var many = doc(200, 60)
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())
    select.feather_box(4.0, 1)
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 30.0)
    var i = 1
    while i <= 40 {                          // the same path, 40 samples
        paint.seg(20.0 + i.to_float() * 4.0, 30.0)
        i = i + 1
    }
    paint.commit()

    assert_eq(wynimg_pick(many, 100, 30, 3), one_edge)
    assert_true(pixel.approx(one_edge, 0.4444, 0.001))   // not decayed to ~0
    assert_eq(wynimg_max_diff(few, many), 0.0)           // byte-exact, whole buffer
    select.release()
}

test "an EMPTY selection means paint everywhere, not paint nothing" {
    // THE CONVERSION BUG THIS EXISTS FOR, and it has been made once already in
    // the filter integration: `select.is_empty()` is true both when there is no
    // selection buffer and when nothing is selected, and BOTH mean "no
    // clipping". Multiplying by the all-zeros mask instead makes the brush a
    // silent no-op - the tool appears broken with no error anywhere.
    //
    // Both spellings of "empty" are checked, because they take different paths:
    // an allocated-but-cleared selection, and a released one.
    var b = doc(120, 40)
    select.init(120, 40)
    select.select_none()
    assert_true(select.active())              // there IS a buffer...
    assert_true(select.is_empty())            // ...and it selects nothing
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 20.0)
    paint.seg(100.0, 20.0)
    paint.commit()
    assert_eq(wynimg_pick(b, 20, 20, 3), 1.0)
    assert_eq(wynimg_pick(b, 60, 20, 3), 1.0)
    assert_eq(wynimg_pick(b, 100, 20, 3), 1.0)

    // And with no selection object at all.
    var b2 = doc(120, 40)
    select.release()
    assert_false(select.active())
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 20.0)
    paint.seg(100.0, 20.0)
    paint.commit()
    assert_eq(wynimg_pick(b2, 60, 20, 3), 1.0)
}

test "select_all is indistinguishable from no selection" {
    // The clip runs for real here (the selection is not empty), so this is the
    // check that a coverage-1 multiply is the identity rather than nearly it.
    var b = doc(120, 40)
    select.release()
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 20.0)
    paint.seg(100.0, 20.0)
    paint.commit()

    var b2 = doc(120, 40)
    select.init(120, 40)
    select.select_all()
    assert_false(select.is_empty())
    round_brush(6.0, 1.0, 0.25)
    paint.begin(0, 20.0, 20.0)
    paint.seg(100.0, 20.0)
    paint.commit()

    assert_eq(wynimg_max_diff(b, b2), 0.0)
    select.release()
}

test "the ERASER is clipped by the selection too" {
    // The eraser is the case a post-hoc clip could not do correctly (source-over
    // cannot lower alpha, so compositing an unclipped erase back through the
    // selection leaves the alpha it was asked to remove). Clipping the coverage
    // instead is right for both tools by construction, and this is the assertion.
    var b = doc(200, 60)
    wynimg_fill(b, 0.6, 0.1, 0.1, 1.0)          // opaque red
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())
    round_brush(8.0, 1.0, 0.25)
    paint.set_tool(paint.TOOL_ERASER())
    paint.begin(0, 20.0, 30.0)
    paint.seg(180.0, 30.0)
    paint.commit()

    // Erased inside...
    assert_eq(wynimg_pick(b, 50, 30, 3), 0.0)
    // ...and NOT outside: alpha is untouched, and so is the premultiplied colour
    // (an eraser that zeroed only alpha would leave a red halo).
    assert_eq(wynimg_pick(b, 150, 30, 3), 1.0)
    assert_true(pixel.approx(wynimg_get(b, pixel.px_index(200, 150, 30, 0)),
                             0.6, 0.001))
    select.release()
    paint.set_tool(paint.TOOL_BRUSH())
}

test "a bucket fill is clipped by the selection" {
    // The fill shares the coverage/apply path, so it inherits the clip - and the
    // reported pixel count stays the FLOODED region's size, which is what the
    // status bar means by "filled N px". Asserting both keeps the two facts from
    // being conflated: the flood is unclipped, the PAINT is clipped.
    var b = doc(80, 40)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)          // one flat black region
    select.init(80, 40)
    select.rect(0.0, 0.0, 40.0, 40.0, select.OP_REPLACE())
    paint.set_tool(paint.TOOL_FILL())
    paint.set_hsv(0.0, 1.0, 1.0)
    paint.set_alpha(1.0)
    paint.set_tolerance(0.05)

    var n = paint.fill_at(0, 20, 20)
    assert_eq(n, 3200)                          // the whole 80x40 flood
    assert_true(wynimg_pick(b, 20, 20, 0) > 0.9)      // red inside
    assert_eq(wynimg_pick(b, 60, 20, 0), 0.0)         // still black outside
    assert_eq(wynimg_pick(b, 60, 20, 3), 1.0)         // and still opaque
    select.release()
    paint.set_tool(paint.TOOL_BRUSH())
}

test "a selection of the WRONG SIZE refuses the stroke instead of painting unclipped" {
    // The one way the clip can fail on live data: the selection was allocated for a
    // different document size, so `wynimg_sel_clip` refuses the dimension mismatch.
    // The choice then is "paint unclipped" or "paint nothing", and it must be the
    // second - a brush that ignored the selection because the mask was the wrong
    // size would overwrite the pixels the selection existed to protect.
    //
    // And begin() must leave NO active stroke when it returns 0, because that is its
    // documented contract and src/ui.wyn relies on it: a 0 means "cannot paint that
    // layer" and the UI never enters DRAG_STROKE, so a stroke left live would never
    // be committed or cancelled.
    var b = doc(64, 64)
    select.init(32, 32)                    // wrong size for a 64x64 layer
    select.select_all()
    round_brush(6.0, 1.0, 0.25)
    assert_eq(paint.begin(0, 32.0, 32.0), 0)
    assert_false(paint.stroke_active())
    assert_eq(wynimg_pick(b, 32, 32, 3), 0.0)   // nothing painted
    // Nothing to commit, and no record made.
    assert_eq(paint.seg(40.0, 32.0), 0)
    assert_eq(paint.commit(), 0)
    assert_eq(history.depth(), 0)
    select.release()
}

test "a clipped stroke is still ONE undo entry, and undo restores everything" {
    // The clip changes which pixels the stroke writes, not how many records it
    // makes: history snapshots the layer either side of the whole gesture, so the
    // clip must be invisible to it.
    var b = doc(200, 60)
    wynimg_fill(b, 0.0, 0.0, 0.0, 1.0)
    select.init(200, 60)
    select.rect(0.0, 0.0, 100.0, 60.0, select.OP_REPLACE())
    round_brush(8.0, 1.0, 0.25)
    paint.set_hsv(0.0, 0.0, 1.0)                // white
    paint.begin(0, 20.0, 30.0)
    var i = 1
    while i <= 20 {
        paint.seg(20.0 + i.to_float() * 8.0, 30.0)
        i = i + 1
    }
    paint.commit()
    assert_eq(history.depth(), 1)
    assert_true(wynimg_pick(b, 50, 30, 0) > 0.9)

    history.undo_any()
    assert_eq(wynimg_pick(b, 50, 30, 0), 0.0)
    assert_eq(wynimg_pick(b, 50, 30, 3), 1.0)
    history.redo_any()
    assert_true(wynimg_pick(b, 50, 30, 0) > 0.9)
    assert_eq(wynimg_pick(b, 150, 30, 0), 0.0)  // still clipped after a redo
    select.release()
}

test "the C picker ramps agree with the Wyn HSV conversion" {
    // csrc/wynimg_paint.c has its own hsv_rgb, because the ramps are built in C
    // for speed. Two implementations of one formula drift; this is the guard.
    // The ramp stores LINEAR values, so the comparison converts.
    var sv = wynimg_new(101, 101)
    assert_eq(wynimg_sv_square(sv, 210.0), 1)
    // x=0 is s=0, x=100 is s=1; y=0 is v=1, y=100 is v=0.
    var si = 0
    while si <= 100 {
        var vi = 0
        while vi <= 100 {
            var want_s = si.to_float() / 100.0
            var want_v = 1.0 - vi.to_float() / 100.0
            var ci = 0
            while ci < 3 {
                var want = pixel.srgb_to_linear(
                    pixel.hsv_channel(210.0, want_s, want_v, ci))
                assert_true(pixel.approx(wynimg_pick(sv, si, vi, ci), want, 0.002))
                ci = ci + 1
            }
            vi = vi + 25
        }
        si = si + 25
    }
    wynimg_free(sv)

    var hs = wynimg_new(4, 360)
    assert_eq(wynimg_hue_strip(hs), 1)
    var yy = 0
    while yy < 360 {
        var want_h = 360.0 * yy.to_float() / 360.0
        var c2 = 0
        while c2 < 3 {
            var w2 = pixel.srgb_to_linear(pixel.hsv_channel(want_h, 1.0, 1.0, c2))
            assert_true(pixel.approx(wynimg_pick(hs, 2, yy, c2), w2, 0.002))
            c2 = c2 + 1
        }
        yy = yy + 30
    }
    wynimg_free(hs)
}

test "the ramps refuse a degenerate buffer instead of dividing by zero" {
    var one = wynimg_new(1, 1)
    assert_eq(wynimg_sv_square(one, 0.0), 0)
    assert_eq(wynimg_hue_strip(one), 0)
    assert_eq(wynimg_sv_square(0, 0.0), 0)
    assert_eq(wynimg_hue_strip(0), 0)
    wynimg_free(one)
}
