import pixel
import layer
import history
import docsnap

// Call convention (v1.20.0 codegen constraint, see the wyn compiler's issue tracker):
//   extern fns   -> called BARE          (wynimg_new)
//   pub fn Wyn   -> called QUALIFIED     (layer.set_opacity, history.undo)
//
// WHY THE OPACITY ASSERTIONS BELOW ARE `assert_eq` AND NOT `approx`.
//
// An undo record stores the OLD VALUE and hands it straight back to
// layer.set_opacity, which only clamps. No arithmetic happens anywhere on that
// path, so a restored opacity is BIT-IDENTICAL to the value recorded - which makes
// exact equality the honest assertion and a tolerance a place for a lossy restore
// to hide.
//
// They were written as `pixel.approx(..., 0.00001)` for a real reason: `assert_eq`
// used to truncate both sides to int, so `assert_eq(opacity, 1.0)` accepted
// anything in [1,2) and `assert_eq(opacity, 0.4)` accepted anything in [0,1) -
// i.e. every wrong opacity there is. `approx` with a tight tolerance was the only
// float assertion available. It now compares floats, so the tolerance is gone
// where the value is provably exact; the ONE assertion that keeps a tolerance is
// the ramp in `history grows past its initial capacity`, whose expectation is
// itself computed (1.0 - i/100.0) and therefore not exact by construction.

test "a new history has nothing to undo" {
    history.history_new()
    assert_false(history.can_undo())
    assert_false(history.can_redo())
    assert_eq(history.depth(), 0)
}

test "undo restores a previous opacity" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 1.0, 0.4)
    assert_true(history.can_undo())

    history.undo()
    assert_eq(layer.opacity(id), 1.0)
    wynimg_free(b)
}

test "redo reapplies an undone change" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 1.0, 0.4)
    history.undo()
    assert_true(history.can_redo())

    history.redo()
    assert_eq(layer.opacity(id), 0.4)
    wynimg_free(b)
}

test "undo and redo work across several steps" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.8)
    history.record_opacity(id, 1.0, 0.8)
    layer.set_opacity(id, 0.6)
    history.record_opacity(id, 0.8, 0.6)
    layer.set_opacity(id, 0.2)
    history.record_opacity(id, 0.6, 0.2)
    assert_eq(history.depth(), 3)

    history.undo()
    assert_eq(layer.opacity(id), 0.6)
    history.undo()
    assert_eq(layer.opacity(id), 0.8)
    history.undo()
    assert_eq(layer.opacity(id), 1.0)
    assert_false(history.can_undo())

    history.redo()
    assert_eq(layer.opacity(id), 0.8)
    wynimg_free(b)
}

test "a new action after undo discards the redo branch" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.8)
    history.record_opacity(id, 1.0, 0.8)
    history.undo()
    assert_true(history.can_redo())

    layer.set_opacity(id, 0.3)
    history.record_opacity(id, 1.0, 0.3)
    assert_false(history.can_redo())
    assert_eq(history.depth(), 1)
    wynimg_free(b)
}

test "blend mode and visibility changes undo too" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_blend_mode(id, 5)
    history.record_blend(id, 0, 5)
    history.undo()
    assert_eq(layer.blend_mode(id), 0)

    layer.set_visible(id, false)
    history.record_visible(id, true, false)
    history.undo()
    assert_true(layer.visible(id))
    wynimg_free(b)
}

test "undo with an empty history is a safe no-op" {
    history.history_new()
    assert_eq(history.undo(), 0)
    assert_eq(history.redo(), 0)
}

test "entries carry human-readable labels" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())
    layer.set_opacity(id, 0.5)
    history.record_opacity(id, 1.0, 0.5)
    assert_eq(history.label(0), "opacity")
    wynimg_free(b)
}

// --- The load-bearing design decision: command records, never snapshots. ---

test "history records parameters, not pixels" {
    // The decisive property. If history snapshotted the canvas, undo would
    // also revert pixel edits made after the recorded action. It must not:
    // an entry is (op, target, old, new) and touches nothing else.
    layer.store_new()
    history.history_new()
    var b = wynimg_new(8, 8)
    wynimg_fill(b, 0.1, 0.1, 0.1, 1.0)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 1.0, 0.4)

    // Paint AFTER the recorded action.
    wynimg_set(b, 0, 0.9)
    history.undo()

    // Opacity reverted; the pixel edit survived untouched.
    assert_eq(layer.opacity(id), 1.0)
    assert_true(pixel.approx(wynimg_get(b, 0), 0.9, 0.00001))
    wynimg_free(b)
}

test "recording is O(1) in canvas size" {
    // A snapshot-based history scales with pixel count; command records do not.
    // The threshold below is calibrated against a MEASURED snapshot cost, not
    // guessed: a C driver copying 40 snapshots of this exact 2048x2048 RGBA
    // float32 buffer (64MB each) takes 584 ms and 2560 MB of RAM. Recording 40
    // command records copies 6 scalars each and takes ~0 ms.
    //
    // 150 ms sits far above the real cost and far below the snapshot cost, so
    // this test genuinely discriminates between the two designs. (An earlier
    // draft used a 512x512 canvas, where 40 real snapshots cost only 37.7 ms
    // and would have passed a 100 ms threshold -- a vacuous test.)
    layer.store_new()
    history.history_new()
    var big = wynimg_new(2048, 2048)
    var id = layer.add("big", big, layer.KIND_RASTER())

    var t0 = Time.now_millis()
    var i = 0
    while i < 40 {
        history.record_opacity(id, 1.0, 0.5)
        i = i + 1
    }
    var elapsed = Time.now_millis() - t0
    assert_eq(history.depth(), 40)
    assert_true(elapsed < 150)
    wynimg_free(big)
}

// --- Cursor edge cases the plan's tests do not reach. ---

test "redo past the newest entry is a safe no-op" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 1.0, 0.4)
    assert_false(history.can_redo())
    assert_eq(history.redo(), 0)
    // The extra redo must not have moved the cursor or reapplied anything.
    assert_eq(layer.opacity(id), 0.4)
    history.undo()
    assert_eq(layer.opacity(id), 1.0)
    wynimg_free(b)
}

test "undo past the oldest entry is a safe no-op" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 1.0, 0.4)
    history.undo()
    assert_eq(history.undo(), 0)
    assert_eq(history.undo(), 0)
    // Still fully redoable -- the failed undos did not corrupt the cursor.
    assert_true(history.can_redo())
    history.redo()
    assert_eq(layer.opacity(id), 0.4)
    wynimg_free(b)
}

test "depth counts entries, not remaining undos" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.8)
    history.record_opacity(id, 1.0, 0.8)
    layer.set_opacity(id, 0.6)
    history.record_opacity(id, 0.8, 0.6)
    assert_eq(history.depth(), 2)

    // Undo moves the cursor; the entries are still there to redo.
    history.undo()
    assert_eq(history.depth(), 2)
    history.undo()
    assert_eq(history.depth(), 2)
    assert_false(history.can_undo())
    assert_true(history.can_redo())
    wynimg_free(b)
}

test "repeated undo/redo cycling is stable" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.25)
    history.record_opacity(id, 1.0, 0.25)

    var i = 0
    while i < 20 {
        history.undo()
        assert_eq(layer.opacity(id), 1.0)
        history.redo()
        assert_eq(layer.opacity(id), 0.25)
        i = i + 1
    }
    assert_eq(history.depth(), 1)
    wynimg_free(b)
}

test "the redo branch is truncated, not merely hidden" {
    // Reusing a slot after truncation must overwrite every column. A stale
    // old_f left in a reused slot would make a later undo restore the wrong
    // value -- the classic parallel-array bug.
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_opacity(id, 0.8)
    history.record_opacity(id, 1.0, 0.8)
    layer.set_opacity(id, 0.6)
    history.record_opacity(id, 0.8, 0.6)
    layer.set_opacity(id, 0.4)
    history.record_opacity(id, 0.6, 0.4)
    assert_eq(history.depth(), 3)

    history.undo()
    history.undo()
    assert_eq(history.depth(), 3)

    // New action at cursor 1 discards entries 1 and 2 and reuses slot 1.
    layer.set_blend_mode(id, 2)
    history.record_blend(id, 0, 2)
    assert_eq(history.depth(), 2)
    assert_false(history.can_redo())
    assert_eq(history.label(1), "blend mode")

    // Undoing the reused slot must apply the BLEND old value, not the
    // opacity values that previously occupied it.
    history.undo()
    assert_eq(layer.blend_mode(id), 0)
    assert_eq(layer.opacity(id), 0.8)
    wynimg_free(b)
}

test "entries target their own layer independently" {
    layer.store_new()
    history.history_new()
    var b1 = wynimg_new(4, 4)
    var b2 = wynimg_new(4, 4)
    var a = layer.add("a", b1, layer.KIND_RASTER())
    var c = layer.add("c", b2, layer.KIND_RASTER())

    layer.set_opacity(a, 0.5)
    history.record_opacity(a, 1.0, 0.5)
    layer.set_opacity(c, 0.2)
    history.record_opacity(c, 1.0, 0.2)

    // Undo the newest entry only: layer c reverts, layer a does not.
    history.undo()
    assert_eq(layer.opacity(c), 1.0)
    assert_eq(layer.opacity(a), 0.5)
    wynimg_free(b1)
    wynimg_free(b2)
}

test "labels cover every op and reject out-of-range indices" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    history.record_opacity(id, 1.0, 0.5)
    history.record_blend(id, 0, 3)
    history.record_visible(id, true, false)
    assert_eq(history.label(0), "opacity")
    assert_eq(history.label(1), "blend mode")
    assert_eq(history.label(2), "visibility")
    assert_eq(history.label(3), "")
    assert_eq(history.label(0 - 1), "")
    wynimg_free(b)
}

test "history_new clears a populated history" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())
    history.record_opacity(id, 1.0, 0.5)
    history.record_opacity(id, 0.5, 0.2)
    history.undo()
    assert_eq(history.depth(), 2)

    history.history_new()
    assert_eq(history.depth(), 0)
    assert_false(history.can_undo())
    assert_false(history.can_redo())
    assert_eq(history.label(0), "")
    wynimg_free(b)
}

test "history grows past its initial capacity" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    // Walk opacity down in 50 steps, recording each.
    var i = 0
    while i < 50 {
        history.record_opacity(id, 1.0 - i / 100.0, 1.0 - (i + 1) / 100.0)
        i = i + 1
    }
    assert_eq(history.depth(), 50)
    layer.set_opacity(id, 0.5)

    // Undo all the way back; the oldest entry's old value is 1.0.
    var j = 0
    while j < 50 {
        history.undo()
        j = j + 1
    }
    assert_false(history.can_undo())
    assert_eq(layer.opacity(id), 1.0)
    wynimg_free(b)
}

// ---------------------------------------------------------------------------
// A DELETE RECORD CAPTURES THE LAYER'S MASK - the eleventh column.
//
// This was a stated limitation: undoing a delete restored the pixels and the
// properties but silently dropped the mask, because there was no column for it
// and the one spare handle column (h_b) is the one `discard_above` FREES. The
// shape of the loss is the same as the properties bug before it - the layer comes
// back, the image looks nearly right, and what is gone is invisible until
// someone looks for it.
// ---------------------------------------------------------------------------

// A mask with a per-pixel RAMP rather than a flat value, so a restore that
// handed back some OTHER coverage buffer of the right size cannot pass. Coverage
// lives in the R channel, matching wynimg_composite and the brush.
fn ramp_mask(w: int, h: int) -> int {
    var m = wynimg_new(w, h)
    var i = 0
    while i < w * h {
        wynimg_set(m, i * 4, i.to_float() / 100.0)
        i = i + 1
    }
    return m
}

test "undoing a delete restores the layer's MASK, not just its pixels" {
    // MUTATION GUARD: drop the h_m column (or the set_mask in apply_ex's
    // OP_DEL_LAYER undo) and the handle comes back 0 - layer.insert always writes
    // mask 0 - so both the handle and every coverage assertion below go red.
    layer.store_new()
    history.history_new()
    var b0 = wynimg_new(4, 4)
    layer.add("bottom", b0, layer.KIND_RASTER())
    var mid = wynimg_new(4, 4)
    layer.add("mid", mid, layer.KIND_RASTER())
    var msk = ramp_mask(4, 4)
    layer.set_mask(1, msk)
    assert_eq(layer.mask(1), msk)

    history.record_del_layer(1, layer.name(1), layer.buffer(1), layer.kind(1))
    layer.remove(1)
    assert_eq(layer.count(), 1)

    history.undo_any()
    assert_eq(layer.count(), 2)
    assert_eq(layer.buffer(1), mid)
    // The SAME mask handle, and it is still alive - layer.remove must not have
    // freed it, and neither must anything between the delete and the undo.
    assert_eq(layer.mask(1), msk)
    assert_eq(wynimg_alive(msk), 1)
    // ...and its COVERAGE is the values it had. Asserting the handle alone would
    // pass for a freed-and-reissued slot or for an all-zeros buffer.
    //
    // 0.0 is exact (zero is representable in float32); the others carry a 1e-6
    // tolerance for a REAL reason and not as a hedge - the buffer stores float32,
    // so 7/100 comes back as 0.07000000029802322 and an exact assert_eq against
    // the double 0.07 would fail on correct data. Stated so the difference between
    // "exact because the path is lossless" and "toleranced because float32 is not
    // float64" stays visible.
    assert_eq(wynimg_get(msk, 0), 0.0)
    assert_true(pixel.approx(wynimg_get(msk, 1 * 4), 0.01, 0.000001))
    assert_true(pixel.approx(wynimg_get(msk, 7 * 4), 0.07, 0.000001))
    assert_true(pixel.approx(wynimg_get(msk, 15 * 4), 0.15, 0.000001))
    wynimg_free(msk)
    wynimg_free(mid)
    wynimg_free(b0)
}

test "an unmasked layer comes back unmasked, not with a stale handle" {
    // The other half of the column: a record for a layer with no mask must store
    // 0, so undo restores 0. A column left holding a previous record's mask would
    // graft one layer's mask onto another - and it would look like a rendering bug
    // in the compositor, three files away from the cause.
    layer.store_new()
    history.history_new()
    layer.add("bottom", wynimg_new(4, 4), layer.KIND_RASTER())

    // First delete a MASKED layer, so the column is populated...
    var m1 = ramp_mask(4, 4)
    layer.add("masked", wynimg_new(4, 4), layer.KIND_RASTER())
    layer.set_mask(1, m1)
    history.record_del_layer(1, layer.name(1), layer.buffer(1), layer.kind(1))
    layer.remove(1)
    history.undo_any()
    assert_eq(layer.mask(1), m1)

    // ...then delete an UNMASKED one and undo that.
    layer.add("plain", wynimg_new(4, 4), layer.KIND_RASTER())
    assert_eq(layer.mask(2), 0)
    history.record_del_layer(2, layer.name(2), layer.buffer(2), layer.kind(2))
    layer.remove(2)
    history.undo_any()
    assert_eq(layer.count(), 3)
    assert_eq(layer.name(2), "plain")
    assert_eq(layer.mask(2), 0)
    // And the masked layer below still has ITS mask.
    assert_eq(layer.mask(1), m1)
    wynimg_free(m1)
}

test "redo of a delete re-captures the mask the layer has NOW" {
    // Between the undo and the redo the layer is live, so the user can change its
    // mask. A redo that re-used the recorded handle would resurrect a mask the
    // layer no longer has on the NEXT undo, and leak the one it does have.
    layer.store_new()
    history.history_new()
    layer.add("bottom", wynimg_new(4, 4), layer.KIND_RASTER())
    var m_old = ramp_mask(4, 4)
    layer.add("mid", wynimg_new(4, 4), layer.KIND_RASTER())
    layer.set_mask(1, m_old)

    history.record_del_layer(1, layer.name(1), layer.buffer(1), layer.kind(1))
    layer.remove(1)
    history.undo_any()
    assert_eq(layer.mask(1), m_old)

    // Swap the mask while the layer is back, then redo the delete and undo again.
    var m_new = wynimg_new(4, 4)
    wynimg_fill(m_new, 0.25, 0.0, 0.0, 1.0)
    layer.set_mask(1, m_new)
    history.redo_any()
    assert_eq(layer.count(), 1)
    history.undo_any()
    assert_eq(layer.mask(1), m_new)
    // 0.25 is a power of two, so it is exact in float32 as well as float64 - no
    // tolerance is warranted here, unlike the 7/100 ramp above.
    assert_eq(wynimg_get(m_new, 0), 0.25)
    wynimg_free(m_old)
    wynimg_free(m_new)
}

test "truncating the redo branch does not free a delete record's mask" {
    // `discard_above` frees OP_PIXELS's two snapshots, which it owns outright. It
    // must NOT touch h_m: a delete record's mask is either live in the layer store
    // or is the only reference to a deleted layer's mask, and freeing it would
    // make a later undo restore a stale handle - which the generation-tagged
    // handle table turns into a silently blank mask rather than a crash.
    layer.store_new()
    history.history_new()
    layer.add("bottom", wynimg_new(4, 4), layer.KIND_RASTER())
    var msk = ramp_mask(4, 4)
    layer.add("mid", wynimg_new(4, 4), layer.KIND_RASTER())
    layer.set_mask(1, msk)
    history.record_del_layer(1, layer.name(1), layer.buffer(1), layer.kind(1))
    layer.remove(1)

    // Undo, then record something else: the delete record itself is discarded.
    history.undo_any()
    assert_eq(layer.mask(1), msk)
    history.record_opacity(1, 1.0, 0.5)
    assert_false(history.can_redo())
    // The mask survived the truncation and is still the layer's.
    assert_eq(wynimg_alive(msk), 1)
    assert_eq(layer.mask(1), msk)
    assert_true(pixel.approx(wynimg_get(msk, 7 * 4), 0.07, 0.000001))
    wynimg_free(msk)
}

test "the eleventh column stays in step with the other ten" {
    // THE INVARIANT h_m WAS ADDED UNDER: one writer, so every column is the same
    // length by construction. The measured failure this guards was a second writer
    // that appended to only the first six columns - a scalar-only session advanced
    // h_len past h_a's length and the first structural undo panicked with
    // "array index out of bounds". Six scalar records then one structural undo is
    // exactly that shape, now with h_m as the newest column to fall behind.
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())
    var msk = ramp_mask(4, 4)
    layer.set_mask(id, msk)

    history.record_opacity(id, 1.0, 0.9)
    history.record_opacity(id, 0.9, 0.8)
    history.record_blend(id, 0, 3)
    history.record_blend(id, 3, 5)
    history.record_visible(id, true, false)
    history.record_visible(id, false, true)
    assert_eq(history.depth(), 6)

    // Now a structural record and its undo, which reads h_a/h_s/h_k/h_m at index 6.
    history.record_del_layer(id, layer.name(id), layer.buffer(id), layer.kind(id))
    layer.remove(id)
    history.undo_any()
    assert_eq(layer.count(), 1)
    assert_eq(layer.mask(0), msk)
    // ...and the six scalar entries still undo correctly underneath it.
    var i = 0
    while i < 6 {
        history.undo_any()
        i = i + 1
    }
    assert_false(history.can_undo())
    assert_eq(layer.opacity(0), 1.0)
    assert_eq(layer.blend_mode(0), 0)
    assert_true(layer.visible(0))
    wynimg_free(msk)
    wynimg_free(b)
}

test "visibility undo round-trips in both directions" {
    layer.store_new()
    history.history_new()
    var b = wynimg_new(4, 4)
    var id = layer.add("l", b, layer.KIND_RASTER())

    layer.set_visible(id, false)
    history.record_visible(id, true, false)
    history.undo()
    assert_true(layer.visible(id))
    history.redo()
    assert_false(layer.visible(id))

    // And the other direction: hidden -> shown.
    layer.set_visible(id, true)
    history.record_visible(id, false, true)
    history.undo()
    assert_false(layer.visible(id))
    history.redo()
    assert_true(layer.visible(id))
    wynimg_free(b)
}

// ---- whole-document transform (OP_DOC_XFORM) -------------------------------
//
// The opcode that unblocks rotate-90 / crop / scale. Everything else in this file
// records a scalar pair or two same-sized buffer handles; this one records a
// SNAPSHOT of every layer buffer and mask, because a size-changing transform
// changes every layer at once and OP_PIXELS's wynimg_copy_into restore requires the
// size to be unchanged.
//
// UNDO IS A SWAP, NOT A COPY - the one place in src/history.wyn that swaps handles.
// It has to be: the parked buffers are a DIFFERENT SIZE, so there is nothing of the
// right size to copy into. These tests pin what that buys and what it costs.

// A buffer whose pixels identify it, so a swap that returned the WRONG buffer of
// the right size cannot pass. R carries the index, G a per-buffer tag.
fn tagged(w: int, h: int, tag: float) -> int {
    var b = wynimg_new(w, h)
    var i = 0
    while i < w * h {
        wynimg_set(b, i * 4 + 0, i.to_float() / 64.0)
        wynimg_set(b, i * 4 + 1, tag)
        wynimg_set(b, i * 4 + 3, 1.0)
        i = i + 1
    }
    return b
}

// Builds the snapshot a doc transform's caller would: park the layers' CURRENT
// handles, install the transformed ones. Returns the snapshot id.
//
// This is deliberately the shape src/ui.wyn's apply path has to use, so these
// tests exercise the real contract rather than a convenient one: the layers must
// already hold the new buffers before the record is made.
fn swap_in(nw: int, nh: int, tag: float) -> int {
    var n = layer.count()
    var snap = docsnap.take(n, wynimg_width(layer.buffer(0)),
                            wynimg_height(layer.buffer(0)))
    var j = 0
    while j < n {
        var fresh = tagged(nw, nh, tag + j.to_float())
        docsnap.set_buf(snap, j, layer.set_buffer(j, fresh))
        var old_m = layer.mask(j)
        layer.set_mask(j, 0)
        docsnap.set_mask(snap, j, old_m)
        j = j + 1
    }
    return snap
}

test "a doc transform records one entry and labels it by name" {
    layer.store_new()
    history.history_new()
    var b = tagged(4, 2, 0.5)
    layer.add("l", b, layer.KIND_RASTER())

    var snap = swap_in(2, 4, 0.9)
    assert_true(history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90") > 0)
    assert_eq(history.depth(), 1)
    // THE LABEL MATTERS HERE MORE THAN ANYWHERE. Without a label_any case the
    // status bar says nothing for the one command that changes the whole document.
    assert_eq(history.undo_label(), "rotate 90")
    assert_true(history.can_undo())
    history.history_reset()
}

test "an unnamed doc transform still labels itself, rather than saying nothing" {
    layer.store_new()
    history.history_new()
    layer.add("l", tagged(4, 2, 0.5), layer.KIND_RASTER())
    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "")
    assert_eq(history.undo_label(), "transform document")
    history.history_reset()
}

test "a doc transform with a dead snapshot is REFUSED, not logged" {
    // A logged entry whose undo can restore nothing would silently drop the
    // pre-transform document on the first Ctrl+Z. A missing entry is a recoverable
    // annoyance; a corrupting one is not.
    layer.store_new()
    history.history_new()
    layer.add("l", tagged(4, 2, 0.5), layer.KIND_RASTER())
    assert_eq(history.record_doc_xform(0, 4, 2, 2, 4, "rotate 90"), 0)
    assert_eq(history.depth(), 0)

    var snap = docsnap.take(1, 4, 2)
    docsnap.discard(snap)
    assert_eq(history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90"), 0)
    assert_eq(history.depth(), 0)

    // ...and a nonsense size is refused for the same reason: doc_w_now() would
    // publish 0, which src/ui.wyn reads as "do not resize", so the document would
    // keep a stale size while holding resized buffers.
    var live = swap_in(2, 4, 0.9)
    assert_eq(history.record_doc_xform(live, 0, 2, 2, 4, "x"), 0)
    assert_eq(history.record_doc_xform(live, 4, 2, 2, 0, "x"), 0)
    assert_eq(history.depth(), 0)
    docsnap.discard(live)
}

test "undo of a doc transform restores every layer's buffer AND its size" {
    // THE CORE PROPERTY. Two layers, so "swaps the active layer only" fails.
    layer.store_new()
    history.history_new()
    var b0 = tagged(4, 2, 0.10)
    var b1 = tagged(4, 2, 0.20)
    layer.add("a", b0, layer.KIND_RASTER())
    layer.add("b", b1, layer.KIND_RASTER())

    var snap = swap_in(2, 4, 0.90)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")
    // The layers now hold the 2x4 buffers.
    assert_eq(wynimg_width(layer.buffer(0)), 2)
    assert_eq(wynimg_width(layer.buffer(1)), 2)

    history.undo_any()
    // Both original handles are back, identically - not a copy, the same handles.
    assert_eq(layer.buffer(0), b0)
    assert_eq(layer.buffer(1), b1)
    assert_eq(wynimg_width(layer.buffer(0)), 4)
    assert_eq(wynimg_height(layer.buffer(0)), 2)
    // ...and the SIZE the document must now have is published. A caller that
    // restored the pixels but not the size would install a correct picture at the
    // wrong stated size, which corrupts the texture on the NEXT refresh.
    assert_eq(history.doc_w_now(), 4)
    assert_eq(history.doc_h_now(), 2)

    history.redo_any()
    assert_eq(wynimg_width(layer.buffer(0)), 2)
    assert_eq(wynimg_height(layer.buffer(0)), 4)
    assert_eq(history.doc_w_now(), 2)
    assert_eq(history.doc_h_now(), 4)
    history.history_reset()
}

test "undo/redo of a doc transform is exact, and repeatable" {
    // The swap must be a true involution: the pixels after undo-redo-undo are the
    // ORIGINAL pixels, bit for bit. rot90 is an exact permutation and so is the
    // swap, so equality is the honest assertion here - a tolerance would let a
    // lossy restore hide, which is the argument this file's header makes for
    // opacity.
    layer.store_new()
    history.history_new()
    var b = tagged(4, 2, 0.375)
    layer.add("a", b, layer.KIND_RASTER())

    var snap = swap_in(2, 4, 0.75)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")

    var cycles = 0
    while cycles < 3 {
        history.undo_any()
        assert_eq(layer.buffer(0), b)
        assert_eq(history.doc_w_now(), 4)
        // Pixel-exact, not merely the right handle: G carries the buffer's tag.
        assert_eq(wynimg_get(layer.buffer(0), 1), 0.375)
        assert_eq(wynimg_get(layer.buffer(0), 4 * 4 + 0), 4.0 / 64.0)
        history.redo_any()
        assert_eq(wynimg_width(layer.buffer(0)), 2)
        assert_eq(history.doc_w_now(), 2)
        cycles = cycles + 1
    }
    history.history_reset()
}

test "a doc transform swaps MASKS as well as buffers" {
    // WHY THIS IS NOT OPTIONAL. wynimg_composite REFUSES a mask whose dimensions
    // disagree with the destination, so a resize that transformed buffers but left
    // masks at the old size would make every masked layer silently vanish from the
    // picture with no error reported anywhere.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())
    var m_old = ramp_mask(4, 2)
    layer.set_mask(0, m_old)

    var snap = swap_in(2, 4, 0.9)
    // swap_in parked the mask and left the layer unmasked, which is what a
    // transform that has not yet made a resized mask looks like.
    assert_eq(layer.mask(0), 0)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")

    history.undo_any()
    assert_eq(layer.mask(0), m_old)
    // The coverage is the original ramp, not some other buffer of the right size.
    assert_true(pixel.approx(wynimg_get(layer.mask(0), 3 * 4), 3.0 / 100.0, 0.00001))

    history.redo_any()
    assert_eq(layer.mask(0), 0)
    history.history_reset()
}

test "doc_w_now is -1 after an undo that did not resize the document" {
    // THE STALENESS BUG THIS GUARDS. If the published size were not cleared before
    // each apply, undoing a rotate and then undoing an unrelated opacity change
    // would leave the rotate's size published - and a UI that reads it after every
    // undo would resize a document that was correct. That is worse than the resize
    // never working.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())

    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")
    layer.set_opacity(0, 0.5)
    history.record_opacity(0, 1.0, 0.5)

    history.undo_any()                       // the opacity change
    assert_eq(history.doc_w_now(), 0 - 1)
    assert_eq(history.doc_h_now(), 0 - 1)
    history.undo_any()                       // the rotate
    assert_eq(history.doc_w_now(), 4)
    // ...and redoing the opacity change on top clears it again.
    history.redo_any()
    assert_eq(history.doc_w_now(), 2)
    history.redo_any()
    assert_eq(history.doc_w_now(), 0 - 1)
    history.history_reset()
}

test "a doc transform refuses to swap a layer store that has changed shape" {
    // The snapshot's slot count is the layer count it was taken at. Swapping
    // row-for-row into a store that has gained or lost rows would leave the
    // document holding buffers of two different sizes - which wynimg_composite
    // refuses layer by layer, i.e. a partial picture with no error anywhere.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())
    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")

    var extra = tagged(2, 4, 0.5)
    layer.add("b", extra, layer.KIND_RASTER())
    var before = layer.buffer(0)
    history.undo_any()
    // Refused: the buffers are untouched and no size is published.
    assert_eq(layer.buffer(0), before)
    assert_eq(history.doc_w_now(), 0 - 1)
    history.history_reset()
    wynimg_free(extra)
}

test "truncating the redo branch frees a doc transform's whole snapshot" {
    // THE LEAK THIS GUARDS is the entire document per discarded step - one full
    // float32 layer per row, 16 bytes a pixel - not the two buffers an OP_PIXELS
    // leak costs. wynimg_free of a stale handle is a deliberate no-op, so a
    // discard_above that missed OP_DOC_XFORM would look identical from outside;
    // wynimg_alive is what makes it observable.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())
    layer.add("b", tagged(4, 2, 0.2), layer.KIND_RASTER())

    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")

    // Undo first, so there IS a redo branch to truncate. This also moves the
    // originals back onto the layers and parks the TRANSFORMED pair - so the
    // handles read out of the snapshot must be read HERE, after the swap, not
    // before it. (Reading them before the undo is a real mistake and this test
    // caught it: it then asserts that the live layer buffers were freed.)
    history.undo_any()
    var parked0 = docsnap.buf_at(snap, 0)
    var parked1 = docsnap.buf_at(snap, 1)
    var on_layer0 = layer.buffer(0)
    var on_layer1 = layer.buffer(1)
    assert_eq(wynimg_alive(parked0), 1)
    // The two sides really are different buffers - otherwise "freed the parked
    // side, kept the live side" would be vacuous.
    assert_true(parked0 != on_layer0)

    // Record something else: the doc transform is now above h_pos and its snapshot
    // is unreachable, so push_all's discard_above(h_pos) must free it.
    layer.set_opacity(0, 0.5)
    history.record_opacity(0, 1.0, 0.5)

    // The entry is gone...
    assert_eq(history.depth(), 1)
    // ...and so is every buffer it owned - both rows, not just the first.
    assert_eq(wynimg_alive(parked0), 0)
    assert_eq(wynimg_alive(parked1), 0)
    assert_false(docsnap.alive(snap))
    // ...while the buffers that are ON THE DOCUMENT are untouched. A discard that
    // freed the wrong side of the swap would pass every assertion above and leave
    // the editor compositing freed memory.
    assert_eq(wynimg_alive(on_layer0), 1)
    assert_eq(wynimg_alive(on_layer1), 1)
    history.history_reset()
}

test "history_reset frees a doc transform's snapshot too" {
    // history_reset calls discard_above(0), so this is the same free path - but it
    // is the path that runs when the DOCUMENT is replaced (opening a file), where
    // the log is the only remaining reference to every parked buffer. Missing it
    // strands the whole outgoing document.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())
    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")
    var parked = docsnap.buf_at(snap, 0)
    assert_eq(wynimg_alive(parked), 1)

    history.history_reset()
    assert_eq(history.depth(), 0)
    assert_eq(wynimg_alive(parked), 0)
    assert_false(docsnap.alive(snap))
}

test "the twelfth column stays in step with the other eleven" {
    // THE INVARIANT h_snap WAS ADDED UNDER, and the second time this file has had
    // to assert it: one writer, so every column is the same length by construction.
    // The measured failure it guards was a second append site that wrote only some
    // columns - a session of one kind of record advanced h_len past another
    // column's length and the first read of that column panicked with "array index
    // out of bounds". Scalar records, then a structural one, then a doc transform
    // is exactly that shape with h_snap as the newest column to fall behind.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())

    history.record_opacity(0, 1.0, 0.9)
    history.record_blend(0, 0, 3)
    history.record_visible(0, true, false)
    history.record_name(0, "a", "b")
    assert_eq(history.depth(), 4)

    // Now a doc transform, which reads h_snap at index 4.
    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "rotate 90")
    assert_eq(history.depth(), 5)
    history.undo_any()
    assert_eq(history.doc_w_now(), 4)
    assert_eq(wynimg_width(layer.buffer(0)), 4)

    // ...and the four scalar entries still undo correctly underneath it.
    history.undo_any()
    assert_eq(layer.name(0), "a")
    history.undo_any()
    assert_true(layer.visible(0))
    history.undo_any()
    assert_eq(layer.blend_mode(0), 0)
    history.undo_any()
    assert_eq(layer.opacity(0), 1.0)
    assert_false(history.can_undo())
    history.history_reset()
}

test "a doc transform undoes correctly on a document with no mask anywhere" {
    // The common case, and the one the mask column must not disturb: an unmasked
    // layer must come back unmasked rather than with a stale handle from the
    // snapshot's zero-initialised mask slot.
    layer.store_new()
    history.history_new()
    layer.add("a", tagged(4, 2, 0.1), layer.KIND_RASTER())
    assert_eq(layer.mask(0), 0)
    var snap = swap_in(2, 4, 0.9)
    history.record_doc_xform(snap, 4, 2, 2, 4, "scale")
    history.undo_any()
    assert_eq(layer.mask(0), 0)
    history.redo_any()
    assert_eq(layer.mask(0), 0)
    history.history_reset()
}
