// ui - WynCanvas's editor window, natively, on SDL3.
//
// This replaces the webview-plus-localhost-HTTP UI in src/app.wyn. That design
// existed for one reason: the webview has no JS->Wyn IPC, so the only channel
// from a button to the imaging core was a socket. The cost was a whole HTTP
// server, a JSON encoder, a binary-safe file sender written in C to work around
// the runtime's inability to serve a PNG, and a document that could only reach
// the screen by being encoded to PNG and re-decoded by a browser. None of that
// is UI work.
//
// Here the same buttons call the same modules directly, and the document reaches
// the screen as a texture upload. src/app.wyn is left untouched and still works.
//
//   ./csrc/build.sh                        # once, and repos/gui/csrc/build.sh
//   WYN_ROOT=... wyn run src/ui.wyn
//
// THE VIEWPORT IS ONE UPLOAD AND ONE BLIT.
//
// Win_texture_update_f32 takes exactly the representation wynimg already holds -
// interleaved float32 RGBA, LINEAR light, PREMULTIPLIED - and converts to display
// encoding inside the backend. So the composite goes to the GPU with no
// conversion and no copy on this side, and the bulk pixels still never enter Wyn:
// csrc/wynimg_tex.c takes a texture handle and a buffer handle, two scalars, and
// does the hand-off in C where wynimg_deref lives.
//
// The alternative that must be named to be dismissed: painting the document with
// one Win_rect per pixel. A 1024x768 view is 786,432 calls per frame. That is not
// a slow version of this, it is a non-working version.
//
// NOTHING HERE KNOWS HOW TO COMPOSITE, BLEND, PAINT, LOAD OR SAVE.
//
// Every imaging operation is a call into the existing modules - render.compose,
// render.compose_to_png, paint.begin/seg/commit, view.screen_to_doc_*, layer.*,
// history.undo_any/redo_any. This file is layout, paint and dispatch. If a blend
// mode is wrong, it is wrong in csrc/, and no edit here could hide that.
//
// ---------------------------------------------------------------------------
// THE THREE THINGS THIS FILE OWNS, AND WHY THEY ARE HERE AND NOT ELSEWHERE
//
// 1. WHERE THE POINTER IS. `view` owns the transform and `paint` owns what a
//    stroke is; only this file knows the window's event stream. That split is
//    what makes the brush testable without a window: tests/test_paint.wyn drives
//    begin/seg/commit in DOCUMENT coordinates, tests/test_view.wyn asserts the
//    transform is invertible, and the only thing left is the composition of the
//    two - which the screenshot script below exercises by pushing real events and
//    reading pixels back.
//
// 2. THE CANVAS DRAG, which the widget toolkit deliberately does not model. The
//    toolkit's contract is "a click is a press and a release over the same
//    control"; a paint stroke is a press, an unbounded number of moves, and a
//    release, and its intermediate positions matter. So the canvas is NOT a
//    widget: `Ui_events` drains the queue and this file reads the resulting
//    pointer state each frame, which is enough because a stroke only needs to
//    know where the pointer is and whether the button is down.
//
//    THIS IS NOT A WORKAROUND but the correct division: making the canvas a
//    widget would mean teaching the toolkit about drag gestures for the benefit
//    of exactly one control.
//
// 3. THE FRAME. One Win_clear, all painting, one Win_present. `Ui_draw` is not
//    used, and that is a correctness requirement rather than a preference:
//    Ui_draw is a complete frame (it clears, paints and presents), so calling it
//    would force drawing the viewport either BEFORE the clear that erases it or
//    AFTER the present that ends the frame. The second appears to work - measured:
//    a rect drawn after Win_present is still in the next screenshot on this
//    backend - but SDL's contract is that the backbuffer is invalidated by
//    SDL_RenderPresent, so a double-buffered driver would flicker. That is
//    exactly the class of bug that is invisible on the machine it was written on.
//
// ---------------------------------------------------------------------------
// WHY HANDLERS SET FLAGS INSTEAD OF DOING THE WORK
//
// A Wyn closure cannot capture a mutable reference to surrounding state, so a
// handler receives only the widget id that was clicked and can reach only
// module-level state. For Undo, Redo, a tool change and a layer toggle that is
// enough: they need the id and the modules, both of which are in scope.
//
// Open and Save additionally need the path the user typed, which lives in the
// Ui - unreachable from a handler. Those two therefore record a REQUEST
// (`g_req`) and the frame loop, which does hold the Ui, services it. Not a
// workaround so much as the only shape available: it also means the file I/O
// happens at a known point in the frame rather than inside event dispatch.

import gui
import widgets
import layout
import pixel
import layer
import history
import render

// select and server both export a `pub fn handle` of different arity
// (select's coverage handle vs server's request handler). That used to require a
// specific import order to compile - a cross-module overload-mangling bug that
// emitted an undefined `handle_string` into one module's own internal call. Fixed
// upstream (wynlang/wyn #239); the order is now free.
import select
import server
import paint
import view
import project
import filter
import text
import xform
import docxform

// Bridge from a wynimg buffer handle to a GPU texture. Implemented in
// csrc/wynimg_tex.c, because resolving a handle to its `float*` requires
// wynimg_deref, which is internal to the shim on purpose - exposing it to Wyn
// would reintroduce the use-after-free the handle table prevents.
//
// Called BARE, not `wynimg::upload_tex`: this is the ENTRY file, where `extern
// fn` declarations are emitted unprefixed. The `::` spelling is only needed
// inside an imported module's `pub fn` (see the note in src/render.wyn).
extern fn wynimg_upload_tex(tex: int, p: int) -> int;

// ---- layout ---------------------------------------------------------------
//
// Window-space geometry, the region hit tests, the colour picker's mapping and
// the layer row bands now live in src/layout.wyn, where they are unit-tested
// without opening a window - see the header there for why the pairs that must
// agree (a control's paint position and its hit column) belong next to each
// other. This file keeps the state they are applied to.

// ---- state ----------------------------------------------------------------
//
// Module-level because handlers can reach nothing else. Each one is written by
// a handler or by the frame loop and read by the painter.

var g_win = -1
var g_font = -1

var g_doc_w = 0
var g_doc_h = 0

// The composited document, on the GPU. Recreated only when the document's
// dimensions change - a texture cannot be resized under its handle.
var g_tex = -1

// ---- marching ants ---------------------------------------------------------
//
// The selection's real boundary, as a second document-sized texture blitted over
// the composite. This replaces the bounding BOX the editor used to draw, which
// showed a rectangle around an ellipse and nothing at all of a feathered edge.
//
// A TEXTURE, NOT PER-PIXEL DRAWING, and that is the whole reason it is now
// affordable. Finding edge pixels from Wyn would be one `select.cov_at` FFI call
// per pixel per frame - 65,536 for a 256x256 document - which is the "one
// Win_rect per pixel" mistake this file's header rejects. `select.outline()` is
// one call into C that fills a coverage buffer, and the buffer reaches the screen
// the same way the document does: one upload, one blit.
//
// Rebuilt only when the selection CHANGES, tracked by a stamp rather than by
// recomputing every frame: the scan is O(pixels), so at 60fps on a large document
// it would be the most expensive thing the editor does, for a picture that did
// not move.
var g_ants_tex = -1
var g_ants_buf = 0
var g_ants_w = 0
var g_ants_h = 0
var g_ants_stamp = -1.0
var g_ants_ready = 0

// ---- filter strength -------------------------------------------------------
//
// Filter parameters used to be hardcoded, and the reason recorded here was that
// "the toolkit has no slider widget". That is no longer true - repos/gui grew
// Ui_slider, Ui_val and Ui_set_range - so the values are now driven by one
// control instead of frozen at the value a single click should mean.
//
// ONE slider, not one per parameter. A blur radius, a sharpen amount and a
// saturation multiplier are different quantities in different units, and a
// separate control for each would be five sliders in a 250px panel for a demo
// that has four filter buttons. So this is a STRENGTH in percent, and each
// filter maps it onto its own sensible range - which is also what makes the
// mapping testable: `strength_frac()` is one number and each filter's use of it
// is one line.
//
// The slider stores an INT (the toolkit's val/vmin/vmax are ints) while every
// filter parameter is a float, so the conversion happens in exactly one place.
// ---- collapsed groups in the layer panel ------------------------------------
//
// Which GROUP rows are collapsed, as a string of one character per layer index
// ("c" collapsed, anything else open). A string rather than a [bool] because it is
// indexed by layer index and a shorter-than-expected read is then a plain
// out-of-range check rather than a crash - and because the layer store SHIFTS rows
// on every add/remove, so this has to be cheap to rebuild and forgiving of being
// out of date. A missing character reads as open, so a newly inserted layer is
// visible by default, which is the only safe direction: a layer hidden by a stale
// fold flag is a layer the user cannot find.
//
// NOT stored in the layer module. Fold state is a VIEW property - it is not part
// of the document, does not belong in .wync, and must not make the document dirty.
// The same argument src/ui.wyn already makes for the selection.
// The pointer x the TOOLKIT saw, published for handlers.
//
// A handler receives only a widget id and cannot reach the Ui, so a row handler that
// needs to know WHERE in the row the click landed has to read a global. It used to
// read gui.Win_mouse_x() - the platform's POLLED position - which is wrong twice
// over: a synthetic press never updates it (so every layer click in a headless test
// looked like a click at x=0, i.e. a twisty hit), and even live it is the pointer's
// position NOW rather than where the click was. Ui_mouse_x is the position the
// toolkit dispatched from, which is the one the handler is being told about.
var g_click_mx = 0

var g_folded = ""

// Bumped by every fold change, so the frame loop knows to rebuild the click
// targets. The existing trigger is `layer.count() != g_row_count`, which cannot
// see a fold: collapsing a group changes which rows are DRAWN without changing how
// many layers exist, so the targets would keep the positions they had while the
// group was open and a click would select the wrong layer. This is the smallest
// signal that closes that gap.
var g_fold_gen = 0
var g_rows_fold_gen = 0

fn is_folded(li: int) -> bool {
    if li < 0 { return false }
    if li >= g_folded.len() { return false }
    return g_folded.substring(li, li + 1) == "c"
}

fn set_folded(li: int, on: bool) {
    if li < 0 { return }
    g_fold_gen = g_fold_gen + 1
    var f = g_folded
    while f.len() <= li { f = f + "o" }
    var head = f.substring(0, li)
    var tail = f.substring(li + 1, f.len())
    if on { g_folded = head + "c" + tail } else { g_folded = head + "o" + tail }
}

// Is this layer hidden because an ANCESTOR group is collapsed?
//
// Walks the parent chain rather than checking one level, so collapsing an outer
// group hides a nested group's children too. The guard is against a corrupt chain
// (undo replay writes the store), where the alternative is a hang.
fn row_hidden(li: int) -> bool {
    var p = layer.parent(li)
    var guard = 0
    while p != 0 - 1 {
        if is_folded(p) { return true }
        guard = guard + 1
        if guard > layer.count() { return false }
        p = layer.parent(p)
    }
    return false
}

// How deep this layer sits, for indentation.
fn row_depth(li: int) -> int {
    var d = 0
    var p = layer.parent(li)
    var guard = 0
    while p != 0 - 1 {
        d = d + 1
        guard = guard + 1
        if guard > layer.count() { return d }
        p = layer.parent(p)
    }
    return d
}

var g_strength_id = -1
var g_strength = 100

fn on_strength(id: int) {
    // The handler cannot read the Ui (a handler receives only an id), so the
    // frame loop copies the value across - see the note where it does.
    g_msg = "strength ${g_strength}%"
}

// The slider as a fraction, 0.0 at the low end and 1.0 at 100%.
//
// The clamp is DEFENSIVE AND CURRENTLY UNREACHABLE, which is worth saying out
// loud rather than leaving as a comment that implies otherwise: the widget
// already clamps to its own 0..200 range (`strength:500` comes back as 200), so
// nothing can get here out of bounds today. Mutation-testing confirms it -
// widening the bound to 99.0 fails no test.
//
// It stays because the range lives in build_form and the arithmetic lives here,
// and the two can drift: the day someone widens the slider to 0..1000, a filter
// receiving a 10x radius is a hang, not a wrong picture. A guard whose cost is
// two comparisons and whose absence is a hang is worth keeping unproven.
fn strength_frac() -> float {
    var f = g_strength.to_float() / 100.0
    if f < 0.0 { f = 0.0 }
    if f > 2.0 { f = 2.0 }
    return f
}
var g_tex_w = 0
var g_tex_h = 0

// The colour picker's two ramps, also as textures. The SV square depends only on
// the hue, so it is rebuilt when the hue changes and not per frame; the hue strip
// never changes at all.
var g_sv_buf = 0
var g_sv_tex = -1
var g_sv_hue = -1.0
var g_hue_buf = 0
var g_hue_tex = -1

// The last composite, retained. The eyedropper reads the COMPOSITE (that is what
// the user is pointing at), and re-compositing inside a click handler would
// double the cost of whichever frame the click lands in. Freed and replaced,
// never accumulated.
var g_last_comp = 0

// Set whenever anything that affects the pixels changes: a visibility toggle,
// an undo, a load, a brush stroke. The composite is the expensive operation in
// the frame, so it runs when the document changed and not once per frame.
var g_dirty = 1

// Deferred requests from Open/Save, serviced by the frame loop (see the header).
var REQ_NONE = 0
var REQ_OPEN = 1
var REQ_SAVE = 2
// A text commit is deferred for exactly the same reason Open and Save are: the
// string the user typed lives in the Ui, which a handler cannot reach.
var REQ_TEXT = 3
var g_req = 0

// One line of feedback, shown in the status bar. A UI that silently does
// nothing when a file cannot be read is indistinguishable from a broken one.
var g_msg = "ready"

// The active layer: what the brush paints into and what the layer buttons act
// on. -1 when the document is empty.
var g_active = 0

// widget id -> layer index, for the per-row click targets. A handler is given
// the id and nothing else, so this table is how it learns which layer was hit.
var g_row_ids = [0]
var g_row_layer = [0]
var g_row_count = 0

// The path entry's widget id, so the frame loop can read what was typed.
var g_path_id = -1

// ---- text tool -------------------------------------------------------------
//
// THE TEXT ENTRY IS A REAL WIDGET, NOT AN ON-CANVAS EDITOR, and that is the
// choice this file makes rather than a shortcut. The task allowed a status-line
// entry; a toolbar text field is the same decision and is honest about it.
//
// The reason is the toolkit's contract: `widgets.Ui_events` DRAINS the key queue,
// so a second reader (an on-canvas editor keeping its own buffer) would see
// nothing. Typing on the canvas would mean teaching the toolkit about a caret
// that is not a widget - the same argument the file header makes for the canvas
// drag going the other way. So the flow is: pick the Text tool, type in the
// entry, click the document to place it. Which is one gesture fewer than an
// on-canvas editor needs anyway.
//
// The entry's widget id, and the font. The font is loaded ONCE, lazily on first
// use rather than at startup: `wynimg_font_default` scans the system font
// directories and opens a file, which is wasted work in a session that never
// draws text, and a machine with no usable font must not stop the editor
// launching.
var g_text_id = -1
var g_text_font = -1
var g_text_px = 32.0

// Where the last click asked for text, in DOCUMENT coordinates. Set by
// canvas_press and consumed by the frame loop's REQ_TEXT service.
var g_text_x = 0.0
var g_text_y = 0.0

// ---- canvas drag state ----------------------------------------------------
//
// A drag is a press, N moves and a release; the toolkit models a CLICK. So the
// canvas tracks its own gesture here (see note 2 in the header).
var DRAG_NONE = 0
var DRAG_STROKE = 1
var DRAG_PAN = 2
var DRAG_SV = 3
var DRAG_HUE = 4
var DRAG_MARQUEE = 5
var g_drag = 0
var g_drag_px = 0        // last pointer position, for the pan delta
var g_drag_py = 0

// ---- selection tools -------------------------------------------------------
//
// THE MARQUEE TOOLS LIVE HERE, NOT IN paint.set_tool, and the reason is a
// boundary rather than a convenience. `paint` owns what a STROKE is - a coverage
// accumulator, a base snapshot, a colour - and a marquee has none of those: it
// produces no pixels and records no history. paint.set_tool also refuses any id
// above 4 by design, so extending it would mean editing a module this change does
// not own. So the selection tools are a SEPARATE mode, and the two are mutually
// exclusive: choosing a marquee sets g_sel_tool and choosing a paint tool clears
// it, which is what `tool_word()` reports and what canvas_press branches on.
// SEL_TEXT is in this enum rather than in paint's because it is the same kind of
// thing as a marquee: a canvas mode this file owns, which produces no stroke and
// which paint.set_tool would refuse anyway (it caps ids at 4). It is not a
// selection, and `mask_for_ops` never sees it - only canvas_press branches on it.
var SEL_NONE = 0
var SEL_RECT = 1
var SEL_ELLIPSE = 2
var SEL_LASSO = 3
var SEL_TEXT = 4
var g_sel_tool = 0

// How a drag combines with what is already selected. Kept as state rather than a
// modifier key because the widget toolkit owns the key queue (a second reader
// sees nothing) - the same argument src/paint.wyn makes for Pan being a tool.
var g_sel_op = 0

// The marquee's anchor, in DOCUMENT coordinates.
//
// DOCUMENT, NOT WINDOW, AND THAT IS THE WHOLE CORRECTNESS ARGUMENT. A marquee
// stored in window pixels and converted at release would be wrong the moment the
// view was zoomed or panned mid-drag, and - worse - would be a SECOND transform
// path that could disagree with the brush's. Anchoring in document space means
// the marquee goes through the identical view.screen_to_doc_* the brush uses, so
// "the selection lands where the pointer was" is true for the same reason the
// brush's version is, and tests/test_view.wyn's invertibility proof covers both.
var g_marq_x0 = 0.0
var g_marq_y0 = 0.0
var g_marq_x1 = 0.0
var g_marq_y1 = 0.0
var g_marq_live = 0

// The lasso's path, accumulated in Wyn arrays and turned into a wynimg point list
// only at release.
//
// WHY NOT A PRE-ALLOCATED POINT LIST, which was the obvious first try:
// `wynimg_sel_polygon` takes the point count from the BUFFER'S WIDTH
// (csrc/wynimg_select.c: `long long n = p->w`), so a list allocated with a cap of
// 512 and filled with 20 real points is a 512-gon with 492 vertices at the origin
// - a lasso in the top-left corner joined to whatever the user drew. There is no
// "used count" to set. So the list must be allocated at EXACTLY the length of the
// path, which cannot be known until the drag ends.
//
// Two Wyn float arrays are the right holder for that: this is the entry file, the
// count is a drag's worth of points rather than a document's worth of pixels, and
// the bulk-data argument in src/select.wyn's header is about 12M pixels, not 200
// coordinates. Points closer than a pixel to the last one are dropped, so a slow
// drag does not push thousands of duplicates.
var g_lasso_xs = [0.0]
var g_lasso_ys = [0.0]
var g_lasso_n = 0

// Pointer state as of the last frame, so a transition (down this frame, up last
// frame) can be detected. The toolkit consumes the EVENTS; this reads the
// resulting polled state, which is sufficient for a gesture that only needs
// position and button-down-ness.
var g_was_down = 0

// Live document coordinates of the pointer, shown in the status bar. A brush
// that paints in the wrong place is diagnosable in one glance if the readout is
// there, and guesswork if it is not.
var g_cur_dx = 0
var g_cur_dy = 0

fn layer_of_widget(id: int) -> int {
    var i = 0
    while i < g_row_count {
        if g_row_ids[i] == id { return g_row_layer[i] }
        i = i + 1
    }
    return 0 - 1
}

fn remember_row(id: int, li: int) {
    if g_row_count < g_row_ids.len() {
        g_row_ids[g_row_count] = id
        g_row_layer[g_row_count] = li
    } else {
        g_row_ids.push(id)
        g_row_layer.push(li)
    }
    g_row_count = g_row_count + 1
}

fn clamp_active() {
    if layer.count() == 0 {
        g_active = 0 - 1
        return
    }
    if g_active < 0 { g_active = 0 }
    if g_active >= layer.count() { g_active = layer.count() - 1 }
}

// One decimal place, without a format function: the runtime has none, and
// "radius 12.000000" in a status bar is worse than no readout.
fn rounded(v: float) -> string {
    var scaled = (v * 10.0 + 0.5).to_int()
    var whole = scaled / 10
    var frac = scaled % 10
    return whole.to_string() + "." + frac.to_string()
}

// Three decimals, hand-rolled for the same reason: a pixel value printed as
// "0.3" is not a proof of anything.
fn rounded3(v: float) -> string {
    var scaled = (v * 1000.0 + 0.5).to_int()
    if scaled < 0 { scaled = 0 }
    var whole = scaled / 1000
    var frac = scaled % 1000
    var fs = frac.to_string()
    while fs.len() < 3 { fs = "0" + fs }
    return whole.to_string() + "." + fs
}

// ---- handlers -------------------------------------------------------------

fn on_open(id: int) { g_req = REQ_OPEN }
fn on_save(id: int) { g_req = REQ_SAVE }

// Undo and Redo go through undo_any/redo_any, which handle the pixel and
// structural commands as well as the three scalar ones. Wiring them to the
// original undo()/redo() would silently skip every paint stroke - the buttons
// would look wired and do nothing for the most common operation there is.
fn on_undo(id: int) {
    if history.can_undo() == false {
        g_msg = "nothing to undo"
        return
    }
    var what = history.undo_label()
    history.undo_any()
    clamp_active()
    // A document transform's undo changes the document SIZE, so the texture, the
    // view and the selection all have to follow. Unconditional because
    // sync_doc_size is a no-op for every other op - which is what keeps this from
    // becoming "on_undo has to know which opcode it undid".
    sync_doc_size()
    g_msg = "undo " + what
    g_dirty = 1
}

fn on_redo(id: int) {
    if history.can_redo() == false {
        g_msg = "nothing to redo"
        return
    }
    var what = history.redo_label()
    history.redo_any()
    clamp_active()
    sync_doc_size()
    g_msg = "redo " + what
    g_dirty = 1
}

// Zoom about the viewport centre. A button has no pointer position of its own
// that means anything, so the anchored form is reserved for the pointer.
fn on_zoom_in(id: int) {
    view.zoom_in_center()
    g_msg = "zoom " + view.zoom().to_string() + "%"
}

fn on_zoom_out(id: int) {
    view.zoom_out_center()
    g_msg = "zoom " + view.zoom().to_string() + "%"
}

fn on_zoom_fit(id: int) {
    view.zoom_fit()
    g_msg = "fit " + view.zoom().to_string() + "%"
}

fn on_zoom_100(id: int) {
    view.zoom_100()
    g_msg = "zoom 100%"
}

// ---- tool selection -------------------------------------------------------
//
// One handler per tool rather than one handler reading a table, because a
// handler receives only a widget id and mapping id->tool would need a second
// lookup table for no gain: there are five tools and they are not data.

// Choosing a paint tool leaves selection-tool mode, and vice versa - the two are
// one mode, not two independent flags, so the canvas can never be "both".
fn on_tool_brush(id: int) {
    g_sel_tool = SEL_NONE
    paint.set_tool(paint.TOOL_BRUSH())
    g_msg = "brush"
}

fn on_tool_mrect(id: int) {
    g_sel_tool = SEL_RECT
    g_msg = "rect select"
}

fn on_tool_mellipse(id: int) {
    g_sel_tool = SEL_ELLIPSE
    g_msg = "ellipse select"
}

fn on_tool_lasso(id: int) {
    g_sel_tool = SEL_LASSO
    g_msg = "lasso select"
}

fn on_tool_text(id: int) {
    g_sel_tool = SEL_TEXT
    g_msg = "text: type in the field, then click the canvas"
}

fn on_tool_eraser(id: int) {
    g_sel_tool = SEL_NONE
    paint.set_tool(paint.TOOL_ERASER())
    g_msg = "eraser"
}

fn on_tool_fill(id: int) {
    g_sel_tool = SEL_NONE
    paint.set_tool(paint.TOOL_FILL())
    g_msg = "fill"
}

fn on_tool_pick(id: int) {
    g_sel_tool = SEL_NONE
    paint.set_tool(paint.TOOL_PICK())
    g_msg = "eyedropper"
}

fn on_tool_pan(id: int) {
    g_sel_tool = SEL_NONE
    paint.set_tool(paint.TOOL_PAN())
    g_msg = "pan"
}

// ---- brush parameter buttons ----------------------------------------------
//
// Steppers rather than sliders: the toolkit has no slider widget, and the two
// controls that genuinely need continuous input - hue, and saturation/value -
// are the picker, which is a custom drag on a texture. A radius that steps by
// x1.5 is also more usable than a 150px slider covering 0.5..200.

fn on_radius_up(id: int) {
    paint.set_radius(paint.radius() * 1.5)
    g_msg = "radius " + rounded(paint.radius())
}

fn on_radius_down(id: int) {
    paint.set_radius(paint.radius() / 1.5)
    g_msg = "radius " + rounded(paint.radius())
}

fn on_hard_up(id: int) {
    paint.set_hardness(paint.hardness() + 0.2)
    g_msg = "hardness " + rounded(paint.hardness())
}

fn on_hard_down(id: int) {
    paint.set_hardness(paint.hardness() - 0.2)
    g_msg = "hardness " + rounded(paint.hardness())
}

fn on_alpha_up(id: int) {
    paint.set_alpha(paint.alpha() + 0.1)
    g_msg = "alpha " + rounded(paint.alpha())
}

fn on_alpha_down(id: int) {
    paint.set_alpha(paint.alpha() - 0.1)
    g_msg = "alpha " + rounded(paint.alpha())
}

// ---- layer commands -------------------------------------------------------
//
// Each records BEFORE mutating, and each records exactly one entry, so Undo
// reverses one user gesture. Writing layer.* without the record would make Undo
// silently skip the operation, which is worse than not having the button.

// Wrap the active layer in a new group.
//
// GROUPING AN EXISTING LAYER, rather than creating an empty group to drag things
// into. A group must sit BELOW its children (set_parent enforces it, and the
// render walk relies on it), so an empty group added above the active layer could
// never contain it - the user would create a group and find nothing could go in.
// Inserting the group directly beneath the active layer and parenting that layer
// into it is the one gesture that is always valid.
//
// The undo entry is the layer INSERT, which is what history already models. That
// leaves the parent assignment outside the log: undoing removes the group row, and
// `remove` orphans its children, so the child returns to the top level and the
// document is back where it started. Reached that way rather than by teaching
// history about parents, which would be a new record type for a state that
// `remove` already restores correctly.
fn on_layer_group(id: int) {
    if g_doc_w <= 0 {
        g_msg = "no document"
        return
    }
    if g_active < 0 {
        g_msg = "no active layer"
        return
    }
    if layer.count() >= 64 {
        g_msg = "too many layers"
        return
    }
    var target = g_active
    // THE TARGET'S CURRENT GROUP, remembered before anything moves. Grouping a
    // layer that is already inside a group has to put the NEW group where the
    // layer was - inside the old one - or the two end up as siblings and the
    // layer moves out of the group it was in. Found by the test asserting
    // nesting; the first version simply dropped the old parent.
    var outer = layer.parent(target)
    var name = "group " + layer.count().to_string()
    // Beneath the target, so the group is below its child.
    layer.insert(target, name, 0, layer.KIND_GROUP())
    history.record_add_layer(target, name, 0, layer.KIND_GROUP())
    // The insert pushed everything from `target` up by one, so the layer is now
    // at target+1 and the group occupies target. `outer` was below target (a
    // parent always is), so its index is unchanged.
    if layer.set_parent(target + 1, target) {
        // Re-establish the enclosing group around the NEW group, so nesting
        // deepens rather than flattening.
        if outer != 0 - 1 { layer.set_parent(target, outer) }
        g_active = target + 1
        g_msg = "grouped into " + name
    } else {
        g_msg = "could not group"
    }
    g_dirty = 1
}

// Take the active layer out of its group, back to the top level.
fn on_layer_ungroup(id: int) {
    if g_active < 0 {
        g_msg = "no active layer"
        return
    }
    if layer.parent(g_active) == 0 - 1 {
        g_msg = "not in a group"
        return
    }
    layer.set_parent(g_active, 0 - 1)
    g_msg = "ungrouped"
    g_dirty = 1
}

fn on_layer_add(id: int) {
    if g_doc_w <= 0 {
        g_msg = "no document"
        return
    }
    var buf = wynimg_new(g_doc_w, g_doc_h)
    if buf == 0 {
        g_msg = "out of memory"
        return
    }
    var pos = layer.count()
    if g_active >= 0 { pos = g_active + 1 }
    var name = "layer " + layer.count().to_string()
    layer.insert(pos, name, buf, layer.KIND_RASTER())
    history.record_add_layer(pos, name, buf, layer.KIND_RASTER())
    g_active = pos
    g_msg = "added " + name
    g_dirty = 1
}

fn on_layer_del(id: int) {
    if layer.count() <= 1 {
        g_msg = "cannot delete the last layer"
        return
    }
    if g_active < 0 { return }
    // Record FIRST: the record holds the buffer handle, and layer.remove
    // deliberately does not free it so undo can put the same pixels back.
    history.record_del_layer(g_active, layer.name(g_active),
                             layer.buffer(g_active), layer.kind(g_active))
    var gone = layer.name(g_active)
    layer.remove(g_active)
    clamp_active()
    g_msg = "deleted " + gone
    g_dirty = 1
}

fn on_layer_up(id: int) {
    if g_active < 0 { return }
    if g_active >= layer.count() - 1 {
        g_msg = "already at the top"
        return
    }
    layer.swap(g_active, g_active + 1)
    history.record_swap(g_active, g_active + 1)
    g_active = g_active + 1
    g_msg = "raised"
    g_dirty = 1
}

fn on_layer_down(id: int) {
    if g_active <= 0 {
        g_msg = "already at the bottom"
        return
    }
    layer.swap(g_active, g_active - 1)
    history.record_swap(g_active, g_active - 1)
    g_active = g_active - 1
    g_msg = "lowered"
    g_dirty = 1
}

fn on_opacity_up(id: int) {
    if g_active < 0 { return }
    var was = layer.opacity(g_active)
    var now = was + 0.1
    if now > 1.0 { now = 1.0 }
    history.record_opacity(g_active, was, now)
    layer.set_opacity(g_active, now)
    g_msg = "opacity " + rounded(now)
    g_dirty = 1
}

fn on_opacity_down(id: int) {
    if g_active < 0 { return }
    var was = layer.opacity(g_active)
    var now = was - 0.1
    if now < 0.0 { now = 0.0 }
    history.record_opacity(g_active, was, now)
    layer.set_opacity(g_active, now)
    g_msg = "opacity " + rounded(now)
    g_dirty = 1
}

// Blend mode steps through the existing 27. A dropdown is not available in the
// toolkit and 27 buttons is not a UI, so two buttons step and the current mode's
// NAME is painted in the layer row - a stepper with no readout is unusable.
fn on_blend_next(id: int) {
    if g_active < 0 { return }
    var was = layer.blend_mode(g_active)
    var now = was + 1
    if now >= pixel.blend_count() { now = 0 }
    history.record_blend(g_active, was, now)
    layer.set_blend_mode(g_active, now)
    g_msg = "blend " + pixel.blend_name(now)
    g_dirty = 1
}

fn on_blend_prev(id: int) {
    if g_active < 0 { return }
    var was = layer.blend_mode(g_active)
    var now = was - 1
    if now < 0 { now = pixel.blend_count() - 1 }
    history.record_blend(g_active, was, now)
    layer.set_blend_mode(g_active, now)
    g_msg = "blend " + pixel.blend_name(now)
    g_dirty = 1
}

// ---- filters --------------------------------------------------------------
//
// A FILTER IS AN UNDOABLE WHOLE-LAYER REPLACEMENT, and that is the honest
// representation rather than a shortcut.
//
// Everything else in this file that changes pixels - the brush, the bucket fill -
// records a before/after pair for the same reason (src/history.wyn's OP_PIXELS),
// and a filter has even less choice about it: a gaussian blur genuinely destroys
// information (it is an averaging operator, so it is not injective), and a levels
// remap with a clamp destroys everything outside the window. There is no
// parameter pair that inverts either. So Undo restores the EXACT prior pixels
// from a snapshot, or a filter is a trap - a button that changes the document
// with no way back.
//
// THE SELECTION IS PASSED AS THE COVERAGE MASK, WITH ONE CONVERSION THAT MATTERS.
// Every filter takes a mask handle where 0 means "the whole buffer", and the
// selection is a coverage buffer of exactly that shape (src/select.wyn's header:
// the mask's R channel is linear coverage, the same convention the brush and the
// text engine produce). So passing the selection IS the integration - the C
// driver blends `original*(1-coverage) + filtered*coverage` per pixel, so a
// feathered selection gives a feathered filter for free.
//
// But an EMPTY selection must become 0, not its handle. `select.is_empty()` is
// true both when there is no selection object and when nothing is selected, and
// in the second case the handle is a valid buffer of all zeros - which would make
// every filter a silent no-op. Turning that into "no mask" is the whole of
// `mask_for_ops` and is the one line that decides whether Blur-with-nothing-
// selected filters the layer or does nothing.

// The mask handle to pass to a filter: the selection when there is one, 0 when
// there is not. See above for why the empty case is 0 and not the handle.
fn mask_for_ops() -> int {
    if select.is_empty() { return 0 }
    return select.handle()
}

// One word for the status bar and the undo label, so "undo blur" is possible.
// Read from the selection state at apply time rather than cached, because the
// selection can change between two filters.
fn scope_word() -> string {
    if select.is_empty() { return "layer" }
    return "selection"
}

// Runs `what` on the active layer, clipped by the selection, as ONE undo entry.
//
// The order is fixed by correctness: snapshot BEFORE, filter, snapshot AFTER,
// record. Snapshotting after the filter would record the filtered pixels as the
// "before" and make Undo a no-op that looks wired - the exact failure the brief
// calls a trap. If the filter itself fails, the before-clone is freed and NO
// entry is recorded, because a history entry whose two halves are identical would
// make Undo appear broken to the user rather than reporting the refusal.
fn run_filter(what: string) {
    if g_active < 0 {
        g_msg = "no active layer"
        return
    }
    var buf = layer.buffer(g_active)
    if buf == 0 {
        // An adjustment layer has no pixels of its own; filtering it would have
        // to mean "filter what is beneath", which is a different feature.
        g_msg = "cannot filter that layer"
        return
    }
    var before = wynimg_clone(buf)
    if before == 0 {
        g_msg = "out of memory"
        return
    }

    var m = mask_for_ops()
    var ok = false

    // EVERY PARAMETER IS THE STRENGTH SLIDER, mapped onto that filter's own
    // units. At 100% each of these is the value it was hardcoded to before, so
    // the default click does exactly what it always did and the slider only adds
    // reach - which is the property that keeps the golden tests meaningful.
    //
    // Each mapping is one line, and each is chosen so the ends are useful rather
    // than merely different: a blur that can go from a whisper to obvious, a
    // sharpen that stops short of ringing, a saturation that reaches full grey
    // at 0% instead of inverting.
    var k = strength_frac()
    if what == "blur"      { ok = filter.gaussian(buf, 4.0 * k, m) }
    if what == "sharpen"   { ok = filter.sharpen(buf, 0.8 * k, m) }
    // Saturation is a MULTIPLIER around 1.0, not a scale of the amount: scaling
    // 1.4 by k would make 0% mean "multiply by 0" (full grey) for saturate and
    // "multiply by 0" again for desaturate, so the two buttons would agree at
    // the low end. Interpolating away from 1.0 keeps them opposites everywhere.
    if what == "saturate"  { ok = filter.saturation(buf, 1.0 + 0.4 * k, m) }
    if what == "desaturate" { ok = filter.saturation(buf, 1.0 - 0.4 * k, m) }
    // Levels: the black/white points close in on the histogram as strength rises
    // and gamma lifts with it. At 0% this is the identity (0, 1, 1.0).
    if what == "levels"    { ok = filter.levels(buf, 0.05 * k, 1.0 - 0.05 * k, 1.0 + 0.2 * k, m) }
    // Invert has no strength - it is its own opposite - and pretending otherwise
    // with a partial blend would make "Inv" twice not equal the original.
    if what == "invert"    { ok = filter.invert(buf, m) }
    if what == "curve" {
        // A curve is a buffer too, so it must be freed on BOTH paths - which is
        // why this filter is the one with its own block rather than a one-liner.
        var c = filter.gamma_curve(32, 1.0 + 0.6 * k)
        if c == 0 {
            wynimg_free(before)
            g_msg = "out of memory"
            return
        }
        ok = filter.curve(buf, c, m)
        filter.free_curve(c)
    }

    if ok == false {
        wynimg_free(before)
        g_msg = what + " refused"
        return
    }

    var after = wynimg_clone(buf)
    if after == 0 {
        // The pixels ARE filtered but cannot be recorded. Put them back rather
        // than leaving an unundoable change on screen: a silent hole in the undo
        // log is worse than the filter not happening.
        wynimg_copy_into(buf, before)
        wynimg_free(before)
        g_msg = "out of memory"
        return
    }
    history.record_pixels_as(g_active, before, after, what)
    g_msg = what + " on " + scope_word()
    g_dirty = 1
}

// ---- whole-document transforms ---------------------------------------------
//
// The size-CHANGING transforms: rotate 90 CW/CCW, crop to the selection, scale.
// These used to be unreachable from the editor - written and tested in
// src/xform.wyn, bound to nothing - because the OP_PIXELS undo restores with
// wynimg_copy_into, which requires the size to be unchanged, and a texture cannot
// be resized under its handle. They now go through src/docxform.wyn, which
// transforms every layer and mask atomically and records one OP_DOC_XFORM entry.
//
// THIS FUNCTION IS THE WINDOW HALF, AND IT IS THE HALF THAT COULD CORRUPT THINGS.
// docxform owns the document; four pieces of state here are document-SIZED and
// every one of them is now stale:
//
//   1. g_doc_w / g_doc_h. Setting these is what makes `refresh` recreate the
//      texture (it compares them against g_tex_w/g_tex_h), so this is not
//      bookkeeping - it IS the texture rebuild, and skipping it would blit the new
//      composite through a texture of the old size.
//   2. The view transform, which maps document to window.
//   3. The SELECTION, which is document-sized coverage and CANNOT survive a size
//      change - it is replaced, never clipped. select.init does that.
//   4. The marching-ants texture and its coverage buffer, both document-sized.
//      paint_ants reallocates them when it notices g_ants_w/h disagree, so
//      nothing is needed here beyond letting it notice.
//
// That list is the `open_wync` precedent - the other place the document's size
// changes underneath the window - and the reason this is one function rather than
// four call sites is that the four items must move together. A caller that
// remembered three of them leaves a working-looking editor with a selection that
// indexes out of bounds.
//
// UNDO GOES THROUGH THE SAME FUNCTION, via `sync_doc_size` below, because an undo
// changes the size in exactly the same way and owes exactly the same four items.
fn apply_doc_size(nw: int, nh: int) {
    if nw <= 0 { return }
    if nh <= 0 { return }
    g_doc_w = nw
    g_doc_h = nh
    // refresh() recreates the texture from these two; the ants texture is
    // reallocated lazily by paint_ants for the same reason.
    view.set_doc(nw, nh)
    view.zoom_fit()
    // The selection is replaced, not clipped. A coverage buffer that disagrees with
    // the document makes every later clip read out of bounds, and there is no
    // meaningful "same selection" after a rotate anyway.
    select.init(nw, nh)
    clamp_active()
    g_dirty = 1
}

// Called after every undo/redo. history.doc_w_now() is -1 unless the entry that was
// just applied was a document transform, so this is a no-op for every other op -
// which is the property that lets on_undo/on_redo call it unconditionally instead of
// asking what they undid.
fn sync_doc_size() {
    var nw = history.doc_w_now()
    var nh = history.doc_h_now()
    if nw <= 0 { return }
    if nh <= 0 { return }
    if nw == g_doc_w and nh == g_doc_h { return }
    apply_doc_size(nw, nh)
}

// One of "rot90-cw", "rot90-ccw", "crop", "scale-half", "scale-double".
//
// A STROKE IN PROGRESS IS CANCELLED FIRST. paint's base clone and coverage buffer
// are full-canvas and sized to the OLD document, and wynimg_stroke_apply refuses a
// size mismatch - so a stroke that survived a rotate would silently stop painting
// until the user released and pressed again. Cancelling is honest about it.
fn run_doc_transform(what: string) {
    if g_doc_w <= 0 or g_doc_h <= 0 { g_msg = "no document"  return }
    if layer.count() <= 0 { g_msg = "no layers"  return }
    if paint.stroke_active() { paint.cancel() }

    var snap = 0
    if what == "rot90-cw"  { snap = docxform.doc_rot_cw(g_doc_w, g_doc_h) }
    if what == "rot90-ccw" { snap = docxform.doc_rot_ccw(g_doc_w, g_doc_h) }
    if what == "crop" {
        // CROP TO THE SELECTION'S BOUNDING BOX, and the bbox is the honest answer
        // rather than a compromise: a crop produces a RECTANGULAR document, so an
        // ellipse or lasso selection has no non-rectangular crop to give. The
        // pixels outside the shape but inside the box are KEPT, which is what every
        // editor does and what a user dragging a marquee expects.
        if select.is_empty() {
            g_msg = "select an area to crop to"
            return
        }
        var x0 = select.bbox_x0()
        var y0 = select.bbox_y0()
        // The bbox is INCLUSIVE at both ends (see src/select.wyn), so the width is
        // x1 - x0 + 1. Getting this wrong loses the selection's last row and column
        // - a one-pixel error that looks like a rounding artefact rather than a bug.
        var cw = select.bbox_x1() - x0 + 1
        var ch = select.bbox_y1() - y0 + 1
        if cw <= 0 or ch <= 0 {
            g_msg = "selection is empty"
            return
        }
        snap = docxform.doc_crop(g_doc_w, g_doc_h, x0, y0, cw, ch)
    }
    if what == "scale-half" {
        // Halving with integer division, floored at 1: a 1px document must stay a
        // real document rather than becoming a refused 0-wide one.
        var hw = g_doc_w / 2
        var hh = g_doc_h / 2
        if hw < 1 { hw = 1 }
        if hh < 1 { hh = 1 }
        snap = docxform.doc_scale(g_doc_w, g_doc_h, hw, hh)
    }
    if what == "scale-double" {
        snap = docxform.doc_scale(g_doc_w, g_doc_h, g_doc_w * 2, g_doc_h * 2)
    }

    if snap == 0 {
        // docxform guarantees the document is EXACTLY as it was on failure, so
        // there is nothing to undo here and nothing to repair.
        g_msg = what + " refused"
        return
    }

    // The transform is applied and recorded; now the window catches up. The new
    // size comes from the same arithmetic docxform used, read off the layer that
    // now holds it rather than recomputed - so the two cannot disagree.
    apply_doc_size(wynimg_width(layer.buffer(top_raster())),
                   wynimg_height(layer.buffer(top_raster())))
    g_msg = history.undo_label() + " -> ${g_doc_w}x${g_doc_h}"
}

// The index of a layer that HAS a buffer, for reading the post-transform size off.
//
// Not simply layer 0: a GROUP has no buffer of its own, so a document whose bottom
// row is a group would read width 0 from it and apply_doc_size would refuse - the
// transform would work and the window would never learn about it.
fn top_raster() -> int {
    var i = 0
    while i < layer.count() {
        if layer.buffer(i) != 0 { return i }
        i = i + 1
    }
    return 0
}

// A dimension-PRESERVING transform (flip H/V, rotate 180). These slot into the same
// OP_PIXELS undo the filters use, because the result is the same size as the source and
// so wynimg_copy_into can restore it. The size-CHANGING transforms are above, in
// run_doc_transform, and go through a whole-document history op instead.
fn run_transform(what: string) {
    if g_active < 0 { g_msg = "no active layer"  return }
    var buf = layer.buffer(g_active)
    if buf == 0 { g_msg = "cannot transform that layer"  return }

    var result = 0
    if what == "flip-h"   { result = xform.flip_h(buf) }
    if what == "flip-v"   { result = xform.flip_v(buf) }
    if what == "rotate180" { result = xform.rot_180(buf) }
    if result == 0 { g_msg = what + " refused"  return }

    // The transform returns a NEW buffer; record before/after and copy the result into
    // the live buffer in place (its dimensions are unchanged, so the texture handle
    // stays valid - the same invariant run_filter relies on).
    var before = wynimg_clone(buf)
    if before == 0 { wynimg_free(result)  g_msg = "out of memory"  return }
    wynimg_copy_into(buf, result)
    wynimg_free(result)

    var after = wynimg_clone(buf)
    if after == 0 {
        wynimg_copy_into(buf, before)
        wynimg_free(before)
        g_msg = "out of memory"
        return
    }
    history.record_pixels_as(g_active, before, after, what)
    g_msg = what + " on " + scope_word()
    g_dirty = 1
}

// ---- text ------------------------------------------------------------------
//
// ONE UNDO ENTRY, THE SAME WAY A FILTER GETS ONE: a before/after pixel pair.
// text.draw goes through `wynimg_stroke_apply` - the identical kernel the brush
// uses (see src/text.wyn's header) - so the composited result is right by
// construction. What it does NOT do is record anything, because a library that
// recorded into history would be deciding the caller's undo granularity. So the
// snapshot pair is taken here, exactly as run_filter takes it, and for the same
// reason: a coverage-weighted blend has no inverse to store instead.
//
// THE COLOUR IS LINEAR, WHICH IS THE ONE THING EASY TO GET WRONG HERE.
// paint.color_linear(c) is what the brush passes to the same kernel; passing
// paint.color_srgb would paint visibly light glyphs that no assertion about
// coverage would catch. That is why there is no sRGB-taking path in text.wyn.
fn commit_text(s: string) {
    if s == "" {
        g_msg = "type some text first"
        return
    }
    if g_active < 0 {
        g_msg = "no active layer"
        return
    }
    var buf = layer.buffer(g_active)
    if buf == 0 {
        g_msg = "cannot draw text on that layer"
        return
    }
    if g_text_font < 0 {
        // Lazily, once. 0 means the machine has no usable font, which is a fact
        // about the machine and is reported rather than treated as a bug - the
        // same contract src/text.wyn asks callers to honour.
        g_text_font = text.default_font()
    }
    if g_text_font == 0 {
        g_msg = "no system font available"
        return
    }

    var before = wynimg_clone(buf)
    if before == 0 {
        g_msg = "out of memory"
        return
    }
    // (x,y) is the TOP-LEFT of the layout box, not the baseline, which is what
    // text.wyn takes - so a click places the top-left of the text where the
    // pointer was and no caller has to add the ascent.
    var ok = text.draw(buf, g_text_font, s, g_text_x, g_text_y, g_text_px,
                       paint.color_linear(0), paint.color_linear(1),
                       paint.color_linear(2), paint.alpha(),
                       1.0, text.ALIGN_LEFT(), 0.0, text.GAMMA_DISPLAY(), 0)
    if ok == false {
        wynimg_free(before)
        g_msg = "text refused"
        return
    }
    var after = wynimg_clone(buf)
    if after == 0 {
        // Put the pixels back rather than leave an unundoable change - the same
        // policy run_filter uses, and for the same reason.
        wynimg_copy_into(buf, before)
        wynimg_free(before)
        g_msg = "out of memory"
        return
    }
    history.record_pixels_as(g_active, before, after, "text")
    g_msg = "text \"" + s + "\" at " + g_text_x.to_int().to_string() + ","
            + g_text_y.to_int().to_string()
    g_dirty = 1
}

fn on_text_bigger(id: int) {
    g_text_px = g_text_px * 1.25
    if g_text_px > 400.0 { g_text_px = 400.0 }
    g_msg = "text " + rounded(g_text_px) + "px"
}

fn on_text_smaller(id: int) {
    g_text_px = g_text_px / 1.25
    if g_text_px < 4.0 { g_text_px = 4.0 }
    g_msg = "text " + rounded(g_text_px) + "px"
}

fn on_flt_blur(id: int) { run_filter("blur") }
fn on_flt_sharpen(id: int) { run_filter("sharpen") }
fn on_flt_saturate(id: int) { run_filter("saturate") }
fn on_flt_desaturate(id: int) { run_filter("desaturate") }
fn on_flt_levels(id: int) { run_filter("levels") }
fn on_flt_invert(id: int) { run_filter("invert") }
fn on_flt_curve(id: int) { run_filter("curve") }

// A layer row does two things depending on WHERE it was clicked: the visibility
// box toggles (through history, so it is undoable), and the rest of the row
// selects the layer. Splitting geometrically rather than with two widgets keeps
// the row's hit area contiguous and gives the painter one rectangle to draw.
fn on_layer_row(id: int) {
    var li = layer_of_widget(id)
    if li < 0 { return }
    var mx = g_click_mx

    // THE TWISTY, on a group with children: fold instead of selecting. Checked
    // BEFORE the visibility box, because on a group row the two would otherwise
    // overlap - see layout.hits_twisty, which owns both boundaries next to the
    // twisty_x/vis_box_x the painter draws at.
    var dep = row_depth(li)
    if layer.kind(li) == layer.KIND_GROUP() {
        if layer.child_count(li) > 0 {
            if layout.hits_twisty(mx, dep) {
                var was_folded = is_folded(li)
                set_folded(li, not was_folded)
                if was_folded { g_msg = "expanded " + layer.name(li) }
                else { g_msg = "collapsed " + layer.name(li) }
                return
            }
        }
    }

    if layout.hits_visibility(mx, dep) {
        var was = layer.visible(li)
        // Hoisted, not written inline as `record_visible(li, was, was == false)`.
        // A comparison passed DIRECTLY as a `bool` argument is typed `int` and
        // the checker rejects it ("Expected: bool, Got: int"); bound to a `var`
        // first it is a bool, as is `not was`. Reported. Same reason `now` exists
        // rather than three copies of the expression.
        var now = not was
        history.record_visible(li, was, now)
        layer.set_visible(li, now)
        g_msg = layer.name(li) + " " + vis_word(now)
        g_dirty = 1
        return
    }
    g_active = li
    g_msg = "active: " + layer.name(li)
}

fn vis_word(on: bool) -> string {
    if on { return "shown" }
    return "hidden"
}

// ---- selection commands ----------------------------------------------------
//
// DELIBERATELY NOT UNDOABLE, and this is a decision rather than an omission.
//
// A selection is not part of the document: it survives a save only as a channel
// in formats that store one, it does not appear in the exported PNG, and no pixel
// changes when it does. Putting it in the undo log would mean Undo after
// "blur the selection" popped the SELECTION change first and left the blur on
// screen - i.e. the user would press Undo, see nothing happen to the image, and
// press it again. Photoshop makes the same call: Select > All is not an undo step
// (it is Deselect that people expect Ctrl+Z to reach, and that is a separate
// argument this project does not need yet).
//
// Stated in the README as a limitation rather than left to be discovered.

fn on_sel_all(id: int) {
    if select.select_all() {
        g_msg = "selected all"
    } else {
        g_msg = "no selection buffer"
    }
    // The marquee is drawn from the selection's bbox, so the frame must redraw -
    // but the PIXELS did not change, so this is not g_dirty (which would force a
    // needless full composite).
}

fn on_sel_none(id: int) {
    select.select_none()
    g_msg = "deselected"
}

// ---- keyboard shortcuts ----------------------------------------------------
//
// EVERY SHORTCUT CALLS THE BUTTON'S OWN HANDLER, and that is the whole design.
// A shortcut that re-implemented "delete the layer" would be a second copy of a
// rule that already exists (refuse to delete the last layer, record history,
// rebuild the rows) and the two copies would drift - the keyboard path would keep
// working after the button's rule changed, which is worse than not having it.
// So this function is a TABLE, not logic: scancode plus modifier in, one existing
// `on_*` call out. The id argument every handler takes is unused by all of them
// (they read global state), so 0 is passed.
//
// This became possible only when the toolkit started handing back keys no widget
// wanted; before that `Ui_events` drained the queue and a second reader saw
// nothing, which is why this file's older comments justify Pan as a tool and the
// selection op as button state. Those justifications are still true for the
// gestures they describe; they are no longer true of the keyboard as such.
//
// THE MODIFIER RULE. Cmd/Ctrl chords are document commands (undo, save, select
// all) and bare letters are tool picks, exactly as every editor does it. A bare
// letter is only offered here when no text field has focus - the toolkit enforces
// that, so typing "b" into the filename box cannot also select the Brush.
fn handle_shortcut(key: int, mod: int) {
    var cmd = widgets.Ui_mod_is_cmd(mod)
    var shift = widgets.Ui_mod_shift(mod)

    if cmd == 1 {
        // Cmd+Z / Cmd+Shift+Z - undo, redo. Shift+Z rather than Cmd+Y because
        // Y is Windows-only and this build runs on macOS and Linux too.
        if key == gui.SCANCODE_Z {
            if shift == 1 { on_redo(0) } else { on_undo(0) }
            return
        }
        if key == gui.SCANCODE_S { on_save(0) return }
        if key == gui.SCANCODE_O { on_open(0) return }
        if key == gui.SCANCODE_A { on_sel_all(0) return }
        if key == gui.SCANCODE_D { on_sel_none(0) return }
        if key == gui.SCANCODE_I { on_sel_invert(0) return }
        // Cmd+= and Cmd+- for zoom, with Cmd+0 for fit: the bindings every
        // browser and editor shares, so they need no discovery.
        // Cmd+G groups, Cmd+Shift+G ungroups - the binding every editor shares,
        // so it needs no discovery. Checked before the zoom keys purely for
        // grouping with the other layer-tree commands.
        if key == gui.SCANCODE_G {
            if shift == 1 { on_layer_ungroup(0) } else { on_layer_group(0) }
            return
        }
        if key == gui.SCANCODE_EQUALS { on_zoom_in(0) return }
        if key == gui.SCANCODE_MINUS { on_zoom_out(0) return }
        if key == gui.SCANCODE_0 { on_zoom_fit(0) return }
        if key == gui.SCANCODE_1 { on_zoom_100(0) return }
        return
    }

    // Bare letters: tool selection. The letters are Photoshop's, because a user
    // arriving from one image editor should not have to relearn them.
    if key == gui.SCANCODE_B { on_tool_brush(0) return }
    if key == gui.SCANCODE_E { on_tool_eraser(0) return }
    if key == gui.SCANCODE_G { on_tool_fill(0) return }
    if key == gui.SCANCODE_I { on_tool_pick(0) return }
    if key == gui.SCANCODE_H { on_tool_pan(0) return }
    if key == gui.SCANCODE_M { on_tool_mrect(0) return }
    if key == gui.SCANCODE_L { on_tool_lasso(0) return }
    if key == gui.SCANCODE_T { on_tool_text(0) return }

    // Transforms on bare letters (R/J/K were unbound). Rotate 180 and the two flips are
    // the dimension-preserving transforms that fit the OP_PIXELS undo.
    if key == gui.SCANCODE_R { run_transform("rotate180") return }
    if key == gui.SCANCODE_J { run_transform("flip-h") return }
    if key == gui.SCANCODE_K { run_transform("flip-v") return }

    // The SIZE-CHANGING transforms, which now have a whole-document undo
    // (OP_DOC_XFORM) and so are reachable at last.
    //
    // ON THE LETTERS. These are document commands, so by this file's own modifier
    // rule they belong on Cmd chords - but Cmd+R, Cmd+C and Cmd+W are taken by the
    // platform (reload, copy, close window), and a binding the OS eats is worse than
    // no binding. So they take bare letters next to the flips they are cousins of,
    // which is also what R/J/K already do.
    //
    // NOT on `-` and `=`, which is the tempting choice for the two scales and the
    // wrong one: those are Cmd+- / Cmd+= for ZOOM, and zoom is non-destructive while
    // a document scale RESAMPLES every layer. Putting a destructive resample one
    // modifier away from a harmless zoom is a footgun, so the scales take a letter
    // and a shift instead.
    if key == gui.SCANCODE_N { run_doc_transform("rot90-cw") return }
    if key == gui.SCANCODE_P { run_doc_transform("rot90-ccw") return }
    if key == gui.SCANCODE_Y { run_doc_transform("crop") return }
    if key == gui.SCANCODE_U {
        if shift == 1 { run_doc_transform("scale-double") }
        else { run_doc_transform("scale-half") }
        return
    }

    // Bracket keys size the brush - the one binding that is muscle memory rather
    // than a menu equivalent, which is why it earns a key of its own.
    if key == gui.SCANCODE_LEFTBRACKET { on_radius_down(0) return }
    if key == gui.SCANCODE_RIGHTBRACKET { on_radius_up(0) return }

    // Escape cancels the gesture in progress rather than quitting. The toolkit
    // still stops the app on Escape when the app ignores it, so this is a real
    // override: a user mid-marquee expects Escape to abandon the marquee.
    if key == gui.SCANCODE_ESCAPE {
        if paint.stroke_active() {
            paint.cancel()
            g_msg = "stroke cancelled"
            g_dirty = 1
            return
        }
        if g_marq_live == 1 {
            g_marq_live = 0
            g_msg = "marquee cancelled"
            return
        }
    }
}

// Drain one frame's unclaimed keys. Separate from the loop body so the script
// runner can drive the identical dispatch a keystroke does.
fn drain_shortcuts(ui: Ui) {
    var k = 0
    while k < widgets.Ui_shortcut_count(ui) {
        handle_shortcut(widgets.Ui_shortcut_at(ui, k), widgets.Ui_shortcut_mod_at(ui, k))
        k = k + 1
    }
}

fn on_sel_invert(id: int) {
    if select.is_empty() {
        // Inverting nothing is selecting everything, which is what a user means
        // by it, and is what the coverage arithmetic does anyway (1-0 = 1).
        select.select_all()
        g_msg = "selected all (inverted empty)"
        return
    }
    select.invert()
    g_msg = "inverted selection"
}

// ---- document -------------------------------------------------------------

// (Re)create the texture to match the document, then composite and upload.
fn refresh(id: int) {
    if g_doc_w <= 0 { return }
    if g_doc_h <= 0 { return }

    if g_tex_w != g_doc_w or g_tex_h != g_doc_h {
        if g_tex >= 0 { gui.Win_texture_free(g_tex) }
        g_tex = gui.Win_texture(g_win, g_doc_w, g_doc_h)
        g_tex_w = g_doc_w
        g_tex_h = g_doc_h
    }
    if g_tex < 0 { return }

    var out = render.compose(g_doc_w, g_doc_h)
    if out == 0 {
        g_msg = "composite failed"
        return
    }
    if wynimg_upload_tex(g_tex, out) == 0 { g_msg = "texture upload failed" }
    // The previous composite is freed here rather than never: a full float32
    // RGBA image is 16 bytes a pixel, so holding one per frame would leak the
    // document's size every 16ms.
    if g_last_comp != 0 { wynimg_free(g_last_comp) }
    g_last_comp = out
    g_dirty = 0
}

// Replaces the document with a single PNG. A missing, truncated or non-PNG file
// yields a null handle whose width reads back 0 (all libpng longjmp handling is
// contained in csrc/wynimg_codec.c), so this reports rather than crashes.
fn open_png(path: string) {
    if path == "" {
        g_msg = "no path"
        return
    }
    var buf = wynimg_load_png(path)
    if wynimg_width(buf) == 0 {
        g_msg = "cannot read " + path
        return
    }
    layer.store_new()
    history.history_new()
    layer.add(path, buf, layer.KIND_RASTER())
    g_doc_w = wynimg_width(buf)
    g_doc_h = wynimg_height(buf)
    g_active = 0
    view.set_doc(g_doc_w, g_doc_h)
    view.zoom_fit()
    g_msg = "opened " + path
    g_dirty = 1
}

fn save_png(path: string) {
    if path == "" {
        g_msg = "no path"
        return
    }
    if render.compose_to_png(g_doc_w, g_doc_h, path) == 1 {
        g_msg = "wrote " + path
        return
    }
    g_msg = "cannot write " + path
}

// ---- layered documents (.wync) --------------------------------------------
//
// THE EXTENSION PICKS THE FORMAT, and the two formats are not interchangeable:
// PNG flattens the stack to one image, `.wync` keeps every layer with its blend
// mode, opacity, visibility, mask and adjustment amount. One Save button that
// silently threw the layer stack away because the user typed the wrong suffix
// would be worse than two buttons, so the suffix - the thing the user actually
// typed - decides, and the status line names which one happened.

fn is_wync(path: string) -> bool { return path.lower().ends_with(".wync") }

fn save_doc(path: string) {
    if path == "" {
        g_msg = "no path"
        return
    }
    if is_wync(path) == false {
        save_png(path)
        return
    }
    // The live selection travels with the document. `select.handle()` is 0 when there
    // is none, which is exactly what project.save reads as "write no trailer".
    var rc = project.save(path, g_doc_w, g_doc_h, select.handle())
    if rc == project.OK() {
        g_msg = "wrote " + path + " (" + layer.count().to_string() + " layers)"
        return
    }
    // Every failure mode has its own code for exactly this reason: "save failed"
    // is not actionable, "cannot open for writing" is.
    g_msg = "cannot write " + path + ": " + project.error_message(rc)
}

// Replaces the document with a loaded .wync. This is the loop src/project.wyn's
// header describes as "the integrator's job": the loader reports a table and
// this decides what happens to the document being replaced.
//
// THE ORDER MATTERS AND IS THE WHOLE FUNCTION.
//
// 1. `load` FIRST, before anything is torn down. On any failure the old document
//    is still intact and the message names the reason - a loader that cleared
//    the stack first would turn "that file is damaged" into "your work is gone".
// 2. Then release the outgoing document's own memory: an in-flight stroke (whose
//    base clone and coverage buffer are full-canvas), then the history log's
//    OP_PIXELS snapshots. Only after that are the old layer buffers unreachable.
// 3. `take_buffer`/`take_mask` TRANSFER ownership row by row, so `release()`
//    frees only what was not kept. Taking twice yields 0 by design, so each is
//    called exactly once per row.
fn open_wync(path: string) {
    var rc = project.load(path)
    if rc != project.OK() {
        g_msg = "cannot open " + path + ": " + project.error_message(rc)
        return
    }
    var n = project.layer_count()
    var w = project.doc_width()
    var h = project.doc_height()
    if n <= 0 or w <= 0 or h <= 0 {
        project.release()
        g_msg = "empty document in " + path
        return
    }

    if paint.stroke_active() { paint.cancel() }
    // The old layer buffers are freed here rather than leaked. Nothing else can
    // still reference them: the stroke is cancelled above, the history log is
    // reset (freeing its own snapshots), and the composite is a separate buffer.
    history.history_reset()
    var old = 0
    while old < layer.count() {
        if layer.buffer(old) != 0 { wynimg_free(layer.buffer(old)) }
        if layer.mask(old) != 0 { wynimg_free(layer.mask(old)) }
        old = old + 1
    }
    layer.store_new()

    var i = 0
    while i < n {
        var idx = layer.add(project.layer_name(i), project.take_buffer(i),
                            project.layer_kind(i))
        layer.set_blend_mode(idx, project.layer_blend(i))
        layer.set_opacity(idx, project.layer_opacity(i))
        layer.set_visible(idx, project.layer_visible(i))
        layer.set_adjust_amount(idx, project.layer_amount(i))
        layer.set_mask(idx, project.take_mask(i))
        i = i + 1
    }

    // GROUP MEMBERSHIP, IN A SECOND PASS. `set_parent` validates that the parent
    // exists and is a group, and rows arrive bottom-first - so a child read before
    // its group has been added would be refused and silently flattened. By here
    // every row exists, and because the file preserves stack order the recorded
    // indices are still the right ones.
    //
    // A refused parent is dropped rather than retried: it can only mean a corrupt
    // or hand-edited file (a parent that is not a group, or above its child), and
    // a layer at the top level is visible and editable, whereas a layer inside a
    // group that does not exist is neither.
    var gi = 0
    while gi < n {
        var pp = project.layer_parent(gi)
        if pp != 0 - 1 { layer.set_parent(gi, pp) }
        gi = gi + 1
    }
    project.release()

    g_doc_w = w
    g_doc_h = h
    g_active = layer.count() - 1
    view.set_doc(g_doc_w, g_doc_h)
    view.zoom_fit()
    // The selection is document-sized coverage, so the OLD one cannot survive a
    // document of different dimensions - it is replaced, never kept and clipped.
    select.init(g_doc_w, g_doc_h)
    // ...but the SAVED selection comes back, when the file carried one. Adopted with
    // take_selection so `release()` below does not free it, and only when its
    // dimensions match the document: a mismatch means a hand-edited or corrupt file,
    // and installing a wrong-sized coverage buffer would make every later clip read
    // out of bounds. A dropped selection is redrawable; that is not.
    if project.has_selection() {
        var sh = project.take_selection()
        if sh != 0 {
            if select.adopt(sh, g_doc_w, g_doc_h) == false { wynimg_free(sh) }
        }
    }
    g_msg = "opened " + path + " (" + n.to_string() + " layers)"
    g_dirty = 1
}

fn open_doc(path: string) {
    if path == "" {
        g_msg = "no path"
        return
    }
    if is_wync(path) { open_wync(path) } else { open_png(path) }
}

// ---- canvas gesture -------------------------------------------------------
//
// Called from the frame loop with the pointer's WINDOW position and button
// state. This is the ONE place that turns window coordinates into document
// coordinates, and it does so through `view`, which is unit-tested as an
// invertible transform. A brush that lands in the wrong place is therefore
// either a bug in view (which tests/test_view.wyn would catch) or in these
// ~70 lines.

// The picker's WINDOW->COLOUR direction is layout.sv_sat/sv_val/hue_at; these two
// only apply the result. Keeping the arithmetic there is what puts it next to the
// inverse (layout.sv_x_of_sat and friends), which paint_picker uses to draw the
// crosshair - the two must agree or the marker sits where a click does not land.
fn pick_sv(mx: int, my: int) {
    paint.set_hsv(paint.hue(), layout.sv_sat(mx), layout.sv_val(my))
    g_msg = "sat " + rounded(paint.sat()) + " val " + rounded(paint.val())
}

fn pick_hue(my: int) {
    paint.set_hsv(layout.hue_at(my), paint.sat(), paint.val())
    g_msg = "hue " + rounded(paint.hue())
}

// ---- marquee ---------------------------------------------------------------
//
// Applied on every drag move, not only at release, so the selection the marquee
// outline shows IS the selection - there is no separate "preview" that could
// disagree with the committed result. That is the same argument src/paint.wyn
// makes for the stroke preview going through the apply kernel.
//
// FOR A LIVE DRAG THE OP IS ALWAYS REPLACE ON THE BASE, which needs one extra
// buffer and is the reason `g_sel_base` exists. Re-applying an ADD rect at every
// mouse move would accumulate every intermediate rectangle - drag a rect
// leftwards and you would select the union of every size it passed through, not
// the final one. So the pre-drag selection is snapshotted at press, and each move
// restores it and applies the shape ONCE with the chosen op.
var g_sel_base = 0

// Appends a lasso point, dropping one within half a pixel of the last so a slow
// drag does not store thousands of duplicates (which would also make the polygon
// kernel's per-point cost the dominant one).
fn lasso_push(x: float, y: float) {
    if g_lasso_n > 0 {
        var lx = g_lasso_xs[g_lasso_n - 1]
        var ly = g_lasso_ys[g_lasso_n - 1]
        if pixel.approx(lx, x, 0.5) {
            if pixel.approx(ly, y, 0.5) { return }
        }
    }
    if g_lasso_n < g_lasso_xs.len() {
        g_lasso_xs[g_lasso_n] = x
        g_lasso_ys[g_lasso_n] = y
    } else {
        g_lasso_xs.push(x)
        g_lasso_ys.push(y)
    }
    g_lasso_n = g_lasso_n + 1
}

// Builds a point list of EXACTLY the path's length and fills the selection with
// it. Exact length because the kernel reads the count from the buffer's width -
// see the note on g_lasso_xs.
fn lasso_fill() {
    if g_lasso_n < 3 { return }
    var pts = select.poly_new(g_lasso_n)
    if pts == 0 { return }
    var i = 0
    while i < g_lasso_n {
        select.poly_set(pts, i, g_lasso_xs[i], g_lasso_ys[i])
        i = i + 1
    }
    select.polygon(pts, g_sel_op)
    select.poly_free(pts)
}

fn marquee_apply(final_pass: bool) {
    if select.active() == false { return }
    // Restore the pre-drag state, then apply the shape once. See above.
    if g_sel_base != 0 { wynimg_copy_into(select.handle(), g_sel_base) }

    if g_sel_tool == SEL_LASSO {
        lasso_fill()
        return
    }

    // A drag from either corner must work, so the rect is normalised rather than
    // requiring top-left-to-bottom-right.
    var x0 = g_marq_x0
    var x1 = g_marq_x1
    if x1 < x0 { x0 = g_marq_x1 x1 = g_marq_x0 }
    var y0 = g_marq_y0
    var y1 = g_marq_y1
    if y1 < y0 { y0 = g_marq_y1 y1 = g_marq_y0 }

    if g_sel_tool == SEL_ELLIPSE {
        // The ellipse INSCRIBED in the dragged box, which is what dragging an
        // ellipse means everywhere; centre and radii, because that is what the
        // engine takes.
        select.ellipse((x0 + x1) / 2.0, (y0 + y1) / 2.0,
                       (x1 - x0) / 2.0, (y1 - y0) / 2.0, g_sel_op)
        return
    }
    select.rect(x0, y0, x1 - x0, y1 - y0, g_sel_op)
}

// A click with no drag DESELECTS, for rect and ellipse. A zero-area marquee is
// what a user does to get rid of a selection, and leaving a 0x0 selection behind
// would make every subsequent tool a silent no-op - the worst outcome available.
fn marquee_release() {
    var degenerate = false
    if g_sel_tool != SEL_LASSO {
        if pixel.approx(g_marq_x0, g_marq_x1, 0.5) {
            if pixel.approx(g_marq_y0, g_marq_y1, 0.5) { degenerate = true }
        }
    } else {
        if g_lasso_n < 3 { degenerate = true }
    }

    if degenerate {
        if g_sel_base != 0 { wynimg_copy_into(select.handle(), g_sel_base) }
        select.select_none()
        g_msg = "deselected"
    } else {
        marquee_apply(true)
        g_msg = sel_tool_word() + " selection, " + rounded(select.area()) + " px"
    }

    if g_sel_base != 0 {
        wynimg_free(g_sel_base)
        g_sel_base = 0
    }
    g_lasso_n = 0
    g_marq_live = 0
}

fn sel_tool_word() -> string {
    if g_sel_tool == SEL_RECT { return "rect" }
    if g_sel_tool == SEL_ELLIPSE { return "ellipse" }
    if g_sel_tool == SEL_LASSO { return "lasso" }
    if g_sel_tool == SEL_TEXT { return "text" }
    return "none"
}

fn canvas_press(mx: int, my: int) {
    var t = paint.tool()

    // The picker first: it is inside the panel, not the viewport, so it can
    // never be confused with a canvas click.
    if layout.in_sv(mx, my) {
        g_drag = DRAG_SV
        pick_sv(mx, my)
        return
    }
    if layout.in_hue(mx, my) {
        g_drag = DRAG_HUE
        pick_hue(my)
        return
    }

    if layout.in_viewport(mx, my) == false { return }

    // The text tool: a click PLACES text, so it needs the document position and
    // then the frame loop (which can read the entry) to do the work. Unlike a
    // marquee this does require the click to be on the canvas - text placed
    // outside the document would rasterise entirely off the buffer.
    if g_sel_tool == SEL_TEXT {
        if view.hits_doc(mx, my) == false {
            g_msg = "outside the canvas"
            return
        }
        g_text_x = view.screen_to_doc_x(mx.to_float())
        g_text_y = view.screen_to_doc_y(my.to_float())
        g_req = REQ_TEXT
        g_msg = "placing text"
        return
    }

    // A marquee tool takes the press before any paint tool sees it, and it does
    // NOT require view.hits_doc: dragging a selection from outside the canvas
    // into it is normal, and the coverage kernels clip to the buffer anyway.
    if g_sel_tool != SEL_NONE {
        if select.active() == false {
            g_msg = "no selection buffer"
            return
        }
        g_marq_x0 = view.screen_to_doc_x(mx.to_float())
        g_marq_y0 = view.screen_to_doc_y(my.to_float())
        g_marq_x1 = g_marq_x0
        g_marq_y1 = g_marq_y0
        g_marq_live = 1
        g_drag = DRAG_MARQUEE

        // Snapshot the pre-drag selection so each move can restore it. Without
        // this an add-mode drag accumulates every intermediate shape.
        if g_sel_base != 0 { wynimg_free(g_sel_base) }
        g_sel_base = wynimg_clone(select.handle())

        g_lasso_n = 0
        if g_sel_tool == SEL_LASSO { lasso_push(g_marq_x0, g_marq_y0) }
        return
    }

    if t == paint.TOOL_PAN() {
        g_drag = DRAG_PAN
        g_drag_px = mx
        g_drag_py = my
        return
    }

    if view.hits_doc(mx, my) == false {
        g_msg = "outside the canvas"
        return
    }

    var dx = view.screen_to_doc_x(mx.to_float())
    var dy = view.screen_to_doc_y(my.to_float())

    // THE SELECTION ALSO GATES THE PRESS, on top of the coverage clip that
    // src/paint.wyn now applies in `apply_cov()`.
    //
    // The two are not redundant, they answer different questions. The clip makes a
    // stroke that crosses the boundary get CUT at it (including at a feathered
    // edge, exactly). This gate makes a press that begins on an unselected pixel do
    // nothing AT ALL - no stroke, no history entry - rather than begin a stroke
    // every dab of which is clipped away to nothing. Without the gate the user gets
    // an undo entry for a gesture that changed no pixels, which reads as a bug.
    //
    // TOOL_PICK is exempt because the eyedropper reads the composite rather than
    // writing to the layer, so a selection has no business restricting where you
    // can sample from.
    if select.is_empty() == false {
        if t != paint.TOOL_PICK() {
            if select.cov_at(dx.to_int(), dy.to_int()) <= 0.0 {
                g_msg = "outside the selection"
                return
            }
        }
    }

    if t == paint.TOOL_PICK() {
        if g_last_comp == 0 { refresh(0) }
        paint.pick_from(g_last_comp, dx.to_int(), dy.to_int())
        g_msg = "picked hue " + rounded(paint.hue())
        return
    }

    if t == paint.TOOL_FILL() {
        if g_active < 0 { return }
        var n = paint.fill_at(g_active, dx.to_int(), dy.to_int())
        if n < 0 {
            g_msg = "cannot fill that layer"
        } else {
            g_msg = "filled " + n.to_string() + " px"
        }
        g_dirty = 1
        return
    }

    // Brush or eraser.
    if g_active < 0 {
        g_msg = "no active layer"
        return
    }
    if paint.begin(g_active, dx, dy) == 0 {
        g_msg = "cannot paint that layer"
        return
    }
    g_drag = DRAG_STROKE
    g_dirty = 1
}

fn canvas_drag(mx: int, my: int) {
    if g_drag == DRAG_MARQUEE {
        // DOCUMENT coordinates, through the same transform the blit uses - so the
        // marquee tracks the pointer at any zoom for the same reason the brush
        // does. See the note on g_marq_x0.
        g_marq_x1 = view.screen_to_doc_x(mx.to_float())
        g_marq_y1 = view.screen_to_doc_y(my.to_float())
        if g_sel_tool == SEL_LASSO { lasso_push(g_marq_x1, g_marq_y1) }
        marquee_apply(false)
        return
    }
    if g_drag == DRAG_STROKE {
        var dx = view.screen_to_doc_x(mx.to_float())
        var dy = view.screen_to_doc_y(my.to_float())
        paint.seg(dx, dy)
        g_dirty = 1
        return
    }
    if g_drag == DRAG_PAN {
        view.pan_by(mx - g_drag_px, my - g_drag_py)
        g_drag_px = mx
        g_drag_py = my
        return
    }
    if g_drag == DRAG_SV {
        pick_sv(mx, my)
        return
    }
    if g_drag == DRAG_HUE {
        pick_hue(my)
        return
    }
}

fn canvas_release(mx: int, my: int) {
    if g_drag == DRAG_MARQUEE {
        marquee_release()
        g_drag = DRAG_NONE
        return
    }
    if g_drag == DRAG_STROKE {
        paint.commit()
        g_msg = paint.tool_name(paint.tool()) + " stroke, "
                + paint.stroke_segments().to_string() + " segs"
        g_dirty = 1
    }
    g_drag = DRAG_NONE
}

// ---- paint ----------------------------------------------------------------
//
// One Win_clear, everything, one Win_present. See the header for why Ui_draw is
// not used.
//
// WHY THE Ui_*_at ACCESSORS AND NOT `ui.widgets[i].label` DIRECTLY.
//
// The accessors are used because they are the toolkit's published surface, NOT
// because the direct spelling is broken. That distinction was worth measuring,
// because it decides whether this indirection is a permanent workaround or a
// style choice, and the two age very differently.
//
// The historical defect - indexing a struct-array field of a type that came from
// an imported module lost the element type, giving "Unknown method 'x' for type
// 'int'" - DOES NOT REPRODUCE on this compiler (v1.20.0-dev). Five shapes were
// built and run against the real `widgets` module: a constant index, a
// loop-variable index, a local bound to the element, a write through the index
// (`ui.widgets[0].x = 99`), and a non-main fn taking `ui: Ui` as a parameter.
// All five compiled and printed correct values.
//
// So the accessors stay on their own merits: paint code reading through
// Ui_x_at/Ui_label_at cannot be broken by a field rename inside widgets.wyn,
// which reaching into `ui.widgets[i]` from another repository could be.

fn is_selected_tool(label: string) -> bool {
    if label == "Brush" { return paint.tool() == paint.TOOL_BRUSH() }
    if label == "Erase" { return paint.tool() == paint.TOOL_ERASER() }
    if label == "Fill" { return paint.tool() == paint.TOOL_FILL() }
    if label == "Pick" { return paint.tool() == paint.TOOL_PICK() }
    if label == "Pan" { return paint.tool() == paint.TOOL_PAN() }
    return false
}

// Chrome for one control, painted from the toolkit's own data (label and rect)
// and its interaction state, so hover and press feedback still come from the
// toolkit rather than being reinvented.
fn paint_button(ui: Ui, i: int) {
    var x = widgets.Ui_x_at(ui, i)
    var y = widgets.Ui_y_at(ui, i)
    var w = widgets.Ui_w_at(ui, i)
    var h = widgets.Ui_h_at(ui, i)
    var id = widgets.Ui_id_at(ui, i)
    var label = widgets.Ui_label_at(ui, i)

    var r = 52
    var g = 52
    var b = 62
    // A tool button is highlighted when its tool is SELECTED, read from the
    // paint module rather than from a cached flag: after a script action or a
    // future keyboard shortcut the module is the truth, and a cached flag would
    // silently disagree with what the next click will do.
    if is_selected_tool(label) {
        r = 36
        g = 104
        b = 86
    }
    if id == widgets.Ui_active(ui) {
        r = 50
        g = 90
        b = 150
    } else {
        if id == widgets.Ui_hot(ui) {
            r = 70
            g = 110
            b = 170
        }
    }
    gui.Win_rect(g_win, x, y, w, h, r, g, b)
    gui.Win_rect_outline(g_win, x, y, w, h, 120, 120, 140)

    var tw = gui.Win_text_width(g_font, label)
    var th = gui.Win_font_height(g_font)
    gui.Win_text(g_win, g_font, label, x + (w - tw) / 2, y + (h - th) / 2,
                 235, 235, 240)
}

// A slider: track, filled portion, thumb, and its value as text.
//
// WHY THIS FILE HAS TO DRAW IT. WynCanvas does not call widgets.Ui_draw - that
// function clears and presents its own frame, which would erase the document (see
// this file's header). So every widget kind it uses must be painted here, and a
// kind with no case is INVISIBLE while still being hit-testable and draggable:
// the slider would work perfectly and show nothing.
//
// The geometry comes from the toolkit (Ui_slider_thumb_x), never recomputed here.
// A second copy of the thumb formula would drift from the one that decides what a
// click MEANS, and the symptom would be a thumb that sits beside the value it
// reports.
fn paint_slider(ui: Ui, i: int) {
    var x = widgets.Ui_x_at(ui, i)
    var y = widgets.Ui_y_at(ui, i)
    var w = widgets.Ui_w_at(ui, i)
    var h = widgets.Ui_h_at(ui, i)
    var id = widgets.Ui_id_at(ui, i)

    var cy = y + h / 2
    // The track, inset by the thumb's half-width so the thumb never overhangs it.
    gui.Win_rect(g_win, x + 6, cy - 2, w - 12, 4, 40, 40, 48)

    var tx = widgets.Ui_slider_thumb_x(ui, id)
    // The filled part, left of the thumb: it is what makes the value readable at
    // a glance without reading the number.
    if tx > x + 6 {
        gui.Win_rect(g_win, x + 6, cy - 2, tx - x - 6, 4, 70, 110, 170)
    }

    // The thumb, brighter while it is the one being dragged or hovered.
    var tr = 200
    var tg = 200
    var tb = 212
    if widgets.Ui_hot(ui) == id { tr = 235 tg = 235 tb = 245 }
    gui.Win_rect(g_win, tx - 5, cy - 8, 10, 16, tr, tg, tb)
    gui.Win_rect_outline(g_win, tx - 5, cy - 8, 10, 16, 20, 20, 26)

    // The value, to the right of the track. Text rather than a tooltip because a
    // filter strength is a number you set deliberately, not one you discover.
    var lbl = "${widgets.Ui_val(ui, id)}%"
    gui.Win_text(g_win, g_font, lbl, x + w - gui.Win_text_width(g_font, lbl),
                 y - 14, 200, 200, 212)
}

fn paint_entry(ui: Ui, i: int) {
    var x = widgets.Ui_x_at(ui, i)
    var y = widgets.Ui_y_at(ui, i)
    var w = widgets.Ui_w_at(ui, i)
    var h = widgets.Ui_h_at(ui, i)
    var id = widgets.Ui_id_at(ui, i)

    gui.Win_rect(g_win, x, y, w, h, 16, 16, 20)
    var er = 110
    var eg = 110
    var eb = 130
    if id == widgets.Ui_focus(ui) {
        er = 70
        eg = 110
        eb = 170
    }
    gui.Win_rect_outline(g_win, x, y, w, h, er, eg, eb)

    // Clip, so a long path stops at the border instead of painting across the
    // toolbar.
    gui.Win_clip(g_win, x + 1, y + 1, w - 2, h - 2)
    var text = widgets.Ui_text_at(ui, i)
    var th = gui.Win_font_height(g_font)
    gui.Win_text(g_win, g_font, text, x + 5, y + (h - th) / 2, 225, 225, 232)
    if id == widgets.Ui_focus(ui) {
        var cw = gui.Win_text_width(g_font, text)
        gui.Win_rect(g_win, x + 6 + cw, y + 4, 2, h - 8, 225, 225, 232)
    }
    gui.Win_clip(g_win, 0, 0, 0, 0)
}

// THE MARQUEE. A selection the user cannot see is a trap, because every
// subsequent tool silently refuses outside it - so the outline is not decoration.
//
// IT IS DRAWN FROM THE SELECTION'S OWN BOUNDING BOX, not from the drag
// rectangle, and that distinction is the whole reason this is trustworthy: the
// bbox comes from `select.bbox_*`, which scans the actual coverage buffer. So the
// outline is a statement ABOUT the selection rather than a redrawing of the
// gesture that made it, and it is therefore correct for a selection built by
// three lasso drags, by an invert, or by Select All - none of which has a drag
// rectangle at all. A marquee painted from g_marq_* would have shown the last
// dragged box and been quietly wrong for every other case.
//
// A bbox is not the shape, and that is stated honestly: an ellipse selection
// shows its bounding box, not marching ants along the rim. Drawing the true
// boundary means walking the coverage buffer per frame to find edge pixels
// (65,536 reads at 256x256, per frame, from Wyn - one FFI call each), which is
// the "one Win_rect per pixel" mistake this file's header rejects. The DRAG
// outline below is exact for a rect and shows the ellipse's box while dragging,
// which is what a user needs to place it.
// Rebuild the ants overlay if the selection changed, then blit it.
//
// Called from the viewport painter right after the document's own blit, so the
// ants land ON the image and under the toolbar. Two cheap guards do the work:
// the texture is only reallocated when the DOCUMENT size changes, and the
// coverage scan only re-runs when the SELECTION changes (select.generation()).
// A frame with an unchanged selection costs one blit.
fn paint_ants(dx: int, dy: int, dw: int, dh: int) {
    if select.active() == false { return }

    if g_ants_w != g_doc_w or g_ants_h != g_doc_h {
        if g_ants_tex >= 0 { gui.Win_texture_free(g_ants_tex) }
        if g_ants_buf != 0 { select.free_mask(g_ants_buf) }
        g_ants_tex = gui.Win_texture(g_win, g_doc_w, g_doc_h)
        g_ants_buf = select.new_mask(g_doc_w, g_doc_h)
        g_ants_w = g_doc_w
        g_ants_h = g_doc_h
        // Force a rebuild: a fresh buffer holds no outline yet, and the stamp
        // may already equal the current generation.
        g_ants_stamp = 0.0 - 1.0
        g_ants_ready = 0
    }
    if g_ants_tex < 0 { return }
    if g_ants_buf == 0 { return }

    var gen = select.generation().to_float()
    if gen != g_ants_stamp {
        g_ants_stamp = gen
        g_ants_ready = 0
        if select.outline(g_ants_buf) {
            if wynimg_upload_tex(g_ants_tex, g_ants_buf) == 1 { g_ants_ready = 1 }
        }
    }
    if g_ants_ready == 1 {
        gui.Win_blit(g_win, g_ants_tex, dx, dy, dw, dh)
    }
}

fn paint_marquee() {
    if select.active() == false { return }

    // While dragging, the exact shape being dragged - a rect outline for MRct,
    // its bounding box for MEll (which is what the ellipse is inscribed in).
    if g_marq_live == 1 {
        if g_sel_tool != SEL_LASSO {
            var ax = view.doc_to_screen_x(g_marq_x0).to_int()
            var ay = view.doc_to_screen_y(g_marq_y0).to_int()
            var bx = view.doc_to_screen_x(g_marq_x1).to_int()
            var by = view.doc_to_screen_y(g_marq_y1).to_int()
            var lx = ax
            var rx = bx
            if rx < lx { lx = bx rx = ax }
            var ty2 = ay
            var by2 = by
            if by2 < ty2 { ty2 = by by2 = ay }
            // Two outlines, light over dark, so the marquee is visible over both
            // a white and a black document - the same trick the picker's
            // crosshair uses.
            gui.Win_rect_outline(g_win, lx, ty2, rx - lx, by2 - ty2, 20, 20, 20)
            gui.Win_rect_outline(g_win, lx - 1, ty2 - 1, rx - lx + 2,
                                 by2 - ty2 + 2, 250, 250, 255)
            return
        }
        // The lasso, as the polyline the user has drawn so far. Exact, because a
        // lasso's own path IS its outline.
        var i = 1
        while i < g_lasso_n {
            gui.Win_line(g_win,
                         view.doc_to_screen_x(g_lasso_xs[i - 1]).to_int(),
                         view.doc_to_screen_y(g_lasso_ys[i - 1]).to_int(),
                         view.doc_to_screen_x(g_lasso_xs[i]).to_int(),
                         view.doc_to_screen_y(g_lasso_ys[i]).to_int(),
                         250, 250, 255)
            i = i + 1
        }
        return
    }

    // THE COMMITTED SELECTION IS DRAWN BY paint_ants, NOT HERE.
    //
    // Its shape now reaches the screen as coverage from select.outline(), so an
    // ellipse shows an ellipse and a feathered edge fades - which is what the
    // README called out as missing. The bounding box that used to be drawn here
    // is deliberately GONE rather than kept as a faint extra: paint_marquee runs
    // AFTER paint_ants, so a box drawn here paints over the ants along every
    // axis-aligned edge, and for a rect selection - where the box and the true
    // outline coincide exactly - it replaced the whole outline with a dark line.
    // Measured, not reasoned: the rect case of tests/run_ants_test.sh caught it
    // reading 40,40,48 (the box) where it expected the bright rim.
    //
    // Nothing is lost. The box conveyed EXTENT, and the outline conveys extent
    // plus shape; the live-drag branch above still draws its own rect while a
    // marquee is being dragged, which is the one moment there is no committed
    // selection to outline yet.
}

// The document. Positioned by `view` at the current zoom and pan, clipped to the
// viewport, on a checkerboard so that transparency is visible as transparency
// rather than as whatever colour the panel happens to be.
//
// Every coordinate comes from `view`, never recomputed here - that is what makes
// "the brush lands under the pointer" true by construction rather than by
// coincidence: the same origin_x/scale that place this blit are the ones
// screen_to_doc_x inverts.
fn paint_viewport(ui: Ui) {
    gui.Win_rect(g_win, layout.VIEW_X(), layout.VIEW_Y(), layout.VIEW_W(), layout.VIEW_H(), 24, 24, 28)
    gui.Win_clip(g_win, layout.VIEW_X(), layout.VIEW_Y(), layout.VIEW_W(), layout.VIEW_H())

    if g_tex >= 0 and g_doc_w > 0 {
        var dw = view.view_doc_w()
        var dh = view.view_doc_h()
        var dx = view.origin_x()
        var dy = view.origin_y()

        // Checkerboard, exactly under the image.
        var cy = 0
        while cy * 16 < dh {
            var cx = 0
            while cx * 16 < dw {
                // NB: the parity is hoisted, not written inline as
                // `if (cx + cy) % 2 == 0`. An `if` whose condition STARTS with
                // "(" has that paren consumed as a C-style condition delimiter,
                // so any operator after the closing paren is a parse error -
                // "Expected an expression". `if (a) == 2 { }` fails the same
                // way. Reported; harmless once known, because the hoist is
                // equally readable.
                var parity = (cx + cy) % 2
                var shade = 58
                if parity == 0 { shade = 74 }
                var cw = 16
                var ch = 16
                if cx * 16 + cw > dw { cw = dw - cx * 16 }
                if cy * 16 + ch > dh { ch = dh - cy * 16 }
                gui.Win_rect(g_win, dx + cx * 16, dy + cy * 16, cw, ch,
                             shade, shade, shade)
                cx = cx + 1
            }
            cy = cy + 1
        }

        // The whole point of this file: one blit.
        gui.Win_blit(g_win, g_tex, dx, dy, dw, dh)
        gui.Win_rect_outline(g_win, dx - 1, dy - 1, dw + 2, dh + 2, 90, 90, 105)

        // The selection's real boundary, as a second blit over the document.
        // Before paint_marquee, so a LIVE drag's own outline draws on top of the
        // committed selection's ants rather than under them.
        paint_ants(dx, dy, dw, dh)

        paint_marquee()

        // Brush cursor: a ring at the pointer, its radius scaled by the zoom, so
        // "how big is the brush" is answered by looking rather than by reading a
        // number. Only for the tools that actually paint - a ring under Pan
        // would be a lie.
        var t = paint.tool()
        var paints = 0
        if t == paint.TOOL_BRUSH() { paints = 1 }
        if t == paint.TOOL_ERASER() { paints = 1 }
        if paints == 1 {
            var mx = gui.Win_mouse_x()
            var my = gui.Win_mouse_y()
            if layout.in_viewport(mx, my) {
                var rr = (paint.radius() * view.scale()).to_int()
                if rr < 2 { rr = 2 }
                gui.Win_rect_outline(g_win, mx - rr, my - rr, rr * 2, rr * 2,
                                     240, 240, 250)
            }
        }
    } else {
        gui.Win_text(g_win, g_font, "no document - type a path and press Open",
                     layout.VIEW_X() + 20, layout.VIEW_Y() + 20, 150, 150, 165)
    }

    gui.Win_clip(g_win, 0, 0, 0, 0)
}

// The colour picker: an SV square and a hue strip, each a texture blitted once
// (see the note in csrc/wynimg_paint.c on why they are not drawn with
// rectangles), plus crosshairs showing the current selection.
fn paint_picker(ui: Ui) {
    // Rebuild the SV square only when the hue changed. Comparing floats with a
    // tolerance rather than for equality because the hue arrives from a drag and
    // from the eyedropper, and "did it change" must not be answered by bit
    // patterns.
    if g_sv_tex >= 0 {
        if pixel.approx(g_sv_hue, paint.hue(), 0.0001) == false {
            wynimg_sv_square(g_sv_buf, paint.hue())
            wynimg_upload_tex(g_sv_tex, g_sv_buf)
            g_sv_hue = paint.hue()
        }
        gui.Win_blit(g_win, g_sv_tex, layout.SV_X(), layout.SV_Y(), layout.SV_SIZE(), layout.SV_SIZE())
    }
    gui.Win_rect_outline(g_win, layout.SV_X() - 1, layout.SV_Y() - 1, layout.SV_SIZE() + 2,
                         layout.SV_SIZE() + 2, 100, 100, 118)

    if g_hue_tex >= 0 {
        gui.Win_blit(g_win, g_hue_tex, layout.HUE_X(), layout.HUE_Y(), layout.HUE_W(), layout.SV_SIZE())
    }
    gui.Win_rect_outline(g_win, layout.HUE_X() - 1, layout.HUE_Y() - 1, layout.HUE_W() + 2,
                         layout.SV_SIZE() + 2, 100, 100, 118)

    // Crosshair on the SV square: double-outlined so it is visible against both
    // a white and a black corner.
    var cx = layout.sv_x_of_sat(paint.sat())
    var cy = layout.sv_y_of_val(paint.val())
    gui.Win_rect_outline(g_win, cx - 4, cy - 4, 9, 9, 255, 255, 255)
    gui.Win_rect_outline(g_win, cx - 5, cy - 5, 11, 11, 20, 20, 20)

    // Marker on the hue strip.
    var hy = layout.hue_y_of(paint.hue())
    gui.Win_rect_outline(g_win, layout.HUE_X() - 2, hy - 2, layout.HUE_W() + 4, 5,
                         255, 255, 255)

    // The resulting colour, as a swatch. Painted with the sRGB bytes, because
    // Win_rect takes display values - using the linear ones would show a
    // markedly darker colour than the brush actually paints.
    var sw_y = layout.SV_Y() + layout.SV_SIZE() + 8
    gui.Win_rect(g_win, layout.SV_X(), sw_y, 56, 22,
                 paint.color_byte(0), paint.color_byte(1), paint.color_byte(2))
    gui.Win_rect_outline(g_win, layout.SV_X(), sw_y, 56, 22, 120, 120, 140)
    gui.Win_text(g_win, g_font, paint.tool_name(paint.tool())
                 + " r" + rounded(paint.radius())
                 + " a" + rounded(paint.alpha()),
                 layout.SV_X() + 64, sw_y + 4, 190, 190, 205)
}

// The layer list. Drawn TOP-DOWN in stacking order, i.e. the topmost layer
// first, because that is what the compositor's last-blended layer is and
// showing a stack upside down is a real usability bug rather than a cosmetic
// one. layer.count()-1 is the top of the stack.
//
// Visibility, opacity and blend mode are painted from the layer module, never
// from a cached copy in a widget: after an Undo the layer module is the truth,
// and a widget-held flag would silently disagree with the pixels on screen.
fn paint_layers(ui: Ui) {
    gui.Win_text(g_win, g_font, "Layers", layout.PANEL_X() + 12, layout.LAYERS_Y() - 18,
                 235, 235, 240)

    var n = layer.count()
    // `k` counts LAYERS walked; `vis` counts rows actually DRAWN. They diverge the
    // moment a group is collapsed, and conflating them would leave a gap where a
    // hidden row used to be - which reads as a rendering glitch rather than as a
    // fold. build_form's click targets are placed by the same two counters, so the
    // row a user clicks is the row that was painted.
    var k = 0
    var vis = 0
    var stop = 0
    while k < n {
        if stop == 1 {
            k = n
        } else {
            var li = n - 1 - k                 // top of the stack first
            if row_hidden(li) {
                k = k + 1
                continue
            }
            var y = layout.row_y(vis)
            if layout.row_fits(y) == false {
                stop = 1
            } else {
                var id = 0 - 1
                var j = 0
                while j < g_row_count {
                    if g_row_layer[j] == li { id = g_row_ids[j] }
                    j = j + 1
                }

                var rr = 40
                var rg = 40
                var rb = 48
                if li == g_active {
                    rr = 52
                    rg = 74
                    rb = 96
                }
                if id == widgets.Ui_hot(ui) {
                    rr = rr + 14
                    rg = rg + 14
                    rb = rb + 14
                }
                // INDENT BY DEPTH, so nesting is visible at a glance. The band's
                // geometry comes from `layout` because build_form places this
                // row's click target from the same three functions - see the note
                // there.
                var dep = row_depth(li)
                gui.Win_rect(g_win, layout.row_band_x(dep), y,
                             layout.row_band_w(dep), layout.row_band_h(),
                             rr, rg, rb)
                if li == g_active {
                    gui.Win_rect_outline(g_win, layout.row_band_x(dep), y,
                                         layout.row_band_w(dep),
                                         layout.row_band_h(), 110, 160, 210)
                }

                // A TWISTY ONLY ON A GROUP THAT HAS CHILDREN. Drawing one on an
                // empty group invites a click that does nothing; drawing one on a
                // raster layer is a lie about what the row is.
                if layer.kind(li) == layer.KIND_GROUP() {
                    if layer.child_count(li) > 0 {
                        var mark = "-"
                        if is_folded(li) { mark = "+" }
                        gui.Win_text(g_win, g_font, mark, layout.twisty_x(dep),
                                     y + 3, 210, 210, 225)
                    }
                }

                // Visibility box, from the layer module.
                gui.Win_rect_outline(g_win, layout.vis_box_x(dep), y + 4, 13, 13,
                                     130, 130, 150)
                if layer.visible(li) {
                    gui.Win_rect(g_win, layout.vis_dot_x(dep), y + 7, 7, 7,
                                 120, 200, 130)
                }

                var fr = 232
                var fg = 232
                var fb = 238
                if layer.visible(li) == false {
                    fr = 130
                    fg = 130
                    fb = 142
                }
                // Name, then the blend mode and opacity on the right.
                var pct = (layer.opacity(li) * 100.0 + 0.5).to_int()
                var meta = pixel.blend_name(layer.blend_mode(li)) + " "
                           + pct.to_string() + "%"
                var mw = gui.Win_text_width(g_font, meta)
                gui.Win_clip(g_win, layout.row_clip_x(dep), y,
                             layout.row_clip_w(dep, mw), layout.row_band_h())
                gui.Win_text(g_win, g_font, layer.name(li),
                             layout.row_name_x(dep), y + 3, fr, fg, fb)
                gui.Win_clip(g_win, 0, 0, 0, 0)
                gui.Win_text(g_win, g_font, meta, layout.row_meta_x(mw), y + 3,
                             150, 160, 175)
                vis = vis + 1
                k = k + 1
            }
        }
    }

    if n == 0 {
        gui.Win_text(g_win, g_font, "(empty)", layout.PANEL_X() + 12, layout.LAYERS_Y() + 4,
                     140, 140, 152)
    }
}

// Dimensions, layer count, zoom, tool, brush parameters, the pointer position in
// DOCUMENT coordinates, the history depth and the last message.
//
// The pointer readout is not decoration: it is the one thing that makes a
// mis-mapped brush diagnosable at a glance instead of by bisecting the transform.
fn paint_status(ui: Ui) {
    var y = layout.WIN_H() - layout.STATUS_H()
    gui.Win_rect(g_win, 0, y, layout.WIN_W(), layout.STATUS_H(), 20, 20, 25)
    gui.Win_line(g_win, 0, y, layout.WIN_W(), y, 60, 60, 72)

    var s = g_doc_w.to_string() + "x" + g_doc_h.to_string()
    s = s + "  " + layer.count().to_string() + "L"
    s = s + "  z" + view.zoom().to_string() + "%"
    s = s + "  " + paint.tool_name(paint.tool())
    s = s + " r" + rounded(paint.radius())
    s = s + " h" + rounded(paint.hardness())
    s = s + " a" + rounded(paint.alpha())
    // The selection's area, because every pixel tool refuses outside it: a user
    // whose brush has stopped working needs to see WHY in the status bar rather
    // than deduce it. Omitted entirely when there is no selection, so the line
    // does not carry a permanent "sel 0".
    if select.is_empty() == false {
        s = s + "  sel " + rounded(select.area()) + "px"
    }
    if g_sel_tool != SEL_NONE {
        s = s + "  [" + sel_tool_word() + " " + select.op_name(g_sel_op) + "]"
    }
    s = s + "  @" + g_cur_dx.to_string() + "," + g_cur_dy.to_string()
    s = s + "  hist " + history.depth().to_string()
    s = s + "  " + g_msg
    gui.Win_text(g_win, g_font, s, 8, y + 5, 200, 200, 212)
}

fn paint(ui: Ui) {
    gui.Win_clear(g_win, 28, 28, 34)

    gui.Win_rect(g_win, 0, 0, layout.WIN_W(), layout.TOOLBAR_H(), 38, 38, 46)
    gui.Win_line(g_win, 0, layout.TOOLBAR_H(), layout.WIN_W(), layout.TOOLBAR_H(), 60, 60, 72)

    // Tool strip background.
    gui.Win_rect(g_win, 0, layout.VIEW_Y(), layout.TOOLS_W(), layout.VIEW_H(), 34, 34, 41)
    gui.Win_line(g_win, layout.TOOLS_W(), layout.VIEW_Y(), layout.TOOLS_W(), layout.VIEW_Y() + layout.VIEW_H(),
                 60, 60, 72)

    paint_viewport(ui)

    // Right panel background, then its contents.
    gui.Win_rect(g_win, layout.PANEL_X(), layout.VIEW_Y(), layout.PANEL_W(), layout.VIEW_H(), 34, 34, 41)
    gui.Win_line(g_win, layout.PANEL_X(), layout.VIEW_Y(), layout.PANEL_X(), layout.VIEW_Y() + layout.VIEW_H(),
                 60, 60, 72)
    paint_picker(ui)
    paint_layers(ui)

    // Widgets last, so a control can never be painted over by the viewport.
    var i = 0
    while i < widgets.Ui_count(ui) {
        var kind = widgets.Ui_kind_at(ui, i)
        if kind == 1 {
            // A layer row's click target has no chrome of its own: the row is
            // already painted by paint_layers. Only real buttons are drawn.
            if layer_of_widget(widgets.Ui_id_at(ui, i)) < 0 {
                paint_button(ui, i)
            }
        }
        if kind == 3 { paint_entry(ui, i) }
        // KIND_SLIDER. Without this case the slider is hit-testable, draggable
        // and completely invisible.
        if kind == 8 { paint_slider(ui, i) }
        if kind == 0 {
            gui.Win_text(g_win, g_font, widgets.Ui_label_at(ui, i),
                         widgets.Ui_x_at(ui, i), widgets.Ui_y_at(ui, i),
                         200, 200, 212)
        }
        i = i + 1
    }

    paint_status(ui)
    gui.Win_present(g_win)
}

// ---- form -----------------------------------------------------------------

// Declared once, like a Visual Basic form: a list of controls with handlers.
// The layer rows are click targets with no chrome - paint_layers draws the row
// itself, and the toolkit supplies only hit-testing and dispatch, which is the
// part that is genuinely difficult to get right.
fn build_form(win: int, font: int) -> Ui {
    var ui = widgets.Ui_new(win, font)

    ui = widgets.Ui_button(ui, "Open", 8, 9, 60, 28, on_open)
    ui = widgets.Ui_button(ui, "Save", 72, 9, 60, 28, on_save)
    ui = widgets.Ui_button(ui, "Undo", 142, 9, 60, 28, on_undo)
    ui = widgets.Ui_button(ui, "Redo", 206, 9, 60, 28, on_redo)

    ui = widgets.Ui_button(ui, "-", 276, 9, 26, 28, on_zoom_out)
    ui = widgets.Ui_button(ui, "+", 304, 9, 26, 28, on_zoom_in)
    ui = widgets.Ui_button(ui, "Fit", 332, 9, 38, 28, on_zoom_fit)
    ui = widgets.Ui_button(ui, "1:1", 372, 9, 38, 28, on_zoom_100)

    // Brush parameter steppers.
    ui = widgets.Ui_button(ui, "r-", 424, 9, 26, 28, on_radius_down)
    ui = widgets.Ui_button(ui, "r+", 452, 9, 26, 28, on_radius_up)
    ui = widgets.Ui_button(ui, "h-", 484, 9, 26, 28, on_hard_down)
    ui = widgets.Ui_button(ui, "h+", 512, 9, 26, 28, on_hard_up)
    ui = widgets.Ui_button(ui, "a-", 544, 9, 26, 28, on_alpha_down)
    ui = widgets.Ui_button(ui, "a+", 572, 9, 26, 28, on_alpha_up)

    ui = widgets.Ui_entry(ui, "/tmp/wyncanvas-out.png", 610, 9, 240, 28)
    g_path_id = widgets.Ui_last_id(ui)

    // The text tool's string, plus its size steppers. A real entry widget rather
    // than an on-canvas caret - see the note on g_text_id for why the toolkit's
    // key handling makes that the only shape available.
    ui = widgets.Ui_entry(ui, "Wyn", 854, 9, 90, 28)
    g_text_id = widgets.Ui_last_id(ui)
    ui = widgets.Ui_button(ui, "t-", 948, 9, 24, 28, on_text_smaller)
    ui = widgets.Ui_button(ui, "t+", 974, 9, 24, 28, on_text_bigger)

    // Tool palette, down the left edge.
    var ty = layout.VIEW_Y() + 8
    ui = widgets.Ui_button(ui, "Brush", 5, ty, 44, 30, on_tool_brush)
    ui = widgets.Ui_button(ui, "Erase", 5, ty + 34, 44, 30, on_tool_eraser)
    ui = widgets.Ui_button(ui, "Fill", 5, ty + 68, 44, 30, on_tool_fill)
    ui = widgets.Ui_button(ui, "Pick", 5, ty + 102, 44, 30, on_tool_pick)
    ui = widgets.Ui_button(ui, "Pan", 5, ty + 136, 44, 30, on_tool_pan)

    // Marquee tools, below the paint tools. Separated by a gap because they are a
    // different MODE rather than a sixth brush - see the note on g_sel_tool.
    ui = widgets.Ui_button(ui, "MRct", 5, ty + 176, 44, 28, on_tool_mrect)
    ui = widgets.Ui_button(ui, "MEll", 5, ty + 206, 44, 28, on_tool_mellipse)
    ui = widgets.Ui_button(ui, "Lass", 5, ty + 236, 44, 28, on_tool_lasso)
    ui = widgets.Ui_button(ui, "Text", 5, ty + 266, 44, 28, on_tool_text)

    // Layer commands, above the layer list.
    var ly = layout.LAYERS_Y() - 48
    ui = widgets.Ui_button(ui, "+L", layout.PANEL_X() + 8, ly, 32, 22, on_layer_add)
    ui = widgets.Ui_button(ui, "-L", layout.PANEL_X() + 42, ly, 32, 22, on_layer_del)
    ui = widgets.Ui_button(ui, "up", layout.PANEL_X() + 76, ly, 32, 22, on_layer_up)
    ui = widgets.Ui_button(ui, "dn", layout.PANEL_X() + 110, ly, 32, 22, on_layer_down)
    ui = widgets.Ui_button(ui, "o-", layout.PANEL_X() + 148, ly, 28, 22,
                           on_opacity_down)
    ui = widgets.Ui_button(ui, "o+", layout.PANEL_X() + 178, ly, 28, 22, on_opacity_up)
    ui = widgets.Ui_button(ui, "<b", layout.PANEL_X() + 8, ly + 24, 32, 22,
                           on_blend_prev)
    ui = widgets.Ui_button(ui, "b>", layout.PANEL_X() + 42, ly + 24, 32, 22,
                           on_blend_next)
    // Group / ungroup, in the space left on the blend row. "[G]" and "]G["
    // rather than words because the panel is 250px wide and the labels have to
    // sit beside four other controls; the brackets read as "wrap" and "unwrap".
    ui = widgets.Ui_button(ui, "[G]", layout.PANEL_X() + 80, ly + 24, 36, 22,
                           on_layer_group)
    ui = widgets.Ui_button(ui, "]G[", layout.PANEL_X() + 118, ly + 24, 36, 22,
                           on_layer_ungroup)

    // Filters, in the toolbar's second row. Abbreviated labels because seven
    // filters at full width would not fit; their PARAMETERS come from the
    // strength slider below the layer list - see run_filter for the mapping.
    var fy = 9
    ui = widgets.Ui_button(ui, "Blur", 1004, fy, 40, 28, on_flt_blur)
    ui = widgets.Ui_button(ui, "Shrp", 1046, fy, 40, 28, on_flt_sharpen)
    ui = widgets.Ui_button(ui, "Sat+", 1088, fy, 40, 28, on_flt_saturate)
    ui = widgets.Ui_button(ui, "Inv", 1130, fy, 36, 28, on_flt_invert)

    // Filter strength, at the BOTTOM of the right panel.
    //
    // Below the layer list rather than in the toolbar, because the toolbar's
    // second row is full: the filter buttons end at x=1166 and the window is
    // 1180 wide. paint_layers already truncates a row that would run past
    // layout.VIEW_Y()+layout.VIEW_H(), so reserving the last band costs no layer rows that were
    // being drawn.
    //
    // 0..200% in steps of 5: 100% reproduces exactly the values that used to be
    // hardcoded, and the range reaches past it because "more than the default"
    // is the request a fixed parameter cannot answer.
    var stry = layout.VIEW_Y() + layout.VIEW_H() - 34
    ui = widgets.Ui_slider(ui, layout.PANEL_X() + 8, stry, layout.PANEL_W() - 16, 20,
                           0, 200, 5, g_strength, on_strength)
    g_strength_id = widgets.Ui_last_id(ui)

    // Selection commands, under the tool palette. `All`/`Non`/`Inv` are the three
    // a user reaches for constantly and none of them is a drag.
    var sy = layout.VIEW_Y() + 306
    ui = widgets.Ui_button(ui, "All", 5, sy, 44, 24, on_sel_all)
    ui = widgets.Ui_button(ui, "Non", 5, sy + 26, 44, 24, on_sel_none)
    ui = widgets.Ui_button(ui, "SInv", 5, sy + 52, 44, 24, on_sel_invert)

    // CLICK TARGETS ARE PLACED BY THE SAME TWO COUNTERS AS THE PAINTER, walking the
    // stack top-first and skipping rows a collapsed group hides. Placing them by
    // layer index instead - which is what the previous `(count-1-i) * layout.ROW_H()`
    // did - would put every target at the position the row would occupy if
    // nothing were folded, so after one collapse a click would select a layer the
    // user cannot see. The two loops MUST agree, and the only way to be sure is
    // for both to derive y from the count of DRAWN rows.
    var vrow = 0
    var i2 = 0
    while i2 < layer.count() {
        var li2 = layer.count() - 1 - i2
        if row_hidden(li2) {
            i2 = i2 + 1
            continue
        }
        var y = layout.row_y(vrow)
        var dep2 = row_depth(li2)
        ui = widgets.Ui_button(ui, layer.name(li2), layout.row_band_x(dep2), y,
                               layout.row_band_w(dep2), layout.row_band_h(),
                               on_layer_row)
        remember_row(widgets.Ui_last_id(ui), li2)
        vrow = vrow + 1
        i2 = i2 + 1
    }

    return ui
}

// Rebuilds the form whenever the layer stack changed shape. Called from the two
// places that can change it (the script runner and the frame loop) so a stale
// widget->layer table cannot dispatch a click to a layer that no longer exists.
fn rebuild_rows(ui: Ui) -> Ui {
    g_row_count = 0
    // Record the fold generation this rebuild is FOR. Without it the trigger
    // `g_fold_gen != g_rows_fold_gen` stays true forever and the whole form is
    // rebuilt every frame - which works, and quietly makes the editor rebuild
    // dozens of widgets per frame for no reason.
    g_rows_fold_gen = g_fold_gen
    return build_form(g_win, g_font)
}

// ---- headless verification seam -------------------------------------------
//
// WHY THIS IS NOT TEST-ONLY SCAFFOLDING BOLTED ON.
//
// The claim "the brush is wired to the active layer through the view transform"
// is not provable by looking at a screenshot, and it is not provable by a unit
// test either: tests/test_paint.wyn can paint at document (16,16) and pass while
// the WINDOW maps a click there to somewhere else entirely. What has to be
// exercised is the whole path - window coordinates, view transform, tool
// dispatch, stroke, composite, upload - and the only way to do that headlessly is
// to push real events and then read pixels back.
//
// So WYNCANVAS_SCRIPT is a comma-separated list of actions run against the real
// widget ids and the real event queue, and it PRINTS what it observes: pixel
// values out of the COMPOSITE, the history depth, the mapped pointer position. A
// claim in this file's comments that a stroke landed is worth nothing; a printed
// `px(128,128)=1.000,0.271,0.000` is a fact.
//
// The `click:Label` action is the strongest of the widget ones. It pushes a real
// press and a real release onto the PLATFORM event queue with
// Win_push_mouse_down/up, then lets widgets.Ui_events drain it - so it exercises
// hit-testing, the press/release-over-the-same-control rule and handler dispatch,
// the shipping path byte for byte, with the only synthetic part being who moved
// the mouse. Calling on_undo(0) directly cannot fail the way a real button can:
// it would still pass if the button were wired to the wrong handler, or to no
// handler, or laid out off-screen.
//
// `stroke:x0:y0:x1:y1` is the strongest of all, because it goes through
// canvas_press/canvas_drag/canvas_release with WINDOW coordinates derived from
// document ones through `view` - the same three functions and the same transform
// the frame loop uses. At zoom 400% with a pan applied, a stroke that still lands
// on the named document pixel proves the mapping, not just the brush.

// Presses and releases the centre of the widget labelled `label`, then drains
// the queue through the toolkit. Returns the Ui, because dispatch mutates it
// (structs are by value; see the header).
fn click_label(ui: Ui, label: string) -> Ui {
    var i = 0
    while i < widgets.Ui_count(ui) {
        if widgets.Ui_label_at(ui, i) == label {
            var cx = widgets.Ui_x_at(ui, i) + widgets.Ui_w_at(ui, i) / 2
            var cy = widgets.Ui_y_at(ui, i) + widgets.Ui_h_at(ui, i) / 2
            // Move first: `hot` is recomputed from the pointer position, and a
            // real click is always preceded by the pointer arriving.
            gui.Win_push_mouse_move(g_win, cx, cy)
            gui.Win_push_mouse_down(g_win, cx, cy, gui.MOUSE_LEFT)
            gui.Win_push_mouse_up(g_win, cx, cy, gui.MOUSE_LEFT)
            return widgets.Ui_events(ui)
        }
        i = i + 1
    }
    print("  no widget labelled ${label}")
    return ui
}

// Window coordinates of the CENTRE of document pixel (dx, dy), through the same
// transform the blit uses. This is what makes a scripted stroke a test of the
// mapping rather than of a hard-coded number.
// NB the parameter names `docx`/`docy`, not the obvious `dx`/`dy`. A local
// `var dx` holding a FLOAT inside an imported module (src/view.wyn's zoom_at has
// one) retypes an INT named `dx` here, and `dx.to_float()` then silently yields
// 0 - measured: a two-file repro where `g(3)` returned 0.5 instead of 3.5,
// alongside a non-fatal "Unknown method 'to_float' for type 'float'". That is
// worse than a compile error, and it would have put every scripted stroke at
// window (0,0). Reported upstream. Renaming is the local fix.
fn win_x_of_doc(docx: int) -> int {
    return view.doc_to_screen_x(docx.to_float() + 0.5).to_int()
}

fn win_y_of_doc(docy: int) -> int {
    return view.doc_to_screen_y(docy.to_float() + 0.5).to_int()
}

// Prints one document pixel, un-premultiplied, from the COMPOSITE - so what is
// printed is what the viewport shows, not what one layer happens to hold.
fn print_px(x: int, y: int) {
    if g_dirty == 1 { refresh(0) }
    if g_last_comp == 0 {
        print("  no composite")
        return
    }
    var _rgb = "${rounded3(wynimg_pick(g_last_comp, x, y, 0))},${rounded3(wynimg_pick(g_last_comp, x, y, 1))},${rounded3(wynimg_pick(g_last_comp, x, y, 2))}"
    print("  px(${x},${y})=${_rgb} a=${rounded3(wynimg_pick(g_last_comp, x, y, 3))}")
}

// A scripted stroke in DOCUMENT coordinates, driven through the WINDOW path.
// Split into 8 intermediate moves so segment accumulation and coverage
// saturation are both exercised rather than assumed.
fn do_stroke(dx0: int, dy0: int, dx1: int, dy1: int) {
    var ax = win_x_of_doc(dx0)
    var ay = win_y_of_doc(dy0)
    var bx = win_x_of_doc(dx1)
    var by = win_y_of_doc(dy1)
    canvas_press(ax, ay)
    var i = 1
    while i <= 8 {
        var t = i.to_float() / 8.0
        var mx = ax + ((bx - ax).to_float() * t).to_int()
        var my = ay + ((by - ay).to_float() * t).to_int()
        canvas_drag(mx, my)
        i = i + 1
    }
    canvas_release(bx, by)
}

// A scripted marquee drag, in DOCUMENT coordinates, through the WINDOW path -
// the same shape as do_stroke and for the same reason. 8 intermediate moves, so
// the per-move restore-and-reapply in marquee_apply is exercised rather than
// assumed: a marquee that accumulated its intermediate rectangles would come out
// with the union of all nine and fail the area assertion.
fn do_marquee(dx0: int, dy0: int, dx1: int, dy1: int) {
    var ax = win_x_of_doc(dx0)
    var ay = win_y_of_doc(dy0)
    var bx = win_x_of_doc(dx1)
    var by = win_y_of_doc(dy1)
    canvas_press(ax, ay)
    var i = 1
    while i <= 8 {
        var t = i.to_float() / 8.0
        var mx = ax + ((bx - ax).to_float() * t).to_int()
        var my = ay + ((by - ay).to_float() * t).to_int()
        canvas_drag(mx, my)
        i = i + 1
    }
    canvas_release(bx, by)
}

// Returns the Ui rather than a status, because a real click mutates it and
// structs are by value - discarding the return would discard the dispatch.
fn run_action(ui: Ui, act: string) -> Ui {
    // click:Undo, click:Brush, click:+L, ... - a real event-queue click.
    if act.starts_with("click:") {
        var label = act.substring(6, act.len())
        var u = click_label(ui, label)
        // g_req is printed because Open and Save are DEFERRED: their handlers
        // record a request and the frame loop performs the I/O (see the header).
        // So `click:Save -> msg=ready req=2` is the correct observation, and the
        // proof that the save happened is the file, one frame later.
        var _st = "tool=${paint.tool_name(paint.tool())} layers=${layer.count()} active=${g_active}"
        print("  click:${label} -> msg=${g_msg} req=${g_req} ${_st} hist=${history.depth()} zoom=${view.zoom()}%")
        return u
    }

    // stroke:x0:y0:x1:y1 in DOCUMENT coordinates, through the window path.
    if act.starts_with("stroke:") {
        var parts = act.substring(7, act.len()).split(":")
        if parts.len() < 4 {
            print("  stroke needs x0:y0:x1:y1")
            return ui
        }
        do_stroke(parts[0].to_int(), parts[1].to_int(),
                  parts[2].to_int(), parts[3].to_int())
        print("  ${act} -> ${g_msg} hist=${history.depth()}")
        return ui
    }

    // screen:docx:docy - paint one frame, then read the WINDOW's framebuffer at
    // the place that document pixel maps to.
    //
    // This is the last link in the chain and the only one the other actions
    // cannot reach. `px:` proves the compositor holds the right value; this
    // proves the value reached the screen at the right coordinates - i.e. that
    // the texture upload, the blit rectangle and the view transform all agree.
    // A channel-order bug (red where blue belongs) or a blit at the wrong origin
    // is invisible to every assertion that stops at the composite.
    //
    // Win_pixel_at returns display-encoded bytes, so the expected value is the
    // sRGB one, not the linear one.
    if act.starts_with("screen:") {
        var sp = act.substring(7, act.len()).split(":")
        if sp.len() < 2 {
            print("  screen needs docx:docy")
            return ui
        }
        if g_dirty == 1 { refresh(0) }
        paint(ui)
        var wx2 = win_x_of_doc(sp[0].to_int())
        var wy2 = win_y_of_doc(sp[1].to_int())
        var _px = "${gui.Win_pixel_at(g_win, wx2, wy2, 0)},${gui.Win_pixel_at(g_win, wx2, wy2, 1)},${gui.Win_pixel_at(g_win, wx2, wy2, 2)}"
        print("  screen doc(${sp[0]},${sp[1]}) -> win(${wx2},${wy2}) rgb=${_px}")
        return ui
    }

    // px:x:y - print a composited document pixel.
    if act.starts_with("px:") {
        var pp = act.substring(3, act.len()).split(":")
        if pp.len() < 2 {
            print("  px needs x:y")
            return ui
        }
        print_px(pp[0].to_int(), pp[1].to_int())
        return ui
    }

    // hsv:h:s:v - set the brush colour directly. Dragging the picker to an exact
    // value would be a test of arithmetic; this tests colour.
    if act.starts_with("hsv:") {
        var hp = act.substring(4, act.len()).split(":")
        if hp.len() < 3 {
            print("  hsv needs h:s:v")
            return ui
        }
        paint.set_hsv(hp[0].to_float(), hp[1].to_float(), hp[2].to_float())
        var _hsv = "${rounded(paint.hue())},${rounded(paint.sat())},${rounded(paint.val())}"
        var _srgb = "${rounded3(paint.color_srgb(0))},${rounded3(paint.color_srgb(1))},${rounded3(paint.color_srgb(2))}"
        var _lin = "${rounded3(paint.color_linear(0))},${rounded3(paint.color_linear(1))},${rounded3(paint.color_linear(2))}"
        print("  hsv -> ${_hsv} srgb=${_srgb} linear=${_lin}")
        return ui
    }

    // pickat:x:y - drag the picker widget itself, in WINDOW coordinates relative
    // to the SV square's top-left, so the picker's own hit-testing is exercised.
    if act.starts_with("pickat:") {
        var qp = act.substring(7, act.len()).split(":")
        if qp.len() < 2 {
            print("  pickat needs sx:sy")
            return ui
        }
        canvas_press(layout.SV_X() + qp[0].to_int(), layout.SV_Y() + qp[1].to_int())
        canvas_release(layout.SV_X() + qp[0].to_int(), layout.SV_Y() + qp[1].to_int())
        print("  ${act} -> hsv=${rounded(paint.hue())},${rounded(paint.sat())},${rounded(paint.val())}")
        return ui
    }

    // huedrag:y - drag the hue strip, y relative to its top.
    if act.starts_with("huedrag:") {
        var yp = act.substring(8, act.len()).to_int()
        canvas_press(layout.HUE_X() + layout.HUE_W() / 2, layout.HUE_Y() + yp)
        canvas_release(layout.HUE_X() + layout.HUE_W() / 2, layout.HUE_Y() + yp)
        print("  ${act} -> hue=${rounded(paint.hue())}")
        return ui
    }

    // brush:radius:hardness:alpha
    if act.starts_with("brush:") {
        var bp = act.substring(6, act.len()).split(":")
        if bp.len() < 3 {
            print("  brush needs radius:hardness:alpha")
            return ui
        }
        paint.set_radius(bp[0].to_float())
        paint.set_hardness(bp[1].to_float())
        paint.set_alpha(bp[2].to_float())
        print("  brush -> r=${rounded(paint.radius())} h=${rounded(paint.hardness())} a=${rounded(paint.alpha())}")
        return ui
    }

    // tool:name - including the three marquee tools, which are a MODE rather than
    // a paint tool (see g_sel_tool), so selecting one clears the paint tool's
    // claim on the canvas and vice versa.
    if act.starts_with("tool:") {
        var tn = act.substring(5, act.len())
        if tn == "brush" { on_tool_brush(0) }
        if tn == "eraser" { on_tool_eraser(0) }
        if tn == "fill" { on_tool_fill(0) }
        if tn == "pick" { on_tool_pick(0) }
        if tn == "pan" { on_tool_pan(0) }
        if tn == "mrect" { on_tool_mrect(0) }
        if tn == "mellipse" { on_tool_mellipse(0) }
        if tn == "lasso" { on_tool_lasso(0) }
        if tn == "text" { on_tool_text(0) }
        print("  tool -> ${paint.tool_name(paint.tool())} sel=${sel_tool_word()}")
        return ui
    }

    // text:x:y:string - places text at DOCUMENT (x,y) through the tool's own
    // path: it sets the tool, presses the canvas at the mapped window position
    // (which is what sets g_text_x/g_text_y and raises REQ_TEXT), and then
    // services the request with the given string. So this exercises the mapping
    // and canvas_press, not just commit_text - the same reason `stroke:` goes
    // through the window path rather than calling paint.seg.
    //
    // The string is the REST of the action, not a field, so it may contain
    // spaces. It may not contain a comma (the script separator) or a colon.
    if act.starts_with("text:") {
        var tp = act.substring(5, act.len()).split(":")
        if tp.len() < 3 {
            print("  text needs x:y:string")
            return ui
        }
        on_tool_text(0)
        canvas_press(win_x_of_doc(tp[0].to_int()), win_y_of_doc(tp[1].to_int()))
        if g_req == REQ_TEXT {
            commit_text(tp[2])
            g_req = REQ_NONE
        }
        print("  ${act} -> ${g_msg} hist=${history.depth()} undo=${history.undo_label()}")
        return ui
    }

    // textpx:size - the text size, so a script can name one instead of counting
    // stepper clicks.
    if act.starts_with("textpx:") {
        g_text_px = act.substring(7, act.len()).to_float()
        print("  textpx -> ${rounded(g_text_px)}")
        return ui
    }

    // filter:name - through run_filter, the SAME function the toolbar buttons
    // call, so a scripted filter proves the button's path and not a parallel one.
    if act.starts_with("filter:") {
        run_filter(act.substring(7, act.len()))
        print("  ${act} -> ${g_msg} hist=${history.depth()} undo=${history.undo_label()}")
        return ui
    }

    // marquee:x0:y0:x1:y1 in DOCUMENT coordinates, dragged through the WINDOW
    // path - canvas_press/drag/release with window coordinates derived from
    // document ones through `view`, exactly as `stroke:` does. That is what makes
    // this a test of the marquee's mapping at a zoom and a pan rather than of
    // select.rect's arithmetic, which tests/test_select.wyn already covers.
    if act.starts_with("marquee:") {
        var qq = act.substring(8, act.len()).split(":")
        if qq.len() < 4 {
            print("  marquee needs x0:y0:x1:y1")
            return ui
        }
        do_marquee(qq[0].to_int(), qq[1].to_int(),
                   qq[2].to_int(), qq[3].to_int())
        print("  ${act} -> ${g_msg} area=${rounded(select.area())} bbox=${select.bbox_x0()},${select.bbox_y0()},${select.bbox_x1()},${select.bbox_y1()}")
        return ui
    }

    // selop:replace|add|subtract|intersect - how the NEXT marquee drag combines.
    if act.starts_with("selop:") {
        var so = act.substring(6, act.len())
        if so == "replace" { g_sel_op = select.OP_REPLACE() }
        if so == "add" { g_sel_op = select.OP_ADD() }
        if so == "subtract" { g_sel_op = select.OP_SUBTRACT() }
        if so == "intersect" { g_sel_op = select.OP_INTERSECT() }
        print("  selop -> ${select.op_name(g_sel_op)}")
        return ui
    }

    // key:NAME[+cmd][+shift] - a KEYBOARD SHORTCUT, through the identical
    // dispatch a real keystroke reaches.
    //
    // WHY NOT Win_push_key_down HERE. That would be the more faithful driver, but
    // the shortcut path deliberately runs only for keys the TOOLKIT chose not to
    // consume, and the toolkit decides that from the polled modifier state - which
    // a synthetic event does not update under SDL_VIDEODRIVER=dummy. So a pushed
    // Cmd+Z arrives as a bare Z and tests the wrong branch. Naming the modifier
    // explicitly tests the dispatch TABLE, which is the part with the branches;
    // the toolkit's own partition is proved in repos/gui's test_shortcuts.wyn.
    if act.starts_with("key:") {
        var spec = act.substring(4, act.len())
        var kmod = 0
        if spec.contains("+cmd") {
            kmod = kmod + gui.KMOD_GUI
            spec = spec.replace("+cmd", "")
        }
        if spec.contains("+shift") {
            kmod = kmod + gui.KMOD_SHIFT
            spec = spec.replace("+shift", "")
        }
        var kc = 0 - 1
        if spec == "z" { kc = gui.SCANCODE_Z }
        if spec == "s" { kc = gui.SCANCODE_S }
        if spec == "o" { kc = gui.SCANCODE_O }
        if spec == "a" { kc = gui.SCANCODE_A }
        if spec == "d" { kc = gui.SCANCODE_D }
        if spec == "i" { kc = gui.SCANCODE_I }
        if spec == "b" { kc = gui.SCANCODE_B }
        if spec == "e" { kc = gui.SCANCODE_E }
        if spec == "g" { kc = gui.SCANCODE_G }
        if spec == "h" { kc = gui.SCANCODE_H }
        if spec == "m" { kc = gui.SCANCODE_M }
        if spec == "l" { kc = gui.SCANCODE_L }
        if spec == "t" { kc = gui.SCANCODE_T }
        // The transforms, so a headless script can drive the document ones - the
        // commands whose failure mode is a corrupted texture handle rather than a
        // wrong tool, and therefore the ones most worth exercising through the real
        // dispatch table.
        if spec == "r" { kc = gui.SCANCODE_R }
        if spec == "j" { kc = gui.SCANCODE_J }
        if spec == "k" { kc = gui.SCANCODE_K }
        if spec == "n" { kc = gui.SCANCODE_N }
        if spec == "p" { kc = gui.SCANCODE_P }
        if spec == "y" { kc = gui.SCANCODE_Y }
        if spec == "u" { kc = gui.SCANCODE_U }
        if spec == "0" { kc = gui.SCANCODE_0 }
        if spec == "1" { kc = gui.SCANCODE_1 }
        if spec == "plus" { kc = gui.SCANCODE_EQUALS }
        if spec == "minus" { kc = gui.SCANCODE_MINUS }
        if spec == "lbracket" { kc = gui.SCANCODE_LEFTBRACKET }
        if spec == "rbracket" { kc = gui.SCANCODE_RIGHTBRACKET }
        if spec == "escape" { kc = gui.SCANCODE_ESCAPE }
        if kc == 0 - 1 {
            print("  key -> unknown key [${spec}]")
            return ui
        }
        handle_shortcut(kc, kmod)
        print("  key ${spec} -> tool=${paint.tool_name(paint.tool())} sel=${sel_tool_word()} msg=${g_msg}")
        return ui
    }

    // winpx:x:y - a raw WINDOW pixel, in window coordinates.
    //
    // `screen:` already reports a pixel, but it takes DOCUMENT coordinates and
    // maps them through `view`, so it can only reach the canvas. Chrome - a
    // button, a slider, the panel - has no document coordinate, and a widget that
    // is hit-testable but never DRAWN is invisible to every state assertion. This
    // is the only way to prove something reached the screen.
    if act.starts_with("winpx:") {
        var wp = act.substring(6, act.len()).split(":")
        if wp.len() < 2 {
            print("  winpx needs x:y")
            return ui
        }
        // Paint first, exactly as `screen:` does. The script runs BEFORE the
        // frame loop's own paint, so probing without this reads an unpainted
        // framebuffer and every pixel comes back 0,0,0 - which looks like "the
        // widget is invisible" and is really "nothing has been drawn yet".
        if g_dirty == 1 { refresh(0) }
        paint(ui)
        var wpx = wp[0].to_int()
        var wpy = wp[1].to_int()
        print("  winpx(${wpx},${wpy})=${gui.Win_pixel_at(g_win, wpx, wpy, 0)},${gui.Win_pixel_at(g_win, wpx, wpy, 1)},${gui.Win_pixel_at(g_win, wpx, wpy, 2)}")
        return ui
    }

    // sliderx:N - where the toolkit says the strength thumb is, so a test can
    // probe the thumb rather than guessing its pixel from the range.
    if act.starts_with("sliderx") {
        if g_strength_id < 0 {
            print("  sliderx -> no slider")
            return ui
        }
        print("  sliderx -> thumb=${widgets.Ui_slider_thumb_x(ui, g_strength_id)} val=${widgets.Ui_val(ui, g_strength_id)}")
        return ui
    }

    // group / ungroup - the two layer-tree commands, through the same handlers
    // the buttons call.
    if act == "group" {
        on_layer_group(0)
        print("  group -> ${g_msg} count=${layer.count()} parent(${g_active})=${layer.parent(g_active)}")
        return ui
    }
    if act == "ungroup" {
        on_layer_ungroup(0)
        print("  ungroup -> ${g_msg} parent(${g_active})=${layer.parent(g_active)}")
        return ui
    }
    // clickat:x:y - a real press+release at a WINDOW coordinate, through the
    // toolkit's own dispatch.
    //
    // `click:LABEL` finds a widget by name; this one goes by POSITION, which is the
    // only way to test that the layer panel's click targets sit where the painter
    // drew its rows. Those are two independent loops, and after a fold they agree
    // only if both derive y from the count of DRAWN rows - a bug here selects a
    // layer the user cannot see, and no label-based click can detect it.
    if act.starts_with("clickat:") {
        var cp = act.substring(8, act.len()).split(":")
        if cp.len() < 2 {
            print("  clickat needs x:y")
            return ui
        }
        var cx2 = cp[0].to_int()
        var cy2 = cp[1].to_int()
        // A REAL MOUSE-MOVE FIRST, and this is not ceremony. Handlers that need to
        // know WHERE in a row the click landed read gui.Win_mouse_x() - the layer
        // panel splits a row into a fold twisty, a visibility box and the name that
        // way. A synthetic press does not update the platform's polled pointer, so
        // without this every such handler reads a stale 0 and behaves as though the
        // click were at the far left: every layer click looked like a twisty hit.
        // Pushing the move through the queue makes the poll agree with the press.
        gui.Win_push_mouse_move(g_win, cx2, cy2)
        var cu2 = widgets.Ui_events(ui)
        // The handler reads g_click_mx, so it has to hold this click's x - the same
        // value the frame loop publishes for a human's click.
        g_click_mx = cx2
        cu2 = widgets.Ui_press(cu2, cx2, cy2)
        cu2 = widgets.Ui_release(cu2, cx2, cy2)
        print("  clickat(${cx2},${cy2}) -> active=${g_active} msg=${g_msg}")
        return cu2
    }

    // fold:N / unfold:N - collapse or expand the group at layer index N, through
    // the same state the twisty click sets.
    if act.starts_with("fold:") {
        set_folded(act.substring(5, act.len()).to_int(), true)
        print("  fold -> ${g_folded}")
        return ui
    }
    if act.starts_with("unfold:") {
        set_folded(act.substring(7, act.len()).to_int(), false)
        print("  unfold -> ${g_folded}")
        return ui
    }
    // rows - the rows the panel would actually DRAW, in order, with their indent.
    // This is what a click maps through, so it is the thing worth asserting.
    if act == "rows" {
        var rn = layer.count()
        var rk = 0
        var rv = 0
        while rk < rn {
            var rli = rn - 1 - rk
            if row_hidden(rli) == false {
                print("  row ${rv} layer=${rli} name=${layer.name(rli)} depth=${row_depth(rli)} folded=${is_folded(rli)}")
                rv = rv + 1
            }
            rk = rk + 1
        }
        print("  rows drawn=${rv} of ${rn}")
        return ui
    }

    // tree - the whole layer tree, one row per layer, for asserting structure.
    if act == "tree" {
        var ti = 0
        while ti < layer.count() {
            print("  tree ${ti} ${layer.name(ti)} kind=${layer.kind(ti)} parent=${layer.parent(ti)}")
            ti = ti + 1
        }
        return ui
    }

    // strength:N - set the filter-strength slider, so a headless run can prove
    // that a filter's parameters actually follow it.
    if act.starts_with("strength:") {
        var sv = act.substring(9, act.len()).to_int()
        if g_strength_id >= 0 {
            ui = widgets.Ui_set_val(ui, g_strength_id, sv)
            g_strength = widgets.Ui_val(ui, g_strength_id)
        }
        print("  strength -> ${g_strength}% frac=${rounded3(strength_frac())}")
        return ui
    }

    // sel:all|none|invert|feather:N - the whole-document commands, through the
    // same handlers the buttons call.
    if act.starts_with("sel:") {
        var sc = act.substring(4, act.len())
        if sc == "all" { on_sel_all(0) }
        if sc == "none" { on_sel_none(0) }
        if sc == "invert" { on_sel_invert(0) }
        if sc.starts_with("feather:") {
            select.feather(sc.substring(8, sc.len()).to_float())
            g_msg = "feathered"
        }
        print("  ${act} -> ${g_msg} area=${rounded(select.area())} empty=${select.is_empty()}")
        return ui
    }

    // selat:x:y - the selection's coverage at one document pixel. This is what
    // makes a feathered edge assertable: a boolean "is it selected" cannot
    // distinguish 1.0 from 0.5, and 0.5 is exactly what a half-covered edge
    // pixel must read.
    if act.starts_with("selat:") {
        var sa = act.substring(6, act.len()).split(":")
        if sa.len() < 2 {
            print("  selat needs x:y")
            return ui
        }
        print("  selat(${sa[0]},${sa[1]})=${rounded3(select.cov_at(sa[0].to_int(), sa[1].to_int()))}")
        return ui
    }

    // zoom:percent - an exact scale, so a script can test one.
    if act.starts_with("zoom:") {
        view.set_zoom(act.substring(5, act.len()).to_int())
        print("  zoom -> ${view.zoom()}% origin=${view.origin_x()},${view.origin_y()}")
        return ui
    }

    // pan:dx:dy in window pixels, through the PAN TOOL and a real drag - so this
    // exercises canvas_press/drag/release, not just view.pan_by.
    if act.starts_with("pan:") {
        var np = act.substring(4, act.len()).split(":")
        if np.len() < 2 {
            print("  pan needs dx:dy")
            return ui
        }
        var keep = paint.tool()
        paint.set_tool(paint.TOOL_PAN())
        var cx = layout.VIEW_X() + layout.VIEW_W() / 2
        var cy = layout.VIEW_Y() + layout.VIEW_H() / 2
        canvas_press(cx, cy)
        canvas_drag(cx + np[0].to_int(), cy + np[1].to_int())
        canvas_release(cx + np[0].to_int(), cy + np[1].to_int())
        paint.set_tool(keep)
        print("  pan -> ${view.pan_x()},${view.pan_y()} origin=${view.origin_x()},${view.origin_y()}")
        return ui
    }

    // map:x:y - what document pixel is window (x,y)? The mapping, printed.
    if act.starts_with("map:") {
        var mp = act.substring(4, act.len()).split(":")
        if mp.len() < 2 {
            print("  map needs x:y")
            return ui
        }
        var wx = mp[0].to_int()
        var wy = mp[1].to_int()
        print("  map win(${wx},${wy}) -> doc(${rounded3(view.screen_to_doc_x(wx.to_float()))},${rounded3(view.screen_to_doc_y(wy.to_float()))}) hits=${view.hits_doc(wx, wy)}")
        return ui
    }

    // eyedrop:x:y in DOCUMENT coordinates, through canvas_press with Pick.
    if act.starts_with("eyedrop:") {
        var kp = act.substring(8, act.len()).split(":")
        if kp.len() < 2 {
            print("  eyedrop needs x:y")
            return ui
        }
        paint.set_tool(paint.TOOL_PICK())
        canvas_press(win_x_of_doc(kp[0].to_int()), win_y_of_doc(kp[1].to_int()))
        print("  ${act} -> hsv=${rounded(paint.hue())},${rounded(paint.sat())},${rounded(paint.val())}  ${g_msg}")
        return ui
    }

    // fill:x:y in DOCUMENT coordinates, through canvas_press with Fill.
    if act.starts_with("fill:") {
        var fp = act.substring(5, act.len()).split(":")
        if fp.len() < 2 {
            print("  fill needs x:y")
            return ui
        }
        paint.set_tool(paint.TOOL_FILL())
        canvas_press(win_x_of_doc(fp[0].to_int()), win_y_of_doc(fp[1].to_int()))
        print("  ${act} -> ${g_msg} hist=${history.depth()}")
        return ui
    }

    // active:n - select a layer without a click, for scripts that need an exact
    // target regardless of layout.
    if act.starts_with("active:") {
        g_active = act.substring(7, act.len()).to_int()
        clamp_active()
        print("  active -> ${g_active} (${layer.name(g_active)})")
        return ui
    }

    if act == "toggle_top" {
        // The topmost layer's row, dispatched by widget id exactly as a click
        // would - which is the point: this goes through on_layer_row.
        var top = layer.count() - 1
        var j = 0
        while j < g_row_count {
            if g_row_layer[j] == top { on_layer_row(g_row_ids[j]) }
            j = j + 1
        }
        print("  toggle_top -> visible(${top})=${layer.visible(top)} history.depth=${history.depth()}")
        return ui
    }
    if act == "undo" {
        on_undo(0)
        print("  undo -> can_undo=${history.can_undo()} can_redo=${history.can_redo()} layers=${layer.count()} msg=${g_msg}")
        return ui
    }
    if act == "redo" {
        on_redo(0)
        print("  redo -> can_undo=${history.can_undo()} can_redo=${history.can_redo()} layers=${layer.count()} msg=${g_msg}")
        return ui
    }
    if act == "zoom_in" {
        on_zoom_in(0)
        print("  zoom_in -> ${view.zoom()}%")
        return ui
    }
    if act == "zoom_out" {
        on_zoom_out(0)
        print("  zoom_out -> ${view.zoom()}%")
        return ui
    }
    if act == "fit" {
        on_zoom_fit(0)
        print("  fit -> ${view.zoom()}%")
        return ui
    }
    // save / open take the path from the environment, so a script can name a
    // temp file without a text-entry drag. Both go through save_doc/open_doc -
    // the SAME suffix-dispatch the Save and Open buttons use - so a `.wync` path
    // here exercises the layered format and a `.png` one the flattened export,
    // and neither is a second code path that could disagree with the button.
    if act == "save" {
        save_doc(System.env("WYNCANVAS_SAVE"))
        print("  save -> ${g_msg}")
        return ui
    }
    if act == "open" {
        open_doc(System.env("WYNCANVAS_OPEN"))
        print("  open -> ${g_msg} doc=${g_doc_w}x${g_doc_h} layers=${layer.count()} zoom=${view.zoom()}%")
        return ui
    }

    // saveas:path / openas:path - the path in the action itself, so ONE run can
    // round-trip a document (write it, mutate, read it back) instead of needing
    // two processes and an environment variable per file.
    if act.starts_with("saveas:") {
        save_doc(act.substring(7, act.len()))
        print("  ${act} -> ${g_msg}")
        return ui
    }
    if act.starts_with("openas:") {
        open_doc(act.substring(7, act.len()))
        print("  ${act} -> ${g_msg} doc=${g_doc_w}x${g_doc_h} layers=${layer.count()} active=${g_active} hist=${history.depth()}")
        return ui
    }
    if act == "layers" {
        // The whole stack, bottom-up, as the compositor sees it.
        var i = 0
        while i < layer.count() {
            print("  L${i} ${layer.name(i)} vis=${layer.visible(i)} mode=${pixel.blend_name(layer.blend_mode(i))} op=${rounded(layer.opacity(i))} buf=${layer.buffer(i)}")
            i = i + 1
        }
        print("  active=${g_active}")
        return ui
    }
    // doc - the document's stated size, the SELECTION's, and the ACTIVE LAYER's
    // buffer, plus what the view thinks it is fitting.
    //
    // FOUR SIZES, NOT ONE, because a whole-document transform is exactly the
    // operation that can leave them disagreeing, and every disagreement is
    // invisible: a selection whose coverage buffer is the old size makes every later
    // clip read out of bounds, a layer buffer at the old size makes
    // wynimg_composite refuse that layer silently, and a view still fitting the old
    // size puts the pointer in the wrong place. Printing g_doc_w alone would assert
    // the easiest quarter of it.
    //
    // The TEXTURE is deliberately NOT here: it is created by `refresh` inside the
    // frame loop, and a script runs before the first frame, so g_tex_w is 0 at this
    // point for reasons that have nothing to do with the transform. The texture is
    // proved instead by `winpx`, which reads the real screen after real frames -
    // that is the assertion that the upload, the blit rectangle and the view
    // transform all agree.
    if act == "doc" {
        var lw = 0
        var lh = 0
        if g_active >= 0 {
            if layer.buffer(g_active) != 0 {
                lw = wynimg_width(layer.buffer(g_active))
                lh = wynimg_height(layer.buffer(g_active))
            }
        }
        print("  doc=${g_doc_w}x${g_doc_h} sel=${select.doc_w()}x${select.doc_h()} buf=${lw}x${lh} vfit=${view.doc_w()}x${view.doc_h()} hist=${history.depth()} undo=${history.undo_label()}")
        return ui
    }
    print("  unknown action: ${act}")
    return ui
}

fn main() -> int {
    // A GUI program that may run headless has to be able to find that out and
    // exit cleanly rather than crash on the first draw call.
    if gui.Win_available() == 0 {
        print("no display backend available")
        return 0
    }

    // The same demo document the golden test verifies, so what the window shows
    // is output that has already been checked pixel-for-pixel. Compositing,
    // masks, blend modes and opacity all come from the existing modules.
    server.demo_scene()
    g_doc_w = 256
    g_doc_h = 256
    g_active = layer.count() - 1

    g_win = gui.Win_window("WynCanvas", layout.WIN_W(), layout.WIN_H())
    if g_win < 0 {
        print("could not open a window")
        return 1
    }
    g_font = gui.Win_font_default(14)
    if g_font < 0 {
        print("no font available")
        gui.Win_close(g_win)
        return 1
    }
    // BARE, not `gui.Win_backend_name()`. A DOT-QUALIFIED call to an `extern fn`
    // that returns `string` is typed `int` at the call site: the emitted C is
    // `long long x = Win_backend_name();` against `extern char*`, so the pointer
    // prints as a decimal address ("4344711438"). The bare spelling emits
    // `const char*` and is correct. Reported; applies to every string-returning
    // extern, so `Win_event_text` inside widgets.wyn is called bare there too.
    print("backend: ${Win_backend_name()}")

    // The view transform needs the viewport rectangle and the document size
    // before anything can be mapped through it.
    view.set_viewport(layout.VIEW_X(), layout.VIEW_Y(), layout.VIEW_W(), layout.VIEW_H())
    view.set_doc(g_doc_w, g_doc_h)
    view.zoom_100()

    // The selection is a document-sized coverage mask, allocated once here and
    // reallocated by open_wync/open_png when the dimensions change. It starts
    // EMPTY, and "empty" deliberately means the same thing as "no selection" -
    // see the header of src/select.wyn - so every tool below can ask
    // `select.is_empty()` and treat true as "no clipping".
    select.init(g_doc_w, g_doc_h)

    // The picker's ramps. Built once; the SV square is re-filled when the hue
    // changes (paint_picker), the hue strip never changes.
    g_sv_buf = wynimg_new(layout.SV_SIZE(), layout.SV_SIZE())
    g_sv_tex = gui.Win_texture(g_win, layout.SV_SIZE(), layout.SV_SIZE())
    g_hue_buf = wynimg_new(layout.HUE_W(), layout.SV_SIZE())
    g_hue_tex = gui.Win_texture(g_win, layout.HUE_W(), layout.SV_SIZE())
    if g_hue_buf != 0 {
        wynimg_hue_strip(g_hue_buf)
        if g_hue_tex >= 0 { wynimg_upload_tex(g_hue_tex, g_hue_buf) }
    }

    var ui = build_form(g_win, g_font)

    // Headless verification seam. With WYNCANVAS_FRAMES set the loop runs that
    // many frames and exits, optionally writing a screenshot - because no
    // assertion can tell you the UI LOOKED right, and a text renderer passes a
    // width test whether it draws letters or mojibake.
    var limit = 0
    var frames_env = System.env("WYNCANVAS_FRAMES")
    if frames_env != "" { limit = frames_env.to_int() }
    var shot = System.env("WYNCANVAS_SHOT")

    // Drive the real handlers before entering the loop (see run_action).
    var script = System.env("WYNCANVAS_SCRIPT")
    if script != "" {
        print("script:")
        var acts = script.split(",")
        var s = 0
        while s < acts.len() {
            ui = run_action(ui, acts[s])
            // A structural change replaces the stack, so the rows must be
            // rebuilt - the same rebuild the frame loop does.
            if layer.count() != g_row_count or g_fold_gen != g_rows_fold_gen {
                ui = rebuild_rows(ui)
            }
            s = s + 1
        }
    }

    var n = 0
    while widgets.Ui_running(ui) == 1 {
        // Published BEFORE Ui_events, because Ui_events is what fires the handlers
        // that read it. Taken from the toolkit's own tracked position, which is the
        // point a click was dispatched from - see the note on g_click_mx.
        g_click_mx = widgets.Ui_mouse_x(ui)
        ui = widgets.Ui_events(ui)

        // The strength slider's value, copied out each frame.
        //
        // A handler receives only a widget id and cannot reach the Ui, so
        // on_strength cannot read its own slider - the same constraint that makes
        // Open/Save deferred requests in this file. Reading it here instead is one
        // line and always current, including mid-drag.
        if g_strength_id >= 0 {
            g_strength = widgets.Ui_val(ui, g_strength_id)
        }

        // Keyboard shortcuts, read straight after Ui_events: the toolkit has just
        // settled focus and recorded whatever no widget claimed. Before the
        // deferred-request block, so a Cmd+S this frame is serviced this frame
        // rather than sitting a frame behind the button that does the same thing.
        drain_shortcuts(ui)

        // Service a deferred Open/Save now that the Ui - and so the typed path
        // - is in scope.
        if g_req != REQ_NONE {
            var path = widgets.Ui_text(ui, g_path_id)
            if g_req == REQ_OPEN { open_doc(path) }
            if g_req == REQ_SAVE { save_doc(path) }
            if g_req == REQ_TEXT { commit_text(widgets.Ui_text(ui, g_text_id)) }
            g_req = REQ_NONE
            if layer.count() != g_row_count or g_fold_gen != g_rows_fold_gen {
                ui = rebuild_rows(ui)
            }
        }

        // The canvas gesture, read AFTER Ui_events so the toolkit has already
        // consumed the press that belongs to a button. `Ui_hit_test` reports the
        // topmost widget of any kind under the point, so a press over any control
        // - including the layer rows - is excluded from the canvas.
        var mx = gui.Win_mouse_x()
        var my = gui.Win_mouse_y()
        var down = gui.Win_mouse_pressed()
        if g_doc_w > 0 {
            g_cur_dx = view.screen_to_doc_x(mx.to_float()).to_int()
            g_cur_dy = view.screen_to_doc_y(my.to_float()).to_int()
        }
        if down == 1 {
            if g_was_down == 0 {
                if widgets.Ui_hit_test(ui, mx, my) == 0 - 1 {
                    canvas_press(mx, my)
                }
            } else {
                canvas_drag(mx, my)
            }
        } else {
            if g_was_down == 1 { canvas_release(mx, my) }
        }
        g_was_down = down

        if g_dirty == 1 { refresh(0) }

        paint(ui)

        n = n + 1
        if limit > 0 {
            if n >= limit {
                if shot != "" { gui.Win_screenshot(g_win, shot) }
                ui = widgets.Ui_set_focus(ui, 0 - 1)
                break
            }
        }

        // Without this the loop spins a core at 100%, which on a laptop is
        // audible within seconds.
        gui.Win_delay(16)
    }

    // An unfinished stroke at exit would leak its two full-canvas buffers.
    if paint.stroke_active() { paint.cancel() }
    if g_last_comp != 0 { wynimg_free(g_last_comp) }
    if g_sv_tex >= 0 { gui.Win_texture_free(g_sv_tex) }
    if g_hue_tex >= 0 { gui.Win_texture_free(g_hue_tex) }
    if g_sv_buf != 0 { wynimg_free(g_sv_buf) }
    if g_hue_buf != 0 { wynimg_free(g_hue_buf) }
    if g_tex >= 0 { gui.Win_texture_free(g_tex) }
    gui.Win_font_free(g_font)
    gui.Win_close(g_win)
    return 0
}
