// layer - layer records held as an array of structs.
//
// This WAS ten parallel arrays, because returning or holding a struct across a
// module boundary miscompiled. That is fixed (wyn #268/#270/#276: a module-level
// global keeps its initializer, an array-typed struct field keeps its element
// type, and a lambda works inside an imported module), so the store is now one
// `[Row]` and adding a column is a one-line change to `Row` instead of an edit
// to eight places that fails silently when you miss one.
//
// THE ACCESSOR SURFACE IS DELIBERATELY UNCHANGED. Every `pub fn` below keeps its
// exact signature, because there are ~1389 `layer.` call sites across 25 files;
// this commit changes the STORAGE only. Collapsing the accessors themselves is a
// separate, later job.
//
// Adjustment layers store PARAMETERS, never baked pixels. That is what makes
// the editor non-destructive, and retrofitting it later would mean rewriting
// the whole render path.
//
// HANDLE COLUMNS ARE SPELLED `int`, NOT `ptr` -- v1.20.0 codegen constraint.
// `ptr` in a module `pub fn` signature emits the undefined C type `layer_ptr`
// (a known cross-module `ptr` codegen defect), so `add`/`buffer`/`mask`/`set_mask` take and
// return `int`. Both are 64-bit and the value is passed straight through to an
// `extern fn`, so nothing is lost -- and that is asserted, not assumed, by
// "a real buffer handle survives the store round-trip" in tests/test_layer.wyn.
// A 32-bit truncation of that column segfaults the suite, which is the check.
//
// CALL CONVENTION: every function here is a `pub fn`, so importers call them
// QUALIFIED (`layer.count()`). See the note in src/pixel.wyn.
// This file is also symlinked at the project root as ./layer.wyn, because
// `import layer` from tests/ does not search src/. See the wyn compiler's issue tracker.

// One layer record. `vis` is an int rather than a bool because the public
// `visible()`/`set_visible()` pair converts at the boundary and the stored
// representation is asserted as 0/1 by the suite.
pub struct Row {
    name: string,
    buf: int,
    kind: int,
    opacity: float,
    blend: int,
    visible: int,
    mask: int,
    amount: float,
    parent: int
}

// Which group each layer belongs to, as a PARENT INDEX, or -1 for the top level.
//
// AN INDEX, WHICH MEANS IT MOVES. A layer's identity in this store IS its stack
// position (`remove` shifts everything above it down), so a parent recorded as an
// index has to be rewritten whenever rows move - which `reparent_after_shift`
// does, in one place, for exactly the three operations that move rows. A stable-id
// scheme would avoid that and is the right answer for a 200-layer document; this
// is honest about being a small one, and the fixups are three lines each.
//
// The alternative - storing children as a list per group - was rejected because it
// duplicates the ordering that the stack already encodes, and two orderings that
// can disagree is the bug this store's parallel-array design exists to avoid.
// The store. One seed row so the global carries a non-empty initializer, exactly
// as the ten arrays each did; `l_count` is the live length and `row_grow` reuses
// capacity above it.
var l_rows = [Row { name: "", buf: 0, kind: 0, opacity: 1.0, blend: 0, visible: 1, mask: 0, amount: 0.0, parent: 0 - 1 }]
var l_count = 0

pub fn KIND_RASTER() -> int { return 0 }
pub fn KIND_ADJUST_BRIGHTNESS() -> int { return 1 }

// A GROUP holds other layers instead of pixels.
//
// It has no buffer of its own: `render.compose` composites a group's CHILDREN
// into a fresh accumulator and then blends that accumulator into its parent using
// the group's own opacity, blend mode and mask. That is what makes "group at 50%"
// mean composite-then-fade rather than fade-each-child - which is the whole
// reason a group is not just a naming convention, and is why it needs a real
// buffer at render time even though it stores none.
pub fn KIND_GROUP() -> int { return 2 }

pub fn store_new() -> int {
    l_count = 0
    return 0
}

pub fn count() -> int { return l_count }

fn valid(id: int) -> bool {
    return id >= 0 and id < l_count
}

// Appends a layer and returns its id. `buf` is a wynimg handle for raster
// layers, or 0 for adjustment layers (which have no pixels of their own).
// ---- the only three functions that touch every column ---------------------
//
// A NEW COLUMN IS ADDED IN THESE THREE PLACES AND NOWHERE ELSE. Before this,
// `add` wrote all the columns twice (a reuse branch and a push branch), `insert`
// wrote them twice more (a shift loop and an initialise block), `remove` shifted
// them and `swap` saved/assigned/restored them - eight hand-written column lists
// in four functions. Adding one column meant editing all eight, and MISSING one
// is silent: the arrays end up at different lengths and the symptom is a crash in
// an unrelated operation much later. src/history.wyn records exactly this bug
// ("a second writer left them at DIFFERENT LENGTHS, which crashed the first
// structural undo") and fixed it the same way.
//
// This is a behaviour-neutral refactor: same writes, same order, one copy.

// Write a complete row at `i`, which must already exist.
fn row_set(i: int, name: string, buf: int, kind: int, op: float,
           bl: int, vis: int, mask: int, amt: float, parent: int) {
    l_rows[i].name = name
    l_rows[i].buf = buf
    l_rows[i].kind = kind
    l_rows[i].opacity = op
    l_rows[i].blend = bl
    l_rows[i].visible = vis
    l_rows[i].mask = mask
    l_rows[i].amount = amt
    l_rows[i].parent = parent
}

// Copy row `src` onto row `dst`. Used by every shift, in both directions.
fn row_copy(dst: int, src: int) {
    row_set(dst, l_rows[src].name, l_rows[src].buf, l_rows[src].kind,
            l_rows[src].opacity, l_rows[src].blend, l_rows[src].visible,
            l_rows[src].mask, l_rows[src].amount, l_rows[src].parent)
}

// Append one row's worth of capacity, so `row_set` can then write it.
//
// The reuse branch exists because `remove` decrements the count without
// shrinking the arrays, so a later add finds capacity already there - a slot
// that must be OVERWRITTEN rather than pushed, or the arrays grow without bound
// across an add/remove cycle.
fn row_grow() {
    if l_count < l_rows.len() { return }
    l_rows.push(Row { name: "", buf: 0, kind: 0, opacity: 1.0, blend: 0,
                      visible: 1, mask: 0, amount: 0.0, parent: 0 - 1 })
}

pub fn add(name: string, buf: int, kind: int) -> int {
    var id = l_count
    row_grow()
    row_set(id, name, buf, kind, 1.0, 0, 1, 0, 0.0, 0 - 1)
    l_count = l_count + 1
    return id
}

pub fn name(id: int) -> string {
    if valid(id) == false { return "" }
    return l_rows[id].name
}

pub fn buffer(id: int) -> int {
    if valid(id) == false { return 0 }
    return l_rows[id].buf
}

pub fn kind(id: int) -> int {
    if valid(id) == false { return 0 }
    return l_rows[id].kind
}

pub fn opacity(id: int) -> float {
    if valid(id) == false { return 1.0 }
    return l_rows[id].opacity
}

pub fn set_opacity(id: int, v: float) {
    if valid(id) == false { return }
    var c = v
    if c < 0.0 { c = 0.0 }
    if c > 1.0 { c = 1.0 }
    l_rows[id].opacity = c
}

pub fn blend_mode(id: int) -> int {
    if valid(id) == false { return 0 }
    return l_rows[id].blend
}

pub fn set_blend_mode(id: int, m: int) {
    if valid(id) == false { return }
    if m < 0 or m >= 27 { return }
    l_rows[id].blend = m
}

pub fn visible(id: int) -> bool {
    if valid(id) == false { return false }
    return l_rows[id].visible == 1
}

pub fn set_visible(id: int, v: bool) {
    if valid(id) == false { return }
    if v { l_rows[id].visible = 1 } else { l_rows[id].visible = 0 }
}

pub fn mask(id: int) -> int {
    if valid(id) == false { return 0 }
    return l_rows[id].mask
}

pub fn set_mask(id: int, m: int) {
    if valid(id) == false { return }
    l_rows[id].mask = m
}

// ---- grouping ---------------------------------------------------------------

// The group this layer belongs to, or -1 for the top level.
pub fn parent(id: int) -> int {
    if valid(id) == false { return 0 - 1 }
    return l_rows[id].parent
}

// Put `id` inside group `p` (-1 for the top level). Returns false and changes
// nothing if the result would not be a valid tree.
//
// THREE THINGS ARE REFUSED, and each is a real way to corrupt a render:
//   - a parent that is not a GROUP, which would ask a raster layer to hold
//     children and give the walk no accumulator to composite them into;
//   - a layer as its own parent, and any longer cycle, which would make the
//     recursive walk recurse forever;
//   - a parent BELOW the child in the stack. A group must sit under its own
//     children the way it does in every editor, and the walk relies on it: it
//     composites a group by scanning upward for rows whose parent is that group.
pub fn set_parent(id: int, p: int) -> bool {
    if valid(id) == false { return false }
    if p == 0 - 1 {
        l_rows[id].parent = 0 - 1
        return true
    }
    if valid(p) == false { return false }
    if p == id { return false }
    if l_rows[p].kind != KIND_GROUP() { return false }
    if p > id { return false }
    // Walk up from the proposed parent: if we reach `id`, this closes a cycle.
    //
    // UNREACHABLE TODAY, and said plainly rather than left to look tested: the
    // `p > id` rule above already forces every parent to sit below its child, so
    // a chain of parents strictly descends and cannot return to `id`. Mutation
    // testing confirms it - deleting this check fails nothing.
    //
    // It stays for the same reason a bounds check stays. The descending-index
    // invariant is a property of two rules in this function, and the store is also
    // written by undo replay; the day either changes, the failure without this
    // check is an infinite loop in the render walk, not a wrong picture. The
    // `guard` counter below is the second half of that argument.
    var up = l_rows[p].parent
    var guard = 0
    while up != 0 - 1 {
        if up == id { return false }
        // A guard rather than trust: the store is edited by undo replay too, and
        // an infinite loop here would hang the editor rather than report anything.
        guard = guard + 1
        if guard > l_count { return false }
        up = l_rows[up].parent
    }
    l_rows[id].parent = p
    return true
}

// How many layers name `g` as their parent.
pub fn child_count(g: int) -> int {
    var n = 0
    var i = 0
    while i < l_count {
        if l_rows[i].parent == g { n = n + 1 }
        i = i + 1
    }
    return n
}

// After rows have MOVED, rewrite every parent index that pointed at a moved row.
//
// `Row.parent` holds indices, and this store's whole design is that an index IS an
// identity - so any operation that shifts rows invalidates parents that pointed
// past the shift. Called by remove/insert/swap, which are the only three
// operations that move rows.
//
// `was`/`now` describe the mapping: a parent equal to `was` becomes `now`, and
// -1 for `now` means the parent was deleted, which ORPHANS the child to the top
// level rather than leaving it pointing at a row that is now someone else. An
// orphaned child is visible and editable; a child pointing at a stale index is a
// render that composites into the wrong accumulator.
// (`from`/`to` would be the natural names; both are reserved words in Wyn.)
fn reparent(was: int, now: int) {
    var i = 0
    while i < l_count {
        if l_rows[i].parent == was { l_rows[i].parent = now }
        i = i + 1
    }
}

// Shift every parent index in [lo, hi] by `delta`.
fn reparent_shift(lo: int, hi: int, delta: int) {
    var i = 0
    while i < l_count {
        var pp = l_rows[i].parent
        if pp >= lo and pp <= hi { l_rows[i].parent = pp + delta }
        i = i + 1
    }
}

pub fn adjust_amount(id: int) -> float {
    if valid(id) == false { return 0.0 }
    return l_rows[id].amount
}

pub fn set_adjust_amount(id: int, v: float) {
    if valid(id) == false { return }
    l_rows[id].amount = v
}

// ---- structural edits ------------------------------------------------------
//
// WHY REMOVE SHIFTS INSTEAD OF LEAVING A HOLE.
//
// A layer's identity in this store IS its stack position: render.compose walks
// 0..count() bottom-up and the compositing order is the array order. A tombstone
// scheme would need every walk to skip holes and would make "move up" mean
// something different from "swap with the next index". Shifting keeps one
// invariant - index == depth - at the cost of O(n) on a delete, where n is the
// layer count (tens), not the pixel count.
//
// The CALLER's ids therefore shift too, and that is deliberate rather than
// hidden: src/ui.wyn rebuilds its widget->layer table after any structural
// edit, and history records positions, not identities. A stable-id scheme would
// be better for a 200-layer document; this is honest about being a small one.
//
// Buffers are NOT freed here. The buffer handle outlives the row on purpose:
// undoing a delete must put the same pixels back, so history owns the handle
// between the delete and its undo. Freeing on remove would make undo restore a
// dead handle - which, thanks to the generation-tagged handle table, would be a
// silently blank layer rather than a crash, i.e. the worst kind of bug.

pub fn remove(id: int) -> int {
    if valid(id) == false { return 0 }
    // ORDER MATTERS. Orphan this row's children FIRST, while `id` still names
    // it; then shift the rows; then renumber the parents that moved. Doing the
    // renumber first would make the orphan pass look for a row that no longer
    // has that index and silently leave dangling parents.
    reparent(id, 0 - 1)
    var i = id
    while i < l_count - 1 {
        row_copy(i, i + 1)
        i = i + 1
    }
    l_count = l_count - 1
    // Everything that was above `id` has moved down one.
    reparent_shift(id + 1, l_count, 0 - 1)
    return 1
}

// Inserts at `pos`, shifting everything at and above it up. `pos` is clamped
// into [0, count()], so an out-of-range position appends rather than being
// rejected - undo replays a recorded position and must never silently drop a
// layer because the stack shrank underneath it.
pub fn insert(pos: int, name: string, buf: int, kind: int) -> int {
    var p = pos
    if p < 0 { p = 0 }
    if p > l_count { p = l_count }
    // Grow by one at the top, then shift down into the gap.
    add(name, 0, 0)
    var i = l_count - 1
    while i > p {
        row_copy(i, i - 1)
        i = i - 1
    }
    // Everything from `p` up has moved up one. Done BEFORE the new row is
    // written, so the fresh row's own parent (-1) is not caught by the shift.
    reparent_shift(p, l_count - 2, 1)
    row_set(p, name, buf, kind, 1.0, 0, 1, 0, 0.0, 0 - 1)
    return p
}

// Swaps two rows. `move up` is swap(i, i+1); reordering is its own operation
// rather than remove+insert so that undo is a second swap with no allocation
// and no chance of losing a buffer handle in between.
pub fn swap(a: int, b: int) -> int {
    if valid(a) == false { return 0 }
    if valid(b) == false { return 0 }
    if a == b { return 1 }
    // Through the scratch row at the top of the arrays, which row_grow has
    // guaranteed exists. Saving the eight values into eight locals worked, but it
    // was a third hand-written column list - and the one most likely to be
    // half-updated, since a missed column there swaps seven fields and silently
    // leaves the eighth behind.
    var tmp = l_count
    row_grow()
    row_copy(tmp, a)
    row_copy(a, b)
    row_copy(b, tmp)
    // The two rows have exchanged indices, so anything parented to either must
    // follow it. Via a sentinel, because two sequential reparent calls would
    // rewrite a->b and then immediately b->a, ending where they started.
    var SENT = 0 - 99
    reparent(a, SENT)
    reparent(b, a)
    reparent(SENT, b)
    return 1
}

pub fn set_name(id: int, s: string) {
    if valid(id) == false { return }
    l_rows[id].name = s
}

// Replaces a row's buffer handle, returning the previous one so the caller can
// decide its fate. Used by nothing in the UI today; it exists because "swap the
// handle" is the wrong way to undo a paint stroke and having the operation named
// makes that visible - undo copies PIXELS back into the live buffer
// (wynimg_copy_into), because other holders of the handle (the texture upload,
// a mask reference) must keep seeing the same buffer.
pub fn set_buffer(id: int, buf: int) -> int {
    if valid(id) == false { return 0 }
    var prev = l_rows[id].buf
    l_rows[id].buf = buf
    return prev
}
