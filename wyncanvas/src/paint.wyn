// paint - tool state and the stroke lifecycle.
//
// This module owns WHAT a stroke is, and src/ui.wyn owns where the pointer was.
// Splitting it that way is what makes the brush testable without a window: the
// headless tests drive begin/seg/commit directly with document coordinates and
// then read pixels back, so a failure is either in this file or in the C kernel,
// never in the mouse plumbing.
//
// A STROKE HAS THREE PHASES, and all three are needed for correctness rather
// than for tidiness:
//
//   begin(layer)  clones the layer's pixels (the BASE) and allocates a coverage
//                 buffer. Nothing is drawn yet.
//   seg(x0,y0,x1,y1)  accumulates coverage for one segment with max(), then
//                 rebuilds the layer as base + colour*coverage. So the live
//                 preview during a drag is produced by the identical code that
//                 produces the final image - there is no separate "preview"
//                 renderer that can disagree with the commit.
//   commit()      records ONE undo entry holding the before and after pixels,
//                 and releases the coverage buffer.
//
// The alternative - composite a dab per mouse position straight into the layer -
// is what most first attempts do, and it is wrong in a way that is obvious once
// seen: overlapping dabs composite repeatedly, so a 30%-alpha stroke goes opaque
// wherever the pointer moved slowly, and undo either restores nothing or needs
// 400 entries for one gesture.
//
// COLOUR LIVES HERE AS sRGB (display) VALUES, because that is what a colour
// picker shows and what a user means by "0.5 grey". Conversion to linear happens
// once, at the point the colour reaches a pixel - `stroke_color_linear`. Storing
// linear and converting for display would be equivalent; storing sRGB and
// FORGETTING to convert is the bug this arrangement makes hard, because the
// only path to the kernel runs through the conversion.
//
// CALL CONVENTION: `pub fn`s here are called QUALIFIED (`paint.begin(...)`), and
// this module reaches the C kernel through `wynimg::name(...)` - see the long
// note in src/render.wyn for why that spelling and no other.

import pixel
import layer
import history

// THE SELECTION CLIPS EVERY STROKE, and importing it here is what makes that
// true rather than approximately true. Until this import existed the selection
// was only a GATE at the press: a stroke that started inside a marquee and was
// dragged out kept painting past the boundary, because the coverage buffer it
// would have to be multiplied into is this module's private `s_cov` and nothing
// outside could reach it. See `clipped_cov` below - the whole fix is one
// multiply in one place.
//
// `import select` needs a compiler new enough to treat `select` as a
// CONTEXTUAL keyword (the channel-multiplexing statement `select { ... }`);
// on an older one this line fails with "Expected module name".
import select

// ---- the dab engine (csrc/wynimg_paint.c) ----------------------------------
//
// Declared HERE rather than in src/pixel.wyn, following src/text.wyn: these are
// the brush's own kernel and nothing else calls them, so the declaration lives
// with the only caller.
//
// WHY A DAB ENGINE AT ALL, given that wynimg_stroke_seg already sweeps a capsule
// per call. Because a brush is a STAMP repeated along the path. Pressure, a
// calligraphic angle and a scatter offset are properties of an individual dab,
// and a single swept capsule has no dabs to give them to. The capsule kernel is
// still the right primitive for src/text.wyn and src/select.wyn, and it is what a
// dense round hard brush degenerates to.
//
// Dabs land every `spacing * radius` px of ARC LENGTH, and the leftover distance
// is carried from one input segment to the next. Both halves matter: place one
// dab per input sample and the stroke's look becomes a property of the pointer's
// report rate; drop the carry and every interior input point is stamped twice.
//
// The run state (the arc-length carry, the dab index) lives in C. There is one
// live stroke, and returning two values across a Wyn module boundary does not
// work here.
extern fn wynimg_brush_set(radius: float, hardness: float, spacing: float,
                           angle_deg: float, aspect: float,
                           scatter: float, seed: int) -> int;
extern fn wynimg_brush_smoothing(on: int) -> int;
extern fn wynimg_dab_begin(stroke: int, x: float, y: float, press: float) -> int;
extern fn wynimg_dab_seg(stroke: int, x: float, y: float, press: float) -> int;
extern fn wynimg_dab_carry() -> float;
extern fn wynimg_dab_count() -> int;

// ---- tools ----------------------------------------------------------------
//
// The tool changes what a drag DOES, not how it is tracked, so it is one int
// consulted at seg/commit time rather than four parallel code paths.

pub fn TOOL_BRUSH() -> int { return 0 }
pub fn TOOL_ERASER() -> int { return 1 }
pub fn TOOL_FILL() -> int { return 2 }
pub fn TOOL_PICK() -> int { return 3 }

// Pan is a TOOL rather than a modifier key, because the widget toolkit owns the
// key queue (Ui_events drains it, and a second reader would see nothing), so a
// space-bar-to-pan modifier is not reachable from here without changing the
// toolkit. A tool is also the thing a headless script can select by name, which
// makes panning verifiable rather than merely present.
pub fn TOOL_PAN() -> int { return 4 }

var p_tool = 0

pub fn tool() -> int { return p_tool }

pub fn set_tool(t: int) {
    if t < 0 { return }
    if t > 4 { return }
    p_tool = t
}

pub fn tool_name(t: int) -> string {
    if t == 0 { return "brush" }
    if t == 1 { return "eraser" }
    if t == 2 { return "fill" }
    if t == 3 { return "pick" }
    if t == 4 { return "pan" }
    return "?"
}

// ---- brush parameters -----------------------------------------------------

var p_radius = 12.0
var p_hardness = 0.6
var p_alpha = 1.0
var p_tol = 0.12

// sRGB (display-encoded) brush colour, plus the HSV it came from. Both are kept
// because HSV is not recoverable from RGB without losing the hue of a grey: a
// user who drags value to 0 and back must get their hue back, and round-tripping
// through RGB would return black-with-no-hue.
var p_h = 210.0
var p_s = 0.85
var p_v = 0.95

pub fn radius() -> float { return p_radius }
pub fn set_radius(r: float) {
    var v = r
    if v < 0.5 { v = 0.5 }
    if v > 200.0 { v = 200.0 }
    p_radius = v
}

pub fn hardness() -> float { return p_hardness }
pub fn set_hardness(h: float) {
    var v = h
    if v < 0.0 { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    p_hardness = v
}

pub fn alpha() -> float { return p_alpha }
pub fn set_alpha(a: float) {
    var v = a
    if v < 0.0 { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    p_alpha = v
}

pub fn tolerance() -> float { return p_tol }
pub fn set_tolerance(t: float) {
    var v = t
    if v < 0.0 { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    p_tol = v
}

// ---- dab-engine parameters -------------------------------------------------
//
// These are the knobs that only exist because a stroke is a chain of DABS rather
// than one swept capsule: a dab can carry an angle, an aspect and a scatter
// offset; a capsule cannot. See the note in src/pixel.wyn.
//
// The defaults are chosen so a caller who sets none of them paints what the
// pre-dab brush painted: 25% spacing is dense enough that consecutive dabs
// overlap heavily and their union is a capsule to within the antialiased rim,
// aspect 1 is round, and scatter 0 puts every dab exactly on the path.

var p_spacing = 0.25
var p_angle = 0.0
var p_aspect = 1.0
var p_scatter = 0.0
var p_seed = 1
var p_smooth = 0

pub fn spacing() -> float { return p_spacing }

// Spacing is a fraction of the dab RADIUS, not an absolute distance, so
// changing the brush size does not change the stroke's character. Clamped rather
// than refused: 0 would be infinitely many dabs and a hung editor, and past ~4
// radii the line is dots and the value stops meaning anything.
pub fn set_spacing(s: float) {
    var v = s
    if v < 0.01 { v = 0.01 }
    if v > 4.0 { v = 4.0 }
    p_spacing = v
}

pub fn angle() -> float { return p_angle }
pub fn set_angle(a: float) {
    var v = a
    while v >= 360.0 { v = v - 360.0 }
    while v < 0.0 { v = v + 360.0 }
    p_angle = v
}

pub fn aspect() -> float { return p_aspect }

// aspect = minor/major. 1 is round; 0.2 is a calligraphic nib five times longer
// than it is wide. Values above 1 are the same nib rotated 90 degrees, so they
// are clamped instead of being a second way to spell the same brush.
pub fn set_aspect(a: float) {
    var v = a
    if v < 0.05 { v = 0.05 }
    if v > 1.0 { v = 1.0 }
    p_aspect = v
}

pub fn scatter() -> float { return p_scatter }
pub fn set_scatter(s: float) {
    var v = s
    if v < 0.0 { v = 0.0 }
    if v > 4.0 { v = 4.0 }
    p_scatter = v
}

pub fn seed() -> int { return p_seed }

// The scatter seed. A randomised brush whose output cannot be reproduced cannot
// be tested, and worse, cannot be undone-and-redone into the same pixels: the
// stroke would change under the user. So scatter is a hash of (seed, dab index),
// never a call to rand().
pub fn set_seed(s: int) { p_seed = s }

pub fn smoothing() -> bool { return p_smooth == 1 }

// Catmull-Rom smoothing of the INPUT path, OFF by default. It moves where dabs
// land, so it is a behaviour change and not a free improvement - see the note at
// the INPUT-PATH SMOOTHING note in csrc/wynimg_paint.c.
pub fn set_smoothing(on: bool) {
    if on { p_smooth = 1 } else { p_smooth = 0 }
}

// Pushes the brush parameters into the C engine. Called at begin() rather than
// from every setter, so a stroke's shape is fixed for its whole duration: a
// slider dragged mid-stroke must not make the second half of one line a
// different brush from the first.
fn push_brush() {
    wynimg::brush_set(p_radius, p_hardness, p_spacing,
                      p_angle, p_aspect, p_scatter, p_seed)
    wynimg::brush_smoothing(p_smooth)
}

pub fn hue() -> float { return p_h }
pub fn sat() -> float { return p_s }
pub fn val() -> float { return p_v }

pub fn set_hsv(h: float, s: float, v: float) {
    var hh = h
    while hh >= 360.0 { hh = hh - 360.0 }
    while hh < 0.0 { hh = hh + 360.0 }
    p_h = hh
    p_s = s
    if p_s < 0.0 { p_s = 0.0 }
    if p_s > 1.0 { p_s = 1.0 }
    p_v = v
    if p_v < 0.0 { p_v = 0.0 }
    if p_v > 1.0 { p_v = 1.0 }
}

// The brush colour as sRGB display values, 0..1. chan 0=R 1=G 2=B.
pub fn color_srgb(chan: int) -> float {
    return pixel.hsv_channel(p_h, p_s, p_v, chan)
}

// The same colour in LINEAR light - what a pixel actually stores. Every path
// from the picker to a buffer goes through here, which is why "compositing sRGB
// by accident" is not reachable.
pub fn color_linear(chan: int) -> float {
    return pixel.srgb_to_linear(color_srgb(chan))
}

// The brush colour as a 0..255 byte, for painting swatches with Win_rect (which
// takes display-encoded ints, so this must NOT be the linear value).
pub fn color_byte(chan: int) -> int {
    var v = color_srgb(chan) * 255.0 + 0.5
    var i = v.to_int()
    if i < 0 { i = 0 }
    if i > 255 { i = 255 }
    return i
}

// ---- the stroke -----------------------------------------------------------

var s_active = 0
var s_layer = -1
var s_base = 0        // pixels as they were when the stroke began
var s_cov = 0         // coverage accumulator (R channel)
var s_clip = 0        // selection-clipped COPY of s_cov; see clip_cov
var s_lx = 0.0        // last position, so a drag paints capsules not dots
var s_ly = 0.0
var s_segs = 0

pub fn stroke_active() -> bool { return s_active == 1 }
pub fn stroke_segments() -> int { return s_segs }

// Begins a stroke on layer `lid` at document coordinates (x,y).
// Returns 1 if a stroke started, 0 if it could not (no such layer, no pixels,
// an adjustment layer, or allocation failure).
//
// A click with no drag must still paint, so the initial position is applied
// immediately as a zero-length segment - which the distance-field kernel handles
// as a point, giving a symmetric dab.
pub fn begin(lid: int, x: float, y: float) -> int {
    return begin_p(lid, x, y, 1.0)
}

// begin with an explicit PRESSURE, 0..1. `begin` is the pressure-1 case, kept as
// its own name because every mouse (as opposed to stylus) event is that case and
// src/ui.wyn should not have to invent a 1.0.
pub fn begin_p(lid: int, x: float, y: float, press: float) -> int {
    if s_active == 1 { cancel() }
    var buf = layer.buffer(lid)
    if buf == 0 { return 0 }
    var w = wynimg::width(buf)
    var h = wynimg::height(buf)
    if w == 0 { return 0 }

    s_base = wynimg::clone(buf)
    if s_base == 0 { return 0 }
    s_cov = wynimg::new(w, h)
    if s_cov == 0 {
        wynimg::free(s_base)
        s_base = 0
        return 0
    }
    s_active = 1
    s_layer = lid
    s_lx = x
    s_ly = y
    s_segs = 0

    // The brush shape is frozen for the whole stroke, and the dab run's
    // arc-length cursor is reset here and ONLY here.
    push_brush()
    wynimg::dab_begin(s_cov, x, y, press)
    s_segs = 1
    // A FAILED FIRST APPLY MUST NOT LEAVE A STROKE ACTIVE. begin() documents
    // "returns 1 if a stroke started"; without the rollback it could return 0 with
    // s_active still 1, and src/ui.wyn (which treats 0 as "cannot paint that
    // layer" and does not enter DRAG_STROKE) would leave the stroke live forever -
    // the next begin() would cancel it and the base buffers would churn silently.
    //
    // Reachable, not theoretical: a selection whose dimensions do not match the
    // layer makes select.clip refuse, so clipped_cov returns 0 and apply_cov with
    // it. Refusing outright is right there - painting unclipped because the mask
    // was the wrong size is the failure mode that loses a user's work.
    if apply_cov() == 0 {
        cancel()
        return 0
    }
    return 1
}

pub fn seg(x: float, y: float) -> int {
    return seg_p(x, y, 1.0)
}

// Extends the stroke to (x,y) at pressure `press`.
//
// The dab engine keeps the previous position AND the leftover arc length, so a
// fast drag lays a continuous line of dabs and a slow one does not pile them up -
// the stroke's look is a property of the brush, not of the pointer's report rate.
// That is the whole reason the API is "extend to" rather than "stamp at".
pub fn seg_p(x: float, y: float, press: float) -> int {
    if s_active == 0 { return 0 }
    if layer.buffer(s_layer) == 0 { return 0 }
    wynimg::dab_seg(s_cov, x, y, press)
    s_lx = x
    s_ly = y
    s_segs = s_segs + 1
    return apply_cov()
}

// THE SELECTION CLIP, and the two things it must not do.
//
// A selection is a coverage mask (src/select.wyn) and a stroke is a coverage
// buffer, so clipping is one multiply: `select.clip(cov)`. It happens HERE, in
// the buffer handed to stroke_apply, because apply_cov is the single choke point
// every phase of a stroke goes through - begin, every seg, and by extension the
// commit, which snapshots what the last apply left. Clipping at three call sites
// instead is three chances for the fourth one to be forgotten.
//
// 1. IT MUST NOT CLIP `s_cov` IN PLACE. The dab engine max()es new dabs into
//    s_cov and every apply re-reads the whole buffer, so an in-place multiply
//    would be applied again on the next apply, and again on the one after:
//    coverage inside a FEATHERED edge would decay geometrically (0.5, 0.25,
//    0.125 ...) and a slow drag would fade its own selection edge away. So the
//    clip runs on a COPY, and s_cov stays the unclipped truth. s_base is not
//    touched at all, which is what keeps the pre-stroke pixels intact outside
//    the selection.
//
// 2. AN EMPTY SELECTION MEANS "NO SELECTION, PAINT EVERYWHERE", NOT "an
//    all-zeros mask". Multiplying by an empty mask makes the brush a silent
//    no-op - the exact conversion bug that bit the filter integration.
//    `select.is_empty()` is true both when there is no selection buffer at all
//    and when nothing is selected, which is deliberate (see select.wyn's
//    `init`), and both mean no clipping.
//
// Failure is a REFUSAL, never an unclipped paint: if the scratch buffer cannot
// be allocated, or the clip is rejected because the selection is not the same
// size as this layer, this returns 0 and apply_cov paints nothing. A brush that
// silently ignored the selection because an allocation failed would be worse
// than one that stopped.
fn clipped_cov() -> int {
    if select.is_empty() { return s_cov }
    if s_clip == 0 {
        s_clip = wynimg::new(wynimg::width(s_cov), wynimg::height(s_cov))
        if s_clip == 0 { return 0 }
    }
    if wynimg::copy_into(s_clip, s_cov) == 0 { return 0 }
    if select.clip(s_clip) == false { return 0 }
    return s_clip
}

// Rebuilds the layer as base + colour*coverage. Shared by begin and seg so the
// live preview during a drag is produced by the identical code as the commit -
// there is no separate preview renderer that can disagree.
fn apply_cov() -> int {
    var buf = layer.buffer(s_layer)
    if buf == 0 { return 0 }
    var cov = clipped_cov()
    if cov == 0 { return 0 }
    var erase = 0
    if p_tool == TOOL_ERASER() { erase = 1 }
    return wynimg::stroke_apply(buf, s_base, cov,
                                color_linear(0), color_linear(1),
                                color_linear(2), p_alpha, erase)
}

// Dabs stamped so far this stroke - distinct from stroke_segments(), which counts
// INPUT samples. The two diverging is the point of spacing: a 200px drag reported
// as 2 samples and as 50 samples must produce the same dab count.
pub fn stroke_dabs() -> int { return wynimg::dab_count() }

// Arc length still to travel before the next dab. Exposed so a test can assert
// the carry is real rather than inferring it from pixels.
pub fn stroke_carry() -> float { return wynimg::dab_carry() }

// Ends the stroke and records it as ONE undo entry.
//
// The "after" snapshot is a second clone rather than the live buffer, because
// history must own pixels that no later stroke can mutate under it. The "before"
// clone taken in begin() is handed over as-is - history owns it from here.
pub fn commit() -> int {
    if s_active == 0 { return 0 }
    var buf = layer.buffer(s_layer)
    var after = wynimg::clone(buf)
    wynimg::free(s_cov)
    wynimg::free(s_clip)
    s_cov = 0
    s_clip = 0
    s_active = 0
    if after == 0 {
        // Could not snapshot: drop the record rather than store a half one,
        // and free the base so the stroke is unrecorded but not leaked.
        wynimg::free(s_base)
        s_base = 0
        return 0
    }
    history.record_pixels(s_layer, s_base, after)
    s_base = 0
    return 1
}

// Abandons the stroke and puts the layer back. Used when a drag leaves the
// canvas or a second begin() arrives without a commit.
pub fn cancel() -> int {
    if s_active == 0 { return 0 }
    var buf = layer.buffer(s_layer)
    if buf != 0 {
        if s_base != 0 { wynimg::copy_into(buf, s_base) }
    }
    wynimg::free(s_base)
    wynimg::free(s_cov)
    wynimg::free(s_clip)
    s_base = 0
    s_cov = 0
    s_clip = 0
    s_active = 0
    return 1
}

// ---- bucket fill ----------------------------------------------------------
//
// Goes through the SAME coverage buffer and the SAME apply kernel as a brush
// stroke, so it inherits premultiplied-linear correctness and one-entry undo
// without a second implementation. Returns the pixel count, 0 if nothing was
// filled, -1 if refused.
pub fn fill_at(lid: int, x: int, y: int) -> int {
    var buf = layer.buffer(lid)
    if buf == 0 { return -1 }
    var w = wynimg::width(buf)
    var h = wynimg::height(buf)
    if w == 0 { return -1 }

    var before = wynimg::clone(buf)
    if before == 0 { return -1 }
    var cov = wynimg::new(w, h)
    if cov == 0 {
        wynimg::free(before)
        return -1
    }

    var n = wynimg::fill_region(cov, buf, x, y, p_tol)
    if n <= 0 {
        wynimg::free(before)
        wynimg::free(cov)
        return n
    }

    // The fill is clipped by the selection for the same reason a stroke is, and
    // IN PLACE is correct here where it is not for a stroke: this coverage buffer
    // is built once, consumed once and freed, so there is no second apply to
    // multiply it a second time. The empty-selection guard is the same - an empty
    // selection means "no selection", not "a mask of zeros".
    //
    // `n` stays the FLOODED region's size, not the painted one. It is what the
    // status bar reports and what a caller uses to say "nothing to fill"; the
    // number of pixels the selection then let through is a different question and
    // there is no honest single number for it once the edge is feathered.
    if select.is_empty() == false { select.clip(cov) }

    var erase = 0
    if p_tool == TOOL_ERASER() { erase = 1 }
    wynimg::stroke_apply(buf, before, cov,
                         color_linear(0), color_linear(1), color_linear(2),
                         p_alpha, erase)
    wynimg::free(cov)

    var after = wynimg::clone(buf)
    if after == 0 {
        wynimg::free(before)
        return n
    }
    history.record_pixels(lid, before, after)
    return n
}

// ---- eyedropper -----------------------------------------------------------
//
// Reads a pixel from a COMPOSITED buffer (the caller passes the composite, not a
// layer) because what the user is pointing at on screen is the composite. The
// value read is linear and un-premultiplied, so it is converted back to sRGB and
// then to HSV, which is the form the picker edits.
pub fn pick_from(buf: int, x: int, y: int) -> int {
    if buf == 0 { return 0 }
    var r = pixel.linear_to_srgb(wynimg::pick(buf, x, y, 0))
    var g = pixel.linear_to_srgb(wynimg::pick(buf, x, y, 1))
    var b = pixel.linear_to_srgb(wynimg::pick(buf, x, y, 2))
    set_hsv(rgb_hue(r, g, b), rgb_sat(r, g, b), rgb_val(r, g, b))
    return 1
}

// RGB -> HSV, one component per function for the same reason hsv_channel takes a
// channel index: a pub fn cannot reliably return a tuple across a module
// boundary here.
fn max3(a: float, b: float, c: float) -> float {
    var m = a
    if b > m { m = b }
    if c > m { m = c }
    return m
}

fn min3(a: float, b: float, c: float) -> float {
    var m = a
    if b < m { m = b }
    if c < m { m = c }
    return m
}

pub fn rgb_val(r: float, g: float, b: float) -> float {
    return max3(r, g, b)
}

// NB the local names `chi`/`clo`, not the obvious `mx`/`mn`. A local `var mx`
// holding a FLOAT in an imported module retypes a same-named `var mx = 0` in the
// importing file, so `mx.to_float()` there fails with "Unknown method 'to_float'
// for type 'float'" - src/ui.wyn has exactly such an `mx` for the mouse position.
// Reported upstream with a two-file repro; the rename is the local fix and is no
// worse to read.
pub fn rgb_sat(r: float, g: float, b: float) -> float {
    var chi = max3(r, g, b)
    if chi <= 0.0 { return 0.0 }
    return (chi - min3(r, g, b)) / chi
}

pub fn rgb_hue(r: float, g: float, b: float) -> float {
    var chi = max3(r, g, b)
    var clo = min3(r, g, b)
    var d = chi - clo
    if d <= 0.0 { return 0.0 }
    var hv = 0.0
    if chi == r { hv = (g - b) / d }
    else {
        if chi == g { hv = 2.0 + (b - r) / d }
        else { hv = 4.0 + (r - g) / d }
    }
    hv = hv * 60.0
    while hv < 0.0 { hv = hv + 360.0 }
    while hv >= 360.0 { hv = hv - 360.0 }
    return hv
}
