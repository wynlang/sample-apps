// render - composites the layer stack into a single output buffer.
//
// This is the only module that knows about both the layer tree and the pixel
// API. Layers are walked bottom-up; each raster layer is blended over the
// accumulator, and each adjustment layer transforms everything composited
// beneath it so far - which is what makes adjustments non-destructive.
//
// CALL CONVENTION -- v1.20.0 codegen constraint, see the wyn compiler's issue tracker.
// This module is the first `pub fn` in the project that must call an
// `extern fn`, and the plan's literal spelling does not compile. Three
// spellings were tried; only the third works:
//
//   wynimg_composite(...)        -> emits `render_render_wynimg_composite`
//                                   (Defect 2: two prefixers both fire)
//   render.wynimg_composite(...) -> emits `render_wynimg_composite` (Defect 1)
//   wynimg::composite(...)       -> emits `wynimg_composite`        CORRECT
//
// The `::` form works because `A::b` lowers to `A_b` on a path that runs
// BEFORE the module prefixer, so it reconstructs the real C symbol name. It is
// not a hack in the sense of being fragile-if-wrong: a typo (`wynimg::nwe`) or
// a wrong arity is a hard C compile error, verified, never a silent miscall.
//
// The declarations come from `pixel` via the import; re-declaring them here
// would be redundant (though harmless, if signatures match exactly).
//
// Handles are `int`, not `ptr` -- see the long note in src/pixel.wyn.
// This file is also symlinked at the project root as ./render.wyn, because
// `import render` from tests/ does not search src/. See the wyn compiler's issue tracker.

import pixel
import layer

// Composite every layer whose parent is `g` into a fresh buffer.
//
// A GROUP IS COMPOSITE-THEN-FADE, NOT FADE-EACH-CHILD, and that is the entire
// reason groups are a render feature rather than a naming convention. The
// children are blended into a buffer of their own, and only then is that buffer
// blended into the parent using the GROUP's opacity, blend mode and mask. A group
// at 50% therefore dims the finished stack; multiplying each child by 0.5 instead
// would let the lower children show through the upper ones, which is a visibly
// different picture and the thing every editor gets right.
//
// Recursion depth is bounded by the tree, and the tree cannot cycle: set_parent
// refuses a cycle and refuses a parent above its child, so a group's children are
// always at higher indices and the walk strictly descends. The `depth` guard is
// still there, because this store is also written by undo replay and a hang is a
// worse failure than a wrong picture.
fn compose_group(g: int, w: int, h: int, depth: int) -> int {
    var out = wynimg::new(w, h)
    if out == 0 { return 0 }
    if depth > 32 { return out }

    var i = 0
    while i < layer.count() {
        if layer.parent(i) == g {
            if layer.visible(i) {
                var k = layer.kind(i)
                if k == layer.KIND_ADJUST_BRIGHTNESS() {
                    // An adjustment applies to what is BELOW it, which inside a
                    // group means what is below it within that group - so it acts
                    // on this accumulator, not on the document. That is what
                    // makes a group a clipping scope for its adjustments.
                    wynimg::brightness(out, layer.adjust_amount(i))
                } else {
                    if k == layer.KIND_GROUP() {
                        // Recurse, then blend the finished sub-stack as one layer.
                        var sub = compose_group(i, w, h, depth + 1)
                        if sub != 0 {
                            wynimg::composite(out, sub, layer.mask(i),
                                              layer.blend_mode(i), layer.opacity(i))
                            wynimg::free(sub)
                        }
                    } else {
                        var buf = layer.buffer(i)
                        if buf != 0 {
                            wynimg::composite(out, buf, layer.mask(i),
                                              layer.blend_mode(i), layer.opacity(i))
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

pub fn compose(w: int, h: int) -> int {
    // The document is the top-level "group": every layer with no parent.
    return compose_group(0 - 1, w, h, 0)
}

// Composites and writes the result to `path`. Returns 1 on success.
pub fn compose_to_png(w: int, h: int, path: string) -> int {
    var out = compose(w, h)
    if out == 0 { return 0 }
    var ok = wynimg::save_png(out, path)
    wynimg::free(out)
    return ok
}
