// history - undo/redo as command records.
//
// Each entry stores the operation, the target layer, and both the old and new
// value. Full-canvas snapshots would cost ~768MB per step for a 12MP document,
// so nothing here copies pixels.
//
// `h_pos` is the number of applied entries. Undo decrements it and reapplies
// the old value; redo increments and reapplies the new one. Recording a fresh
// action truncates anything above `h_pos`, discarding the redo branch.
//
// Parallel arrays, like src/layer.wyn: one column per field, so no accessor
// ever returns a struct across a module boundary (known v1.20.0 miscompile).
// A record is 6 scalars regardless of canvas size -- that invariant is the
// whole point, and "recording is O(1) in canvas size" in tests/test_history.wyn
// guards it.
//
// CALL CONVENTION: every function here is a `pub fn` or a module-private `fn`,
// so importers call them QUALIFIED (`history.undo()`). See src/pixel.wyn.
// This file is also symlinked at the project root as ./history.wyn, because
// `import history` from tests/ does not search src/. See the wyn compiler's issue tracker.

import layer

var h_op = [0]
var h_layer = [0]
var h_old_f = [0.0]
var h_new_f = [0.0]
var h_old_i = [0]
var h_new_i = [0]
var h_len = 0
var h_pos = 0

fn OP_OPACITY() -> int { return 0 }
fn OP_BLEND() -> int { return 1 }
fn OP_VISIBLE() -> int { return 2 }

pub fn history_new() -> int {
    h_len = 0
    h_pos = 0
    return 0
}

// Empties the log AND frees the snapshot buffers it owned. Declared here next to
// history_new but implemented below, where discard_above is in scope.
//
// WHY BOTH EXIST. `history_new` resets the counters, which is what a test that
// starts a fresh scenario wants and what src/server.wyn's demo scene wants: the
// buffers in the log at that moment are all still reachable through the layer
// store. Replacing the DOCUMENT (opening a file) is the other case, and there
// the log is the only remaining reference to every OP_PIXELS snapshot - two
// full-canvas float32 buffers per recorded stroke, 8MB a step on a 256x256
// document. Resetting the counters alone would strand all of them.
pub fn history_reset() -> int {
    discard_above(0)
    h_len = 0
    h_pos = 0
    return 0
}

pub fn depth() -> int { return h_len }
pub fn can_undo() -> bool { return h_pos > 0 }
pub fn can_redo() -> bool { return h_pos < h_len }

// EVERY record goes through push_ex -> push_full, including the three scalar
// ones. That is not indirection for its own sake: the entry columns were later
// extended with h_a/h_b/h_s/h_k for the pixel and structural commands, and a
// second writer that appended to only the first six left the arrays at DIFFERENT
// LENGTHS.
//
// The failure was measured, not theorised: a script that clicked `b>` twice,
// `o-` twice, `dn`, `-L` and then Undo panicked with
// "array index out of bounds: index 5, length 2" - six scalar records had
// advanced h_len to 6 while h_a still held 2, so the first structural undo read
// off the end. A scalar-only session never touches h_a and never notices.
//
// One writer makes the TWELVE columns the same length by construction, which is
// the only version of this invariant that cannot rot - and it is why adding h_m
// for the delete record's mask, and later h_snap for a whole-document transform,
// were each a two-line change rather than an audit.
fn push(op: int, lid: int, of: float, nf: float, oi: int, ni: int) -> int {
    return push_ex(op, lid, of, nf, oi, ni, 0, 0, "", 0)
}

pub fn record_opacity(layer_id: int, old_v: float, new_v: float) -> int {
    return push(OP_OPACITY(), layer_id, old_v, new_v, 0, 0)
}

pub fn record_blend(layer_id: int, old_m: int, new_m: int) -> int {
    return push(OP_BLEND(), layer_id, 0.0, 0.0, old_m, new_m)
}

pub fn record_visible(layer_id: int, old_v: bool, new_v: bool) -> int {
    var oi = 0
    var ni = 0
    if old_v { oi = 1 }
    if new_v { ni = 1 }
    return push(OP_VISIBLE(), layer_id, 0.0, 0.0, oi, ni)
}

fn apply(i: int, use_new: bool) -> int {
    var op = h_op[i]
    var lid = h_layer[i]
    if op == OP_OPACITY() {
        if use_new { layer.set_opacity(lid, h_new_f[i]) }
        else { layer.set_opacity(lid, h_old_f[i]) }
        return 1
    }
    if op == OP_BLEND() {
        if use_new { layer.set_blend_mode(lid, h_new_i[i]) }
        else { layer.set_blend_mode(lid, h_old_i[i]) }
        return 1
    }
    if op == OP_VISIBLE() {
        var v = h_old_i[i]
        if use_new { v = h_new_i[i] }
        layer.set_visible(lid, v == 1)
        return 1
    }
    return 0
}

pub fn undo() -> int {
    if can_undo() == false { return 0 }
    h_pos = h_pos - 1
    return apply(h_pos, false)
}

pub fn redo() -> int {
    if can_redo() == false { return 0 }
    var r = apply(h_pos, true)
    h_pos = h_pos + 1
    return r
}

pub fn label(i: int) -> string {
    if i < 0 or i >= h_len { return "" }
    var op = h_op[i]
    if op == OP_OPACITY() { return "opacity" }
    if op == OP_BLEND() { return "blend mode" }
    if op == OP_VISIBLE() { return "visibility" }
    return "change"
}

// ---- pixel and structural commands ----------------------------------------
//
// WHY A PAINT STROKE IS TWO SNAPSHOTS AND NOT A PARAMETER PAIR.
//
// Everything above records a scalar old/new pair, which is why "recording is
// O(1) in canvas size" holds. A brush stroke has no such representation: the
// operation IS pixels. So OP_PIXELS stores two buffer HANDLES - the layer as it
// was before the stroke and as it is after - and undo/redo copies one of them
// back into the live buffer with wynimg_copy_into.
//
// COPY, NOT SWAP. The layer's buffer handle is also held by the texture
// upload path and can be referenced as another layer's mask, so replacing the
// handle would leave those pointing at the pre-undo pixels. Copying keeps one
// buffer identity for the life of the layer and moves only the contents.
//
// THE COST IS NAMED, NOT HIDDEN. Two float32 RGBA snapshots per stroke is
// 32 bytes per pixel per undo step - 8MB per step on a 256K-pixel document,
// 400MB on a 12MP one. That is the price of pixel undo without tiling; a real
// editor stores only the stroke's dirty rectangle, which is exactly what
// WYNIMG_TILE is reserved for. What is NOT acceptable is leaking them, so
// truncating the redo branch frees the snapshots it discards (see `discard`).
//
// STRUCTURAL COMMANDS carry a name and a buffer handle so that undoing a delete
// restores the same pixels, not an empty layer. That is why layer.remove does
// not free the buffer: between the delete and its undo, history owns it.

import pixel
import docsnap

fn OP_PIXELS() -> int { return 3 }
fn OP_ADD_LAYER() -> int { return 4 }
fn OP_DEL_LAYER() -> int { return 5 }
fn OP_SWAP() -> int { return 6 }
fn OP_NAME() -> int { return 7 }

// A WHOLE-DOCUMENT TRANSFORM: rotate 90, crop, scale, canvas resize.
//
// WHY THIS IS NOT OP_PIXELS WITH MORE COLUMNS - the one case where a new opcode is
// right, having argued twice above that it usually is not (see record_pixels_as).
//
// OP_PIXELS restores with wynimg_copy_into, which REQUIRES the source and
// destination to be the same size, and it owns exactly two handles. A
// size-changing transform breaks both halves at once: it changes the size of EVERY
// layer, so the record owns N buffers and N masks, and it cannot restore by
// copying because there is nothing of the right size to copy into. There is no
// version of OP_PIXELS that covers it - the difference is in the arithmetic, not
// in the label, which is exactly the test record_pixels_as's note sets for
// deserving an opcode.
//
// The record is one snapshot id (src/docsnap.wyn) in ONE new column plus the
// document's size, and undo is a SWAP: the snapshot holds whichever side is not on
// the document, so undo and redo are the identical exchange - the shape OP_SWAP
// already uses.
fn OP_DOC_XFORM() -> int { return 8 }

// Extra columns. Parallel arrays again, one per field: `h_a`/`h_b` are buffer
// handles for OP_PIXELS and OP_DEL_LAYER/OP_ADD_LAYER, `h_s` is the layer name,
// `h_k` the layer kind, `h_m` the layer's MASK handle.
//
// h_m IS THE ELEVENTH COLUMN, and it is a column rather than a reuse of h_b for
// the reason the old comment on record_del_layer stated: h_b is OP_PIXELS's
// "after" snapshot, and `discard_above` FREES that. A mask parked in h_b would be
// freed out from under the live layer the moment the redo branch was truncated -
// a silently blank mask, which is exactly the class of bug the handle table's
// generation tagging turns from a crash into an invisible one.
var h_a = [0]
var h_b = [0]
var h_s = [""]
var h_k = [0]
var h_m = [0]

// THE TWELFTH COLUMN: the docsnap id of a whole-document transform's parked
// buffers, 0 for every other op.
//
// A COLUMN, not a reuse of h_a, for the same reason h_m was not a reuse of h_b.
// h_a is OP_PIXELS's "before" snapshot and a raw wynimg handle that
// `discard_above` frees with wynimg_free; a docsnap id is not a wynimg handle at
// all, and freeing one as if it were would either be a no-op that leaked N layer
// buffers or - if the integers happened to collide - free an unrelated live
// buffer. The two namespaces must not share a column.
//
// The document SIZE rides in the columns this op does not use: h_old_i/h_new_i are
// the width before/after and h_old_f/h_new_f the height before/after. Undo needs
// both sides because the size is not recoverable from the buffers alone once they
// have been swapped out - and it is `float` for the height only because that is
// which column was free, which is stated here rather than left to look
// intentional. Widths and heights are small integers, exactly representable.
var h_snap = [0]

fn push_ex(op: int, lid: int, of: float, nf: float, oi: int, ni: int,
           a: int, b: int, s: string, k: int) -> int {
    return push_full(op, lid, of, nf, oi, ni, a, b, s, k, 0)
}

// push_full delegates to push_all for the same reason `push` delegates to push_ex
// and push_ex to push_full: the columns have now been extended TWICE (h_m for a
// delete's mask, h_snap for a whole-document transform), and each time the
// delegation chain meant the existing callers did not have to be audited. Adding a
// parameter to the one writer and letting every other entry point pass the default
// is a two-line change; a second append site is the bug below.
fn push_full(op: int, lid: int, of: float, nf: float, oi: int, ni: int,
             a: int, b: int, s: string, k: int, m: int) -> int {
    return push_all(op, lid, of, nf, oi, ni, a, b, s, k, m, 0)
}

// THE ONE WRITER - now of TWELVE columns.
//
// The columns were extended once before and a second writer left them at DIFFERENT
// LENGTHS, which crashed the first structural undo of any session that had only
// made scalar edits ("array index out of bounds: index 5, length 2"). Twelve
// columns stay the same length because exactly one function appends. h_snap was
// added by editing this function and nothing else, which is the property being
// preserved: every other entry point reaches here and cannot skip a column.
fn push_all(op: int, lid: int, of: float, nf: float, oi: int, ni: int,
            a: int, b: int, s: string, k: int, m: int, snap: int) -> int {
    // Free any snapshot the discarded redo branch owned. Without this every
    // "paint, undo, paint again" leaks a full-canvas float buffer.
    discard_above(h_pos)
    h_len = h_pos
    if h_len < h_op.len() {
        h_op[h_len] = op
        h_layer[h_len] = lid
        h_old_f[h_len] = of
        h_new_f[h_len] = nf
        h_old_i[h_len] = oi
        h_new_i[h_len] = ni
    } else {
        h_op.push(op)
        h_layer.push(lid)
        h_old_f.push(of)
        h_new_f.push(nf)
        h_old_i.push(oi)
        h_new_i.push(ni)
    }
    if h_len < h_a.len() {
        h_a[h_len] = a
        h_b[h_len] = b
        h_s[h_len] = s
        h_k[h_len] = k
        h_m[h_len] = m
    } else {
        h_a.push(a)
        h_b.push(b)
        h_s.push(s)
        h_k.push(k)
        h_m.push(m)
    }
    // h_snap gets its OWN length check rather than riding the h_a branch above.
    // The two are the same length in every reachable state, but "in every
    // reachable state" is precisely the assumption that broke last time; a column
    // that checks its own length cannot be desynchronised by a future column being
    // added to the wrong branch.
    if h_len < h_snap.len() {
        h_snap[h_len] = snap
    } else {
        h_snap.push(snap)
    }
    h_len = h_len + 1
    h_pos = h_len
    return h_len
}

// Frees the snapshot buffers owned by entries at or above `from`, which are
// about to become unreachable. Only OP_PIXELS owns buffers outright; a
// structural entry's handle is either live in the layer store (add) or is the
// only surviving reference to a deleted layer's pixels (delete), and freeing
// either would be wrong - so this frees snapshots and nothing else.
//
// h_m (the delete record's mask) is NEVER freed here for exactly that reason,
// and it is why the mask needed its own column rather than a seat in h_b: h_b is
// freed two lines below.
//
// OP_DOC_XFORM's SNAPSHOT IS FREED, and it is the second thing that owns buffers
// outright. Its docsnap holds the N layer buffers and N masks that are NOT on the
// document, so once the entry is unreachable nothing else references them - the
// same position OP_PIXELS's two snapshots are in, and the leak is N full-canvas
// layers per discarded step instead of 2. `docsnap.discard` frees them and marks
// the id dead; zeroing the column afterwards means a double discard of the same
// entry cannot reach it twice even if the log is reset after a truncation.
fn discard_above(start: int) -> int {
    var i = start
    var n = 0
    while i < h_len {
        if h_op[i] == OP_PIXELS() {
            if i < h_a.len() {
                wynimg::free(h_a[i])
                wynimg::free(h_b[i])
                h_a[i] = 0
                h_b[i] = 0
                n = n + 1
            }
        }
        if h_op[i] == OP_DOC_XFORM() {
            if i < h_snap.len() {
                if h_snap[i] != 0 {
                    docsnap.discard(h_snap[i])
                    h_snap[i] = 0
                    n = n + 1
                }
            }
        }
        i = i + 1
    }
    return n
}

// `before` and `after` must be clones (wynimg_clone) of the layer buffer taken
// either side of the stroke. History takes ownership of both.
pub fn record_pixels(layer_id: int, before: int, after: int) -> int {
    return push_ex(OP_PIXELS(), layer_id, 0.0, 0.0, 0, 0, before, after, "", 0)
}

// THE SAME RECORD, WITH THE OPERATION'S OWN NAME - and this is why a filter and
// a text commit do NOT get their own opcodes.
//
// A filter over a selection, and a text block committed through the brush
// kernel, are both "these pixels of this layer were replaced". There is no
// smaller honest representation: a gaussian blur is not invertible (energy is
// genuinely lost at the borders and in the interior average), and a text commit
// is a coverage-weighted blend whose inverse would need the coverage kept
// forever. So the before/after pair IS the operation, exactly as it is for a
// brush stroke, and reusing OP_PIXELS means undo, redo, the leak-free redo-branch
// truncation in `discard_above`, and the copy-not-swap rule are all inherited
// rather than re-derived per feature. A fifth opcode with an identical `apply`
// body would be the version that eventually drifts.
//
// Only the LABEL differs, and it rides in the string column OP_PIXELS does not
// use - so the status bar can say "undo blur" instead of "undo paint", which is
// the difference between a user knowing what Undo will do and guessing.
pub fn record_pixels_as(layer_id: int, before: int, after: int,
                        what: string) -> int {
    return push_ex(OP_PIXELS(), layer_id, 0.0, 0.0, 0, 0, before, after, what, 0)
}

pub fn record_add_layer(pos: int, name: string, buf: int, kind: int) -> int {
    return push_ex(OP_ADD_LAYER(), pos, 0.0, 0.0, 0, 0, buf, 0, name, kind)
}

// A DELETE MUST CAPTURE THE LAYER'S PROPERTIES, NOT JUST ITS PIXELS.
//
// Measured: deleting a layer that was `overlay` at 60% opacity and then undoing
// restored it as `normal` at 100%. The buffer came back, so the image looked
// nearly right and the layer row read plausibly - which is precisely why it is
// worth a record rather than a comment. Real, silent data loss.
//
// The properties ride in the columns the scalar ops use and this op does not:
// h_new_f is the opacity, h_new_i the blend mode, h_old_i the visibility. Undo of
// a delete is an insert followed by restoring those three.
//
// THE MASK IS CAPTURED TOO, in h_m - the eleventh column.
//
// It used to be dropped, and the note here said so honestly: there was no column
// left, and parking the handle in h_b (OP_PIXELS's "after" snapshot) would have
// let `discard_above` free a live mask. The fix is the column, not a cleverer
// encoding, and it is read out of the LAYER rather than passed in, so a caller
// cannot delete a masked layer and forget to hand the mask over - the one way
// this could silently regress.
//
// Ownership matches the buffer exactly: layer.remove drops the row without
// freeing either handle, so between the delete and its undo the ONLY reference to
// both is this record. discard_above therefore frees neither (see its note).
pub fn record_del_layer(pos: int, name: string, buf: int, kind: int) -> int {
    var vis = 0
    if layer.visible(pos) { vis = 1 }
    return push_full(OP_DEL_LAYER(), pos, 0.0, layer.opacity(pos),
                     vis, layer.blend_mode(pos), buf, 0, name, kind,
                     layer.mask(pos))
}

pub fn record_swap(a: int, b: int) -> int {
    return push_ex(OP_SWAP(), a, 0.0, 0.0, a, b, 0, 0, "", 0)
}

// A rename needs TWO strings but there is one string column, so both ride in it
// as "old\nnew". The alternative - store only the old name and read the new one
// off the layer at undo time - breaks the second redo of a twice-renamed layer,
// because by then the layer holds the undone name. A newline cannot occur in a
// name typed into a single-line entry field, so the split is unambiguous.
pub fn record_name(layer_id: int, old_s: string, new_s: string) -> int {
    return push_ex(OP_NAME(), layer_id, 0.0, 0.0, 0, 0, 0, 0,
                   old_s + "\n" + new_s, 0)
}

// A WHOLE-DOCUMENT TRANSFORM. `snap` is a docsnap id holding the layer buffers and
// masks the transform DISPLACED (the "before" side), and ow/oh are the document
// size those buffers belong to; nw/nh are the size the document now has. History
// takes ownership of the snapshot and frees it via docsnap.discard - through
// `discard_above` when the redo branch is truncated, and through history_reset.
//
// THE CALLER MUST HAVE ALREADY INSTALLED THE NEW BUFFERS. This records a fait
// accompli, exactly as record_pixels does: the transform ran, the layers hold the
// new handles, the old ones are in the snapshot. Recording first and applying
// second would leave a window where a failed apply had a log entry for something
// that never happened, which is the one shape undo cannot recover from.
//
// `what` is the label, in the string column - "rotate 90", "crop", "scale" - so the
// status bar names which document transform Undo will reverse. A record with an
// invalid snapshot is REFUSED (0) rather than logged: an OP_DOC_XFORM whose undo
// cannot restore anything would silently drop the pre-transform document on the
// first Ctrl+Z, and a missing log entry is a recoverable annoyance where a
// corrupting one is not.
pub fn record_doc_xform(snap: int, ow: int, oh: int, nw: int, nh: int,
                        what: string) -> int {
    if docsnap.alive(snap) == false { return 0 }
    if ow <= 0 or oh <= 0 or nw <= 0 or nh <= 0 { return 0 }
    return push_all(OP_DOC_XFORM(), 0, oh.to_float(), nh.to_float(),
                    ow, nw, 0, 0, what, 0, 0, snap)
}

// The document size the LAST undo/redo left behind, published by the applier.
//
// WHY THE APPLIER PUBLISHES IT INSTEAD OF THE CALLER DERIVING IT. `h_pos` has
// already moved by the time a caller could look (undo_any decrements before
// applying, redo_any increments after), so "the entry at h_pos" means a different
// entry and a different END of it in each direction. A caller that gets that
// off-by-one wrong installs the correct picture at the wrong stated size - which
// does not fail here, it corrupts the texture on the NEXT refresh, when
// src/ui.wyn's refresh() compares g_doc_w against the texture it already made.
//
// The applier has no ambiguity: it knows `use_new`. So it writes the answer, and
// -1 means "the last undo/redo did not change the document size", which is every
// other opcode. Reset before each apply so a stale value cannot be read as a fresh
// one - the failure that would resize the document on an unrelated undo.
var h_doc_w = 0 - 1
var h_doc_h = 0 - 1

pub fn doc_w_now() -> int { return h_doc_w }
pub fn doc_h_now() -> int { return h_doc_h }

// Applies the non-scalar ops. Returns 1 if it handled `i`, 0 if not (in which
// case the scalar `apply` above owns it).
fn apply_ex(i: int, use_new: bool) -> int {
    var op = h_op[i]
    var lid = h_layer[i]
    if op == OP_PIXELS() {
        var live = layer.buffer(lid)
        if live == 0 { return 1 }
        var snap = h_a[i]
        if use_new { snap = h_b[i] }
        wynimg::copy_into(live, snap)
        return 1
    }
    if op == OP_ADD_LAYER() {
        if use_new {
            layer.insert(lid, h_s[i], h_a[i], h_k[i])
        } else {
            layer.remove(lid)
        }
        return 1
    }
    if op == OP_DEL_LAYER() {
        if use_new {
            // REDO of a delete must re-capture the mask, not assume the record
            // still holds it. Between the undo and the redo the layer is live and
            // the user can attach or replace its mask; a redo that put the old
            // handle back would resurrect a mask the layer no longer has, and the
            // one it does have would leak.
            if i < h_m.len() { h_m[i] = layer.mask(lid) }
            layer.remove(lid)
        } else {
            // Insert, then restore the properties the delete captured. Without
            // the second half, undoing the delete of an `overlay` layer at 60%
            // brought it back as `normal` at 100% - measured, and near-invisible
            // because the pixels were right. The MASK is the same class of loss
            // and was the last one outstanding: layer.insert always writes mask 0,
            // so the restore has to be explicit.
            layer.insert(lid, h_s[i], h_a[i], h_k[i])
            layer.set_opacity(lid, h_new_f[i])
            layer.set_blend_mode(lid, h_new_i[i])
            layer.set_visible(lid, h_old_i[i] == 1)
            if i < h_m.len() { layer.set_mask(lid, h_m[i]) }
        }
        return 1
    }
    if op == OP_SWAP() {
        // Symmetric: undo and redo are the same swap.
        layer.swap(h_old_i[i], h_new_i[i])
        return 1
    }
    if op == OP_NAME() {
        var parts = h_s[i].split("\n")
        if parts.len() < 2 { return 1 }
        if use_new { layer.set_name(lid, parts[1]) }
        else { layer.set_name(lid, parts[0]) }
        return 1
    }
    if op == OP_DOC_XFORM() {
        // SWAP, NOT COPY - the one place in this file that does. Everywhere else
        // undo copies pixels into the live buffer and keeps one buffer identity for
        // the life of the layer (see the OP_PIXELS note), because the handle is also
        // held by the texture upload path and can be a mask reference.
        //
        // That is impossible here and the reason is the whole opcode: the parked
        // buffers are a DIFFERENT SIZE, so there is nothing of the right size to
        // copy into. So the handles are exchanged, and the obligation the copy rule
        // was protecting moves to the caller: src/ui.wyn must rebuild the texture
        // and replace the selection after this returns, which it does by setting
        // g_doc_w/g_doc_h (refresh() recreates the texture when those change) and
        // calling select.init.
        //
        // UNDO AND REDO ARE THE IDENTICAL EXCHANGE, exactly as OP_SWAP's are: the
        // snapshot holds whichever side is not on the document, so applying it twice
        // returns to the start. `use_new` is therefore unused for the pixels and is
        // read only for the SIZE, which is not symmetric.
        var snap = 0
        if i < h_snap.len() { snap = h_snap[i] }
        if docsnap.alive(snap) == false {
            // A record whose snapshot is gone cannot restore anything. Refusing to
            // touch the layers is the only safe answer: half-swapping would leave
            // the document with buffers of two different sizes, which
            // wynimg_composite refuses layer by layer - a document that renders as
            // a partial picture with no error reported anywhere.
            return 1
        }
        var n = docsnap.count(snap)
        // The snapshot's slot count is the layer count it was taken at. A store that
        // has since gained or lost rows cannot be swapped row-for-row, and the
        // mismatch can only come from an undo log that skipped an entry - so refuse
        // rather than swap the rows that happen to line up.
        if n != layer.count() { return 1 }
        var j = 0
        while j < n {
            // Exchange the buffer, then the mask, one row at a time. set_buffer and
            // set_mask both hand back the displaced handle, which is what makes each
            // exchange two statements with no temporary that an early return could
            // drop.
            var parked_b = docsnap.buf_at(snap, j)
            var live_b = layer.set_buffer(j, parked_b)
            docsnap.set_buf(snap, j, live_b)

            var parked_m = docsnap.mask_at(snap, j)
            var live_m = layer.mask(j)
            layer.set_mask(j, parked_m)
            docsnap.set_mask(snap, j, live_m)
            j = j + 1
        }
        // The size the document must now have, and the size the snapshot's freshly
        // parked buffers belong to. These move together with the buffers or an undo
        // installs the right pixels at the wrong stated size.
        if use_new {
            h_doc_w = h_new_i[i]
            h_doc_h = h_new_f[i].to_int()
            docsnap.set_dims(snap, h_old_i[i], h_old_f[i].to_int())
        } else {
            h_doc_w = h_old_i[i]
            h_doc_h = h_old_f[i].to_int()
            docsnap.set_dims(snap, h_new_i[i], h_new_f[i].to_int())
        }
        return 1
    }
    return 0
}

// Undo/redo that also handle the non-scalar ops. The originals are left intact
// - tests/test_history.wyn asserts their exact behaviour - and these are what
// the UI calls.
// h_doc_w/h_doc_h are CLEARED FIRST, in both, so `doc_w_now()` describes the undo
// that just ran and never a previous one. Without this, undoing a rotate and then
// undoing an unrelated opacity change would leave the rotate's size published, and
// a UI that reads it after every undo would resize the document on the opacity
// undo - which is worse than the resize never working, because it corrupts a
// document that was correct.
pub fn undo_any() -> int {
    if can_undo() == false { return 0 }
    h_doc_w = 0 - 1
    h_doc_h = 0 - 1
    h_pos = h_pos - 1
    if apply_ex(h_pos, false) == 1 { return 1 }
    return apply(h_pos, false)
}

pub fn redo_any() -> int {
    if can_redo() == false { return 0 }
    h_doc_w = 0 - 1
    h_doc_h = 0 - 1
    var r = 0
    if apply_ex(h_pos, true) == 1 { r = 1 }
    else { r = apply(h_pos, true) }
    h_pos = h_pos + 1
    return r
}

pub fn label_any(i: int) -> string {
    if i < 0 or i >= h_len { return "" }
    var op = h_op[i]
    if op == OP_PIXELS() {
        // A named pixel op (a filter, a text commit) carries its own label in the
        // string column; a brush stroke leaves it "" and is called "paint".
        if i < h_s.len() {
            if h_s[i] != "" { return h_s[i] }
        }
        return "paint"
    }
    if op == OP_ADD_LAYER() { return "add layer" }
    if op == OP_DEL_LAYER() { return "delete layer" }
    if op == OP_SWAP() { return "reorder" }
    if op == OP_NAME() { return "rename" }
    if op == OP_DOC_XFORM() {
        // The operation's own name ("rotate 90", "crop", "scale"), like a named
        // pixel op. Without a case here the status bar says nothing at all for the
        // one command that changes the whole document - the point at which a user
        // most needs to be told what Undo is about to do.
        if i < h_s.len() {
            if h_s[i] != "" { return h_s[i] }
        }
        return "transform document"
    }
    return label(i)
}

// Label of the entry Undo would revert, and of the one Redo would reapply.
// A status bar that says "undo" tells you nothing; one that says "undo paint"
// tells you whether the last stroke was recorded at all.
pub fn undo_label() -> string {
    if can_undo() == false { return "" }
    return label_any(h_pos - 1)
}

pub fn redo_label() -> string {
    if can_redo() == false { return "" }
    return label_any(h_pos)
}
