// Wyn v1.5.0 Feature Showcase
// Beautiful syntax with complex functionality

// ============================================================================
// ENUMS WITH DATA - Modern type system
// ============================================================================

enum Result {
    Ok(int),
    Err(string)
}

enum Option {
    Some(int),
    None
}

enum Status {
    Active,
    Inactive,
    Error(string)
}

// ============================================================================
// GENERIC COLLECTIONS - HashMap<K,V>
// ============================================================================

fn create_scores() -> HashMap<string, int> {
    var scores: HashMap<string, int> = {}
    scores.insert("alice", 95)
    scores.insert("bob", 87)
    scores.insert("charlie", 92)
    return scores
}

// ============================================================================
// PATTERN MATCHING - Elegant control flow
// ============================================================================

fn handle_result(r: Result) -> int {
    var value = match r {
        Result_Ok(x) => x,
        Result_Err(msg) => 0
    }
    return value
}

fn check_option(opt: Option) -> int {
    var value = match opt {
        Option_Some(x) => x,
        Option_None() => -1
    }
    return value
}

// ============================================================================
// OPTION METHODS - Safe null handling
// ============================================================================

fn demo_option_methods() -> int {
    var some = Option_Some(42)
    var none = Option_None()
    
    print("Option methods:")
    print("  some.is_some() = ")
    print(some.is_some().to_string())
    
    print("  none.is_none() = ")
    print(none.is_none().to_string())
    
    print("  some.unwrap() = ")
    print(some.unwrap().to_string())
    
    print("  none.unwrap_or(99) = ")
    print(none.unwrap_or(99).to_string())
    
    return 0
}

// ============================================================================
// RESULT METHODS - Error handling
// ============================================================================

fn demo_result_methods() -> int {
    var ok = Result_Ok(100)
    var err = Result_Err("failed")
    
    print("Result methods:")
    print("  ok.is_ok() = ")
    print(ok.is_ok().to_string())
    
    print("  err.is_err() = ")
    print(err.is_err().to_string())
    
    print("  ok.unwrap() = ")
    print(ok.unwrap().to_string())
    
    print("  err.unwrap_or(0) = ")
    print(err.unwrap_or(0).to_string())
    
    return 0
}

// ============================================================================
// STRING FEATURES - Indexing and methods
// ============================================================================

fn demo_strings() -> int {
    var text = "Hello Wyn"
    
    print("String features:")
    print("  text = ")
    print(text)
    
    print("  text[0] = ")
    print(text[0])
    
    print("  text[6] = ")
    print(text[6])
    
    var words = text.split(" ")
    print("  words.len() = ")
    print(words.len().to_string())
    
    return 0
}

// ============================================================================
// HASHMAP FEATURES - Variable keys and indexing
// ============================================================================

fn demo_hashmap() -> int {
    var scores = create_scores()
    
    print("HashMap features:")
    print("  scores.len() = ")
    print(scores.len().to_string())
    
    print("  scores[\"alice\"] = ")
    print(scores["alice"].to_string())
    
    // Variable key!
    var key = "bob"
    print("  scores[key] where key=\"bob\" = ")
    print(scores[key].to_string())
    
    // Variable key assignment!
    scores[key] = 95
    print("  After scores[key] = 95: ")
    print(scores[key].to_string())
    
    print("  scores.contains(\"charlie\") = ")
    print(scores.contains("charlie").to_string())
    
    return 0
}

// ============================================================================
// BOOL METHODS - Type conversions
// ============================================================================

fn demo_bool() -> int {
    var flag = true
    
    print("Bool methods:")
    print("  true.to_string() = ")
    print(flag.to_string())
    
    print("  true.to_int() = ")
    print(flag.to_int().to_string())
    
    var no = false
    print("  false.to_int() = ")
    print(no.to_int().to_string())
    
    return 0
}

// ============================================================================
// TYPE INFERENCE - Automatic type propagation
// ============================================================================

fn demo_inference() -> int {
    print("Type inference:")
    
    // Type inferred from function return!
    var scores = create_scores()
    print("  var scores = create_scores()")
    print("  Type: HashMap<string, int> (inferred!)")
    print("  scores.insert(\"test\", 100) works!")
    scores.insert("test", 100)
    
    return 0
}

// ============================================================================
// MAIN - Complete demonstration
// ============================================================================

fn main() -> int {
    print("╔════════════════════════════════════════╗")
    print("║  Wyn v1.5.0 Feature Showcase          ║")
    print("║  Beautiful Syntax + Complex Code      ║")
    print("╚════════════════════════════════════════╝")
    print("")
    
    print("━━━ 1. Pattern Matching ━━━")
    var ok_result = Result_Ok(42)
    var val = handle_result(ok_result)
    print("Result_Ok(42) matched to: ")
    print(val.to_string())
    
    var some_opt = Option_Some(99)
    var opt_val = check_option(some_opt)
    print("Option_Some(99) matched to: ")
    print(opt_val.to_string())
    print("")
    
    print("━━━ 2. Option Methods ━━━")
    demo_option_methods()
    print("")
    
    print("━━━ 3. Result Methods ━━━")
    demo_result_methods()
    print("")
    
    print("━━━ 4. String Features ━━━")
    demo_strings()
    print("")
    
    print("━━━ 5. HashMap Features ━━━")
    demo_hashmap()
    print("")
    
    print("━━━ 6. Bool Methods ━━━")
    demo_bool()
    print("")
    
    print("━━━ 7. Type Inference ━━━")
    demo_inference()
    print("")
    
    print("╔════════════════════════════════════════╗")
    print("║  ✓ All v1.5.0 features working!       ║")
    print("║  ✓ Enums with data                    ║")
    print("║  ✓ Pattern matching                   ║")
    print("║  ✓ Generic collections                ║")
    print("║  ✓ Type inference                     ║")
    print("║  ✓ String indexing                    ║")
    print("║  ✓ Variable HashMap keys              ║")
    print("╚════════════════════════════════════════╝")
    
    return 0
}
