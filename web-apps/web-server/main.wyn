// Simple HTTP Web Server

fn build_html() -> string {
    var html = "<html><head><title>Wyn Server</title></head><body>";
    html = html.concat("<h1>Wyn Web Server</h1>");
    html = html.concat("<p>Powered by Wyn v1.4.0</p>");
    html = html.concat("</body></html>");
    return html;
}

fn build_response() -> string {
    var body = build_html();
    var response = "HTTP/1.1 200 OK\r\n";
    response = response.concat("Content-Type: text/html\r\n");
    response = response.concat("Content-Length: ");
    response = response.concat(body.len().to_string());
    response = response.concat("\r\n\r\n");
    response = response.concat(body);
    return response;
}

async fn serve_request(socket: int) -> int {
    var request = Net::recv(socket);
    if request.len() > 0 {
        print("Received request");
        var response = build_response();
        Net::send(socket, response);
    }
    Net::close(socket);
    return 1;
}

fn main() -> int {
    var port = 8080;
    print("=== Wyn Web Server ===");
    print("Port:", port);
    print("");
    
    var server = Net::listen(port);
    if server < 0 {
        print("Failed to start");
        return 1;
    }
    
    print("Server running!");
    print("Visit: http://localhost:8080");
    print("");
    
    // Serve 3 requests
    var count = 0;
    while count < 3 {
        print("Waiting for connection...");
        var handled = await serve_request(server);
        count = count + handled;
        print("Served:", count);
        Time::sleep(1);
    }
    
    Net::close(server);
    print("Server stopped");
    return 0;
}
