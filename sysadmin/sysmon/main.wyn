// sysmon — System monitor (htop-lite) written in Wyn
// Demonstrates: Terminal TUI, System.exec, string parsing, real-time updates
//
// Shows: CPU, memory, disk, top processes, load average
// Keys: q=quit, r=refresh, 1=processes, 2=disk, 3=network

fn repeat_str(ch: string, n: int) -> string {
    var out = ""
    for i in 0..n { out = out + ch }
    return out
}

fn progress_bar(pct: int, width: int) -> string {
    var filled = pct * width / 100
    if filled > width { filled = width }
    if filled < 0 { filled = 0 }
    var bar = "\x1b[32m"
    for i in 0..filled { bar = bar + "█" }
    bar = bar + "\x1b[90m"
    for i in filled..width { bar = bar + "░" }
    bar = bar + "\x1b[0m"
    return bar
}

fn draw_header(cols: int, row: int) {
    Terminal.move(row, 1)
    Terminal.write("\x1b[1;36m sysmon\x1b[0m — System Monitor")
    var right = "q:quit r:refresh 1:proc 2:disk 3:net "
    Terminal.move(row, cols - right.len())
    Terminal.write("\x1b[90m" + right + "\x1b[0m")
}

fn draw_cpu_section(cols: int, row: int) -> int {
    var r = row
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m CPU \x1b[0m")
    r = r + 1

    var ncpu = System.exec("sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 1").trim()
    var load = System.exec("uptime").trim()
    // Extract load average
    var load_idx = load.index_of("load average")
    if load_idx < 0 { load_idx = load.index_of("load averages") }
    var load_str = ""
    if load_idx >= 0 {
        load_str = load.substring(load_idx, load.len())
    }

    Terminal.move(r, 3)
    Terminal.write("Cores: " + ncpu + "  " + load_str)
    r = r + 1

    // Per-CPU usage via top snapshot
    var cpu_info = System.exec("ps -A -o %cpu | awk '{s+=$1} END {printf \"%.0f\", s}'").trim()
    var cpu_total = cpu_info.to_int()
    var ncpu_int = ncpu.to_int()
    if ncpu_int < 1 { ncpu_int = 1 }
    var cpu_pct = cpu_total / ncpu_int
    if cpu_pct > 100 { cpu_pct = 100 }

    Terminal.move(r, 3)
    var bar_width = cols - 25
    if bar_width > 50 { bar_width = 50 }
    Terminal.write("Total: [" + progress_bar(cpu_pct, bar_width) + "] " + cpu_pct.to_string() + "%")
    r = r + 1
    return r
}

fn draw_memory_section(cols: int, row: int) -> int {
    var r = row + 1
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m MEM \x1b[0m")
    r = r + 1

    // macOS memory via vm_stat
    var pagesize = System.exec("sysctl -n hw.pagesize 2>/dev/null || echo 4096").trim().to_int()
    var vm = System.exec("vm_stat 2>/dev/null")
    
    // Parse pages
    var free_pages = 0
    var active_pages = 0
    var inactive_pages = 0
    var wired_pages = 0
    var speculative_pages = 0

    // Simple parsing: find key lines
    var line_start = 0
    var vlen = vm.len()
    for idx in 0..vlen {
        if vm[idx] == "\n" {
            var line = vm.substring(line_start, idx).trim()
            line_start = idx + 1
            if line.contains("Pages free") {
                var colon = line.index_of(":")
                if colon > 0 {
                    var val = line.substring(colon + 1, line.len()).trim().replace(".", "")
                    free_pages = val.to_int()
                }
            }
            if line.contains("Pages active") {
                var colon = line.index_of(":")
                if colon > 0 {
                    var val = line.substring(colon + 1, line.len()).trim().replace(".", "")
                    active_pages = val.to_int()
                }
            }
            if line.contains("Pages inactive") {
                var colon = line.index_of(":")
                if colon > 0 {
                    var val = line.substring(colon + 1, line.len()).trim().replace(".", "")
                    inactive_pages = val.to_int()
                }
            }
            if line.contains("Pages wired") {
                var colon = line.index_of(":")
                if colon > 0 {
                    var val = line.substring(colon + 1, line.len()).trim().replace(".", "")
                    wired_pages = val.to_int()
                }
            }
            if line.contains("Pages speculative") {
                var colon = line.index_of(":")
                if colon > 0 {
                    var val = line.substring(colon + 1, line.len()).trim().replace(".", "")
                    speculative_pages = val.to_int()
                }
            }
        }
    }

    var total_pages = free_pages + active_pages + inactive_pages + wired_pages + speculative_pages
    var used_pages = active_pages + wired_pages
    var total_mb = total_pages * pagesize / 1048576
    var used_mb = used_pages * pagesize / 1048576
    var free_mb = total_mb - used_mb
    var pct = 0
    if total_mb > 0 { pct = used_mb * 100 / total_mb }

    var bar_width = cols - 25
    if bar_width > 50 { bar_width = 50 }
    Terminal.move(r, 3)
    Terminal.write("Used:  [" + progress_bar(pct, bar_width) + "] " + used_mb.to_string() + "/" + total_mb.to_string() + " MB")
    r = r + 1

    Terminal.move(r, 3)
    Terminal.write("\x1b[90mActive: " + (active_pages * pagesize / 1048576).to_string() + "MB  Wired: " + (wired_pages * pagesize / 1048576).to_string() + "MB  Free: " + free_mb.to_string() + "MB\x1b[0m")
    r = r + 1
    return r
}

fn draw_processes(cols: int, row: int, max_rows: int) -> int {
    var r = row + 1
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m TOP PROCESSES \x1b[0m")
    r = r + 1

    // Header
    Terminal.move(r, 3)
    Terminal.write("\x1b[1;37m" + "PID".pad_right(8, " ") + "CPU%".pad_right(8, " ") + "MEM%".pad_right(8, " ") + "RSS".pad_right(10, " ") + "COMMAND" + "\x1b[0m")
    r = r + 1

    var ps = System.exec("ps -eo pid,pcpu,pmem,rss,comm -r | head -" + (max_rows + 1).to_string())
    var line_start = 0
    var plen = ps.len()
    var line_num = 0
    for idx in 0..plen {
        if ps[idx] == "\n" {
            var line = ps.substring(line_start, idx)
            line_start = idx + 1
            line_num = line_num + 1
            if line_num == 1 { continue }
            if line_num > max_rows + 1 { continue }

            Terminal.move(r, 3)
            // Alternate row colors
            if line_num % 2 == 0 {
                Terminal.write("\x1b[90m" + line.trim() + "\x1b[0m")
            } else {
                Terminal.write(line.trim())
            }
            r = r + 1
        }
    }
    return r
}

fn draw_disk_view(cols: int, row: int, max_rows: int) -> int {
    var r = row + 1
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m DISK USAGE \x1b[0m")
    r = r + 1

    var df = System.exec("df -h | grep -v devfs | grep -v map")
    var line_start = 0
    var dlen = df.len()
    var line_num = 0
    for idx in 0..dlen {
        if df[idx] == "\n" {
            var line = df.substring(line_start, idx)
            line_start = idx + 1
            line_num = line_num + 1
            if line_num > max_rows { continue }

            Terminal.move(r, 3)
            if line_num == 1 {
                Terminal.write("\x1b[1;37m" + line.trim() + "\x1b[0m")
            } else {
                Terminal.write(line.trim())
            }
            r = r + 1
        }
    }
    return r
}

fn draw_network_view(cols: int, row: int, max_rows: int) -> int {
    var r = row + 1
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m NETWORK INTERFACES \x1b[0m")
    r = r + 1

    var net = System.exec("netstat -i 2>/dev/null | head -" + max_rows.to_string())
    var line_start = 0
    var nlen = net.len()
    var line_num = 0
    for idx in 0..nlen {
        if net[idx] == "\n" {
            var line = net.substring(line_start, idx)
            line_start = idx + 1
            line_num = line_num + 1
            if line_num > max_rows { continue }

            Terminal.move(r, 3)
            if line_num == 1 {
                Terminal.write("\x1b[1;37m" + line.trim() + "\x1b[0m")
            } else {
                Terminal.write(line.trim())
            }
            r = r + 1
        }
    }

    // Listening ports
    r = r + 1
    Terminal.move(r, 1)
    Terminal.write("\x1b[1;33m LISTENING PORTS \x1b[0m")
    r = r + 1
    var ports = System.exec("lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | head -15 || netstat -tlnp 2>/dev/null | head -15")
    line_start = 0
    var plen = ports.len()
    line_num = 0
    for idx in 0..plen {
        if ports[idx] == "\n" {
            var line = ports.substring(line_start, idx)
            line_start = idx + 1
            line_num = line_num + 1
            if line_num > 15 { continue }
            Terminal.move(r, 3)
            if line_num == 1 {
                Terminal.write("\x1b[1;37m" + line.trim() + "\x1b[0m")
            } else {
                Terminal.write(line.trim())
            }
            r = r + 1
        }
    }
    return r
}

fn draw_status(cols: int, rows: int, view: int, msg: string) {
    Terminal.move(rows, 1)
    var views = ""
    if view == 1 { views = "\x1b[1;7m PROC \x1b[0;32;40m DISK  NET " }
    if view == 2 { views = " PROC \x1b[1;7m DISK \x1b[0;32;40m NET " }
    if view == 3 { views = " PROC  DISK \x1b[1;7m NET \x1b[0;32;40m" }
    Terminal.write("\x1b[32;40m" + views)
    if msg.len() > 0 {
        var gap = cols - 20 - msg.len()
        if gap > 0 { Terminal.write(repeat_str(" ", gap)) }
        Terminal.write(msg)
    } else {
        Terminal.write(repeat_str(" ", cols - 20))
    }
    Terminal.write("\x1b[0m")
}

fn main() -> int {
    var cols = Terminal.cols()
    var rows = Terminal.rows()

    Terminal.raw_mode()
    Terminal.clear()

    var running = 1
    var view = 1
    var msg = ""

    // Initial draw
    draw_header(cols, 1)
    var next_row = draw_cpu_section(cols, 2)
    next_row = draw_memory_section(cols, next_row)
    var remaining = rows - next_row - 2
    if remaining < 5 { remaining = 5 }
    if view == 1 { draw_processes(cols, next_row, remaining) }
    if view == 2 { draw_disk_view(cols, next_row, remaining) }
    if view == 3 { draw_network_view(cols, next_row, remaining) }
    draw_status(cols, rows, view, "Ready")

    while running == 1 {
        var key = Terminal.read_key()
        if key == 0 { continue }

        if key == 113 { running = 0 }

        if key == 114 {
            // r — refresh
            Terminal.clear()
            draw_header(cols, 1)
            next_row = draw_cpu_section(cols, 2)
            next_row = draw_memory_section(cols, next_row)
            remaining = rows - next_row - 2
            if remaining < 5 { remaining = 5 }
            if view == 1 { draw_processes(cols, next_row, remaining) }
            if view == 2 { draw_disk_view(cols, next_row, remaining) }
            if view == 3 { draw_network_view(cols, next_row, remaining) }
            msg = "Refreshed"
            draw_status(cols, rows, view, msg)
        }

        if key == 49 {
            view = 1
            Terminal.clear()
            draw_header(cols, 1)
            next_row = draw_cpu_section(cols, 2)
            next_row = draw_memory_section(cols, next_row)
            remaining = rows - next_row - 2
            if remaining < 5 { remaining = 5 }
            draw_processes(cols, next_row, remaining)
            draw_status(cols, rows, view, "Processes")
        }
        if key == 50 {
            view = 2
            Terminal.clear()
            draw_header(cols, 1)
            next_row = draw_cpu_section(cols, 2)
            next_row = draw_memory_section(cols, next_row)
            remaining = rows - next_row - 2
            if remaining < 5 { remaining = 5 }
            draw_disk_view(cols, next_row, remaining)
            draw_status(cols, rows, view, "Disk")
        }
        if key == 51 {
            view = 3
            Terminal.clear()
            draw_header(cols, 1)
            next_row = draw_cpu_section(cols, 2)
            next_row = draw_memory_section(cols, next_row)
            remaining = rows - next_row - 2
            if remaining < 5 { remaining = 5 }
            draw_network_view(cols, next_row, remaining)
            draw_status(cols, rows, view, "Network")
        }
    }

    Terminal.restore()
    Terminal.clear()
    println("sysmon exited.")
    return 0
}
