// httpcheck -- HTTP endpoint health checker
// Demonstrates: structs, string interpolation, System.exec
// Non-interactive: prints and exits

fn status_icon(code: int) -> string {
    if code >= 200 && code < 300 { return "\x1b[32m✓\x1b[0m" }
    if code >= 300 && code < 400 { return "\x1b[33m→\x1b[0m" }
    return "\x1b[31m✗\x1b[0m"
}

fn check(url: string, label: string) -> int {
    var code_str = System.exec("curl -s -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 3 '${url}' 2>/dev/null").trim()
    var code = code_str.to_int()
    var time_str = System.exec("curl -s -o /dev/null -w '%{time_total}' --connect-timeout 2 --max-time 3 '${url}' 2>/dev/null").trim()
    var icon = status_icon(code)
    var cs = code.to_string()
    if code == 0 { cs = "---" }
    println("  ${label.pad_right(22, " ")}${icon}       ${cs.pad_right(6, " ")}${time_str}s")
    return code
}

fn main() {
    println("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    println("\x1b[1;36m║\x1b[0m           \x1b[1mhttpcheck\x1b[0m -- HTTP Health Checker                  \x1b[1;36m║\x1b[0m")
    println("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    println("")

    println("  ${"Endpoint".pad_right(22, " ")}Status  Code  Time")
    println("  ${"────────────────────".pad_right(22, " ")}──────  ────  ────")

    var up = 0
    var down = 0

    var c1 = check("https://example.com", "example.com")
    if c1 >= 200 && c1 < 400 { up += 1 } else { down += 1 }

    var c2 = check("https://httpbin.org/status/200", "httpbin 200")
    if c2 >= 200 && c2 < 400 { up += 1 } else { down += 1 }

    var c3 = check("https://httpbin.org/status/404", "httpbin 404")
    if c3 >= 200 && c3 < 400 { up += 1 } else { down += 1 }

    var c4 = check("http://localhost:8080", "localhost:8080")
    if c4 >= 200 && c4 < 400 { up += 1 } else { down += 1 }

    println("")
    println("  \x1b[32m● Up: ${up}\x1b[0m  \x1b[31m● Down: ${down}\x1b[0m")
    println("")
}
