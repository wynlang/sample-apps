// httpcheck — HTTP endpoint health checker
// Demonstrates: System.exec (curl), string parsing, status reporting
// Non-interactive: prints and exits

fn check_url(url: string) -> int {
    var result = System.exec("curl -s -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 5 '" + url + "' 2>/dev/null")
    return result.trim().to_int()
}

fn check_time(url: string) -> string {
    var result = System.exec("curl -s -o /dev/null -w '%{time_total}' --connect-timeout 3 --max-time 5 '" + url + "' 2>/dev/null")
    return result.trim()
}

fn status_icon(code: int) -> string {
    if code >= 200 {
        if code < 300 { return "\x1b[32m✓\x1b[0m" }
    }
    if code >= 300 {
        if code < 400 { return "\x1b[33m→\x1b[0m" }
    }
    if code == 0 { return "\x1b[31m✗\x1b[0m" }
    return "\x1b[31m✗\x1b[0m"
}

fn main() -> int {
    println("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    println("\x1b[1;36m║\x1b[0m           \x1b[1mhttpcheck\x1b[0m — HTTP Health Checker                   \x1b[1;36m║\x1b[0m")
    println("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    println("")

    var urls = [
        "https://httpbin.org/status/200",
        "https://httpbin.org/status/404",
        "https://httpbin.org/delay/1",
        "https://example.com",
        "https://aws.amazon.com",
        "https://this-does-not-exist-xyz.com",
        "http://localhost:8080",
        "http://localhost:3000"
    ]
    var labels = [
        "httpbin 200",
        "httpbin 404",
        "httpbin delay",
        "example.com",
        "aws.amazon.com",
        "nonexistent.com",
        "localhost:8080",
        "localhost:3000"
    ]

    println("  " + "Endpoint".pad_right(22, " ") + "Status  Code  Time")
    println("  " + "────────────────────".pad_right(22, " ") + "──────  ────  ────")

    var up = 0
    var down = 0

    for i in 0..8 {
        var url = urls[i]
        var label = labels[i]
        var code = check_url(url)
        var time_s = check_time(url)
        var icon = status_icon(code)

        var code_str = code.to_string()
        if code == 0 { code_str = "---" }

        println("  " + label.pad_right(22, " ") + icon + "       " + code_str.pad_right(6, " ") + time_s + "s")

        if code >= 200 {
            if code < 400 { up = up + 1 }
            else { down = down + 1 }
        } else {
            down = down + 1
        }
    }

    println("")
    println("  \x1b[32m● Up: " + up.to_string() + "\x1b[0m  \x1b[31m● Down: " + down.to_string() + "\x1b[0m")
    println("")

    return 0
}
