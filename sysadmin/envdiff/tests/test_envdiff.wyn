// Tests for envdiff's diff core. These mirror src/main.wyn's classify/redact rules:
// the old app had no tests because it had no logic worth testing -- it printed a
// hardcoded list. The three things that can now be wrong are (a) which bucket a key
// lands in, (b) whether a secret leaks, (c) whether KEY=VALUE parsing loses a key.

enum Change { Added, Removed, Changed, Same }

fn classify(in_base: bool, in_now: bool, was: string, is_now: string) -> Change {
    if not in_base { return Change.Added }
    if not in_now { return Change.Removed }
    if was != is_now { return Change.Changed }
    return Change.Same
}

fn secret(key: string) -> bool {
    var k = key.upper()
    return k.contains("KEY") or k.contains("TOKEN") or k.contains("SECRET") or k.contains("PASSWORD") or k.contains("PASSWD")
}

fn count_keys(text: string) -> int {
    var n = 0
    for raw in text.lines() {
        var line = "" + raw
        if line.index_of("=") < 1 { continue }
        n += 1
    }
    return n
}

test "a key only in the live env is Added" {
    match classify(false, true, "", "x") {
        Added => assert(1 == 1)
        Removed => assert(1 == 0)
        Changed => assert(1 == 0)
        Same => assert(1 == 0)
    }
}

test "a key only in the baseline is Removed" {
    match classify(true, false, "x", "") {
        Removed => assert(1 == 1)
        Added => assert(1 == 0)
        Changed => assert(1 == 0)
        Same => assert(1 == 0)
    }
}

test "same key different value is Changed" {
    match classify(true, true, "us-east-1", "us-west-2") {
        Changed => assert(1 == 1)
        Added => assert(1 == 0)
        Removed => assert(1 == 0)
        Same => assert(1 == 0)
    }
}

test "identical value is Same" {
    match classify(true, true, "en_US.UTF-8", "en_US.UTF-8") {
        Same => assert(1 == 1)
        Added => assert(1 == 0)
        Removed => assert(1 == 0)
        Changed => assert(1 == 0)
    }
}

test "an empty value is Changed, not Removed" {
    // Present-but-empty is a real state and must not be confused with absent.
    match classify(true, true, "1", "") {
        Changed => assert(1 == 1)
        Removed => assert(1 == 0)
        Added => assert(1 == 0)
        Same => assert(1 == 0)
    }
}

test "secret-looking names are redacted" {
    assert(secret("API_TOKEN"))
    assert(secret("DB_PASSWORD"))
    assert(secret("SESSION_SECRET"))
    assert(secret("aws_access_key_id"))
    assert(secret("MYSQL_PASSWD"))
}

test "ordinary names are not redacted" {
    assert(not secret("HOME"))
    assert(not secret("PATH"))
    assert(not secret("AWS_REGION"))
}

test "every KEY=VALUE line is counted -- no off-by-one" {
    // The old app looped 0..26 over 27 keys and dropped the last one. Parsing is now
    // driven by the data, so the last line must survive.
    var text = "A=1\nB=2\nC=3\nD=4\nE=5"
    assert(count_keys(text) == 5)
}

test "lines with no = are skipped, not half-parsed" {
    var text = "A=1\ncontinuation of a multi-line value\nB=2\n\n=novalue"
    assert(count_keys(text) == 2)
}

test "a value containing = keeps only the first as the separator" {
    var line = "DATABASE_URL=postgres://u:p@h/db?a=1&b=2"
    var eq = line.index_of("=")
    assert(line.substring(0, eq) == "DATABASE_URL")
    assert(line.substring(eq + 1, line.len()) == "postgres://u:p@h/db?a=1&b=2")
}
