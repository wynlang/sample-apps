// servicemon — Service health monitor dashboard
// Demonstrates: System.exec, HashMap, Test framework, ANSI output
// Non-interactive: checks services and prints status

fn check_service(name: string, check_cmd: string) -> int {
    var code = System.exec_code(check_cmd)
    return code
}

fn status_line(name: string, cmd: string, desc: string) -> string {
    var code = check_service(name, cmd)
    var icon = ""
    if code == 0 {
        icon = "\x1b[32m● UP  \x1b[0m"
    } else {
        icon = "\x1b[31m● DOWN\x1b[0m"
    }
    return "  " + icon + "  " + name.pad_right(18, " ") + desc
}

fn main() {
    println("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    println("\x1b[1;36m║\x1b[0m          \x1b[1mservicemon\x1b[0m — Service Health Monitor                \x1b[1;36m║\x1b[0m")
    println("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    println("")

    // System services
    println("  \x1b[1;33m═══ System Services ═══\x1b[0m")
    println("")
    println(status_line("DNS", "host -W1 localhost >/dev/null 2>&1", "DNS resolution"))
    println(status_line("Internet", "ping -c1 -W1 8.8.8.8 >/dev/null 2>&1", "External connectivity"))
    println(status_line("Disk Space", "test $(df -Ph / | tail -1 | awk '{sub(/%/,\"\"); print $5}') -lt 95", "Root < 95% full"))
    println("")

    // Common dev services
    println("  \x1b[1;33m═══ Development Services ═══\x1b[0m")
    println("")
    println(status_line("SSH", "nc -z localhost 22 2>/dev/null", "SSH server"))
    println(status_line("HTTP :80", "nc -z localhost 80 2>/dev/null", "Web server"))
    println(status_line("HTTP :8080", "nc -z localhost 8080 2>/dev/null", "Dev server"))
    println(status_line("HTTP :3000", "nc -z localhost 3000 2>/dev/null", "Node/React"))
    println(status_line("MySQL", "nc -z localhost 3306 2>/dev/null", "MySQL/MariaDB"))
    println(status_line("PostgreSQL", "nc -z localhost 5432 2>/dev/null", "PostgreSQL"))
    println(status_line("Redis", "nc -z localhost 6379 2>/dev/null", "Redis cache"))
    println(status_line("MongoDB", "nc -z localhost 27017 2>/dev/null", "MongoDB"))
    println("")

    // Docker
    println("  \x1b[1;33m═══ Container Runtime ═══\x1b[0m")
    println("")
    var docker_running = System.exec_code("docker info >/dev/null 2>&1")
    if docker_running == 0 {
        println("  \x1b[32m● UP  \x1b[0m  Docker            Container runtime")
        var containers = System.exec("docker ps --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | head -10")
        if containers.len() > 0 {
            println("")
            println("  \x1b[1m  Container          Status              Ports\x1b[0m")
            var line_start = 0
            var clen = containers.len()
            for idx in 0..clen {
                if containers[idx] == "\n" {
                    var line = containers.substring(line_start, idx).trim()
                    line_start = idx + 1
                    if line.len() > 0 {
                        println("    " + line)
                    }
                }
            }
        }
    } else {
        println("  \x1b[31m● DOWN\x1b[0m  Docker            Not running")
    }

    // Git status
    println("")
    println("  \x1b[1;33m═══ Git ═══\x1b[0m")
    println("")
    var git_check = System.exec_code("git rev-parse --git-dir >/dev/null 2>&1")
    if git_check == 0 {
        var branch = System.exec("git branch --show-current 2>/dev/null").trim()
        var status = System.exec("git status --porcelain 2>/dev/null | wc -l").trim()
        println("  \x1b[32m●\x1b[0m Branch: \x1b[1m" + branch + "\x1b[0m  Changes: " + status)
    } else {
        println("  \x1b[90mNot a git repository\x1b[0m")
    }

    println("")
}
