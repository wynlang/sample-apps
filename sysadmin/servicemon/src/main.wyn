// servicemon -- Concurrent service health monitor
// Demonstrates: spawn + await_all for parallel health checks, structs, interpolation
// Non-interactive: checks all services concurrently and prints status
//
// The up/down rule, the section layout and the `docker ps` line handling live in
// src/health.wyn so they can be tested with nothing running -- see
// tests/test_health.wyn. This file keeps the probe commands and the printing.

import health

struct ServiceCheck { name: string, desc: string, up: int }

// One probe: an exit status. Spawned, so every caller's wait overlaps every other's.
fn probe(cmd: string) -> int => System.exec_code(cmd)

fn main() {
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    print("\x1b[1;36m║\x1b[0m          \x1b[1mservicemon\x1b[0m -- Concurrent Health Monitor              \x1b[1;36m║\x1b[0m")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    print("")

    var names = [
        "DNS", "Internet", "Disk Space",
        "SSH", "HTTP :80", "HTTP :8080", "HTTP :3000",
        "MySQL", "PostgreSQL", "Redis", "MongoDB", "Docker"
    ]
    // NOTE ON PORTABILITY: `host`, `ping -W1`, `df -Ph`, `nc -z` and `docker` are all
    // POSIX-shell probes. `ping -W1` means "wait 1 second" on macOS/BSD and "1 second
    // deadline" on Linux -- both bound the wait, which is all this needs. None of this
    // path exists on Windows, where there is no `nc` and no POSIX shell.
    var cmds = [
        "host -W1 localhost >/dev/null 2>&1",
        "ping -c1 -W1 8.8.8.8 >/dev/null 2>&1",
        "test $(df -Ph / | tail -1 | awk '{sub(/%/,\"\"); print $5}') -lt 95",
        "nc -z localhost 22 2>/dev/null",
        "nc -z localhost 80 2>/dev/null",
        "nc -z localhost 8080 2>/dev/null",
        "nc -z localhost 3000 2>/dev/null",
        "nc -z localhost 3306 2>/dev/null",
        "nc -z localhost 5432 2>/dev/null",
        "nc -z localhost 6379 2>/dev/null",
        "nc -z localhost 27017 2>/dev/null",
        "docker info >/dev/null 2>&1"
    ]
    var descs = [
        "DNS resolution", "External connectivity", "Root < 95% full",
        "SSH server", "Web server", "Dev server", "Node/React",
        "MySQL/MariaDB", "PostgreSQL", "Redis cache", "MongoDB", "Container runtime"
    ]
    var count = health.count()

    print("  Checking ${count} services concurrently...")

    // Every probe is in flight before any is read, and then AWAITED.
    //
    // The old version spawned twelve writes into a pre-filled results array and then
    // `Time.sleep(3000)` -- a guess. Two consequences, both observed: it could never
    // finish faster than 3 seconds, and a probe that had not landed yet printed as
    // "● DOWN" with an EMPTY NAME, indistinguishable from a service that really was down.
    // await_all cannot return early, so a row can no longer describe a check that has not
    // happened.
    var futures = []
    for i in 0..count { futures.push(spawn probe(cmds[i])) }
    var codes = await_all(futures)

    var results = []
    for i in 0..count {
        // `up:` is bound to a var first, deliberately. Computing an int struct field
        // INLINE from an exec-derived value silently yields 0 on the compiler in this
        // repo (see the note in sysadmin/httpcheck/src/main.wyn).
        var up = 0
        if health.is_up(codes[i]) { up = 1 }
        results.push(ServiceCheck { name: "" + names[i], desc: "" + descs[i], up: up })
    }

    // One walk over all twelve, with the heading emitted when the section changes. The
    // section boundaries come from health.section_of(), so the headings and the rows are
    // driven by the same rule instead of three hardcoded index ranges.
    var current = ""
    for i in 0..count {
        var sect = health.section_of(i)
        if sect != current {
            current = sect
            print("")
            print("  \x1b[1;33m${health.section_title(sect)}\x1b[0m")
            print("")
        }
        var r = results[i]
        var colour = "\x1b[31m"
        if r.up { colour = "\x1b[32m" }
        print("  ${colour}${health.badge(r.up == 1)}\x1b[0m  ${r.name.pad_right(12, " ")}${r.desc}")
    }

    // The running containers, if the runtime answered.
    if results[count - 1].up {
        var out = System.exec("docker ps --format '{{.Names}}\t{{.Status}}' 2>/dev/null | head -5")
        var n = health.container_count(out)
        if n > 0 {
            print("")
            for i in 0..n { print("    ${health.container_line(out, i)}") }
        }
    }

    var up_count = 0
    for i in 0..count { if results[i].up { up_count = up_count + 1 } }
    print("")
    print("  \x1b[32m● Up: ${up_count}\x1b[0m  \x1b[31m● Down: ${count - up_count}\x1b[0m")
    print("")
}
