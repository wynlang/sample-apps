// portscanner -- a concurrent port scanner in about 90 lines.
//
// Demonstrates, in the order they matter:
//   * `spawn` + `await_all` - every port is probed AT THE SAME TIME. Scanning 11 ports
//     sequentially means 11 network timeouts end to end; here the wall-clock cost is
//     one timeout, because the scans overlap. That is the whole reason to look at this
//     file.
//   * a struct RETURNED THROUGH A FUTURE - `spawn scan(p)` hands back a `Probe`, not an
//     int. This used to be impossible, and the workaround in this file was to encode
//     two values into one number as `port * 10 + open` and decode it at the other end.
//     A struct says what it means.
//   * `enum` + `match` - a port is Open, Closed or Filtered, and every place that turns
//     that into text is a match with no fallthrough. An `if` chain returning strings
//     cannot tell you it forgot a case; a match can.
//   * string interpolation, expression-bodied functions, and `for x in xs`.
//
//   wyn run sysadmin/portscanner/src/main.wyn            # a common set of ports
//   wyn run sysadmin/portscanner/src/main.wyn 22 80 443  # or name your own

// Open / Closed / Filtered rather than a bool, because they are three different
// answers: nothing listening, something refusing, and nothing replying at all. A
// scanner that collapses the last two tells you a firewalled port is closed, which is
// the one thing you wanted to know.
enum State { Open, Closed, Filtered }

// One probe's result. Returned THROUGH a future - see the note at the top.
struct Probe {
    port: int,
    state: State,
    ms: int
}

// Expression bodies: one line in, one line out, no `return` ceremony.
fn icon(s: State) -> string => match s {
    State.Open => "\x1b[32m●\x1b[0m",
    State.Closed => "\x1b[90m○\x1b[0m",
    State.Filtered => "\x1b[33m◐\x1b[0m"
}

fn label(s: State) -> string => match s {
    State.Open => "\x1b[32mOPEN\x1b[0m",
    State.Closed => "\x1b[90mclosed\x1b[0m",
    State.Filtered => "\x1b[33mfiltered\x1b[0m"
}

// A match, not an if-chain: adding a port means adding a line, and the compiler
// checks the `_` is still reachable.
fn service(port: int) -> string => match port {
    22 => "SSH",
    25 => "SMTP",
    53 => "DNS",
    80 => "HTTP",
    443 => "HTTPS",
    3000 => "Dev Server",
    3306 => "MySQL",
    5432 => "PostgreSQL",
    6379 => "Redis",
    8080 => "HTTP Alt",
    8443 => "HTTPS Alt",
    9090 => "Prometheus",
    27017 => "MongoDB",
    _ => "-"
}

// Probe one port. Runs on its own coroutine when spawned.
//
// `nc -z -w1` exits 0 when something accepts, 1 when the connection is refused, and
// times out when a firewall drops the packet - which is how the three states are told
// apart. The elapsed time distinguishes the last two: a refusal is immediate, a drop
// costs the full timeout.
fn probe(port: int) -> Probe {
    var t0 = Time.now_millis()
    var out = System.exec("nc -z -w1 localhost ${port} 2>/dev/null; echo $?")
    var elapsed = Time.now_millis() - t0

    // The exit status is the last line: `nc` may print to stdout first.
    var code = out.trim()
    var nl = code.last_index_of("\n")
    if nl >= 0 { code = code.substring(nl + 1, code.len()).trim() }

    if code == "0" { return Probe { port: port, state: State.Open, ms: elapsed } }
    // Slow AND refused means the packet was dropped rather than rejected.
    if elapsed >= 900 { return Probe { port: port, state: State.Filtered, ms: elapsed } }
    return Probe { port: port, state: State.Closed, ms: elapsed }
}

fn main() {
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    print("\x1b[1;36m║\x1b[0m           \x1b[1mportscanner\x1b[0m -- concurrent port scanner            \x1b[1;36m║\x1b[0m")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    print("")

    var ports = []
    args = System.args()
    for i in 1..args.len() {
        p = args[i].to_int()
        if p > 0 and p < 65536 { ports.push(p) }
        else { print("  skipping '${args[i]}': not a port number") }
    }
    if ports.len() == 0 {
        ports = [22, 80, 443, 3000, 3306, 5432, 6379, 8080, 8443, 9090, 27017]
    }

    print("  probing \x1b[1m${ports.len()}\x1b[0m ports on localhost, all at once...")
    print("")

    // THE PART WORTH READING. Every probe is launched before any is awaited, so the
    // timeouts overlap: the scan costs one timeout in wall-clock, not one per port.
    var t0 = Time.now_millis()
    var futures = []
    for p in ports { futures.push(spawn probe(p)) }
    var results = await_all(futures)
    var wall = Time.now_millis() - t0

    print("  ${"PORT".pad_right(9, " ")}${"SERVICE".pad_right(14, " ")}${"STATE".pad_right(12, " ")}TIME")
    print("  ${"────".pad_right(9, " ")}${"───────".pad_right(14, " ")}${"─────".pad_right(12, " ")}────")

    var open = 0
    var filtered = 0
    var slowest = 0
    for r in results {
        // A match on the enum instead of counting a bool, so the tally cannot drift
        // from what was printed.
        match r.state {
            State.Open => { open += 1 }
            State.Filtered => { filtered += 1 }
            State.Closed => { }
        }
        if r.ms > slowest { slowest = r.ms }
        var port_col = r.port.to_string().pad_right(9, " ")
        print("  ${port_col}${service(r.port).pad_right(14, " ")}${icon(r.state)} ${label(r.state)}".pad_right(60, " ") + "\x1b[90m${r.ms}ms\x1b[0m")
    }

    print("")
    print("  \x1b[1m${open}\x1b[0m open, ${filtered} filtered, ${results.len() - open - filtered} closed")
    // The concurrency payoff, measured rather than claimed: the whole scan takes about
    // as long as its slowest single probe, not the sum of them.
    print("  \x1b[90m${wall}ms total; slowest single probe ${slowest}ms")
    print("  sequential would have cost about the sum, not the max\x1b[0m")
    print("")
}
