// portscanner -- Concurrent port scanner using spawn + await_all
// Demonstrates: spawn, await_all, structs, string interpolation, for..in
// Non-interactive: prints and exits

fn port_name(port: int) -> string {
    if port == 22 { return "SSH" }
    if port == 80 { return "HTTP" }
    if port == 443 { return "HTTPS" }
    if port == 3000 { return "Dev Server" }
    if port == 3306 { return "MySQL" }
    if port == 5432 { return "PostgreSQL" }
    if port == 6379 { return "Redis" }
    if port == 8080 { return "HTTP Alt" }
    if port == 8443 { return "HTTPS Alt" }
    if port == 9090 { return "Prometheus" }
    if port == 27017 { return "MongoDB" }
    return "Unknown"
}

fn scan_port(port: int) -> int {
    var cmd = "nc -z -w1 localhost ${port} 2>/dev/null; echo $?"
    var result = System.exec(cmd).trim()
    var last_nl = result.last_index_of("\n")
    var exit_str = result
    if last_nl >= 0 {
        exit_str = result.substring(last_nl + 1, result.len()).trim()
    }
    // Encode port + status: port * 10 + (1 if open, 0 if closed)
    if exit_str == "0" { return port * 10 + 1 }
    return port * 10
}

fn main() {
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    print("\x1b[1;36m║\x1b[0m           \x1b[1mportscanner\x1b[0m -- Concurrent Port Scanner             \x1b[1;36m║\x1b[0m")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    print("")

    var ports = [22, 80, 443, 3000, 3306, 5432, 6379, 8080, 8443, 9090, 27017]
    var count = ports.len()

    print("  Scanning \x1b[1mlocalhost\x1b[0m (${count} ports concurrently)...")
    print("")

    // Spawn all port scans concurrently and await results
    var futures = []
    for i in 0..count {
        futures.push(spawn scan_port(ports[i]))
    }
    var results = await_all(futures)

    print("  ${"PORT".pad_right(8, " ")}${"SERVICE".pad_right(15, " ")}STATUS")
    print("  ${"────".pad_right(8, " ")}${"───────".pad_right(15, " ")}──────")

    var open_count = 0
    for i in 0..count {
        var encoded = results[i]
        var port = encoded / 10
        var is_open = encoded % 10
        var name = port_name(port)
        var status = "\x1b[90m○ closed\x1b[0m"
        if is_open == 1 {
            status = "\x1b[32m● OPEN\x1b[0m"
            open_count += 1
        }
        print("  ${port.to_string().pad_right(8, " ")}${name.pad_right(15, " ")}${status}")
    }

    print("")
    print("  \x1b[90mFound ${open_count} open port(s) on localhost\x1b[0m")
    print("")
}
