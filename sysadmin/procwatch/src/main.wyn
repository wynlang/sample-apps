// procwatch -- Process monitor with filtering and sorting
// Demonstrates: System.exec, string parsing, HashMap, formatted output
// Non-interactive: prints and exits

fn main() {
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    print("\x1b[1;36m║\x1b[0m           \x1b[1mprocwatch\x1b[0m -- Process Monitor                      \x1b[1;36m║\x1b[0m")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    print("")

    // Top CPU consumers
    print("  \x1b[1;33m═══ Top CPU Consumers ═══\x1b[0m")
    print("")
    print("  " + "PID".pad_right(8, " ") + "CPU%".pad_right(8, " ") + "MEM%".pad_right(8, " ") + "RSS(MB)".pad_right(10, " ") + "COMMAND")
    print("  " + "───".pad_right(8, " ") + "────".pad_right(8, " ") + "────".pad_right(8, " ") + "───────".pad_right(10, " ") + "───────")

    var ps_cpu = System.exec("ps -eo pid,pcpu,pmem,rss,comm -r | head -16")
    var line_start = 0
    var plen = ps_cpu.len()
    var line_num = 0
    for idx in 0..plen {
        if ps_cpu[idx] == "\n" {
            var line = ps_cpu.substring(line_start, idx).trim()
            line_start = idx + 1
            line_num += 1
            if line_num == 1 { continue }
            if line.len() == 0 { continue }

            // Parse fields
            var pid = line.split_at(" ", 0)
            var cpu = line.split_at(" ", 1)
            var mem = line.split_at(" ", 2)
            var rss_kb = line.split_at(" ", 3)
            var rss_mb = rss_kb.to_int() / 1024

            // Command: everything after 4th field
            var cmd = ""
            var field = 0
            var fstart = 0
            var flen = line.len()
            for fi in 0..flen {
                if line[fi] == " " {
                    if fi > fstart {
                        field += 1
                        if field == 4 {
                            cmd = line.substring(fi, flen).trim()
                        }
                    }
                    fstart = fi + 1
                }
            }
            // Shorten command path
            var slash = cmd.last_index_of("/")
            if slash >= 0 { cmd = cmd.substring(slash + 1, cmd.len()) }
            if cmd.len() > 30 { cmd = cmd.substring(0, 30) }

            // Color high CPU
            var cpu_val = cpu.to_int()
            var cpu_color = "\x1b[0m"
            if cpu_val > 50 { cpu_color = "\x1b[31m" }
            else { if cpu_val > 10 { cpu_color = "\x1b[33m" } }

            print("  " + pid.pad_right(8, " ") + cpu_color + cpu.pad_right(8, " ") + "\x1b[0m" + mem.pad_right(8, " ") + rss_mb.to_string().pad_right(10, " ") + cmd)
        }
    }

    // Top memory consumers
    print("")
    print("  \x1b[1;33m═══ Top Memory Consumers ═══\x1b[0m")
    print("")
    print("  " + "PID".pad_right(8, " ") + "MEM%".pad_right(8, " ") + "RSS(MB)".pad_right(10, " ") + "COMMAND")
    print("  " + "───".pad_right(8, " ") + "────".pad_right(8, " ") + "───────".pad_right(10, " ") + "───────")

    var ps_mem = System.exec("ps -eo pid,pmem,rss,comm -m | head -11")
    line_start = 0
    var mlen = ps_mem.len()
    line_num = 0
    for idx in 0..mlen {
        if ps_mem[idx] == "\n" {
            var line = ps_mem.substring(line_start, idx).trim()
            line_start = idx + 1
            line_num += 1
            if line_num == 1 { continue }
            if line.len() == 0 { continue }

            var pid = line.split_at(" ", 0)
            var mem = line.split_at(" ", 1)
            var rss_kb = line.split_at(" ", 2)
            var rss_mb = rss_kb.to_int() / 1024

            var cmd = ""
            var field = 0
            var fstart = 0
            var flen = line.len()
            for fi in 0..flen {
                if line[fi] == " " {
                    if fi > fstart {
                        field += 1
                        if field == 3 { cmd = line.substring(fi, flen).trim() }
                    }
                    fstart = fi + 1
                }
            }
            var slash = cmd.last_index_of("/")
            if slash >= 0 { cmd = cmd.substring(slash + 1, cmd.len()) }
            if cmd.len() > 35 { cmd = cmd.substring(0, 35) }

            print("  " + pid.pad_right(8, " ") + mem.pad_right(8, " ") + rss_mb.to_string().pad_right(10, " ") + cmd)
        }
    }

    // Process summary
    print("")
    print("  \x1b[1;33m═══ Summary ═══\x1b[0m")
    print("")
    var total = System.exec("ps -e | wc -l").trim()
    var running = System.exec("ps -eo state | grep -c R 2>/dev/null || echo ?").trim()
    var sleeping = System.exec("ps -eo state | grep -c S 2>/dev/null || echo ?").trim()
    print("  Total processes: " + total)
    print("  Running:         " + running)
    print("  Sleeping:        " + sleeping)
    print("")

}
