// gitdash -- Git repository dashboard
// Demonstrates: System.exec, global variables, string parsing, ANSI output
// Non-interactive: prints and exits

var branch = ""
var ahead = 0
var behind = 0
var staged = 0
var modified = 0
var untracked = 0

fn load_git_status() {
    branch = System.exec("git branch --show-current 2>/dev/null").trim()
    
    // Count file statuses
    var status = System.exec("git status --porcelain 2>/dev/null")
    var line_start = 0
    var slen = status.len()
    for idx in 0..slen {
        if status[idx] == "\n" {
            var line = status.substring(line_start, idx)
            line_start = idx + 1
            if line.len() < 2 { continue }
            var code = line.substring(0, 2)
            if code.contains("?") { untracked = untracked + 1 }
            else {
                if code[0] != " " { staged = staged + 1 }
                if code[1] != " " { modified = modified + 1 }
            }
        }
    }
    
    // Ahead/behind
    var ab = System.exec("git rev-list --left-right --count HEAD...@{upstream} 2>/dev/null").trim()
    if ab.len() > 0 {
        ahead = ab.split_at("\t", 0).to_int()
        behind = ab.split_at("\t", 1).to_int()
    }
}

fn print_section(title: string) {
    print("")
    print("  \x1b[1;33m═══ " + title + " ═══\x1b[0m")
    print("")
}

fn main() {
    print("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    print("\x1b[1;36m║\x1b[0m             \x1b[1mgitdash\x1b[0m -- Git Repository Dashboard              \x1b[1;36m║\x1b[0m")
    print("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")

    var is_git = System.exec_code("git rev-parse --git-dir >/dev/null 2>&1")
    if is_git != 0 {
        print("")
        print("  \x1b[31m✗ Not a git repository\x1b[0m")
        print("")
        return 1
    }

    load_git_status()

    // Branch info
    print_section("Branch")
    var branch_icon = "\x1b[32m●\x1b[0m"
    if modified > 0 { branch_icon = "\x1b[33m●\x1b[0m" }
    if staged > 0 { branch_icon = "\x1b[36m●\x1b[0m" }
    print("  " + branch_icon + " \x1b[1m" + branch + "\x1b[0m")
    
    if ahead > 0 { print("    \x1b[32m↑ " + ahead.to_string() + " ahead\x1b[0m") }
    if behind > 0 { print("    \x1b[31m↓ " + behind.to_string() + " behind\x1b[0m") }
    if ahead == 0 {
        if behind == 0 {
            print("    \x1b[90mUp to date with remote\x1b[0m")
        }
    }

    // Working tree
    print_section("Working Tree")
    var total_changes = staged + modified + untracked
    if total_changes == 0 {
        print("  \x1b[32m✓ Clean working tree\x1b[0m")
    } else {
        if staged > 0 { print("  \x1b[32m● Staged:    " + staged.to_string() + "\x1b[0m") }
        if modified > 0 { print("  \x1b[33m● Modified:  " + modified.to_string() + "\x1b[0m") }
        if untracked > 0 { print("  \x1b[31m● Untracked: " + untracked.to_string() + "\x1b[0m") }
    }

    // Recent commits
    print_section("Recent Commits")
    var git_log = System.exec("git log --oneline --decorate -10 2>/dev/null")
    var line_start = 0
    var llen = git_log.len()
    var line_num = 0
    for idx in 0..llen {
        if git_log[idx] == "\n" {
            var line = git_log.substring(line_start, idx).trim()
            line_start = idx + 1
            line_num += 1
            if line.len() == 0 { continue }
            if line_num == 1 {
                print("  \x1b[1m→ " + line + "\x1b[0m")
            } else {
                print("  \x1b[90m  " + line + "\x1b[0m")
            }
        }
    }

    // Stash
    var stash_count = System.exec("git stash list 2>/dev/null | wc -l").trim()
    if stash_count.to_int() > 0 {
        print_section("Stash")
        print("  " + stash_count + " stash entries")
    }

    // Remotes
    print_section("Remotes")
    var remotes = System.exec("git remote -v 2>/dev/null | head -4")
    var line_start2 = 0
    var rlen = remotes.len()
    for idx in 0..rlen {
        if remotes[idx] == "\n" {
            var line = remotes.substring(line_start2, idx).trim()
            line_start2 = idx + 1
            if line.len() > 0 {
                print("  " + line)
            }
        }
    }

    print("")
}
