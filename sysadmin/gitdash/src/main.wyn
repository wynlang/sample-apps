// gitdash -- a one-screen summary of a git repository: branch, divergence from
// upstream, working-tree state, and recent commits.
//
//   wyn run src/main.wyn            # the repository containing the current directory
//   wyn run src/main.wyn /some/repo # any other repository
//
// Unlike the rest of the sysadmin apps this one is portable without effort: `git` is the
// same program everywhere, and `--porcelain` is a documented machine-readable format that
// does not shift between versions or locales. So the interesting problem here is not
// capability detection -- it is parsing a format correctly, which is why all of that
// lives in porcelain.wyn under test.
//
// What the old version got wrong:
//
//   * It could not report a MERGE CONFLICT. Its rule was "if the code contains ? it is
//     untracked, else column 0 means staged and column 1 means modified", so a conflicted
//     file ("UU") was counted as staged *and* modified and the word "conflict" never
//     appeared -- for the one thing you most need a git dashboard to tell you.
//   * It showed a BLANK branch on a detached HEAD, because `git branch --show-current`
//     prints nothing there. The porcelain header always names something.
//   * It could not tell "no upstream configured" from "level with upstream": with no
//     upstream, both counts came back 0 and it printed "Up to date with remote".
//   * It counted status lines by scanning for "\n" one character at a time and taking a
//     2-char slice, so the LAST line was dropped whenever git's output had no trailing
//     newline, and a path containing a space could confuse the split.

import porcelain

fn heading(title: string) {
    print("")
    print("  \x1b[1;33m${title}\x1b[0m")
}

fn row(label: string, value: string) {
    print("    \x1b[90m${label.pad_right(10, " ")}\x1b[0m ${value}")
}

// One `git` invocation, in the requested directory. `-C` is how git is told where to
// work; `cd` in a `System.exec` would only affect the subshell and vanish with it (a
// mistake the old filebrowser actually shipped).
fn git(dir: string, args: string) -> string => System.exec("git -C '${dir}' ${args} 2>/dev/null")

fn main() {
    var args = System.args()
    var dir = "."
    if args.len() > 1 { dir = "" + args[1] }

    if not File.exists(dir) {
        print("  \x1b[31mno such directory\x1b[0m ${dir}")
        return
    }
    if System.exec_code("command -v git >/dev/null 2>&1") != 0 {
        print("  \x1b[31mgit is not installed\x1b[0m \x1b[90m-- nothing to report\x1b[0m")
        return
    }
    if System.exec_code("git -C '${dir}' rev-parse --git-dir >/dev/null 2>&1") != 0 {
        print("  \x1b[31mnot a git repository\x1b[0m \x1b[90m${dir}\x1b[0m")
        return
    }

    // -b adds the "## branch...upstream [ahead N, behind M]" header, so branch, upstream
    // and divergence all come from this ONE call -- and stay consistent with the file
    // list below, which is parsed from the same text.
    var status = git(dir, "status --porcelain -b")
    // NB: not named `root` -- that is a reserved word (as in `root::` imports) and using
    // it as a variable fails to parse, with an error that points at the wrong line.
    var top = git(dir, "rev-parse --show-toplevel").trim()
    if top.len() == 0 { top = dir }

    print("")
    print("  \x1b[1;36mgitdash\x1b[0m \x1b[90m${top}\x1b[0m")

    // ---- branch -------------------------------------------------------
    heading("Branch")
    var branch = porcelain.branch(status)
    if branch.len() == 0 { branch = "\x1b[33munknown\x1b[0m \x1b[90m(no porcelain header)\x1b[0m" }
    row("branch", "\x1b[1m${branch}\x1b[0m")

    var up = porcelain.upstream(status)
    if up.len() == 0 {
        // Distinct from "in sync": there is nothing to be in sync WITH.
        row("upstream", "\x1b[90mnone configured -- nothing to compare against\x1b[0m")
    } else {
        var ahead = porcelain.divergence(status, "ahead")
        var behind = porcelain.divergence(status, "behind")
        // NB: `else if` has to sit on the same line as the preceding `}` -- on its own
        // line the parser does not join it to the `if`.
        var state = "\x1b[32mlevel\x1b[0m"
        if ahead > 0 and behind > 0 { state = "\x1b[31m↑${ahead} ↓${behind} diverged\x1b[0m" } else if ahead > 0 { state = "\x1b[32m↑${ahead} ahead\x1b[0m" } else if behind > 0 { state = "\x1b[33m↓${behind} behind\x1b[0m" }
        row("upstream", "${up}  ${state}")
    }

    // ---- working tree -------------------------------------------------
    heading("Working tree")
    var conflicts = porcelain.count(status, porcelain.bucket_conflict())
    var staged = porcelain.count(status, porcelain.bucket_staged())
    var modified = porcelain.count(status, porcelain.bucket_modified())
    var untracked = porcelain.count(status, porcelain.bucket_untracked())

    if porcelain.count_changes(status) == 0 {
        row("state", "\x1b[32mclean\x1b[0m")
    } else {
        // Conflicts first, and loudly: they block everything else you might do.
        if conflicts > 0 { row("conflicts", "\x1b[1;31m${conflicts} -- resolve these first\x1b[0m") }
        if staged > 0 { row("staged", "\x1b[32m${staged}\x1b[0m") }
        if modified > 0 { row("modified", "\x1b[33m${modified}\x1b[0m") }
        if untracked > 0 { row("untracked", "\x1b[90m${untracked}\x1b[0m") }

        // The files themselves, conflicts before everything else.
        print("")
        var shown = 0
        for raw in status.lines() {
            var line = "" + raw
            if line.starts_with("##") { continue }
            if porcelain.classify(line) != porcelain.bucket_conflict() { continue }
            print("      \x1b[1;31mconflict\x1b[0m  ${porcelain.path(line)}")
            shown += 1
        }
        for raw2 in status.lines() {
            var line2 = "" + raw2
            if line2.starts_with("##") { continue }
            if shown >= 12 { continue }
            var b = porcelain.classify(line2)
            if b == porcelain.bucket_conflict() { continue }
            if b == porcelain.bucket_none() or b == porcelain.bucket_ignored() { continue }
            var mark = "\x1b[90m untracked\x1b[0m"
            if b == porcelain.bucket_staged() { mark = "\x1b[32m staged   \x1b[0m" }
            if b == porcelain.bucket_modified() { mark = "\x1b[33m modified \x1b[0m" }
            if b == porcelain.bucket_both() { mark = "\x1b[36m both     \x1b[0m" }
            print("      ${mark} ${porcelain.path(line2)}")
            shown += 1
        }
        var total = porcelain.count_changes(status)
        if total > shown { print("      \x1b[90m... and ${total - shown} more\x1b[0m") }
    }

    // ---- commits ------------------------------------------------------
    heading("Recent commits")
    var log = git(dir, "log --oneline --decorate -8")
    var commits = porcelain.log_count(log)
    if commits == 0 {
        // A repository with no commits yet is a normal state, not a failure.
        row("history", "\x1b[90mno commits yet\x1b[0m")
    } else {
        for i in 1..commits + 1 {
            var line = porcelain.log_line(log, i)
            if i == 1 { print("      \x1b[1m→ ${line}\x1b[0m") }
            else { print("      \x1b[90m  ${line}\x1b[0m") }
        }
    }

    // ---- stash --------------------------------------------------------
    var stash = porcelain.log_count(git(dir, "stash list"))
    if stash > 0 {
        heading("Stash")
        row("entries", "${stash}")
    }
    print("")
}
