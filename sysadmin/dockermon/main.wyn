// dockermon — Docker container monitor dashboard
// Demonstrates: System.exec, global variables, string parsing, ANSI output
// Non-interactive: prints and exits

var total_containers = 0
var running_containers = 0
var stopped_containers = 0

fn parse_docker_info() {
    var info = System.exec("docker info --format '{{.Containers}} {{.ContainersRunning}} {{.ContainersStopped}} {{.Images}}' 2>/dev/null").trim()
    if info.len() > 0 {
        total_containers = info.split_at(" ", 0).to_int()
        running_containers = info.split_at(" ", 1).to_int()
        stopped_containers = info.split_at(" ", 2).to_int()
    }
}

fn print_section(title: string) {
    println("")
    println("  \x1b[1;33m═══ " + title + " ═══\x1b[0m")
    println("")
}

fn main() {
    println("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    println("\x1b[1;36m║\x1b[0m           \x1b[1mdockermon\x1b[0m — Docker Container Monitor               \x1b[1;36m║\x1b[0m")
    println("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")

    // Check Docker availability
    var docker_ok = System.exec_code("docker info >/dev/null 2>&1")
    if docker_ok != 0 {
        println("")
        println("  \x1b[31m✗ Docker is not running or not installed\x1b[0m")
        println("")
        return 1
    }

    parse_docker_info()

    // Summary
    print_section("Overview")
    var images = System.exec("docker images --format '{{.ID}}' 2>/dev/null | wc -l").trim()
    var volumes = System.exec("docker volume ls -q 2>/dev/null | wc -l").trim()
    var networks = System.exec("docker network ls -q 2>/dev/null | wc -l").trim()

    println("  Containers: " + total_containers.to_string() + " total  \x1b[32m" + running_containers.to_string() + " running\x1b[0m  \x1b[31m" + stopped_containers.to_string() + " stopped\x1b[0m")
    println("  Images:     " + images)
    println("  Volumes:    " + volumes)
    println("  Networks:   " + networks)

    // Running containers
    print_section("Running Containers")
    var ps = System.exec("docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null")
    if ps.len() > 0 {
        var line_start = 0
        var plen = ps.len()
        var line_num = 0
        for idx in 0..plen {
            if ps[idx] == "\n" {
                var line = ps.substring(line_start, idx).trim()
                line_start = idx + 1
                line_num = line_num + 1
                if line.len() == 0 { continue }
                if line_num == 1 {
                    println("  \x1b[1;37m" + line + "\x1b[0m")
                } else {
                    println("  \x1b[32m●\x1b[0m " + line)
                }
            }
        }
    } else {
        println("  \x1b[90mNo running containers\x1b[0m")
    }

    // Stopped containers
    if stopped_containers > 0 {
        print_section("Stopped Containers")
        var stopped = System.exec("docker ps -f status=exited --format '{{.Names}}\t{{.Image}}\t{{.Status}}' 2>/dev/null | head -10")
        var line_start = 0
        var slen = stopped.len()
        for idx in 0..slen {
            if stopped[idx] == "\n" {
                var line = stopped.substring(line_start, idx).trim()
                line_start = idx + 1
                if line.len() > 0 {
                    println("  \x1b[31m●\x1b[0m " + line)
                }
            }
        }
    }

    // Disk usage
    print_section("Disk Usage")
    var disk = System.exec("docker system df --format 'table {{.Type}}\t{{.TotalCount}}\t{{.Size}}\t{{.Reclaimable}}' 2>/dev/null")
    if disk.len() > 0 {
        var line_start = 0
        var dlen = disk.len()
        var line_num = 0
        for idx in 0..dlen {
            if disk[idx] == "\n" {
                var line = disk.substring(line_start, idx).trim()
                line_start = idx + 1
                line_num = line_num + 1
                if line.len() == 0 { continue }
                if line_num == 1 {
                    println("  \x1b[1;37m" + line + "\x1b[0m")
                } else {
                    println("  " + line)
                }
            }
        }
    }

    println("")
}
