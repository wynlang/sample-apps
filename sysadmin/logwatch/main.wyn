// logwatch — Real-time log file watcher with pattern highlighting
// Demonstrates: File.read, string methods, ANSI colors, pattern matching
// Non-interactive: prints analysis and exits

fn severity_color(level: string) -> string {
    if level == "ERROR" { return "\x1b[31m" }
    if level == "WARN" { return "\x1b[33m" }
    if level == "INFO" { return "\x1b[32m" }
    if level == "DEBUG" { return "\x1b[90m" }
    return "\x1b[0m"
}

fn main() -> int {
    println("\x1b[1;36m╔══════════════════════════════════════════════════════════════╗\x1b[0m")
    println("\x1b[1;36m║\x1b[0m             \x1b[1mlogwatch\x1b[0m — Log File Analyzer                    \x1b[1;36m║\x1b[0m")
    println("\x1b[1;36m╚══════════════════════════════════════════════════════════════╝\x1b[0m")
    println("")

    // Generate sample log data for demo
    var log = "[2026-02-11 08:00:01] INFO  Server started on port 8080\n"
    log = log + "[2026-02-11 08:00:02] INFO  Database connection established\n"
    log = log + "[2026-02-11 08:01:15] INFO  Request GET /api/users (200) 45ms\n"
    log = log + "[2026-02-11 08:01:16] INFO  Request GET /api/health (200) 2ms\n"
    log = log + "[2026-02-11 08:02:33] ERROR Connection timeout to redis:6379\n"
    log = log + "[2026-02-11 08:02:34] WARN  Retrying redis connection (attempt 1/3)\n"
    log = log + "[2026-02-11 08:02:35] WARN  Retrying redis connection (attempt 2/3)\n"
    log = log + "[2026-02-11 08:02:36] INFO  Redis connection restored\n"
    log = log + "[2026-02-11 08:03:00] INFO  Request POST /api/login (200) 120ms\n"
    log = log + "[2026-02-11 08:03:01] WARN  Rate limit approaching for IP 10.0.0.5\n"
    log = log + "[2026-02-11 08:03:45] INFO  Request GET /api/users/42 (200) 30ms\n"
    log = log + "[2026-02-11 08:04:22] ERROR Out of memory: heap allocation failed\n"
    log = log + "[2026-02-11 08:04:23] ERROR Service crash: restarting worker pid 1234\n"
    log = log + "[2026-02-11 08:04:25] INFO  Worker restarted successfully\n"
    log = log + "[2026-02-11 08:05:00] DEBUG GC cycle completed: freed 45MB\n"
    log = log + "[2026-02-11 08:05:30] INFO  Request GET /api/metrics (200) 5ms\n"

    // Parse and analyze
    var error_count = 0
    var warn_count = 0
    var info_count = 0
    var debug_count = 0
    var total_lines = 0

    // Collect error messages
    var errors = ["", "", "", "", "", "", "", "", "", ""]
    var error_idx = 0

    var line_start = 0
    var llen = log.len()

    println("  \x1b[1mLog Output:\x1b[0m")
    println("")

    for idx in 0..llen {
        if log[idx] == "\n" {
            var line = log.substring(line_start, idx)
            line_start = idx + 1
            total_lines = total_lines + 1

            // Detect severity
            var color = "\x1b[0m"
            if line.contains("ERROR") {
                error_count = error_count + 1
                color = "\x1b[31m"
                if error_idx < 10 {
                    errors[error_idx] = line
                    error_idx = error_idx + 1
                }
            } else {
                if line.contains("WARN") {
                    warn_count = warn_count + 1
                    color = "\x1b[33m"
                } else {
                    if line.contains("DEBUG") {
                        debug_count = debug_count + 1
                        color = "\x1b[90m"
                    } else {
                        info_count = info_count + 1
                        color = "\x1b[0m"
                    }
                }
            }

            println("  " + color + line + "\x1b[0m")
        }
    }

    // Summary
    println("")
    println("  \x1b[1m═══ Summary ═══\x1b[0m")
    println("")
    println("  Total lines:  " + total_lines.to_string())
    println("  \x1b[31m● Errors:     " + error_count.to_string() + "\x1b[0m")
    println("  \x1b[33m● Warnings:   " + warn_count.to_string() + "\x1b[0m")
    println("  \x1b[32m● Info:       " + info_count.to_string() + "\x1b[0m")
    println("  \x1b[90m● Debug:      " + debug_count.to_string() + "\x1b[0m")

    // Error details
    if error_count > 0 {
        println("")
        println("  \x1b[1;31m═══ Errors ═══\x1b[0m")
        for i in 0..error_idx {
            println("  \x1b[31m  → " + errors[i] + "\x1b[0m")
        }
    }

    // Health assessment
    println("")
    if error_count == 0 {
        println("  \x1b[32m✓ System healthy — no errors detected\x1b[0m")
    } else {
        if error_count <= 2 {
            println("  \x1b[33m⚠ System degraded — " + error_count.to_string() + " error(s) found\x1b[0m")
        } else {
            println("  \x1b[31m✗ System critical — " + error_count.to_string() + " errors require attention\x1b[0m")
        }
    }
    println("")

    return 0
}
