// facts.wyn -- the parsers behind sysinfo, kept apart from the printing.
//
// Every function here is pure: text in, one value out. That is the whole point --
// `sysinfo` used to bury its parsing inside main() next to the `System.exec` that
// produced the text, so the only way to exercise it was to run it on a Mac and squint.
// Split out like this, tests/test_facts.wyn feeds each parser captured output from a
// real macOS box AND a real Linux box, and the app imports the same code the tests
// prove. No fixture-mirroring, no live system required.
//
// The contract for a missing or malformed field is a sentinel the caller must handle:
// -1 for ints, "" for strings. Nothing here panics, and nothing invents a zero --
// "0 MB of RAM" and "I could not read the RAM" are different facts, and main.wyn
// prints them differently.

// `to_int()` PANICS on anything that is not an integer, so no parser may call it on
// text it has not checked. This is the only gate to it in the app.
export fn num(s: string) -> int {
    var t = s.trim()
    if t.len() == 0 { return -1 }
    for i in 0..t.len() {
        var c = t.substring(i, i + 1)
        if c < "0" or c > "9" { return -1 }
    }
    return t.to_int()
}

// A percentage like "80.4" as hundredths (8040), so it can be compared and sorted
// with integers and no float parsing. -1 for anything that is not a number.
//
// `to_float()` panics exactly as `to_int()` does, so this is the only gate to reading
// `ps`'s %CPU column -- and it has to be a gate, because that column is "-" on some
// kernel threads and "?" on others.
export fn centi(s: string) -> int {
    var t = s.trim()
    if t.len() == 0 { return -1 }
    var dot = t.index_of(".")
    if dot < 0 {
        var n = num(t)
        if n < 0 { return -1 }
        return n * 100
    }
    var whole = num(t.substring(0, dot))
    var frac = t.substring(dot + 1, t.len())
    if whole < 0 or frac.len() == 0 { return -1 }
    // Only the first two decimal places matter, and a short fraction is padded:
    // "5.4" is 5.40, not 5.04.
    var two = frac
    if two.len() > 2 { two = two.substring(0, 2) }
    while two.len() < 2 { two += "0" }
    var f = num(two)
    if f < 0 { return -1 }
    return whole * 100 + f
}

// Nth whitespace-separated field of a line, "" if the line is too short.
// `words()` collapses runs of spaces; `split_at(" ", n)` does not, which is why the
// old sysinfo printed "used /  total ()" with every disk field blank.
export fn field(line: string, n: int) -> string {
    var w = line.words()
    if n < 0 or n >= w.len() { return "" }
    return "" + w[n]
}

// ---------------------------------------------------------------- key: value

// "Pages free:   3753." -> "3753."   /   "MemTotal:  8126204 kB" -> "8126204 kB"
// Matching is prefix-anchored on "<key>:" so "Pages free" cannot be answered by
// "Pages freed" or by a line that merely mentions the key later on.
export fn kv(text: string, key: string) -> string {
    var want = key + ":"
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if not line.starts_with(want) { continue }
        return line.substring(want.len(), line.len()).trim()
    }
    return ""
}

// ---------------------------------------------------------------- memory

// vm_stat (macOS) reports page COUNTS with a trailing period: "Pages free: 3753."
export fn vm_pages(text: string, key: string) -> int {
    var v = kv(text, key)
    if v.len() == 0 { return -1 }
    return num(v.replace(".", ""))
}

// vm_stat's first line carries the page size, so we never have to guess 4096 on a
// machine whose pages are 16384 bytes -- an 4x error in every memory figure.
export fn vm_page_size(text: string) -> int {
    var marker = "page size of "
    var lines = text.lines()
    if lines.len() == 0 { return -1 }
    var head = "" + lines[0]
    var at = head.index_of(marker)
    if at < 0 { return -1 }
    return num(field(head.substring(at + marker.len(), head.len()), 0))
}

// /proc/meminfo (Linux) reports kB: "MemTotal:  8126204 kB"
export fn meminfo_kb(text: string, key: string) -> int {
    var v = kv(text, key)
    if v.len() == 0 { return -1 }
    return num(field(v, 0))
}

// Total physical memory in MB from vm_stat's page counts. macOS has no single
// "MemTotal", so it is the sum of every page bucket -- and if any bucket is missing
// the answer is -1, not a quietly short total.
export fn vm_total_mb(text: string) -> int {
    var page = vm_page_size(text)
    if page < 1 { return -1 }
    // NB: not named `free` -- that collides with C's free() in the generated code.
    var unused = vm_pages(text, "Pages free")
    var active = vm_pages(text, "Pages active")
    var inactive = vm_pages(text, "Pages inactive")
    var spec = vm_pages(text, "Pages speculative")
    var wired = vm_pages(text, "Pages wired down")
    if unused < 0 or active < 0 or inactive < 0 or spec < 0 or wired < 0 { return -1 }
    return (unused + active + inactive + spec + wired) * page / 1048576
}

// Memory actually committed (active + wired), in MB. Inactive and speculative pages
// are reclaimable, so counting them as "used" is what makes naive monitors report
// 95% on an idle Mac.
export fn vm_used_mb(text: string) -> int {
    var page = vm_page_size(text)
    if page < 1 { return -1 }
    var active = vm_pages(text, "Pages active")
    var wired = vm_pages(text, "Pages wired down")
    if active < 0 or wired < 0 { return -1 }
    return (active + wired) * page / 1048576
}

// MemTotal - MemAvailable: the kernel's own answer to "how much is really in use",
// which already excludes reclaimable cache.
export fn meminfo_used_mb(text: string) -> int {
    var total = meminfo_kb(text, "MemTotal")
    var avail = meminfo_kb(text, "MemAvailable")
    if total < 0 or avail < 0 { return -1 }
    return (total - avail) / 1024
}

export fn pct(part: int, whole: int) -> int {
    if whole < 1 or part < 0 { return -1 }
    return part * 100 / whole
}

// ---------------------------------------------------------------- disk (df -Pk)

// `df -Pk` is POSIX-specified: 6 columns, sizes in 1024-byte blocks, on both
// platforms. `df -h` is not -- its units differ and it is what forced the old apps
// into `grep -v devfs | grep -v map` pipelines.
// Returns column `col` of the row whose mount point (last column) is `mount`.
export fn df_col(text: string, mount: string, col: int) -> string {
    for raw in text.lines() {
        var line = ("" + raw).trim()
        var w = line.words()
        if w.len() < 6 { continue }
        // The header line ends in "Mounted on", so its last word is "on" -- a caller
        // asking for mount "on" would otherwise be handed "1024-blocks" as a size.
        // Requiring a numeric block count rejects it without skipping by line number
        // (some `df` implementations are invoked with the header suppressed).
        if num("" + w[1]) < 0 { continue }
        if ("" + w[w.len() - 1]) != mount { continue }
        return field(line, col)
    }
    return ""
}

export fn df_total_kb(text: string, mount: string) -> int => num(df_col(text, mount, 1))
export fn df_used_kb(text: string, mount: string) -> int => num(df_col(text, mount, 2))

// The capacity column is "5%" -- the sign has to come off before it is a number.
export fn df_pct(text: string, mount: string) -> int {
    var c = df_col(text, mount, 4)
    if c.len() == 0 { return -1 }
    return num(c.replace("%", ""))
}

// Is this row backed by actual storage worth showing?
//
// The rule is about RAM-backed vs disk-backed, not a denylist of names. Note that
// `overlay` is NOT excluded: it is the real root filesystem of every Docker container,
// and denylisting it by name (the obvious first guess) means no `/` row on Linux at
// all. RAM-backed tmpfs/devfs/shm stay out wherever they are mounted. This replaces
// the `grep -v devfs | grep -v map` chains the old apps carried.
export fn is_real_fs(device: string, mount: string) -> bool {
    if device == "devfs" or device == "tmpfs" or device == "shm" { return false }
    if device == "none" or device == "map" or device.starts_with("map ") { return false }
    // Kernel and runtime mounts: real bytes, but not disks anyone monitors.
    if mount == "/dev" or mount.starts_with("/dev/") { return false }
    if mount == "/proc" or mount.starts_with("/proc/") { return false }
    if mount == "/sys" or mount.starts_with("/sys/") { return false }
    if mount == "/run" or mount.starts_with("/run/") { return false }
    // macOS firmlinks all report the same figures as `/`.
    if mount.starts_with("/System/Volumes/") { return false }
    return true
}

// ---------------------------------------------------------------- load average

// macOS: "13:39  up 8 days, 8:54, 2 users, load averages: 4.98 6.72 7.16"
// Linux: "13:39:02 up 3 days,  1:12,  1 user,  load average: 0.14, 0.11, 0.09"
// Note "averages:" vs "average:" and spaces vs commas -- both are normalised to
// three space-separated numbers so the caller does not care which box it is on.
export fn load_from_uptime(text: string) -> string {
    var line = text.trim()
    var at = line.index_of("load average")
    if at < 0 { return "" }
    // index_of takes no start offset, so slice first and search the tail.
    var tail = line.substring(at, line.len())
    var colon = tail.index_of(":")
    if colon < 0 { return "" }
    var rest = tail.substring(colon + 1, tail.len()).replace(",", " ")
    var w = rest.words()
    if w.len() < 3 { return "" }
    return "${w[0]} ${w[1]} ${w[2]}"
}

// /proc/loadavg: "0.14 0.11 0.09 1/406 15" -- present even on a container with no
// `uptime` binary, which is exactly where the old apps printed a blank field.
export fn load_from_proc(text: string) -> string {
    var w = text.trim().words()
    if w.len() < 3 { return "" }
    return "${w[0]} ${w[1]} ${w[2]}"
}

// ---------------------------------------------------------------- cpu

// /proc/cpuinfo: "model name	: Intel(R) Core(TM) i7-9750H CPU @ 2.60GHz"
export fn cpu_model_linux(text: string) -> string {
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if not line.starts_with("model name") { continue }
        var colon = line.index_of(":")
        if colon < 0 { continue }
        return line.substring(colon + 1, line.len()).trim()
    }
    // ARM Linux has no "model name"; fall back to the part number.
    for raw2 in text.lines() {
        var l2 = ("" + raw2).trim()
        if not l2.starts_with("CPU part") { continue }
        var c2 = l2.index_of(":")
        if c2 < 0 { continue }
        return "ARM " + l2.substring(c2 + 1, l2.len()).trim()
    }
    return ""
}

// ---------------------------------------------------------------- network

// One parser for BOTH `ifconfig` (macOS) and `ip -o -4 addr` (Linux): find the word
// "inet", take the next word, drop any "/24" prefix length, and refuse loopback and
// link-local. Doing it by word position rather than by line shape is what lets the
// two very different formats share the code.
export fn first_ipv4(text: string) -> string {
    for raw in text.lines() {
        var w = ("" + raw).trim().words()
        for i in 0..w.len() {
            if ("" + w[i]) != "inet" { continue }
            if i + 1 >= w.len() { continue }
            var addr = "" + w[i + 1]
            var slash = addr.index_of("/")
            if slash > 0 { addr = addr.substring(0, slash) }
            if addr.starts_with("127.") or addr.starts_with("169.254.") { continue }
            if addr.index_of(".") < 0 { continue }
            return addr
        }
    }
    return ""
}

// Trailing ":" off an interface token: "en0:" -> "en0", "eth0" -> "eth0".
fn strip_colon(tok: string) -> string {
    if tok.ends_with(":") { return tok.substring(0, tok.len() - 1) }
    return tok
}

// Interface names from three formats that all mean the same thing:
//   macOS ifconfig      "en0: flags=8863<UP,...> mtu 1500"
//   Linux ip -o link    "2: eth0: <BROADCAST,MULTICAST,UP> mtu 1500 ..."
//   Linux ip -o -4 addr "2: eth0    inet 172.17.0.2/16 brd ... scope global eth0"
// A leading numeric "N:" index means the name is the SECOND token (and it may or may
// not itself carry a colon); otherwise the first token is the name. Indented lines are
// continuations of the preceding block and never introduce a name.
export fn iface_names(text: string) -> string {
    var out = ""
    for raw in text.lines() {
        var line = "" + raw
        if line.len() == 0 { continue }
        if line.starts_with(" ") or line.starts_with("\t") { continue }
        var w = line.words()
        if w.len() < 2 { continue }
        var first = "" + w[0]
        if not first.ends_with(":") { continue }
        var name = strip_colon(first)
        // "2:" is an index, not a name -- the name is the next token.
        if num(name) >= 0 { name = strip_colon("" + w[1]) }
        if name.len() == 0 or name == "lo" or name == "lo0" { continue }
        if out.len() > 0 { out += " " }
        out += name
    }
    return out
}

// nameserver lines out of /etc/resolv.conf, space-joined.
export fn nameservers(text: string) -> string {
    var out = ""
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if not line.starts_with("nameserver") { continue }
        var v = field(line, 1)
        if v.len() == 0 { continue }
        if out.len() > 0 { out += " " }
        out += v
    }
    return out
}

// ---------------------------------------------------------------- processes

// `ps -eo pid,pcpu,pmem,rss,comm` on both platforms. rank 1 = first process row;
// the header line is skipped by name ("PID"), not by index, so a `ps` that omits
// the header does not silently cost us the busiest process.
export fn ps_rows(text: string) -> int {
    var n = 0
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if line.len() == 0 { continue }
        if field(line, 0) == "PID" { continue }
        if num(field(line, 0)) < 0 { continue }
        n += 1
    }
    return n
}

// A whole process row, trimmed; "" if there is no such row. Callers wanting several
// columns of one row should take the row once and use `field` on it -- each ps_field
// call is a fresh scan of the whole text.
export fn ps_row(text: string, rank: int) -> string {
    var n = 0
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if line.len() == 0 { continue }
        if field(line, 0) == "PID" { continue }
        if num(field(line, 0)) < 0 { continue }
        n += 1
        if n == rank { return line }
    }
    return ""
}

// COMMAND is the last column and may contain spaces, so it is everything from field 4
// on -- `words()[4]` would truncate "/Applications/Some App.app/…/Some App" at the space.
export fn ps_command(row: string) -> string {
    var w = row.words()
    if w.len() < 5 { return "" }
    return w.slice(4, w.len()).join(" ")
}

export fn ps_field(text: string, rank: int, col: int) -> string {
    var line = ps_row(text, rank)
    if line.len() == 0 { return "" }
    if col < 4 { return field(line, col) }
    return ps_command(line)
}

// Row indices of the `n` busiest processes, busiest first, space-separated: "17 4 233".
// "" if there are no rows.
//
// Sorting is done HERE rather than by asking `ps` to do it, because there is no
// portable flag for it: macOS `ps -r` means "sort by CPU", but Linux (procps) `ps -r`
// means "show only RUNNING processes" -- which on an idle box matches nothing, so the
// first Linux run of this app reported a header and no processes at all.
//
// All `n` ranks come out of ONE pass over the text. Ranking each position with its own
// call re-parsed the whole `ps` output per candidate per rank; with ~650 processes that
// took 22 seconds for a single report. It returns a string because an exported function
// cannot return an array across a module boundary in the current compiler -- the caller
// splits it with `words()`.
export fn ps_top(text: string, n: int) -> string {
    var cpus: [int] = []
    for raw in text.lines() {
        var line = ("" + raw).trim()
        if line.len() == 0 { continue }
        if field(line, 0) == "PID" { continue }
        if num(field(line, 0)) < 0 { continue }
        cpus.push(centi(field(line, 1)))
    }
    var rows = cpus.len()
    var want = n
    if want > rows { want = rows }
    if want < 1 { return "" }

    // taken[i] marks row i+1 as already emitted; picking the max of what is left is
    // O(rows) per rank with no allocation and, unlike a comparator, no dependence on
    // sort stability for equal CPU values.
    var taken: [bool] = []
    for i in 0..rows { taken.push(false) }
    var out = ""
    // A `while` rather than `for _ in 0..want` because the counter is never used in the
    // body, and an unused `for` variable in an imported module currently comes out
    // module-prefixed in the generated C and fails to compile. (Same family of quirk as
    // `unused` above, which may not be called `free`.)
    var remaining = want
    while remaining > 0 {
        remaining -= 1
        var best = -1
        // Starts below centi()'s -1 sentinel so that a row with an unparseable %CPU
        // (kernel threads print "-") still gets picked once everything measurable is
        // taken -- otherwise those rows are silently dropped from the ranking.
        var best_cpu = 0 - 2
        for r in 0..rows {
            if taken[r] { continue }
            if cpus[r] <= best_cpu { continue }
            best_cpu = cpus[r]
            best = r
        }
        if best < 0 { return out }
        taken[best] = true
        if out.len() > 0 { out += " " }
        out += "${best + 1}"
    }
    return out
}

// Just the executable name, not its whole path.
export fn basename(path: string) -> string {
    var slash = path.last_index_of("/")
    if slash < 0 { return path }
    return path.substring(slash + 1, path.len())
}

// ---------------------------------------------------------------- formatting

// KB -> "12.3 GB" / "482 MB", with one decimal and no floating point: an integer
// tenths division, so the same input always prints the same string.
export fn human_kb(kb: int) -> string {
    if kb < 0 { return "?" }
    if kb < 1024 { return "${kb} KB" }
    if kb < 1048576 {
        var tenths = kb * 10 / 1024
        return "${tenths / 10}.${tenths % 10} MB"
    }
    var gt = kb * 10 / 1048576
    if gt < 10240 { return "${gt / 10}.${gt % 10} GB" }
    var tt = kb * 10 / 1073741824
    return "${tt / 10}.${tt % 10} TB"
}
