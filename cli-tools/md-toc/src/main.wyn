// md-toc -- build a real, pasteable table of contents for a markdown file.
//
// The previous version was wrong in a way you could see. It read a HARDCODED
// "../../README.md", took no argument, and counted every line starting with "#" as a
// heading -- including the lines INSIDE fenced code blocks. Run on the repo README it
// printed "python/" as a heading nested under "Web server", because those "#" lines were
// comments in a bash snippet:
//     - Web server
//         - python/
// The nesting was nonsense, the entries were not links, and nothing checked the document.
//
// Rewritten to be a tool you would actually use:
//   * fenced code blocks (``` and ~~~) are skipped -- the bug above, fixed at the source.
//   * depth is NORMALISED to the shallowest heading, so a doc that starts at ## is not
//     indented pointlessly.
//   * GitHub-style anchor slugs, so every entry is a clickable [text](#slug) you can
//     paste straight back into the file.
//   * a structure summary (count per level) and three checks a writer wants: a SKIPPED
//     level (## followed by ####), DUPLICATE headings whose anchors would collide, and
//     more than one H1.
//
//   wyn run src/main.wyn [file.md]      (no argument: README.md in the current directory)

struct Heading {
    depth: int,
    text: string,
    slug: string,
    line: int
}

// GitHub's exact anchor rule: lowercase, keep [a-z0-9_-], drop everything else
// (punctuation, emoji), turn each remaining space into a dash. Note it does NOT
// collapse runs of dashes -- "FAQ / Troubleshooting" really is "#faq--troubleshooting".
fn slugify(title: string) -> string {
    var out = ""
    for ch in title.lower().chars() {
        if "abcdefghijklmnopqrstuvwxyz0123456789_-".contains(ch) { out = out + ch }
        else if ch == " " { out = out + "-" }
    }
    return out
}

// Leading '#' run, 1..6, and only if followed by a space -- "#hashtag" is not a heading.
fn heading_depth(line: string) -> int {
    var d = 0
    while d < line.len() and line.substring(d, d + 1) == "#" { d += 1 }
    if d == 0 or d > 6 { return 0 }
    if d >= line.len() or line.substring(d, d + 1) != " " { return 0 }
    return d
}

fn parse(md: string) -> [Heading] {
    var heads = []
    var n = 0
    var fenced = false
    // split("\n"), not lines(): lines() drops blank lines, which would skew line numbers.
    for raw in md.split("\n") {
        n += 1
        var line = raw.trim()
        // A fence toggles code mode; everything inside is text, not structure.
        if line.substring(0, 3) == "```" or line.substring(0, 3) == "~~~" {
            fenced = not fenced
            continue
        }
        if fenced { continue }
        var d = heading_depth(line)
        if d == 0 { continue }
        var text = line.substring(d + 1, line.len()).trim()
        while text.len() > 0 and text.substring(text.len() - 1, text.len()) == "#" {
            text = text.substring(0, text.len() - 1).trim()
        }
        if text.len() == 0 { continue }
        heads.push(Heading { depth: d, text: text, slug: slugify(text), line: n })
    }
    return heads
}

fn main() {
    print("\x1b[1;36m═══ md-toc ═══\x1b[0m")
    print("")

    var path = ""
    args = System.args()
    if args.len() > 1 { path = args[1] }
    else if File.exists("README.md") == 1 { path = "README.md" }
    else if File.exists("cli-tools/md-toc/README.md") == 1 { path = "cli-tools/md-toc/README.md" }
    if path == "" or File.exists(path) == 0 {
        print("  \x1b[31mno markdown file\x1b[0m (pass a path, or run from the app directory)")
        return
    }

    // The annotation is load-bearing: without it the element type of a returned
    // struct array is lost (see README).
    var heads: [Heading] = parse(File.read(path))
    if heads.len() == 0 {
        print("  \x1b[33m${path}\x1b[0m has no headings")
        return
    }

    // Normalise: the shallowest heading in the document becomes column zero.
    var depths = heads.map((h) => h.depth)
    var base = depths.min()

    print("  \x1b[90m${path}\x1b[0m \x1b[1m${heads.len()}\x1b[0m headings, H${base}-H${depths.max()}")
    print("")
    for h in heads {
        print("${"  ".repeat(h.depth - base + 1)}- [${h.text}](#${h.slug})")
    }

    // Structure: one bar per level that occurs, derived from the same headings.
    print("")
    print("  \x1b[1mstructure\x1b[0m")
    for d in base..7 {
        var at = heads.filter((h) => h.depth == d)
        if at.len() == 0 { continue }
        print("  \x1b[36mH${d}\x1b[0m ${"█".repeat(at.len())} ${at.len()}")
    }

    // Checks. Collide-able anchors are counted; the other two are read off the sequence.
    var seen = HashMap.new()
    for h in heads { seen.insert_int(h.slug, seen.get_int(h.slug) + 1) }
    var problems = []
    for k in seen.keys() {
        if seen.get_int(k) > 1 { problems.push("duplicate anchor #${k} x${seen.get_int(k)} - links will land on the first one") }
    }
    var prev = base
    for h in heads {
        if h.depth > prev + 1 { problems.push("line ${h.line}: H${prev} jumps to H${h.depth} (\"${h.text}\") - a level was skipped") }
        prev = h.depth
    }
    var h1s = heads.filter((h) => h.depth == 1)
    if h1s.len() > 1 { problems.push("${h1s.len()} H1 headings - a document should have one title") }

    print("")
    if problems.len() == 0 { print("  \x1b[32m✓ no structural problems\x1b[0m") }
    else {
        print("  \x1b[1;33m${problems.len()} structural problems\x1b[0m")
        for p in problems { print("  \x1b[33m!\x1b[0m ${p}") }
    }
    print("")
}
