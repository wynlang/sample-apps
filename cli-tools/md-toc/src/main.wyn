// Markdown TOC Generator -- Extract headings from markdown files
// Demonstrates: File.read, .split(), string interpolation, pattern detection

fn main() {
    print("=== Markdown Table of Contents ===")
    print("")

    var content = File.read("../../README.md")
    if content.len() == 0 {
        print("Error: could not read README.md")
        return 1
    }

    var lines = content.split("\n")
    var heading_count = 0

    for line in lines {
        var trimmed = line.trim()
        if trimmed.starts_with("### ") {
            print("    - ${trimmed.substring(4, trimmed.len())}")
            heading_count += 1
        } else if trimmed.starts_with("## ") {
            print("  - ${trimmed.substring(3, trimmed.len())}")
            heading_count += 1
        } else if trimmed.starts_with("# ") {
            print("- ${trimmed.substring(2, trimmed.len())}")
            heading_count += 1
        }
    }

    print("")
    print("Found ${heading_count} headings")
}
