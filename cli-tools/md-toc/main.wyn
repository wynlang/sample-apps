// Markdown TOC Generator — Extract headings from markdown files
// Demonstrates: File.read, string methods, pattern detection

fn main() -> int {
    println("=== Markdown Table of Contents ===")
    println("")

    var content = File.read("../sample-apps/README.md")
    if content.len() == 0 {
        println("Error: could not read README.md")
        return 1
    }

    var line_start = 0
    var total_len = content.len()
    var heading_count = 0

    for idx in 0..total_len {
        if content[idx] == "\n" {
            var line = content.substring(line_start, idx)
            var trimmed = line.trim()
            line_start = idx + 1

            if trimmed.len() == 0 { continue }

            // Detect heading level
            if trimmed.starts_with("### ") {
                var title = trimmed.substring(4, trimmed.len())
                println("    - " + title)
                heading_count = heading_count + 1
            } else {
                if trimmed.starts_with("## ") {
                    var title = trimmed.substring(3, trimmed.len())
                    println("  - " + title)
                    heading_count = heading_count + 1
                } else {
                    if trimmed.starts_with("# ") {
                        var title = trimmed.substring(2, trimmed.len())
                        println("- " + title)
                        heading_count = heading_count + 1
                    }
                }
            }
        }
    }

    println("")
    println("Found " + heading_count.to_string() + " headings")

    return 0
}
