// loc -- Concurrent Lines of Code Counter
// Demonstrates: spawn, await_all, structs, string interpolation

struct FileStats { name: string, code: int, blank: int, comment: int }

fn count_file(filename: string) -> int {
    var content = File.read(filename)
    var code = 0
    var blank = 0
    var comment = 0
    var lines = content.split("\n")
    for line in lines {
        var trimmed = line.trim()
        if trimmed.len() == 0 { blank = blank + 1 }
        else if trimmed.starts_with("//") { comment = comment + 1 }
        else { code = code + 1 }
    }
    // Encode as code * 1000000 + blank * 1000 + comment
    return code * 1000000 + blank * 1000 + comment
}

fn main() {
    print("=== Lines of Code Counter ===")

    var files = [
    "../sample-apps/cli-tools/loc/src/main.wyn",
    "../sample-apps/cli-tools/todo-finder/src/main.wyn",
    "../sample-apps/cli-tools/word-counter/src/main.wyn",
    "../sample-apps/cli-tools/config-reader/src/main.wyn",
    "../sample-apps/cli-tools/md-toc/src/main.wyn"
    ]
    var count = files.len()

    // Count lines concurrently using spawn + await_all
    var futures = []
    for i in 0..count {
        if File.exists(files[i]) {
            futures.push(spawn count_file(files[i]))
        } else {
            futures.push(spawn count_file(""))
        }
    }
    var results = await_all(futures)

    var total_code = 0
    var total_blank = 0
    var total_comment = 0

    for i in 0..count {
        var packed = results[i]
        var code = packed / 1000000
        var blank = (packed / 1000) % 1000
        var comment = packed % 1000
        if code > 0 or blank > 0 {
            var total = code + blank + comment
            print("  ${files[i]}")
            print("    Code: ${code}  Blank: ${blank}  Comment: ${comment}  Total: ${total}")
            total_code += code
            total_blank += blank
            total_comment += comment
        }
    }

    var grand_total = total_code + total_blank + total_comment
    print("")
    print("=== Summary ===")
    print("  Files:   ${count}")
    print("  Code:    ${total_code}")
    print("  Blank:   ${total_blank}")
    print("  Comment: ${total_comment}")
    print("  Total:   ${grand_total}")
}
