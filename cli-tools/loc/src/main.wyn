// loc -- Concurrent Lines of Code Counter
// Demonstrates: spawn for parallel file processing, structs, string interpolation

struct FileStats { name: string, code: int, blank: int, comment: int }

fn count_lines(filename: string, content: string, results: [FileStats], idx: int) {
    var code = 0
    var blank = 0
    var comment = 0
    var lines = content.split("\n")
    for line in lines {
        var trimmed = line.trim()
        if trimmed.len() == 0 { blank = blank + 1 }
        else if trimmed.starts_with("//") { comment = comment + 1 }
        else { code = code + 1 }
    }
    results[idx] = FileStats { name: filename, code: code, blank: blank, comment: comment }
}

fn main() -> int {
    println("=== Lines of Code Counter ===")

    var files = [
        "../sample-apps/cli-tools/loc/src/main.wyn",
        "../sample-apps/cli-tools/todo-finder/src/main.wyn",
        "../sample-apps/cli-tools/word-counter/src/main.wyn",
        "../sample-apps/cli-tools/config-reader/src/main.wyn",
        "../sample-apps/cli-tools/md-toc/src/main.wyn"
    ]
    var count = files.len()
    var results: [FileStats] = []

    for i in 0..count {
        results.push(FileStats { name: "", code: 0, blank: 0, comment: 0 })
    }

    // Count lines concurrently
    for i in 0..count {
        if File.exists(files[i]) {
            var content = File.read(files[i])
            spawn count_lines(files[i], content, results, i)
        }
    }

    Time.sleep(200)

    var total_code = 0
    var total_blank = 0
    var total_comment = 0

    for i in 0..count {
        var s = results[i]
        if s.name.len() > 0 {
            var total = s.code + s.blank + s.comment
            println("  ${s.name}")
            println("    Code: ${s.code}  Blank: ${s.blank}  Comment: ${s.comment}  Total: ${total}")
            total_code += s.code
            total_blank += s.blank
            total_comment += s.comment
        }
    }

    var grand_total = total_code + total_blank + total_comment
    println("")
    println("=== Summary ===")
    println("  Files:   ${count}")
    println("  Code:    ${total_code}")
    println("  Blank:   ${total_blank}")
    println("  Comment: ${total_comment}")
    println("  Total:   ${grand_total}")
    return 0
}
