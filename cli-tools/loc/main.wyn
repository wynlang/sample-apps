// loc — Lines of Code Counter
// Demonstrates: file I/O, string methods, structs, loops

struct FileStats { name: string, code: int, blank: int, comment: int }

fn count_lines(filename: string, content: string) -> FileStats {
    var code = 0
    var blank = 0
    var comment = 0
    var line_start = 0
    var len = content.len()

    for i in 0..len {
        if content[i] == "\n" {
            var line = content.substring(line_start, i)
            var trimmed = line.trim()
            if trimmed.len() == 0 {
                blank = blank + 1
            } else {
                if trimmed.starts_with("//") {
                    comment = comment + 1
                } else {
                    code = code + 1
                }
            }
            line_start = i + 1
        }
    }
    if line_start < len {
        code = code + 1
    }

    return FileStats { name: filename, code: code, blank: blank, comment: comment }
}

fn display_stats(s: FileStats) {
    var total = s.code + s.blank + s.comment
    println("  " + s.name)
    println("    Code: " + s.code.to_string() + "  Blank: " + s.blank.to_string() + "  Comment: " + s.comment.to_string() + "  Total: " + total.to_string())
}

fn main() -> int {
    println("=== Lines of Code Counter ===")

    // Count lines in the sample apps themselves
    var files = [
        "../sample-apps/cli-tools/loc/main.wyn",
        "../sample-apps/cli-tools/todo-finder/main.wyn",
        "../sample-apps/cli-tools/word-counter/main.wyn",
        "../sample-apps/cli-tools/config-reader/main.wyn",
        "../sample-apps/cli-tools/md-toc/main.wyn"
    ]

    var total_code = 0
    var total_blank = 0
    var total_comment = 0

    for i in 0..5 {
        if File.exists(files[i]) {
            var content = File.read(files[i])
            var stats = count_lines(files[i], content)
            display_stats(stats)
            total_code = total_code + stats.code
            total_blank = total_blank + stats.blank
            total_comment = total_comment + stats.comment
        }
    }

    println("")
    println("=== Summary ===")
    var total = total_code + total_blank + total_comment
    println("  Files:   5")
    println("  Code:    " + total_code.to_string())
    println("  Blank:   " + total_blank.to_string())
    println("  Comment: " + total_comment.to_string())
    println("  Total:   " + total.to_string())

    return 0
}
