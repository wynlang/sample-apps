// loc — Lines of Code Counter
// Counts lines of code, blank lines, and comment lines in .wyn files

struct FileStats { name: string, code: int, blank: int, comment: int }

fn FileStats.total(self) -> int {
    return self.code + self.blank + self.comment
}

fn count_lines(filename: string, content: string) -> FileStats {
    var code = 0
    var blank = 0
    var comment = 0
    var in_line = 0
    var line_start = 0
    var len = str_len(content)

    for i in 0..len {
        if content[i] == "\n" {
            var line = str_substring(content, line_start, i)
            var trimmed = str_trim(line)
            if str_len(trimmed) == 0 {
                blank = blank + 1
            } else {
                if str_starts_with(trimmed, "//") {
                    comment = comment + 1
                } else {
                    code = code + 1
                }
            }
            line_start = i + 1
        }
    }
    // Last line (no trailing newline)
    if line_start < len {
        code = code + 1
    }

    return FileStats { name: filename, code: code, blank: blank, comment: comment }
}

fn display_stats(s: FileStats) {
    var total = s.code + s.blank + s.comment
    println("  " + s.name)
    println("    Code: " + int_to_string(s.code) + "  Blank: " + int_to_string(s.blank) + "  Comment: " + int_to_string(s.comment) + "  Total: " + int_to_string(total))
}

fn main() -> int {
    println("=== Lines of Code Counter ===")

    var files = [
        "tests/validation/test_struct_methods.wyn",
        "tests/validation/test_option_type.wyn",
        "tests/validation/test_returning_closures.wyn",
        "tests/validation/test_traits.wyn",
        "tests/validation/test_runtime_extraction.wyn"
    ]

    var total_code = 0
    var total_blank = 0
    var total_comment = 0

    for i in 0..5 {
        var content = file_read(files[i])
        var stats = count_lines(files[i], content)
        display_stats(stats)
        total_code = total_code + stats.code
        total_blank = total_blank + stats.blank
        total_comment = total_comment + stats.comment
    }

    println("")
    println("=== Summary ===")
    println("  Files:   " + int_to_string(5))
    println("  Code:    " + int_to_string(total_code))
    println("  Blank:   " + int_to_string(total_blank))
    println("  Comment: " + int_to_string(total_comment))
    println("  Total:   " + int_to_string(total_code + total_blank + total_comment))

    return 0
}
