// twux -- Terminal multiplexer written in Wyn
// Demonstrates: Terminal API, string manipulation, System.exec, arrays, structs
//
// Features: Up to 4 panes, create/close/rename/switch, help overlay
//
// Keys:
//   Ctrl+B then c    -- Create new pane
//   Ctrl+B then n/p  -- Next/previous pane
//   Ctrl+B then 1-4  -- Jump to pane by number
//   Ctrl+B then x    -- Close current pane
//   Ctrl+B then r    -- Rename current pane
//   Ctrl+B then l    -- Refresh all panes
//   Ctrl+B then ?    -- Toggle help screen
//   Ctrl+B then q    -- Quit
//   Arrow L/R         -- Switch panes

fn repeat_str(ch: string, n: int) -> string {
    var out = ""
    for i in 0..n { out = out + ch }
    return out
}

fn write_lines(content: string, start_row: int, start_col: int, max_width: int, max_rows: int) {
    var line_start = 0
    var row = 0
    var clen = content.len()
    for idx in 0..clen {
        if content[idx] == "\n" {
            if row < max_rows {
                var line = content.substring(line_start, idx)
                if line.len() > max_width { line = line.substring(0, max_width) }
                Terminal.move(start_row + row, start_col)
                Terminal.write(line)
                row += 1
            }
            line_start = idx + 1
        }
    }
}

fn draw_frame(cols: int, rows: int) {
    Terminal.move(1, 1)
    Terminal.write("┌" + repeat_str("─", cols - 2) + "┐")
    for r in 2..(rows - 1) {
        Terminal.move(r, 1)
        Terminal.write("│")
        Terminal.move(r, cols)
        Terminal.write("│")
    }
    Terminal.move(rows - 1, 1)
    Terminal.write("└" + repeat_str("─", cols - 2) + "┘")
}

fn draw_one_pane(idx: int, active: int, pane_count: int, title: string, content: string, cols: int, rows: int) {
    var base = cols / pane_count
    var cs = base * idx + 1
    var w = base
    if idx == pane_count - 1 { w = cols - base * (pane_count - 1) }

    // Vertical divider
    if idx > 0 {
        for r in 1..(rows - 1) {
            Terminal.move(r, cs)
            Terminal.write("│")
        }
        Terminal.move(1, cs)
        Terminal.write("┬")
        Terminal.move(rows - 1, cs)
        Terminal.write("┴")
    }

    // Title
    var num = "${idx + 1}"
    var tstr = " " + num + ":" + title + " "
    if tstr.len() > w - 2 { tstr = tstr.substring(0, w - 2) }
    Terminal.move(1, cs + 1)
    if idx == active {
        Terminal.write("\x1b[1;7m" + tstr + "\x1b[0m")
    } else {
        Terminal.write("\x1b[2m" + tstr + "\x1b[0m")
    }

    // Content area
    var cc = cs + 1
    if idx == 0 { cc = 2 }
    var cw = w - 2
    var cr = rows - 4
    var blank = repeat_str(" ", cw)
    for r in 2..(rows - 2) {
        Terminal.move(r, cc)
        Terminal.write(blank)
    }
    write_lines(content, 2, cc, cw, cr)
}

fn draw_status_bar(cols: int, rows: int, pane_count: int, active: int, t0: string, t1: string, t2: string, t3: string, msg: string) {
    Terminal.move(rows, 1)
    Terminal.write("\x1b[32;40m")
    var tabs = ""
    var used = 0
    if pane_count >= 1 {
        var n = "1:" + t0
        if active == 0 { tabs = tabs + "\x1b[1;7m " + n + " \x1b[0;32;40m" }
        else { tabs = tabs + " " + n + " " }
        used += n.len() + 2
    }
    if pane_count >= 2 {
        var n = "2:" + t1
        if active == 1 { tabs = tabs + "\x1b[1;7m " + n + " \x1b[0;32;40m" }
        else { tabs = tabs + " " + n + " " }
        used += n.len() + 2
    }
    if pane_count >= 3 {
        var n = "3:" + t2
        if active == 2 { tabs = tabs + "\x1b[1;7m " + n + " \x1b[0;32;40m" }
        else { tabs = tabs + " " + n + " " }
        used += n.len() + 2
    }
    if pane_count >= 4 {
        var n = "4:" + t3
        if active == 3 { tabs = tabs + "\x1b[1;7m " + n + " \x1b[0;32;40m" }
        else { tabs = tabs + " " + n + " " }
        used += n.len() + 2
    }
    Terminal.write(tabs)
    if msg.len() > 0 {
        var right = " " + msg + " "
        var gap = cols - used - right.len()
        if gap > 0 { Terminal.write(repeat_str(" ", gap)) }
        Terminal.write(right)
    } else {
        var gap = cols - used
        if gap > 0 { Terminal.write(repeat_str(" ", gap)) }
    }
    Terminal.write("\x1b[0m")
}

fn draw_help_overlay(cols: int, rows: int) {
    var w = 44
    var h = 16
    var sc = (cols - w) / 2
    var sr = (rows - h) / 2
    Terminal.move(sr, sc)
    Terminal.write("\x1b[1;37;44m┌" + repeat_str("─", w - 2) + "┐\x1b[0m")
    var lines = [
        "        twux -- Key Bindings        ",
        "                                    ",
        "  Prefix: Ctrl+B, then:             ",
        "                                    ",
        "  c       Create new pane           ",
        "  x       Close current pane        ",
        "  n / p   Next / previous pane      ",
        "  1-4     Jump to pane by number    ",
        "  r       Rename current pane       ",
        "  l       Refresh all panes         ",
        "  ?       Toggle this help          ",
        "  q       Quit twux                 ",
        "                                    ",
        "  Press any key to close            "
    ]
    for i in 0..14 {
        Terminal.move(sr + 1 + i, sc)
        Terminal.write("\x1b[1;37;44m│" + lines[i] + " │\x1b[0m")
    }
    Terminal.move(sr + h - 1, sc)
    Terminal.write("\x1b[1;37;44m└" + repeat_str("─", w - 2) + "┘\x1b[0m")
}

fn main() {
    var cols = Terminal.cols()
    var rows = Terminal.rows()

    // Pane state -- parallel arrays, max 4 panes
    var titles = ["files", "procs", "disk", "env"]
    var cmds = ["ls -la", "ps aux | head -20", "df -h", "env | sort | head -20"]
    var contents = ["", "", "", ""]
    var pc = 2
    var act = 0

    // Load initial content
    contents[0] = System.exec("ls -la 2>&1 | head -40")
    contents[1] = System.exec("ps aux | head -20 2>&1 | head -40")

    Terminal.raw_mode()
    Terminal.clear()

    // Initial draw
    draw_frame(cols, rows)
    if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
    if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
    if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
    if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
    draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], "Ctrl+B ? for help")

    var running = 1
    var show_help = 0
    var msg = "Ctrl+B ? for help"

    while running == 1 {
        var key = Terminal.read_key()
        if key == 0 { continue }

        // Dismiss help
        if show_help == 1 {
            if key != 2 {
                show_help = 0
                msg = ""
                Terminal.clear()
                draw_frame(cols, rows)
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
                draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], msg)
                continue
            }
        }

        // Ctrl+B prefix (ASCII 2)
        if key == 2 {
            msg = "-- PREFIX --"
            draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], msg)
            var cmd = 0
            while cmd == 0 { cmd = Terminal.read_key() }

            // q -- quit
            if cmd == 113 { running = 0 }

            // c -- create pane
            if cmd == 99 {
                if pc < 4 {
                    // Load content for new pane
                    if pc == 2 { contents[2] = System.exec("df -h 2>&1 | head -40") }
                    if pc == 3 { contents[3] = System.exec("env | sort | head -20 2>&1 | head -40") }
                    pc += 1
                    act = pc - 1
                    msg = "Created pane ${pc}"
                    Terminal.clear()
                    draw_frame(cols, rows)
                    if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                    if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                    if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                    if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
                } else {
                    msg = "Max 4 panes"
                }
            }

            // x -- close pane
            if cmd == 120 {
                if pc > 1 {
                    // Shift left from active
                    if act == 0 {
                        titles[0] = titles[1]
                        cmds[0] = cmds[1]
                        contents[0] = contents[1]
                        titles[1] = titles[2]
                        cmds[1] = cmds[2]
                        contents[1] = contents[2]
                        titles[2] = titles[3]
                        cmds[2] = cmds[3]
                        contents[2] = contents[3]
                    }
                    if act == 1 {
                        titles[1] = titles[2]
                        cmds[1] = cmds[2]
                        contents[1] = contents[2]
                        titles[2] = titles[3]
                        cmds[2] = cmds[3]
                        contents[2] = contents[3]
                    }
                    if act == 2 {
                        titles[2] = titles[3]
                        cmds[2] = cmds[3]
                        contents[2] = contents[3]
                    }
                    pc -= 1
                    if act >= pc { act = pc - 1 }
                    msg = "Closed pane"
                    Terminal.clear()
                    draw_frame(cols, rows)
                    if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                    if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                    if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                    if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
                } else {
                    msg = "Can't close last pane"
                }
            }

            // n -- next pane
            if cmd == 110 {
                act += 1
                if act >= pc { act = 0 }
                msg = "Pane ${act + 1}"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }

            // p -- previous pane
            if cmd == 112 {
                act -= 1
                if act < 0 { act = pc - 1 }
                msg = "Pane ${act + 1}"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }

            // 1-4 jump
            if cmd == 49 {
                if pc >= 1 { act = 0 }
                msg = "Pane 1"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }
            if cmd == 50 {
                if pc >= 2 { act = 1 }
                msg = "Pane 2"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }
            if cmd == 51 {
                if pc >= 3 { act = 2 }
                msg = "Pane 3"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }
            if cmd == 52 {
                if pc >= 4 { act = 3 }
                msg = "Pane 4"
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }

            // r -- rename (inline since we need to mutate titles)
            if cmd == 114 {
                Terminal.move(rows, 1)
                Terminal.write("\x1b[33;40m Rename: " + repeat_str(" ", cols - 9) + "\x1b[0m")
                Terminal.move(rows, 10)
                var buf = ""
                var reading = 1
                while reading == 1 {
                    var k = Terminal.read_key()
                    if k == 13 { reading = 0 }
                    if k == 27 { buf = "" reading = 0 }
                    if k == 127 {
                        if buf.len() > 0 {
                            buf = buf.substring(0, buf.len() - 1)
                            Terminal.move(rows, 10)
                            Terminal.write(buf + " ")
                            Terminal.move(rows, 10 + buf.len())
                        }
                    }
                    if k >= 32 {
                        if k < 127 {
                            var chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
                            var ci = k - 32
                            if ci >= 0 {
                                if ci < chars.len() {
                                    var ch = chars.substring(ci, ci + 1)
                                    buf += ch
                                    Terminal.write(ch)
                                }
                            }
                        }
                    }
                }
                if buf.len() > 0 {
                    if act == 0 { titles[0] = buf }
                    if act == 1 { titles[1] = buf }
                    if act == 2 { titles[2] = buf }
                    if act == 3 { titles[3] = buf }
                    msg = "Renamed to '" + buf + "'"
                } else {
                    msg = "Rename cancelled"
                }
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }

            // l -- refresh all
            if cmd == 108 {
                if pc >= 1 { contents[0] = System.exec(cmds[0] + " 2>&1 | head -40") }
                if pc >= 2 { contents[1] = System.exec(cmds[1] + " 2>&1 | head -40") }
                if pc >= 3 { contents[2] = System.exec(cmds[2] + " 2>&1 | head -40") }
                if pc >= 4 { contents[3] = System.exec(cmds[3] + " 2>&1 | head -40") }
                msg = "Refreshed"
                Terminal.clear()
                draw_frame(cols, rows)
                if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            }

            // ? -- help
            if cmd == 63 {
                if show_help == 0 {
                    draw_help_overlay(cols, rows)
                    show_help = 1
                    msg = "Help -- press any key"
                } else {
                    show_help = 0
                    msg = ""
                    Terminal.clear()
                    draw_frame(cols, rows)
                    if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
                    if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
                    if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
                    if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
                }
            }

            draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], msg)
        }

        // Arrow right -- next pane
        if key == 1002 {
            act += 1
            if act >= pc { act = 0 }
            msg = "Pane ${act + 1}"
            if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
            if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
            if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
            if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], msg)
        }

        // Arrow left -- previous pane
        if key == 1003 {
            act -= 1
            if act < 0 { act = pc - 1 }
            msg = "Pane ${act + 1}"
            if pc >= 1 { draw_one_pane(0, act, pc, titles[0], contents[0], cols, rows) }
            if pc >= 2 { draw_one_pane(1, act, pc, titles[1], contents[1], cols, rows) }
            if pc >= 3 { draw_one_pane(2, act, pc, titles[2], contents[2], cols, rows) }
            if pc >= 4 { draw_one_pane(3, act, pc, titles[3], contents[3], cols, rows) }
            draw_status_bar(cols, rows, pc, act, titles[0], titles[1], titles[2], titles[3], msg)
        }
    }

    Terminal.restore()
    Terminal.clear()
    print("twux exited cleanly.")
}
