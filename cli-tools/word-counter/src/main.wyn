// word-counter -- rank the most frequent words in a file.
//
// Demonstrates a HashMap used the way you actually use one: tally every token, then
// rank the tallies. The previous version built the same HashMap and then threw it
// away - it printed the counts of nine HARDCODED keywords instead of the words that
// were actually common, so "word frequency" was a promise the output did not keep.
//
// Also shows: `.lines()` and `.split()` instead of a hand-rolled character scan,
// string interpolation, and a small struct sorted by a field.
//
//   wyn run cli-tools/word-counter/src/main.wyn <file>
//   wyn run cli-tools/word-counter/src/main.wyn        # falls back to this source

// One ranked entry. A struct, so the sort is by a named field rather than by decoding
// a packed integer.
struct Count { word: string, n: int }

// Lowercase and strip anything that is not a letter or digit, so "Cat," and "cat"
// count as one word. Done in Wyn rather than shelling out, because it is the kind of
// text munging the language should be comfortable with.
fn normalize(w: string) -> string {
    var out = ""
    for ch in w.lower().chars() {
        if (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") { out = out + ch }
    }
    return out
}

fn main() {
    print("\x1b[1;36m═══ word frequency ═══\x1b[0m")
    print("")

    // A file argument if given; otherwise this source, found whether the app is run
    // from its own directory or from the repo root.
    var path = ""
    args = System.args()
    if args.len() > 1 { path = args[1] }
    else if File.exists("src/main.wyn") == 1 { path = "src/main.wyn" }
    else if File.exists("cli-tools/word-counter/src/main.wyn") == 1 { path = "cli-tools/word-counter/src/main.wyn" }
    if path == "" or File.exists(path) == 0 {
        print("  \x1b[31mnot found:\x1b[0m ${path}   (pass a file path)")
        return
    }

    // Tally every word. get_int returns 0 for an absent key, so the first sight of a
    // word starts it at 1 with no special case.
    var counts = HashMap.new()
    var total = 0
    for line in File.read(path).lines() {
        for raw in line.split(" ") {
            var w = normalize(raw)
            if w.len() == 0 { continue }
            counts.insert_int(w, counts.get_int(w) + 1)
            total += 1
        }
    }

    // Rank. Pull the keys into structs, then a selection sort by count - the whole
    // point of building the HashMap, and the step the old version skipped.
    var ranked = []
    for k in counts.keys() { ranked.push(Count { word: k, n: counts.get_int(k) }) }

    var i = 0
    while i < ranked.len() {
        var max = i
        var j = i + 1
        while j < ranked.len() {
            if ranked[j].n > ranked[max].n { max = j }
            j += 1
        }
        if max != i {
            var tmp = ranked[i]
            ranked[i] = ranked[max]
            ranked[max] = tmp
        }
        i += 1
    }

    print("  \x1b[90m${total} words, ${ranked.len()} distinct\x1b[0m")
    print("")

    // An empty (or punctuation-only) file leaves `ranked` empty, and reading
    // `ranked[0].n` below then SEGFAULTED: a struct-array out-of-bounds read is
    // unchecked, unlike an int-array read which panics with a file and line. Bail out
    // before indexing rather than relying on the runtime to catch it.
    if ranked.len() == 0 {
        print("  \x1b[90mno words to rank\x1b[0m")
        print("")
        return
    }

    // The top 15, as a bar chart scaled to the most common word.
    var top = ranked[0].n
    var shown = 0
    for c in ranked {
        if shown >= 15 { break }
        var bar = ""
        var width = c.n * 30 / top
        for b in 0..width { bar = bar + "█" }
        print("  ${c.word.pad_right(16, " ")}\x1b[36m${bar}\x1b[0m ${c.n}")
        shown += 1
    }
    print("")
}
