// Tests for the classification and comment-detection rules in src/main.wyn.
// The old app had no tests, which is how it shipped finding zero markers.

enum Marker { Bug, Fixme, Hack, Xxx, Todo }

var marks = ["BUG", "FIXME", "HACK", "XXX", "TODO"]
var openers = ["//", "#", "/*", "*", "--"]

fn of_tag(s: string) -> Marker => match s {
    "BUG" => Marker.Bug,
    "FIXME" => Marker.Fixme,
    "HACK" => Marker.Hack,
    "XXX" => Marker.Xxx,
    _ => Marker.Todo
}
fn sev(m: Marker) -> int => match m {
    Marker.Bug => 0, Marker.Fixme => 1, Marker.Hack => 2, Marker.Xxx => 3, Marker.Todo => 4
}

// Same rule as scan(): the marker must be a whole word after a comment opener.
// Returns the marker tag, or "" for no hit.
fn hit_tag(line: string) -> string {
    var word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\""
    var cmt = -1
    for o in openers {
        var i = line.index_of(o)
        if i >= 0 and (cmt < 0 or i < cmt) { cmt = i }
    }
    if cmt < 0 { return "" }
    for m in marks {
        var at = line.index_of(m)
        var end = at + m.len()
        var whole = end >= line.len() or not word.contains(line.substring(end, end + 1))
        if at > cmt and whole { return m }
    }
    return ""
}

test "severity orders bug worst and todo least" {
    assert(sev(Marker.Bug) == 0)
    assert(sev(Marker.Bug) < sev(Marker.Fixme))
    assert(sev(Marker.Fixme) < sev(Marker.Hack))
    assert(sev(Marker.Hack) < sev(Marker.Xxx))
    assert(sev(Marker.Xxx) < sev(Marker.Todo))
}

test "unknown tags classify as todo" {
    assert(sev(of_tag("BUG")) == 0)
    assert(sev(of_tag("FIXME")) == 1)
    assert(sev(of_tag("HACK")) == 2)
    assert(sev(of_tag("XXX")) == 3)
    assert(sev(of_tag("TODO")) == 4)
    assert(sev(of_tag("nonsense")) == 4)
}

test "markers in comments are hits" {
    assert(hit_tag("    // TODO: expiry dates") == "TODO")
    assert(hit_tag("# FIXME rate table") == "FIXME")
    assert(hit_tag("      * @TODO don't expose this") == "TODO")
    assert(hit_tag("x = 8 / 100   // XXX which 8%?") == "XXX")
}

test "markers outside a comment are not hits" {
    // THE BUG THIS CATCHES: the old version used bare line.contains("TODO"), so a
    // string literal or an identifier counted as debt. These must all be misses.
    assert(hit_tag("var marks = [\"BUG\", \"TODO\"]") == "")
    assert(hit_tag("TODO written in prose, no comment opener") == "")
    assert(hit_tag("    return TODO_LIMIT") == "")
}

test "partial words are not markers" {
    assert(hit_tag("// TODOS later") == "")
    assert(hit_tag("// BUGGY behaviour") == "")
    assert(hit_tag("// TODO") == "TODO")
}

test "the sample tree really carries debt" {
    // Guards the failure mode that broke the old app: a default target that
    // matches nothing. Paths are relative to the app directory.
    var text = File.read("sample/checkout.wyn")
    assert(text.len() > 0)
    var n = 0
    for line in text.split("\n") { if hit_tag(line).len() > 0 { n += 1 } }
    assert(n == 5)
}
