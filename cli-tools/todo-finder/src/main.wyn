// todo-finder -- walk a source tree concurrently and report its code debt.
//
// The previous version was a hardcoded-pattern clone of cli-tools/wyn-grep carrying a
// hardcoded, WRONG file list ("../sample-apps/cli-tools/loc/src/main.wyn", ...), so every
// File.exists() was false and the ENTIRE run was:
//     === TODO Finder ===
//
//     Total items found: 0
// Its header also claimed "Demonstrates: spawn for concurrent file scanning" while
// containing no spawn at all.
//
// Rewritten into a real debt scanner, and into something wyn-grep is not:
//   * `enum Marker` in severity order, so a hit's rank IS its index in that ladder --
//     one enum, no separate severity table to fall out of sync with it.
//   * a marker counts only as a WHOLE WORD after a COMMENT opener, so a "BUG" string
//     literal is not debt and neither is TODOS. A grep cannot tell the difference.
//   * the tree is walked recursively and every file scanned CONCURRENTLY with `spawn`
//     + `await_all` -- the old header's claim, finally true.
//   * one `[Hit]` list feeds all three views (chart, worst files, listing), so they
//     cannot drift apart.
//
//   wyn run src/main.wyn [path]      # default "." -- this app, sample/ and all

enum Marker { Bug, Fixme, Hack, Xxx, Todo }

struct Hit { file: string, line: int, sev: int, text: string }

// Severity order, worst first: a marker's INDEX here is its severity rank, which is why
// there is no sev() table to fall out of step with the enum.
var marks = ["BUG", "FIXME", "HACK", "XXX", "TODO"]
// `*` is NOT here. It was, as a "continuation of a block comment" opener, and it made
// every line containing a multiplication or a markdown bold span into debt: the repo's own
// README line `| **todo-finder** | Scan for TODO/FIXME markers ...` was counted as two real
// markers, and `var n = 2 * len(TODO)` as one. A bare `*` cannot distinguish a comment
// continuation from arithmetic, and this tool's whole claim is that it only counts markers
// inside comments - so the guess has to go rather than be refined.
var openers = ["//", "#", "/*", "--"]
var code_ext = ["wyn", "c", "h", "cpp", "py", "js", "ts", "go", "rs", "java", "sh", "md"]

// The ladder by index, not `for m in [Marker.Bug, ...]`: a for-in over an array of enum
// variants whose body holds a LAMBDA pins the loop variable to the FIRST element on the
// compiler in this repo -- that is what made this chart print "BUG" five times. Repro:
//     for m in [M.A, M.B, M.C] { var g = [1].filter((n) => n > 0)  print(tag(m)) }
//   -> A A A
fn nth(i: int) -> Marker {
    if i == 0 { return Marker.Bug }
    if i == 1 { return Marker.Fixme }
    if i == 2 { return Marker.Hack }
    if i == 3 { return Marker.Xxx }
    return Marker.Todo
}

// The tag string is `marks[sev]` -- deliberately NOT a second match, so the tag a hit is
// reported under is the very string it was matched by.
fn colour(m: Marker) -> string => match m {
    Marker.Bug => "\x1b[1;31m", Marker.Fixme => "\x1b[31m", Marker.Hack => "\x1b[33m",
    Marker.Xxx => "\x1b[35m", Marker.Todo => "\x1b[36m"
}

// Collect scannable files. Dot-entries are skipped, so .git is never walked, and so are
// generated .wyn.c / .wyn.out build artifacts.
fn walk(dir: string) -> [string] {
    var out = []
    for name in File::list_dir(dir) {
        if name.len() == 0 or name.substring(0, 1) == "." { continue }
        var p = dir + "/" + name
        if File::is_dir(p) == 1 { for q in walk(p) { out.push("" + q) } }
        else if not p.contains(".wyn.") {
            var bits = p.split(".")
            if bits.len() > 1 and code_ext.contains("" + bits[bits.len() - 1]) { out.push(p) }
        }
    }
    return out
}

// One file, scanned off the main thread. Hits come back as one tab-separated string of
// "path\tline\tsev\ttext" rows that main re-inflates into Hits. Not stylistic: a future
// can only carry a STRING out on the compiler in this repo. `-> [Hit]` fails to compile,
// and a struct whose string field was BUILT IN THE CALLEE arrives EMPTY -- repro:
//     fn work() -> S { var b = ""  for i in 0..3 { b = b + "x" }  return S { blob: b, n: 3 } }
//   -> await_all gives n=3 but blob.len()=0: the count crossed, the string did not.
fn scan(path: string, text: string) -> string {
    var word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\""
    var blob = ""
    var ln = 1
    for line in text.split("\n") {
        // Where a comment starts, if anywhere: the earliest opener on the line.
        var cmt = -1
        for o in openers {
            var i = line.index_of(o)
            if i >= 0 and (cmt < 0 or i < cmt) { cmt = i }
        }
        // A `*` counts as a comment opener ONLY at the start of the line (a javadoc/block
        // continuation: `  * @TODO ...`). As a bare substring it matched every
        // multiplication and every markdown bold span; anchoring it to the line start keeps
        // the real case and loses the false positives.
        var lead = line.trim()
        if cmt < 0 and lead.len() > 0 and lead.substring(0, 1) == "*" {
            cmt = line.index_of("*")
        }
        var s = 0
        for m in marks {
            // SCAN EVERY OCCURRENCE, not just the first. A single index_of() meant that
            // if the first hit was before the comment opener, a genuine marker later on
            // the same line was silently dropped and never rescanned:
            //     var BUGS = 1  // BUG: a REAL one that was missed
            // found nothing at all.
            var pos = 0
            var found = false
            while not found {
                var rest = line.substring(pos, line.len())
                var rel = rest.index_of(m)
                if rel < 0 { break }
                var at = pos + rel
                var end = at + m.len()
                // A WHOLE WORD needs BOTH sides checked. Only the character AFTER the
                // marker was tested, so any word ENDING in one counted: `// the DEBUG
                // line` was booked as a BUG, which is how the repo scan reported 17.
                var after_ok = end >= line.len() or not word.contains(line.substring(end, end + 1))
                var before_ok = at == 0 or not word.contains(line.substring(at - 1, at))
                if cmt >= 0 and at > cmt and after_ok and before_ok {
                    blob = blob + "${path}\t${ln}\t${s}\t${line.trim()}\n"
                    found = true
                }
                pos = end
                if pos >= line.len() { break }
            }
            s += 1
        }
        ln += 1
    }
    return blob
}

fn main() {
    print("\x1b[1;36m═══ code debt ═══\x1b[0m")
    var args = System.args()
    var top = "."
    if args.len() > 1 { top = "" + args[1] }
    var files = walk(top)
    if files.len() == 0 {
        print("  no scannable files under \x1b[1m${top}\x1b[0m")
        return
    }

    // Every file scanned at once, one future each.
    var futs = []
    for f in files { futs.push(spawn scan(f, File.read(f))) }
    var scans = await_all(futs)

    // Re-inflate every row into a Hit, tallying per file as we go.
    var hits = []
    var per_file = HashMap.new()
    for blob in scans {
        for l in blob.split("\n") {
            if l.len() == 0 { continue }
            var c = l.split("\t")
            var path = "" + c[0]
            hits.push(Hit { file: path, line: c[1].to_int(), sev: c[2].to_int(), text: "" + c[3] })
            per_file.insert_int(path, per_file.get_int(path) + 1)
        }
    }
    var dirty = per_file.keys().len()
    print("  \x1b[1m${hits.len()}\x1b[0m markers in \x1b[1m${dirty}\x1b[0m of ${files.len()} files under \x1b[90m${top}\x1b[0m")

    // Severity chart, worst marker first, scaled so the biggest bar is 30 wide.
    var sizes = []
    for i in 0..5 {
        var want = i
        sizes.push(hits.filter((h) => h.sev == want).len())
    }
    var peak = sizes.max()
    print("")
    for i in 0..5 {
        var m = nth(i)
        if sizes[i] > 0 {
            var name = "" + marks[i]
            print("  ${colour(m)}${name.pad_right(6, " ")}${"█".repeat(1 + sizes[i] * 29 / peak)}\x1b[0m ${sizes[i]}")
        }
    }

    // Worst offenders, by hit count.
    print("")
    print("  \x1b[1mworst files\x1b[0m")
    var ranked = per_file.keys().sort_by((k) => 0 - per_file.get_int("" + k))
    for i in 0..5 {
        if i >= dirty { break }
        var k = "" + ranked[i]
        print("  ${per_file.get_int(k).to_string().pad_left(4, " ")}  \x1b[90m${k}\x1b[0m")
    }

    // Every hit, grouped by marker, worst group first; 5 shown per group.
    for i in 0..5 {
        var want = i
        var group = hits.filter((h) => h.sev == want)
        if group.len() == 0 { continue }
        var m = nth(i)
        print("")
        var name = "" + marks[i]
        print("  ${colour(m)}${name}\x1b[0m \x1b[90m(${group.len()})\x1b[0m")
        var shown = 0
        for h in group {
            if shown == 5 { print("    \x1b[90m... ${group.len() - 5} more\x1b[0m") break }
            var t = "" + h.text
            if t.len() > 68 { t = t.substring(0, 65) + "..." }
            print("    \x1b[90m${h.file}:${h.line}\x1b[0m ${t}")
            shown += 1
        }
    }
    print("")
}
