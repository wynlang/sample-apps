// todo-finder — Scan source files for action item comments
// Demonstrates: file I/O, string methods, structs

fn find_todos(filename: string) -> int {
    var content = File.read(filename)
    var line_num = 1
    var line_start = 0
    var len = content.len()
    var found = 0

    for i in 0..len {
        if content[i] == "\n" {
            var line = content.substring(line_start, i)

            if line.contains("TODO") {
                println("  " + filename + ":" + line_num.to_string() + " [TODO] " + line.trim())
                found = found + 1
            }
            if line.contains("FIXME") {
                println("  " + filename + ":" + line_num.to_string() + " [FIXME] " + line.trim())
                found = found + 1
            }
            if line.contains("HACK") {
                println("  " + filename + ":" + line_num.to_string() + " [HACK] " + line.trim())
                found = found + 1
            }

            line_num = line_num + 1
            line_start = i + 1
        }
    }
    return found
}

fn main() -> int {
    println("=== TODO Finder ===")
    println("")

    // Scan the sample apps themselves for TODOs
    var files = [
        "../sample-apps/cli-tools/loc/main.wyn",
        "../sample-apps/cli-tools/todo-finder/main.wyn",
        "../sample-apps/cli-tools/word-counter/main.wyn",
        "../sample-apps/cli-tools/config-reader/main.wyn",
        "../sample-apps/cli-tools/md-toc/main.wyn",
        "../sample-apps/cli-tools/twux/main.wyn"
    ]
    var total = 0

    for i in 0..6 {
        if File.exists(files[i]) {
            total = total + find_todos(files[i])
        }
    }

    println("")
    println("Total items found: " + total.to_string())
    return 0
}
