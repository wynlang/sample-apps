// config-reader -- parse a real config file, infer each value's type, validate a schema.
//
// The previous version was a hardcoded string list wearing a parser's clothes. It printed
// "Loaded 8 config entries" and a flat list including `database_host = localhost` -- but
// `database_host` was not a key it had parsed from anything. Line 38 was literally
//   var keys = ["app_name", "version", "port", ..., "database_host", "database_port"]
// so the "structure" in the output was invented in the source. Nothing was validated
// either: the only check was `if port > 0 { "Port is valid" }`.
//
// Rewritten as the thing every program actually needs:
//   * a real TOML-ish parser -- `[sections]`, `key = value`, `#` comments, quoted strings.
//     A section plus a key makes `database.host`: genuinely nested, not a fabricated name.
//   * `enum Value { Int, Float, Bool, Str }` inferred per value, so `8080` is an int and
//     `"8080"` is a string, and every place that names a type is one `match`.
//   * a declared SCHEMA validated both ways -- every problem at once, with line numbers:
//     type mismatch, out-of-range port, unknown key, malformed line, missing required key.
//   * typed accessors, so the caller gets an `int` and not a string to re-parse.
//
//   wyn run cli-tools/config-reader/src/main.wyn [config-file]

enum Value { Int, Float, Bool, Str }

struct Entry { line: int, path: string, raw: string, kind: Value }
struct Rule  { path: string, kind: Value, lo: int, hi: int }
struct Fault { line: int, msg: string }

fn type_name(k: Value) -> string => match k {
    Value.Int   => "int",
    Value.Float => "float",
    Value.Bool  => "bool",
    Value.Str   => "string"
}

// Infer from the literal, the way a config loader must: true/false is a bool, all-digits
// an int, digits with one dot a float. (Quoted is forced to Str by the caller.)
fn infer(v: string) -> Value {
    if v == "true" or v == "false" { return Value.Bool }
    var dots = 0
    var digits = v.len() > 0
    for i in 0..v.len() {
        var c = v.substring(i, i + 1)
        if c == "." { dots += 1 }
        else if c < "0" or c > "9" { digits = false }
    }
    if digits and dots == 0 { return Value.Int }
    if digits and dots == 1 { return Value.Float }
    return Value.Str
}

// Typed access: the caller gets an int, not a string to re-parse.
fn get_int(es: [Entry], path: string) -> int {
    for e in es { if e.path == path { return ("" + e.raw).to_int() } }
    return 0
}

fn get_str(es: [Entry], path: string) -> string {
    for e in es { if e.path == path { return "" + e.raw } }
    return ""
}

fn main() {
    print("\x1b[1;36m═══ config reader ═══\x1b[0m\n")

    // The file argument, or app.conf found from the app dir, src/, or the repo root.
    var path = ""
    args = System.args()
    if args.len() > 1 { path = args[1] }
    else if File.exists("app.conf") == 1 { path = "app.conf" }
    else if File.exists("../app.conf") == 1 { path = "../app.conf" }
    else if File.exists("cli-tools/config-reader/app.conf") == 1 { path = "cli-tools/config-reader/app.conf" }
    if path == "" or File.exists(path) == 0 {
        print("  \x1b[31mno config file\x1b[0m (pass a path, or run from the app directory)")
        return
    }

    var entries = []
    var faults = []
    var section = "-"
    var n = 0
    // `.split("\n")`, not `.lines()`: a blank line must still advance the counter, or every
    // reported line number is wrong.
    for raw_line in File.read(path).split("\n") {
        n += 1
        // Cut a trailing `# comment`, but only where the `#` sits outside quotes.
        var t = raw_line.trim()
        var cut = t.len()
        var quotes = 0
        for i in 0..t.len() {
            var c = t.substring(i, i + 1)
            if c == "\"" { quotes += 1 }
            if c == "#" and quotes % 2 == 0 { cut = i; break }
        }
        t = t.substring(0, cut).trim()
        if t.len() == 0 { continue }

        if t.substring(0, 1) == "[" {
            var close = t.index_of("]")
            if close < 1 { faults.push(Fault { line: n, msg: "unterminated section header: ${t}" }) }
            else { section = t.substring(1, close).trim() }
            continue
        }
        var eq = t.index_of("=")
        if eq < 1 {
            faults.push(Fault { line: n, msg: "malformed line, expected `key = value`: ${t}" })
            continue
        }
        var key = t.substring(0, eq).trim()
        var val = t.substring(eq + 1, t.len()).trim()
        var quoted = val.len() > 1 and val.substring(0, 1) == "\""
        if quoted {
            var body = val.substring(1, val.len())
            var end = body.index_of("\"")
            if end < 0 { faults.push(Fault { line: n, msg: "unterminated string for `${key}`" }) }
            else { val = body.substring(0, end) }
        }
        var kind = Value.Str
        if not quoted { kind = infer(val) }
        entries.push(Entry { line: n, path: "${section}.${key}", raw: val, kind: kind })
    }

    // What was parsed: section, key, inferred type, value. Derived, not invented.
    print("  \x1b[1m${path}\x1b[0m \x1b[90m${n} lines\x1b[0m → \x1b[1m${entries.len()}\x1b[0m entries")
    var shown = "-"
    for e in entries {
        var p = "" + e.path
        var dot = p.index_of(".")
        var sec = p.substring(0, dot)
        if sec != shown { print("\n  \x1b[35m[${sec}]\x1b[0m"); shown = sec }
        print("    ${p.substring(dot + 1, p.len()).pad_right(9, " ")} \x1b[90m${type_name(e.kind).pad_right(6, " ")}\x1b[0m ${e.raw}")
    }

    // The schema: expected type per key; `lo`/`hi` bound an int (0/0 means unbounded).
    var rules = [
        Rule { path: "app.name",       kind: Value.Str,   lo: 0, hi: 0 },
        Rule { path: "app.version",    kind: Value.Str,   lo: 0, hi: 0 },
        Rule { path: "app.debug",      kind: Value.Bool,  lo: 0, hi: 0 },
        Rule { path: "server.host",    kind: Value.Str,   lo: 0, hi: 0 },
        Rule { path: "server.port",    kind: Value.Int,   lo: 1, hi: 65535 },
        Rule { path: "server.workers", kind: Value.Int,   lo: 1, hi: 256 },
        Rule { path: "server.timeout", kind: Value.Float, lo: 0, hi: 0 },
        Rule { path: "database.host",  kind: Value.Str,   lo: 0, hi: 0 },
        Rule { path: "database.port",  kind: Value.Int,   lo: 1, hi: 65535 },
        Rule { path: "database.name",  kind: Value.Str,   lo: 0, hi: 0 },
        Rule { path: "database.pool",  kind: Value.Int,   lo: 1, hi: 64 },
        Rule { path: "logging.level",  kind: Value.Str,   lo: 0, hi: 0 }
    ]
    // Validate both ways: every entry against the schema, then every rule against reality.
    for e in entries {
        var p = "" + e.path
        var known = false
        for r in rules {
            if ("" + r.path) != p { continue }
            known = true
            if type_name(e.kind) != type_name(r.kind) {
                faults.push(Fault { line: e.line, msg: "${p}: expected ${type_name(r.kind)}, got ${type_name(e.kind)} (${e.raw})" })
            } else if r.hi > 0 {
                var v = ("" + e.raw).to_int()
                if v < r.lo or v > r.hi { faults.push(Fault { line: e.line, msg: "${p}: ${v} out of range ${r.lo}..${r.hi}" }) }
            }
        }
        if not known { faults.push(Fault { line: e.line, msg: "${p}: unknown key, not in schema" }) }
    }
    for r in rules {
        var want = "" + r.path
        var seen = false
        for e in entries { if ("" + e.path) == want { seen = true } }
        if not seen { faults.push(Fault { line: 0, msg: "${want}: required key is missing" }) }
    }

    print("")
    if faults.len() == 0 { print("  \x1b[32m✓ config is valid\x1b[0m") }
    else {
        print("  \x1b[1;31m${faults.len()} problem(s)\x1b[0m")
        var ordered = faults.sort_by((f) => f.line)   // report in file order
        for f in ordered {
            var at = "line ${f.line}"
            if f.line == 0 { at = "absent " }
            print("    \x1b[31m✗\x1b[0m \x1b[90m${at.pad_right(8, " ")}\x1b[0m ${f.msg}")
        }
    }

    // Typed access: real ints and strings out, no re-parsing at the call site.
    var db_port = get_int(entries, "database.port")
    print("\n  \x1b[1mtyped access\x1b[0m")
    print("    connect to \x1b[36m${get_str(entries, "database.host")}:${db_port}\x1b[0m (next free port ${db_port + 1})")
    print("    pool of ${get_int(entries, "database.pool")} at level \x1b[36m${get_str(entries, "logging.level")}\x1b[0m\n")
}
